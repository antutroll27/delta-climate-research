{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/textures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/collections/wards/items.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/geo+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/collections/wards/items/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/geo+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/wards/(.*)/cityjson.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/city+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/ngsi-ld/(.*).jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/stac/items/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/geo+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.oai.openapi+json;version=3.1"
        }
      ]
    }
  ]
}
