# Dependencies
node_modules/

# Build output
dist/
.output/

# Environment files
.env
.env.local
.env.*.local

# Secrets — GCP/Earth Engine service-account keys must NEVER enter the repo.
# They live at ~/.config/delta-climate/ and are read via GOOGLE_APPLICATION_CREDENTIALS.
# (src/ is bundler-visible AND .vercelignore does not exclude src/, so a key here
#  would ship to the client and to the Vercel build machine.)
*service-account*.json
*-credentials.json
gcp-*.json
deltaclimate-*.json
# NASA Earthdata bearer tokens / netrc — live in ~/.config/delta-climate/
*earthdata*token*
.netrc

# OS
.DS_Store
Thumbs.db
._*

# Editor
.vscode/
.idea/

# Astro
.astro/
.vercel
playwright-report/
test-results/
# Playwright CLI trace/session cache and agent run artifacts (screenshots, reports —
# tens of MB, regenerated on demand; never belong in git)
.playwright-cli/
output/



# firecrawl CLI scrape cache
.firecrawl/

# preview scratch artifacts (headless screenshots + verification scripts)
#
# The whole directory, not just its top level. The old patterns were
# `previews/_*` plus `previews/*.html` further down, which matched neither
# subdirectories nor the .png/.mjs inside them — so 61 MB of screenshots and
# throwaway verification scripts across 11 sub-folders sat untracked and one
# `git add -A` from entering the history permanently.
previews/
models-src/

# heavy/unshipped 3D assets — keep local, out of git (move to Git LFS when wiring production)
public/models/river-8k.glb
# flora assets (feature not yet built into the hero)
public/models/flora.glb
public/models/flora_raw.glb
public/models/flowers_pack_4.glb
public/models/nature_vegetation_pack.glb
inspiration/

# personal Claude Code permission posture (not shared)
.claude/settings.local.json

# python bytecode from the data-pipeline scripts
scripts/__pycache__/

# Swept in by an over-broad `git add -A` during the Landsat campaign.
# A 2 MB Claude Code session transcript and a 582 KB PDF that regenerates
# from thermal-splatting-brief.md — neither belongs in version control.
docs/dataset/*.jsonl
docs/*.pdf

# overturemaps CLI resume scratch — not data, regenerated per download
data/geometry/raw/*.state
