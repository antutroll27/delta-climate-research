---
import { ClientRouter } from 'astro:transitions';
// Fonts are self-hosted via @font-face in global.css (Satoshi, Moonscape Serif, Noplato Mono).
// Old mono kept available — uncomment to load Geist Mono (use via the --font-mono-alt token):
// import '@fontsource-variable/geist-mono/index.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const BRAND_DESCRIPTION =
  'A boutique consultancy turning decision-grade climate-risk and embodied-carbon intelligence into standards-aligned adaptation decisions.';

const {
  title = 'Delta Climate Research — Research-led climate intelligence',
  description = BRAND_DESCRIPTION,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Demo-safe structured data: only truthfully-assertable facts (no contact/socials).
// `Astro.site!` relies on `site` being set in astro.config.mjs (it always is — the
// sitemap integration requires it too); build fails loudly if that invariant breaks.
const site = Astro.site!.href.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${site}/#organization`,
      name: 'Delta Climate Research',
      url: `${site}/`,
      logo: `${site}/favicon.svg`,
      description: BRAND_DESCRIPTION,
      areaServed: ['India', 'United Arab Emirates'],
      knowsAbout: [
        'Urban heat vulnerability mapping',
        'Heat Vulnerability Index',
        'Blue carbon MRV',
        'Mangrove soil organic carbon',
        'Embodied carbon accounting',
        'Environmental Product Declarations',
        'Climate risk intelligence',
        'Carbon Border Adjustment Mechanism',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'Delta Climate Research',
      publisher: { '@id': `${site}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Delta Climate Research" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="author" content="Delta Climate Research" />
    <meta name="theme-color" content="#050606" />

    <!-- Structured data (demo-safe: only truthful facts) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Mona Sans (variable woff2) — the site's display + body sans, above the fold -->
    <link
      rel="preload"
      href="/fonts/MonaSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Moonscape Serif removed — see src/styles/_serif-stash.css to restore -->
    <!-- Noplato Mono — above-the-fold mono labels (kicker, nav) -->
    <link
      rel="preload"
      href="/fonts/NoplatoMono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />

    <!-- pre-paint: a hard reload always lands on the hero, never a deep-linked
         section. Runs in <head> before the body parses, so stripping the hash
         beats the browser's native anchor jump; manual scrollRestoration stops
         it restoring the prior scroll position. Only fires on a real 'reload'
         navigation — fresh deep-links (/#about typed or clicked from another
         page) and back/forward keep their anchor. View transitions don't re-run
         inline head scripts, so in-site navigation is untouched. -->
    <script is:inline>
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        var isReload = nav
          ? nav.type === 'reload'
          : performance.navigation && performance.navigation.type === 1;
        if (isReload) {
          history.scrollRestoration = 'manual';
          if (location.hash) {
            history.replaceState(null, '', location.pathname + location.search);
          }
        }
      } catch (e) {}
    </script>

    <!-- pre-paint: only enable reveal-hiding when motion is allowed (flash-safe; no-JS shows all) -->
    <script is:inline>
      try {
        if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          document.documentElement.classList.add('reveal-ready');
        }
      } catch (e) {}
    </script>

    <!-- pre-paint loader gate: first-visit instrument loader, home only, once per
         session, motion allowed. Sets the attribute before the body paints so
         returning visitors never see a flash. -->
    <script is:inline>
      try {
        if (
          location.pathname === '/' &&
          !sessionStorage.getItem('delta:loaded') &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          document.documentElement.setAttribute('data-loader', 'show');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />

    <script>
      import { initSmoothScroll, destroySmoothScroll } from '../scripts/smooth-scroll';
      import { initScrollEffects, destroyScrollEffects } from '../scripts/scroll-effects';
      import { initSectionEffects, destroySectionEffects } from '../scripts/section-effects';
      import { initAboutField, destroyAboutField } from '../scripts/about-field';

      function initScroll() {
        // destroy-first makes init idempotent (page-load can fire after a prior init)
        destroyAboutField();
        destroySectionEffects();
        destroyScrollEffects();
        destroySmoothScroll();
        initSmoothScroll();
        initScrollEffects();
        initSectionEffects();
        initAboutField(); // async (three.js code-split); no-ops off the home page
      }

      function teardownScroll() {
        destroyAboutField();
        destroySectionEffects();
        destroyScrollEffects();
        destroySmoothScroll();
      }

      // astro:page-load fires on first load AND after every view-transition nav.
      document.addEventListener('astro:page-load', initScroll);
      // Kill triggers/ticker before the DOM is swapped out.
      document.addEventListener('astro:before-swap', teardownScroll);
    </script>

    <script>
      let revealIO: IntersectionObserver | undefined;

      function setupReveals() {
        if (!document.documentElement.classList.contains('reveal-ready')) return;
        revealIO = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              if (el.hasAttribute('data-reveal-group')) {
                const step = parseInt(el.getAttribute('data-stagger') || '70', 10);
                Array.from(el.children).forEach((child, i) => {
                  (child as HTMLElement).style.transitionDelay = `${i * step}ms`;
                  child.classList.add('is-inview');
                });
              } else {
                el.classList.add('is-inview');
              }
              obs.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -4% 0px', threshold: 0.05 }
        );
        document
          .querySelectorAll('[data-reveal], [data-reveal-group]')
          .forEach((el) => revealIO!.observe(el));
      }

      function teardownReveals() {
        revealIO?.disconnect();
        revealIO = undefined;
      }

      setupReveals();
      document.addEventListener('astro:page-load', setupReveals);
      document.addEventListener('astro:before-swap', teardownReveals);
    </script>
  </body>
</html>
