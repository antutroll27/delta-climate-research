---
// Climate Highlights — a live read on the indicators Delta tracks (the same
// signals behind the hero's Climate Clock), curated into a highlights board.
// Night-tide coming-soon until the board ships; the Δ ghost mark keeps it
// distinct from the numbered research/project placeholders.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SoonTide from '../components/SoonTide.astro';
---

<Base
  title="Climate Highlights — Delta Climate Research"
  description="A live read on the climate indicators Delta Climate Research tracks — renewables, regenerative land, and protected territory — curated into a highlights board. Currently in preparation."
  noindex
>
  <Nav />
  <SoonTide
    kicker="Climate Highlights"
    sub="A live read on the indicators we watch — renewables, regenerative land, protected territory — curated down to the few that actually move a decision. The board surfaces this cycle; the clock on the hero is the first beat of it."
    ghost="Δ"
    gaugeLabel="LIVE — 0.3"
    statusRows={[
      { k: 'Status', v: 'In preparation', live: true },
      { k: 'Source', v: 'Live indicators' },
      { k: 'Window', v: '2026 · Q3' },
    ]}
    backHref="/"
    backLabel="Back to home"
    nextHref="/white-papers"
    nextLabel="White papers"
    notifySubject="Notify me — Climate Highlights"
  >
    The signal is still <em>surfacing.</em>
  </SoonTide>
  <Footer />
</Base>
