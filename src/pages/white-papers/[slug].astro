---
// Per-paper page. Until a paper ships (`published: true` in src/data/papers.ts
// plus real content here), this renders the night-tide "in preparation" page:
// drifting waves, star field, bobbing ghost numeral, and the status readout.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SoonTide from '../../components/SoonTide.astro';
import { papers } from '../../data/papers';

export function getStaticPaths() {
  return papers.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

const { paper } = Astro.props;
const idx = papers.findIndex((p) => p.slug === paper.slug);
const next = papers[(idx + 1) % papers.length];
---

<Base
  title={`${paper.title} — Delta Climate Research`}
  description={paper.excerpt}
  noindex={!paper.published}
  ogType={paper.published ? 'article' : 'website'}
>
  <Nav />
  <SoonTide
    kicker={`White Paper WP/${paper.id} — ${paper.cat}`}
    sub={paper.excerpt}
    ghost={paper.id}
    gaugeLabel={`DRAFT — WP/${paper.id}`}
    statusRows={[
      { k: 'Status', v: 'In preparation', live: true },
      { k: 'Series', v: paper.cat },
      { k: 'Window', v: paper.date },
      { k: 'Access', v: 'On publication' },
    ]}
    backHref="/white-papers"
    backLabel="All research"
    nextHref={`/white-papers/${next.slug}`}
    nextLabel={`Next: WP/${next.id}`}
    notifySubject={`Notify me — WP/${paper.id}`}
  >
    {paper.title}
  </SoonTide>
  <Footer />
</Base>
