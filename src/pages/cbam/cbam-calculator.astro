<script>
  import { initCbam } from '../../scripts/cbam-algos/cbam-app.ts';
  import { mountViews } from '../../scripts/cbam-ui/views.ts';
  // Mount on load and on soft nav (ClientRouter), matching the heat map's pattern. Both guard
  // against the double call themselves (astro:page-load also fires on first paint).
  const boot = () => {
    const root = document.getElementById('cbx');
    if (!root) return;
    // ponytail: dark by default for now. Phase 1 re-homes today's cb-* cards unchanged, and they
    // are drawn for a dark ground: in light theme the attest label read 1.01:1 (axe). Light comes
    // back as the OS default once phases 2-4 restyle the cards; ?theme=light previews it meanwhile.
    const theme = new URLSearchParams(location.search).get('theme');
    root.dataset.theme = theme === 'light' ? 'light' : 'dark';
    mountViews(root);
    initCbam();
  };
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

