---
// CBAM certificate estimator — the working tool.
//
// The engine under src/scripts/cbam-algos/ is the GeoCBAM SaaS's, copied
// byte-for-byte and never edited here. This page is the form and the readout.
//
// WHY THIS IS NOT THE VUE COMPONENT. The portability dossier recommends mounting
// the SaaS's own cards as an Astro island, and its reasoning is sound: the
// honesty states are enforced inside those components, so taking them means the
// honesty travels for free. Two things pointed the other way. §6.7 — the cards
// carry GeoCBAM's design tokens, and this site has its own @theme; and
// precedent: the heat map, far more complex than a form, is vanilla TS here. So
// the engine is verbatim, the UI is native, and the honesty states are held
// instead by an exhaustive switch in cbam-app.ts plus a test asserting every
// branch renders what it owes.
//
// THE LOOK follows docs/cbam-calculator-ui-astro.md — its layout, spacing,
// instrument-card structure and the behaviours in its §6 — expressed in this
// site's palette rather than GeoCBAM's. The doc's own colour law ("gold means
// default values, teal means verified") is already this site's law with bronze
// and cyan, so the semantics ported without translation.
//
// TWO PLACES THE DOC IS WRONG FOR THIS BUILD, both checked rather than assumed:
//   §5 says the form must be a client-framework island with client:load, because
//   "Astro components shed their interactivity". Not so — the interactivity is a
//   plain <script> module, and the dependent route field works. No Vue, no React.
//   §9 lists the result-card internals as not covered; the waterfall, provenance
//   stamp and status tags were already built here.
//
// THE FRAMING BANNER IS MARKUP, NOT JAVASCRIPT (dossier §7.1). It must be on the
// page whether or not the script runs, whether or not the pack loads.
import Base from '../../layouts/Base.astro';
import '../../styles/cbam-app.css';
import '../../styles/cbam-bento.css';
import { renderSectorChips } from '../../scripts/cbam-ui/good-sheet.ts';
import { renderTitleCard } from '../../scripts/cbam-ui/title-card.ts';
---

<Base
  title="CBAM Calculator · Delta Climate"
  description="Estimate EU CBAM certificate exposure for a good, origin and production route. Runs entirely in your browser from the Commission's published default values and benchmarks. Screening-grade: it shows what it cannot compute rather than guessing."
  noindex
  nativeScroll
>
  <div class="cbx" id="cbx">
    <nav class="cbx-rail" aria-label="Calculator sections">
      <a class="cbx-brand" href="/" aria-label="Delta Climate Research, home">
        <svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true"><path d="M14 3 25 24H3Z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M14 9.5 20 21H8Z" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M14 15 16.5 20H11.5Z" fill="currentColor"/></svg>
        <span class="cbx-lbl"><span><b>Delta</b> Climate</span><span class="cbx-app">CBAM Calculator</span></span>
      </a>
      <div class="cbx-tcard" id="cbTitle" set:html={renderTitleCard(null)} />
      <button type="button" class="cbx-nav" data-goto="estimate"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3.5h10a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1ZM7 7h6M7 10.5h2M11 10.5h2M7 13.5h2M11 13.5h2"/></svg><span class="cbx-lbl">Estimate</span></button>
      <button type="button" class="cbx-nav" data-goto="three-years"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16V11M10 16V7M16 16V3.5"/></svg><span class="cbx-lbl">Three years</span></button>
      <button type="button" class="cbx-nav" data-goto="why"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 15 8 10l3 2.5 5-7M12.5 5.5H16V9"/></svg><span class="cbx-lbl">Why it changes</span></button>
      <button type="button" class="cbx-nav" data-goto="list"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5h9M7 10h9M7 15h9M3.5 5h.5M3.5 10h.5M3.5 15h.5"/></svg><span class="cbx-lbl">Shipment list</span><em class="cbx-badge" data-list-badge hidden></em></button>
      <button type="button" class="cbx-nav" data-goto="export"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5v9M6.5 9.5 10 13l3.5-3.5M4 16.5h12"/></svg><span class="cbx-lbl">Export</span></button>
      <button type="button" class="cbx-nav" data-goto="rules"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3.5h7l3 3V16a.5.5 0 0 1-.5.5h-9.5a.5.5 0 0 1-.5-.5V4a.5.5 0 0 1 .5-.5ZM7.5 9.5h5M7.5 12.5h5M7.5 6.5h2.5"/></svg><span class="cbx-lbl">Rules &amp; sources</span></button>
      <button type="button" class="cbx-nav cbx-collapse" data-collapse aria-expanded="true"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 5 7 10l5 5"/></svg><span class="cbx-lbl">Collapse menu</span></button>
    </nav>

    <header class="cbx-top">
      <a href="/" aria-label="Delta Climate Research, home"><svg viewBox="0 0 28 28" width="24" height="24" aria-hidden="true"><path d="M14 3 25 24H3Z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
      <div><span class="cbx-app">CBAM Calculator</span><span id="cbTitlePhone">No line yet</span></div>
    </header>

    <main id="main" tabindex="-1" class="cbx-main">
      <section data-view="estimate" aria-labelledby="cbxH-estimate">
        <h1 id="cbxH-estimate" class="cbx-h1" tabindex="-1">Estimate. <span>A labelled what-if, not a declaration.</span></h1>
        <!-- NON-NEGOTIABLE §7.1 — ships with the calculator, always, in markup. -->
      <!-- WORDING APPROVED 2026-10-14. The three sentences from "This tool counts
           certificates" to "labelled what-if" replace the ones that said a 2027 or 2028 import
           returns nothing, which stopped being true when the pack gained pending price rows
           for those years. The alternatives that were considered are in
           docs/superpowers/plans/2026-10-13-cbam-pending-price-rows.md.
           The date is the day the pack's certificate-price source was last read (its
           retrievedAt), the date the pack's own 2027-28 rows give for "none published";
           cbam-render.test.mjs fails if the two disagree. -->
      <div class="cb-banner" role="note">
        Prototype estimator · Commission default values or your own verified figures · decision-support, not a
        declaration. Computed in your browser from the published rules, and never sent
        anywhere. This tool counts certificates for 2026, 2027 and 2028 imports, and shows a
        cost only where the Commission has published a certificate price. For 2026 the price is
        set per quarter. From 2027 it is set weekly: none published as at 14 October 2026, so a
        2027 or 2028 import shows certificates and no cost. No final figure exists for any of
        these years — the cross-sectoral correction factor is unpublished — so any number below
        is a labelled what-if. This is not a filing, not validated by the EU CBAM Registry, and
        not a statement of monetary liability.
      </div>
        <div class="cb-grid b-est">
          <section class="b-inputs" aria-labelledby="cbInH">
            <div class="b-in-head">
              <h2 class="b-t-ti" id="cbInH">Your line.</h2>
              <p class="b-t-sub">Fill these in, top to bottom. The estimate updates as you go.</p>
            </div>

            <section class="b-t b-inp">
              <span class="b-step" aria-hidden="true">1</span>
              <label class="b-t-ti" for="cbCn">Good.</label>
              <div class="b-field">
                <svg class="b-fi-ic" viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"/><path d="m13 13 3.5 3.5"/></svg>
                <input id="cbCn" list="cbCnList" autocomplete="off" spellcheck="false" aria-describedby="cbCnName"
                       placeholder="e.g. 2523100090 — grey cement clinker" />
                <button type="button" class="b-pill" data-good-open aria-haspopup="dialog" aria-expanded="false"
                        aria-controls="cbGoodSheet" aria-label="Change good">Change</button>
              </div>
              <datalist id="cbCnList"></datalist>
              <!-- Spec D5: the Commission's full CN description, clamped to two lines; the full text in title. -->
              <p class="b-help b-clamp2" id="cbCnName">Type a CN code, or press Change to search by name.</p>
            </section>

            <section class="b-t b-inp" aria-labelledby="cbStep2">
              <span class="b-step" aria-hidden="true">2</span>
              <h3 class="b-t-ti" id="cbStep2">Origin &amp; route.</h3>
              <label class="b-lab" for="cbCountry">Country of origin</label>
              <div class="b-field">
                <select id="cbCountry">
                  <option value="" disabled selected>Select origin…</option>
                </select>
              </div>
              <span class="b-lab" id="cbRouteLab">Production route</span>
              <!-- THE SOURCE OF TRUTH, HIDDEN (spec §6.5). cbam-app.ts rebuilds and reads this select; the
                   radiogroup below mirrors it both ways (inputs-estimate.ts mountRadioMirror). 1×1 and
                   clipped, not [hidden], so cbam-lines.spec.ts's selectOption still reaches it. -->
              <select id="cbRoute" class="b-native" tabindex="-1" aria-hidden="true" disabled>
                <option value="">Choose a good and origin first</option>
              </select>
              <div class="b-segrow" id="cbRouteSeg" role="radiogroup" aria-labelledby="cbRouteLab">
                <p class="b-help b-seg-empty">Choose a good and origin first</p>
              </div>
              <p class="b-help" id="cbRouteVo"></p>
              <!-- THE PROVENANCE HALF, and DELIBERATELY NOT A LIVE REGION: it restates the route just
                   picked, so announcing it would read the same route back twice. -->
              <p class="b-help" id="cbRouteNote"></p>
            </section>

            <section class="b-t b-inp">
              <span class="b-step" aria-hidden="true">3</span>
              <label class="b-t-ti" for="cbDate">Import date.</label>
              <div class="b-field"><input id="cbDate" type="date" value="2026-03-15" /></div>
              <div id="cbDatePeriod"></div>
              <!-- ITS OWN LIVE REGION, DELIBERATELY NOT #cbStatus: it fires on `date` change, and #cbStatus
                   has one writer on the add path. The two never fire on the same interaction. -->
              <p class="cb-datenote b-help" id="cbDateNote" role="status" aria-live="polite"></p>
            </section>

            <section class="b-t b-inp">
              <span class="b-step" aria-hidden="true">4</span>
              <label class="b-t-ti" for="cbMass">Net mass.<span class="cb-sr"> In tonnes.</span></label>
              <div class="b-field b-field-big">
                <input id="cbMass" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value="100" aria-describedby="cbMassHint" />
                <span aria-hidden="true">t</span>
              </div>
              <!-- H1 (audit 2026-11-02): a text field, read by the engine's own parser. type="number"
                   re-read 0,85 as 085 in Chromium and priced the figure tenfold. -->
              <p class="b-help" id="cbMassHint">Use a decimal point: 0.85, not 0,85.</p>
              <div id="cbMassRuler" aria-hidden="true"></div>
            </section>

            <section class="b-t b-inp" aria-labelledby="cbStep5">
              <span class="b-step" aria-hidden="true">5</span>
              <h3 class="b-t-ti" id="cbStep5">Emissions data.</h3>
              <select id="cbTier" class="b-native" tabindex="-1" aria-hidden="true">
                <option value="default+markup" selected>Commission default + mark-up</option>
                <option value="actual-verified">My verified figures</option>
              </select>
              <div class="b-opts" id="cbTierCards" role="radiogroup" aria-labelledby="cbStep5">
                <button type="button" role="radio" class="b-opt b-opt-bz on" data-value="default+markup" aria-checked="true" tabindex="0"><b>Commission default + mark-up</b><span>The Commission's published default value, with its mark-up.</span></button>
                <button type="button" role="radio" class="b-opt b-opt-cy" data-value="actual-verified" aria-checked="false" tabindex="-1"><b>My verified figures</b><span>Your installation's verified figures. The mark-up does not apply to them.</span></button>
              </div>
              <!-- "My verified figures" reveals the panel; the attestation is the gate — we transcribe a
                   claim, we never bless it. -->
              <div id="cbVerifiedRow" class="b-vfields" hidden>
                <label class="b-lab" for="cbSeeDirect">Verified direct emissions (tCO₂e / tonne)</label>
                <div class="b-field"><input id="cbSeeDirect" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /></div>
                <!-- Shown only when the indirect side is charged for this good AND the scope includes it.
                     cbam-app.ts CLEARS this input whenever the row is hidden, so a stale value behind an
                     invisible row can never inflate the next line. -->
                <div id="cbSeeIndirectRow" hidden>
                  <label class="b-lab" for="cbSeeIndirect">Verified indirect emissions (tCO₂e / tonne)</label>
                  <div class="b-field"><input id="cbSeeIndirect" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /></div>
                </div>
                <label class="cb-check"><input id="cbAttest" type="checkbox" />
                  I attest these figures come from an accredited verification (ISO 14064-3 / CBAM
                  Art. 8) — my claim, not checked by this tool.</label>
                <label class="b-lab" for="cbRef">Verification reference (optional)</label>
                <div class="b-field"><input id="cbRef" type="text" placeholder="verifier / report ID" /></div>
                <p class="b-help">Whole-good figures, precursors included — that scope is what a
                  verifier's CBAM report states, and what keeps this estimate on Column B.</p>
              </div>
              <!-- Only for goods the Commission publishes an indirect default for (cement, fertilisers,
                   sintered iron ore). Defaults to INCLUDING indirect: direct-only understates. -->
              <div id="cbScopeRow" hidden>
                <label class="b-lab" for="cbScope">Emissions scope</label>
                <div class="b-field">
                  <select id="cbScope">
                    <option value="direct_and_indirect" selected>Direct + indirect (electricity)</option>
                    <option value="direct">Direct only</option>
                  </select>
                </div>
                <p class="b-help">Indirect emissions are charged for this sector and receive no free allocation —
                  the benchmarks are direct-emission benchmarks.</p>
              </div>
            </section>

            <button id="cbAdd" type="button" class="b-add">Add line to the list</button>
          </section>

          <!-- aria-live: the figure AND the refusal both need announcing. Polite, always: since the rail
               shell (spec §6.3) this region holds the ONE draft line; the list lives in #cbList. -->
          <section id="cbOutWrap" class="b-results" aria-labelledby="cb-res-h" aria-live="polite">
            <h2 id="cb-res-h" class="cb-sr">Provisional exposure</h2>
            <div id="cbOut" class="b-bento b-out">
              <!-- MUST MATCH renderEstimateIdle(run()'s idle copy) in tiles-estimate.ts, after whitespace
                   between tags is dropped: cbam-tiles-estimate.test.mjs pins the two together, and
                   build-contracts.test.mjs pins this cb-idle sentence to cbam-app.ts's, byte for byte.
                   It is what stays on screen if ensurePack() never resolves. -->
              <section class="b-t b-hero b-s2"><h3 class="b-t-ti">Certificates.</h3><p class="cb-idle">Choose a good, origin, route, mass and import date to see the provisional exposure.</p></section>
              <section class="b-t b-s2 b-yrs" aria-live="off"><button type="button" class="b-go" data-goto="three-years" aria-label="Open Three years"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M4 10 10 4M5 4h5v5"/></svg></button><h3 class="b-t-ti">Three years.</h3><div data-deck></div></section>
              <section class="b-t b-s2 b-prov"><div class="b-pv"><h3 class="b-t-ti">Provenance.</h3></div></section>
            </div>
            <p class="cb-source" id="cbProv"></p>
          </section>
        </div>
      </section>

      <section data-view="three-years" aria-labelledby="cbxH-years" hidden>
        <h1 id="cbxH-years" class="cbx-h1" tabindex="-1">Three years. <span>2026 to 2028, the law as published.</span></h1>
        <div class="cb-out">
        <!-- The three-year strip (cbam-outlook.ts), drawn under the preview of ONE line and
               cleared in multi-line mode. aria-live="off" ON PURPOSE, inside a polite region:
               the result card above is what a screen-reader user is told about, and re-reading
               three more years and a table after every keystroke would bury it. The strip is
               ordinary content, reachable by heading and by Tab. -->
          <div id="cbOutlook" aria-live="off"></div>
        <div class="cbx-plate cbx-empty"><p>Price a line first. The three-year view appears once a line is priced.</p><button type="button" class="cb-btn" data-goto="estimate">Go to Estimate</button></div>
        </div>
      </section>

      <section data-view="why" aria-labelledby="cbxH-why" hidden>
        <h1 id="cbxH-why" class="cbx-h1" tabindex="-1">Why it changes. <span>The same line, drawn.</span></h1>
        <div class="cb-out">
        <!-- The graphs (cbam-graphs.ts), drawn under the strip for the same previewed line and
               cleared with it. Not announced, for the reason the strip is not: every card's
               sentence, table and marks are ordinary content, reachable by heading and by Tab. -->
          <div id="cbGraphs" aria-live="off"></div>
        <div class="cbx-plate cbx-empty"><p>Price a line first. The graphs appear once a line is priced.</p><button type="button" class="cb-btn" data-goto="estimate">Go to Estimate</button></div>
        </div>
      </section>

      <section data-view="list" aria-labelledby="cbxH-list" hidden>
        <h1 id="cbxH-list" class="cbx-h1" tabindex="-1">Shipment list. <span>Every line, the annual de minimis test and the total.</span></h1>
        <!-- THE LIST'S OWN CONTAINER (spec §6.3). aria-live="off" for the reason renderAll's
             comment gives: every add, remove and attest rebuilds every card, and reading that
             wall back on each click buried the answer. #cbStatus carries the spoken summary. -->
        <div id="cbList" aria-live="off"></div>
        <div class="cbx-plate cbx-empty"><p>No lines yet. Price a line on Estimate, then add it to the list.</p><button type="button" class="cb-btn" data-goto="estimate">Go to Estimate</button></div>
      </section>

      <section data-view="export" aria-labelledby="cbxH-export" hidden>
        <h1 id="cbxH-export" class="cbx-h1" tabindex="-1">Export. <span>Take the shipment out of the browser.</span></h1>
        <div class="b-bento b-export">
          <section class="b-t b-s2" aria-labelledby="cbExpCsvH">
            <div class="b-t-h"><div><h2 id="cbExpCsvH" class="b-t-ti">CSV.</h2></div></div>
            <div id="cbExportCsv"><p class="b-lead2">Add a line to the list to export it.</p></div>
            <button id="cbCsv" type="button" class="cb-btn b-add" disabled>Export CSV</button>
          </section>
          <section class="b-t b-s2 b-hero" aria-labelledby="cbExpDocH">
            <div class="b-t-h"><div><h2 id="cbExpDocH" class="b-t-ti">Document.</h2></div></div>
            <div id="cbExportDoc"><p class="b-lead2">Add a line to the list to print it.</p></div>
            <button id="cbDoc" type="button" class="cb-btn b-add" disabled>Export document</button>
          </section>
          <section class="b-t b-s4" aria-labelledby="cbExpFpH">
            <div class="b-t-h"><div><h2 id="cbExpFpH" class="b-t-ti">What travels with it.</h2><p class="b-t-sub">Each line, and the rule pack, carries a fingerprint. Same dots, same inputs and rules.</p></div></div>
            <div id="cbExportFps"></div>
          </section>
        </div>
      </section>

      <section data-view="rules" aria-labelledby="cbxH-rules" hidden>
        <h1 id="cbxH-rules" class="cbx-h1" tabindex="-1">Rules &amp; sources. <span>What this rests on.</span></h1>
        <div class="b-bento b-rules">
          <section class="b-t b-s2 b-r2 b-hero b-frame" aria-labelledby="cbRulesFramingH">
            <div class="b-t-h"><div><h2 id="cbRulesFramingH" class="b-t-ti">Framing.</h2><p class="b-t-sub">Read first.</p></div></div>
            <!-- MOVED from the Estimate view, verbatim (spec §6.2; D1 default: the eyebrow stays in markup,
                 under the Rules framing title, until the CEO decides). Pinned in cbam-render.test.mjs. -->
            <p class="cb-eyebrow">Provisional · defaults or your verified figures · in-browser</p>
            <p class="b-frame-full">The full framing sits at the top of Estimate, above the form, so it is read before any figure.</p>
            <button type="button" class="btn b-add" data-goto="estimate">Read it on Estimate</button>
          </section>
          <section class="b-t b-s2" aria-labelledby="cbRulesNotYetH">
            <div class="b-t-h"><div><h2 id="cbRulesNotYetH" class="b-t-ti">Not yet published.</h2><p class="b-t-sub">What the law still owes, as the rule pack records it.</p></div></div>
            <div id="cbNotYet"><p class="b-lead2">This reads the rule pack, which loads with your first line. <button type="button" class="btn" data-load-pack>Load the rule pack</button></p></div>
          </section>
          <section class="b-t" aria-labelledby="cbRulesKeyH">
            <h2 id="cbRulesKeyH" class="b-t-ti">Colour key.</h2>
            <p class="b-t-sub">Colour only ever marks where a figure came from.</p>
            <div class="b-key">
              <div class="b-k b-k-bz"><b>Bronze.</b><span>Commission default values, and the mark-up on them.</span></div>
              <div class="b-k b-k-cy"><b>Cyan.</b><span>Your own verified figures.</span></div>
              <div class="b-k b-k-ink"><b>Ink.</b><span>Everything else.</span></div>
            </div>
          </section>
          <section class="b-t" aria-labelledby="cbRulesPackH">
            <h2 id="cbRulesPackH" class="b-t-ti">Rule pack.</h2>
            <div id="cbRulePack"><p class="b-lead2">Loads with the rule pack. <button type="button" class="btn" data-load-pack>Load the rule pack</button></p></div>
          </section>
          <section class="b-t b-s4" aria-labelledby="cbRulesMethodH">
            <h2 id="cbRulesMethodH" class="b-t-ti">Method.</h2>
            <!-- D4: the figures in the last sentence are MEASURED against the shipped pack and pinned by
                 tests/unit/cbam-rules-view.test.mjs; a regenerated pack that moves them turns that red. -->
            <p class="cb-foot">
            Engine and rule corpus shared with the GeoCBAM ledger. Default values and benchmarks are the
            European Commission's; the cut, structure and normalisation are ours. Where the Commission
            has not published a benchmark matching a production route, this tool gives no figure
            rather than substituting a nearby one — 28 of 572 offered goods have at least one such
            route, and all 28 are iron and steel.
          </p>
          </section>
          <section class="b-t b-s4 b-srcs" aria-labelledby="cbRulesSourcesH">
            <div class="b-t-h"><div><h2 id="cbRulesSourcesH" class="b-t-ti">Sources.</h2></div></div>
            <div id="cbSources"><p class="b-lead2">Loads with the rule pack. <button type="button" class="btn" data-load-pack>Load the rule pack</button></p></div>
          </section>
        </div>
      </section>

      <!-- MOVED HERE FROM THE FORM (spec §6.3). A live region inside a [hidden] view is never
           announced, and Remove and attest happen on the List view. One writer, as before. -->
      <p class="cb-note cbx-status" id="cbStatus" role="status" aria-live="polite"></p>

      <!-- Print-only. Filled at export time; offscreen otherwise. NOT [hidden] —
         display:none would defeat the visibility trick in the print stylesheet below. -->
    <section id="cbPrint" aria-hidden="true"></section>
    </main>

    <!-- The good sheet (spec §5.1, §6.5): a modal dialog over the input column. good-sheet.ts wires it;
         while it is open the rail, top bar, main and tab bar are inert. -->
    <div class="b-scrim" id="cbGoodScrim" hidden></div>
    <div class="b-sheet" id="cbGoodSheet" role="dialog" aria-modal="true" aria-labelledby="cbGoodH" aria-describedby="cbGoodSub" hidden>
      <header>
        <div><h2 class="b-t-ti" id="cbGoodH">Good.</h2><p class="b-t-sub" id="cbGoodSub">Search the goods this estimator prices.</p></div>
        <button type="button" class="b-x" data-good-close aria-label="Close">×</button>
      </header>
      <label class="b-big-in"><span class="cb-sr">Search goods by CN code or description</span><input type="search" data-good-search autocomplete="off" spellcheck="false" /></label>
      <div class="b-chips" data-good-chips role="group" aria-label="Sector" set:html={renderSectorChips(null)} />
