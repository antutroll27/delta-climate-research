---
// CBAM certificate estimator — the working tool.
//
// The engine under src/scripts/cbam-algos/ is the GeoCBAM SaaS's, copied
// byte-for-byte and never edited here. This page is the form and the readout.
//
// WHY THIS IS NOT THE VUE COMPONENT. The portability dossier recommends mounting
// the SaaS's own cards as an Astro island, and its reasoning is sound: the
// honesty states are enforced inside those components, so taking them means the
// honesty travels for free. Two things pointed the other way. §6.7 — the cards
// carry GeoCBAM's design tokens (bg-card, text-teal, text-gold), and this site
// has its own @theme; importing a second palette would clash with the
// survey-instrument language, and restyling four card files costs about what
// building native ones does. And precedent: the heat map, far more complex than
// a form, is vanilla TS here. So the engine is verbatim, the UI is native, and
// the honesty states are held instead by an exhaustive switch in cbam-app.ts plus
// a test asserting every branch renders what it owes.
//
// THE FRAMING BANNER IS MARKUP, NOT JAVASCRIPT (dossier §7.1). It must be on the
// page whether or not the script runs, whether or not the pack loads.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
---

<Base
  title="CBAM certificate estimator — Delta Climate Research"
  description="Estimate EU CBAM certificate exposure for a good, origin and production route. Runs entirely in your browser from the Commission's published default values and benchmarks. Screening-grade: it shows what it cannot compute rather than guessing."
  noindex
>
  <Nav />

  <main id="main" tabindex="-1" class="cb-page">
    <div class="wrap">
      <p class="sec-index">Interactive tools</p>
      <h1 class="sec-title">CBAM certificate <em>estimator.</em></h1>

      <!-- NON-NEGOTIABLE §7.1 — ships with the calculator, always, in markup. -->
      <div class="cb-banner" role="note">
        <strong>Prototype estimator · Commission default values only · decision-support, not a
        declaration.</strong> Computed in your browser from the same published rules, and never
        sent anywhere. For a 2026 import no final figure exists — the cross-sectoral correction
        factor is unpublished — so any number below is a labelled what-if. This is not a filing,
        not validated by the EU CBAM Registry, and not a statement of monetary liability.
      </div>

      <div class="cb-grid">
        <section class="cb-form" aria-labelledby="cb-form-h">
          <h2 id="cb-form-h" class="cb-h">The line</h2>

          <label>
            <span>Good — CN code</span>
            <input id="cbCn" list="cbCnList" autocomplete="off" placeholder="e.g. 25231000" />
            <datalist id="cbCnList"></datalist>
          </label>

          <label>
            <span>Country of origin</span>
            <select id="cbCountry"><option value="" disabled selected>Select origin…</option></select>
          </label>

          <label>
            <span>Production route</span>
            <select id="cbRoute" disabled><option value="">Choose a good and origin first</option></select>
          </label>

          <label>
            <span>Net mass (tonnes)</span>
            <input id="cbMass" type="number" min="0" step="any" value="100" />
          </label>

          <label>
            <span>Import date</span>
            <input id="cbDate" type="date" value="2026-03-15" />
          </label>

          <p class="cb-note" id="cbStatus" role="status" aria-live="polite"></p>
        </section>

        <!-- aria-live: the figure AND the refusal both need announcing. A refusal only
             sighted users learn about is not a refusal. -->
        <section class="cb-result" aria-labelledby="cb-res-h" aria-live="polite">
          <h2 id="cb-res-h" class="cb-h">Provisional exposure</h2>
          <div id="cbOut"><p class="cb-idle">Choose a good, an origin, a route and a mass.</p></div>
          <p class="cb-prov-line" id="cbProv"></p>
        </section>
      </div>

      <p class="cb-foot">
        Engine and rule corpus shared with the GeoCBAM ledger. Default values and benchmarks are the
        European Commission's; the cut, structure and normalisation are ours. Where the Commission
        has not published a benchmark matching a production route, this tool shows no deduction
        rather than substituting a nearby one — 183 of 574 offered goods currently resolve that way,
        and 181 of those are iron and steel.
      </p>
    </div>
  </main>

  <Footer />
</Base>

<script>
  import { initCbam } from '../../scripts/cbam-algos/cbam-app.ts';
  // Mount on load and on soft nav (ClientRouter), matching the heat map's pattern.
  const boot = () => initCbam();
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .cb-page { min-height: 100dvh; padding-block: 9rem 6rem; background: var(--color-base); }
  .cb-h {
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--color-ink-muted); margin: 0 0 1.1rem;
  }

  /* The framing banner. Bronze, bordered, unmissable — it is the first thing read
     and it is not decoration. */
  .cb-banner {
    margin: 2.2rem 0 2.8rem; max-width: 76ch;
    border: 1px solid rgb(176 141 87 / 0.34);
    background: rgb(176 141 87 / 0.07); border-radius: 10px; padding: 1.1rem 1.3rem;
    font-size: 0.88rem; line-height: 1.7; color: var(--color-ink-muted);
  }
  .cb-banner strong { color: var(--color-bronze); font-weight: 500; }

  .cb-grid { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: 2rem; align-items: start; }
  @media (max-width: 900px) { .cb-grid { grid-template-columns: 1fr; } }

  .cb-form, .cb-result {
    background: rgb(9 20 22 / 0.6); border: 1px solid rgb(111 202 214 / 0.16);
    border-radius: 14px; padding: 1.4rem 1.5rem;
  }
  .cb-form label { display: block; margin-bottom: 1.1rem; }
  .cb-form label > span {
    display: block; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-ink-faint); margin-bottom: 0.45rem;
  }
  .cb-form input, .cb-form select {
    width: 100%; background: rgb(5 6 6 / 0.7); color: var(--color-paper);
    border: 1px solid rgb(111 202 214 / 0.22); border-radius: 8px;
    padding: 0.62rem 0.7rem; font: inherit; font-size: 0.92rem;
    /* keeps the native date picker and select panels dark (dossier §6.8) */
    color-scheme: dark;
  }
  .cb-form input:focus-visible, .cb-form select:focus-visible {
    outline: 2px solid var(--color-cyan); outline-offset: 1px;
  }
  .cb-form select:disabled { opacity: 0.5; }
  .cb-note { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; color: var(--color-cyan); min-height: 1em; }

  .cb-idle { color: var(--color-ink-faint); font-size: 0.9rem; }
</style>

<style is:global>
  /* RUNTIME-INJECTED NODES.
     cbam-app.ts builds the result panel with innerHTML, so these elements never
     exist at build time and Astro's scoped styles cannot reach them — the first
     render came out as unstyled text. Global, but every selector is namespaced
     under .cb-result so nothing escapes this page. */
  /* result */
.cb-result .cb-tag{
    display: inline-block; font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.18em;
    text-transform: uppercase; padding: 0.34rem 0.7rem; border-radius: 20px; margin-bottom: 1.1rem;
  }
.cb-result .cb-tag.ok{ color: var(--color-cyan); background: rgb(111 202 214 / 0.13); border: 1px solid rgb(111 202 214 / 0.35); }
.cb-result .cb-tag.pending{ color: var(--color-bronze); background: rgb(176 141 87 / 0.13); border: 1px solid rgb(176 141 87 / 0.4); }
.cb-result .cb-tag.unavail{ color: #e5a34d; background: rgb(229 163 77 / 0.1); border: 1px solid rgb(229 163 77 / 0.36); }

.cb-result .cb-fig{ display: flex; align-items: baseline; gap: 0.6rem; }
.cb-result .cb-n{ font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 500; letter-spacing: -0.03em; color: var(--color-paper); line-height: 1; }
.cb-result .cb-u{ font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ink-faint); }
.cb-result .cb-cost{ margin-top: 0.5rem; font-size: 1.5rem; color: var(--color-cyan); }
.cb-result .cb-sub{ margin-top: 0.9rem; font-size: 0.84rem; line-height: 1.65; color: var(--color-ink-muted); max-width: 62ch; }
.cb-result .cb-warn{ color: var(--color-bronze); }

.cb-result .cb-water{ margin-top: 1.4rem; border-top: 1px solid rgb(111 202 214 / 0.12); padding-top: 0.9rem; }
.cb-result .cb-row{ display: flex; justify-content: space-between; gap: 1rem; padding: 0.3rem 0; font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-ink-faint); }
.cb-result .cb-row b{ color: var(--color-paper); font-weight: 400; }
.cb-result .cb-row.cb-net b{ color: var(--color-cyan); }

.cb-result .cb-reason{ margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.7; color: var(--color-paper); max-width: 62ch; }
.cb-result .cb-sel{ display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1rem; }
.cb-result .cb-sel span{ font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ink-faint); }
.cb-result .cb-sel code{ font-family: var(--font-mono); font-size: 0.72rem; color: #e5a34d; word-break: break-all; }

.cb-result .cb-stamp{ margin-top: 1.4rem; border-top: 1px solid rgb(176 141 87 / 0.22); padding-top: 0.9rem; }
.cb-result .cb-stamp-h{ font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-bronze); margin-bottom: 0.6rem; }
.cb-result .cb-prov{ margin-top: 0.6rem; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-bronze); }
.cb-result .cb-notes{ margin: 0.7rem 0 0; padding-left: 1.1rem; }
.cb-result .cb-notes li{ font-size: 0.8rem; line-height: 1.65; color: var(--color-ink-muted); margin-bottom: 0.4rem; }

.cb-result .cb-prov-line, .cb-result .cb-foot{
    margin-top: 1.2rem; font-family: var(--font-mono); font-size: 0.58rem;
    letter-spacing: 0.1em; line-height: 1.9; color: var(--color-ink-faint);
  }
.cb-result .cb-foot{ margin-top: 2.4rem; max-width: 90ch; }
</style>
