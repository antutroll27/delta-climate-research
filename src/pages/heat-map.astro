---
import Base from '../layouts/Base.astro';
import HeatMapStage from '../components/ClimateEngine/HeatMapStage.astro';

// noindex until a measured raster (Landsat LST) is wired — the heat FIELD is
// modelled, and Delta sells defensible rigour. Sitemap exclusion lives alongside
// this flag in astro.config.mjs so the two never drift (page-spec §7.8).
---
<Base
  title="Urban Heat Scenario Explorer — Delta Climate Research"
  description="Interactive urban-heat-island simulator for three Kolkata wards — test green interventions and see cooling in °C and cost in ₹ on a live 3D map. Modelled scenario, screening-grade."
  noindex={true}
>
  <HeatMapStage />
</Base>

<script>
  // Vanilla-TS core, thin Astro shell (mirrors river-scene.ts). Mount on load and
  // on soft nav (ClientRouter); dispose before swap so the two GL contexts + rAF
  // loops don't leak across navigations.
  import { mountHeatMap } from '../scripts/climate-engine/heat-map-app';

  let dispose: (() => void) | null = null;
  const boot = () => { if (document.getElementById('mlmap') && !dispose) dispose = mountHeatMap(); };
  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = null; });
</script>
