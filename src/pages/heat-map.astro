---
import Base from '../layouts/Base.astro';
import HeatMapStage from '../components/ClimateEngine/HeatMapStage.astro';

// INDEXABLE, with the build status stated on the page instead of hidden from
// search. The page was noindex "until a measured raster is wired", which treated
// invisibility as the honest option — but a noindexed page is not more honest,
// it is just unfindable, and it left the site with two indexable routes and
// nothing ranking. The caveats a reader needs are now ON the page: an UNDER
// CONSTRUCTION stamp, the "heat field modelled" banner, and a per-phase accuracy
// band that says outright when a number is indicative rather than decision-grade.
//
// /heat-map/brief and /heat-map/compare stay noindex — they are deep-link views
// of this same tool with thin standalone content, and indexing them would put
// three near-duplicate pages into search competing with each other.
---
<Base
  title="Urban Heat Scenario Explorer — Delta Climate Research"
  description="Interactive urban-heat-island simulator for three Kolkata wards — test green interventions and see cooling in °C and cost in ₹ on a live 3D map. Modelled scenario, screening-grade."
>
  <HeatMapStage />
</Base>

<script>
  let dispose: (() => void) | null = null;
  let bootGeneration = 0;
  // Keep the route shell interactive while MapLibre, Three, and the instrument
  // load as one deferred module. This is a route-level boundary, not a change to
  // model inputs or rendering fidelity.
  const boot = async () => {
    const generation = ++bootGeneration;
    if (!document.getElementById('mlmap') || dispose) return;
    const { mountHeatMap } = await import('../scripts/climate-engine/heat-map-app');
    if (generation === bootGeneration && document.getElementById('mlmap') && !dispose) dispose = mountHeatMap();
  };
  void boot();
  document.addEventListener('astro:page-load', () => { void boot(); });
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = null; });
</script>
