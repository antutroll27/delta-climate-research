---
// Our Team — the leadership bench, McBride-inspired giant-name roster rendered
// in Delta's dark instrument language: mono bronze kicker, masked section
// title, hairline rows that invert to a bronze fill on hover (off-black text),
// and a cursor-glued circular monogram card (desktop, motion-permitting; wired
// in section-effects.ts). Each row opens a slow, dark slide-up detail sheet
// (photo + bio + record); open/close handled by the scoped script below.
// Roster data lives in src/data/team.ts.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { team } from '../data/team';
---

<Base
  title="Our Team — Delta Climate Research"
  description="The climatologists, climate-policy specialists, and operators behind Delta Climate Research — a small, senior bench turning earth-science data into defensible decisions."
>
  <Nav />
  <main class="team-page">
    <section class="wrap team-intro">
      <p class="sec-kicker">Our Team</p>
      <h1 class="sec-title team-title" data-mask>
        <span class="ln"><span>The people behind the</span></span>
        <span class="ln"><span><em>measurement.</em></span></span>
      </h1>
      <div class="team-meta" data-reveal-group data-stagger="120">
        {/* Lede paragraph hidden per request — restore by uncommenting (CEO may want it back):
        <p class="team-lede">A small, senior bench of climate-risk analysts, policy specialists, and the operators who turn earth-science data into decisions that hold up.</p>
        */}
        <div class="team-stats">
          <div><b>05</b><span>Specialists</span></div>
          <div><b>04</b><span>Disciplines</span></div>
          <div><b>100%</b><span>Senior bench</span></div>
        </div>
      </div>
    </section>

    <section class="wrap">
      <ul class="roster" id="team-roster" data-reveal-group data-stagger="90" role="list">
        {team.map((m, i) => (
          <li>
            <button
              type="button"
              class="trow"
              data-trow
              data-open={i}
              data-i={i}
              data-mono={m.mono}
              data-cover={m.cover}
              data-photo={m.photo}
              data-pos={m.photoPos}
              data-name={`${m.first} ${m.last}`}
              aria-haspopup="dialog"
              aria-label={`Open profile — ${m.first} ${m.last}, ${m.tier}`}
            >
              <span class="trow-fill" aria-hidden="true"></span>
              <span class="trow-in">
                <span class="t-left">
                  <span class="t-id" aria-hidden="true">{m.id}</span>
                  <span class="t-role">
                    <span class="t-tier">{m.tier}</span>
                    <span class="t-disc">{m.discipline}</span>
                  </span>
                </span>
                <span class="t-name"><span class="first">{m.first}</span> <span class="last">{m.last}</span></span>
                <span class="t-plus" aria-hidden="true">+</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <p class="team-foot" data-reveal>// Delta·Climate·Research — leadership bench</p>
    </section>
  </main>

  <!-- slide-up detail sheet (dark, slow rise) — panels rendered once, toggled by the script -->
  <div class="team-backdrop" data-sheet-close aria-hidden="true"></div>
  <aside class="team-sheet" id="team-sheet" role="dialog" aria-modal="true" aria-label="Team member profile" aria-hidden="true">
    <span class="sheet-grip" aria-hidden="true"></span>
    <div class="sheet-bar">
      <span class="sheet-tag" data-sheet-tag>Delta·Climate·Research — Team</span>
      <button type="button" class="sheet-x" data-sheet-close aria-label="Close profile">✕</button>
    </div>
    <div class="sheet-scroll">
      {team.map((m, i) => (
        <article class="panel" data-panel={i} hidden>
          <div class="panel-in">
            <div class="p-photo">
              <div class={`pdisc pcv-${m.cover}`}>
                <span class="pmono">{m.mono}</span>
                <img class="pphoto" src={m.photo} alt={`${m.first} ${m.last}`} style={`object-position:${m.photoPos}`} loading="lazy" decoding="async" width="260" height="260" />
              </div>
              <span class="p-id">DCR/{m.id}</span>
            </div>
            <div class="p-body">
              <p class="p-role">{m.tier} · {m.discipline}</p>
              <h2 class="p-name">{m.first} {m.last}</h2>
              {m.bio.map((par) => <p class="p-bio">{par}</p>)}
              <div class="p-grid">
                <div><h3>Focus</h3><div class="p-tags">{m.focus.map((f) => <span class="p-tag">{f}</span>)}</div></div>
                <div><h3>Background</h3><ul>{m.background.map((b) => <li>{b}</li>)}</ul></div>
                <div><h3>Selected work</h3><ul>{m.work.map((w) => <li>{w}</li>)}</ul></div>
                <div><h3>Contact</h3><ul><li><a href={`mailto:${m.email}`}>{m.email}</a></li><li><a href="#">LinkedIn ↗</a></li></ul></div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </aside>

  <!-- cursor-glued circular monogram card (desktop + motion; driven by section-effects.ts) -->
  <div class="tcard" data-tcard aria-hidden="true">
    <span class="tdisc">
      <span class="tcv tcv-1 on"></span><span class="tcv tcv-2"></span><span class="tcv tcv-3"></span><span class="tcv tcv-4"></span>
      <span class="tmono" data-tmono>AB</span>
      <img class="tphoto" data-tphoto alt="" />
    </span>
    <span class="ttag"><span data-tname>ANGAD BURMAN</span><span class="sep">·</span><span data-tid>DCR/01</span></span>
  </div>

  <Footer />
</Base>

<style>
  .team-page {
    position: relative;
    background:
      radial-gradient(55% 40% at 72% 14%, rgb(111 202 214 / 0.05), transparent 64%),
      var(--color-base);
  }

  /* intro */
  .team-intro { padding-top: clamp(15rem, 30vh, 22rem); padding-bottom: clamp(2.5rem, 6vh, 5rem); }
  .team-title { max-width: 20ch; font-size: clamp(3.4rem, 7.4vw, 6.5rem); }
  .team-meta { margin-top: clamp(1.5rem, 3vh, 2.4rem); }
  .team-lede {
    max-width: 56ch; font-weight: 300; font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.65; color: var(--color-ink-muted);
  }
  .team-stats { display: flex; flex-wrap: wrap; gap: clamp(2rem, 5vw, 4rem); margin-top: clamp(2.5rem, 5vh, 3.5rem); font-family: var(--font-mono); }
  .team-stats b { display: block; font-weight: 400; font-size: clamp(2.1rem, 3vw, 2.7rem); letter-spacing: -0.01em; color: var(--color-paper); margin-bottom: 0.35rem; }
  .team-stats span { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ink-faint); }

  /* roster — each row is a button that opens the detail sheet */
  .roster { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-hairline); }
  .roster > li { display: block; }
  .trow {
    appearance: none; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer;
    display: block; width: 100%; position: relative; overflow: hidden;
    border: 0; border-bottom: 1px solid var(--color-hairline);
  }
  .trow-fill {
    position: absolute; inset: 0; background: var(--color-bronze);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }
  .trow-in {
    position: relative; z-index: 1; /* above the bronze fill */
    display: grid; grid-template-columns: minmax(11rem, 22vw) minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center;
    padding: clamp(1.6rem, 4.2vh, 2.8rem) clamp(0.4rem, 1vw, 1rem);
  }
  .t-left { display: flex; align-items: baseline; gap: clamp(1rem, 2vw, 1.8rem); }
  .t-id {
    font-family: var(--font-mono); font-size: clamp(0.9rem, 1.4vw, 1.15rem); font-weight: 300;
    line-height: 1; color: transparent; -webkit-text-stroke: 1px rgb(176 141 87 / 0.45);
    transition: color 0.4s ease, -webkit-text-stroke 0.4s ease;
  }
  .t-role { font-family: var(--font-mono); }
  .t-tier { display: block; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-cyan-muted); transition: color 0.4s ease; }
  .t-disc { display: block; margin-top: 0.35rem; font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-faint); transition: color 0.4s ease; }

  .t-name {
    font-weight: 350; font-size: clamp(2rem, 5.4vw, 4.6rem); line-height: 1.0;
    letter-spacing: -0.03em; white-space: nowrap;
    color: var(--color-paper); transition: color 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .t-name .last { color: var(--color-ink-muted); transition: color 0.45s ease; }
  .t-plus { font-family: var(--font-mono); font-size: 1.4rem; line-height: 1; color: var(--color-cyan); opacity: 0.4; transition: opacity 0.4s ease, transform 0.4s ease, color 0.4s ease; }

  /* hover inversion — pointer devices only (touch shows readable names, no fill) */
  @media (hover: hover) and (pointer: fine) {
    .roster .t-name { color: rgb(236 237 240 / 0.42); }
    .roster .t-name .last { color: rgb(236 237 240 / 0.26); }
    .roster:hover .trow:not(:hover) .t-name,
    .roster:hover .trow:not(:hover) .t-name .last { color: rgb(236 237 240 / 0.24); }
    .trow:hover .trow-fill { clip-path: inset(0 0 0 0); }
    .trow:hover .t-name,
    .trow:hover .t-name .last { color: var(--color-base); }
    .trow:hover .t-id { color: var(--color-base); -webkit-text-stroke: 1px transparent; }
    .trow:hover .t-tier { color: var(--color-base); }
    .trow:hover .t-disc { color: rgb(5 6 6 / 0.7); }
    .trow:hover .t-plus { color: var(--color-base); opacity: 1; transform: rotate(90deg); }
  }
  .trow:focus-visible { outline: 1px solid var(--color-cyan); outline-offset: -2px; }

  .team-foot {
    margin-top: clamp(2.5rem, 6vh, 4rem); padding-bottom: clamp(4rem, 10vh, 7rem);
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-ink-faint);
  }

  /* ── slide-up detail sheet ── */
  .team-backdrop {
    position: fixed; inset: 0; z-index: 70; background: rgb(5 6 6 / 0.72);
    backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
    opacity: 0; pointer-events: none; transition: opacity 0.7s ease;
  }
  .team-backdrop.on { opacity: 1; pointer-events: auto; }
  .team-sheet {
    position: fixed; inset-inline: 0; bottom: 0; z-index: 71; max-height: 88vh;
    display: flex; flex-direction: column;
    background: var(--color-base); border-top: 1px solid var(--color-hairline);
    transform: translateY(101%);
    transition: transform 1.15s cubic-bezier(0.5, 0.02, 0.3, 1); /* slow, deliberate rise */
    box-shadow: 0 -28px 70px rgb(0 0 0 / 0.6);
  }
  .team-sheet.on { transform: translateY(0); }
  .sheet-grip { display: block; width: 44px; height: 4px; border-radius: 99px; background: var(--color-hairline); margin: 0.9rem auto 0; flex: none; }
  .sheet-bar { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem clamp(1.5rem, 4vw, 4rem) 0.5rem; flex: none; }
  .sheet-tag { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-faint); }
  .sheet-x { appearance: none; background: none; border: 1px solid var(--color-hairline); color: var(--color-paper); border-radius: 99px; width: 36px; height: 36px; cursor: pointer; font-size: 1rem; line-height: 1; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .sheet-x:hover { background: var(--color-cyan); color: var(--color-base); border-color: var(--color-cyan); }
  .sheet-scroll { overflow-y: auto; }
  .panel[hidden] { display: none; }
  .panel .panel-in { padding: clamp(1.5rem, 4vh, 3rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 7vh, 5rem); max-width: 84rem; margin-inline: auto; }

  /* panel content */
  .panel-in { display: grid; grid-template-columns: clamp(150px, 22vw, 260px) minmax(0, 1fr); gap: clamp(2.5rem, 6.5vw, 6.5rem); align-items: start; }
  .p-photo { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .pdisc { position: relative; width: 100%; aspect-ratio: 1; max-width: 260px; border-radius: 50%; overflow: hidden; border: 1px solid var(--color-hairline); box-shadow: 0 0 0 7px var(--color-base), 0 0 0 8px rgb(111 202 214 / 0.2); }
  .pcv-1 { background: radial-gradient(70% 70% at 32% 22%, rgb(111 202 214 / 0.5), transparent 60%), linear-gradient(150deg, #0e3236, #061416); }
  .pcv-2 { background: radial-gradient(70% 70% at 68% 26%, rgb(176 141 87 / 0.5), transparent 62%), linear-gradient(160deg, #2a2113, #0b0904); }
  .pcv-3 { background: radial-gradient(72% 72% at 40% 70%, rgb(146 194 203 / 0.45), transparent 60%), linear-gradient(120deg, #14272d, #07110f); }
  .pcv-4 { background: radial-gradient(70% 70% at 60% 34%, rgb(111 202 214 / 0.35), transparent 64%), linear-gradient(135deg, #10343a, #060f10); }
  .pmono { position: absolute; inset: 0; display: grid; place-items: center; font-weight: 300; font-size: clamp(3.4rem, 7vw, 5.6rem); letter-spacing: -0.04em; color: rgb(244 246 248 / 0.92); }
  /* real portrait — sits over the gradient+mono (mono shows only if the image fails) */
  .pphoto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .p-id { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-cyan); }

  .p-role { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-cyan-muted); }
  .p-name { font-family: var(--font-mono); font-weight: 400; font-size: clamp(2.4rem, 5vw, 4.2rem); letter-spacing: -0.02em; line-height: 1.04; margin: 0.5rem 0 1.2rem; }
  .p-bio { max-width: 60ch; font-weight: 300; font-size: 0.98rem; line-height: 1.7; color: var(--color-ink-muted); margin-bottom: 0.9rem; }
  .p-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: clamp(1.2rem, 3vw, 2.2rem); margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid var(--color-hairline); }
  .p-grid h3 { font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-bronze); margin: 0 0 0.8rem; font-weight: 400; }
  .p-grid ul { list-style: none; margin: 0; padding: 0; }
  .p-grid li { font-size: 0.82rem; line-height: 1.55; color: var(--color-ink-muted); margin-bottom: 0.35rem; }
  .p-tag { display: inline-block; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-cyan-muted); border: 1px solid var(--color-hairline); border-radius: 99px; padding: 0.3rem 0.7rem; margin: 0 0.35rem 0.4rem 0; }
  .p-grid a { color: var(--color-cyan); text-decoration: none; border-bottom: 1px solid rgb(111 202 214 / 0.3); }

  /* hide the hover card while a sheet is open (it would otherwise float over it) */
  :global(body.team-sheet-open) .tcard { opacity: 0 !important; }

  /* cursor-glued circular monogram card */
  .tcard {
    position: fixed; z-index: 65; top: 0; left: 0; width: 300px;
    pointer-events: none; opacity: 0;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
  }
  .tdisc {
    position: relative; width: 300px; height: 300px; border-radius: 50%;
    overflow: hidden; border: 1px solid var(--color-hairline); background: var(--color-surface);
    box-shadow: 0 0 0 8px var(--color-base), 0 0 0 9px rgb(111 202 214 / 0.2);
  }
  .tcv { position: absolute; inset: 0; opacity: 0; transition: opacity 0.4s ease; }
  .tcv.on { opacity: 1; }
  .tcv-1 { background: radial-gradient(70% 70% at 32% 22%, rgb(111 202 214 / 0.5), transparent 60%), linear-gradient(150deg, #0e3236, #061416); }
  .tcv-2 { background: radial-gradient(70% 70% at 68% 26%, rgb(176 141 87 / 0.5), transparent 62%), linear-gradient(160deg, #2a2113, #0b0904); }
  .tcv-3 { background: radial-gradient(72% 72% at 40% 70%, rgb(146 194 203 / 0.45), transparent 60%), linear-gradient(120deg, #14272d, #07110f); }
  .tcv-4 { background: radial-gradient(70% 70% at 60% 34%, rgb(111 202 214 / 0.35), transparent 64%), linear-gradient(135deg, #10343a, #060f10); }
  .tmono { position: absolute; inset: 0; display: grid; place-items: center; font-weight: 300; font-size: 6.2rem; letter-spacing: -0.04em; color: rgb(244 246 248 / 0.92); }
  /* cursor-card portrait — src + object-position set on hover by section-effects.ts */
  .tphoto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.25s ease; }
  .tphoto.on { opacity: 1; }
  .ttag { font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(236 237 240 / 0.85); display: flex; align-items: center; gap: 0.55rem; }
  .ttag .sep { color: var(--color-cyan); }

  @media (max-width: 860px), (hover: none) { .tcard { display: none; } }
  @media (max-width: 860px) {
    .t-name { white-space: normal; }
    .trow-in { grid-template-columns: 1fr auto; }
    .t-left { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .panel-in { grid-template-columns: 1fr; gap: 1.5rem; }
    .p-photo { flex-direction: row; align-items: center; }
    .pdisc { width: 120px; }
    .team-sheet { max-height: 92vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trow-fill { transition: none; }
    .team-sheet, .team-backdrop { transition: none; }
  }
</style>

<script>
  // Detail-sheet open/close — page-scoped, runs regardless of motion (essential,
  // unlike the cursor card which is motion-gated in section-effects.ts).
  let teamKeyBound = false;

  function closeTeamSheet() {
    const sheet = document.getElementById('team-sheet');
    if (!sheet) return;
    document.querySelector('.team-backdrop')?.classList.remove('on');
    sheet.classList.remove('on');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('team-sheet-open');
    document.body.style.overflow = '';
    const trigger = (window as any).__teamTrigger;
    if (trigger && typeof trigger.focus === 'function') trigger.focus();
  }

  function initTeamSheet() {
    const sheet = document.getElementById('team-sheet');
    if (!sheet) return;
    const backdrop = document.querySelector('.team-backdrop');
    const panels = [...sheet.querySelectorAll<HTMLElement>('[data-panel]')];
    const tag = sheet.querySelector<HTMLElement>('[data-sheet-tag]');

    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = parseInt(btn.dataset.open || '0', 10);
        panels.forEach((p, idx) => { p.hidden = idx !== i; });
        if (tag) tag.textContent = `Team — DCR/${String(i + 1).padStart(2, '0')}`;
        (window as any).__teamTrigger = btn;
        backdrop?.classList.add('on');
        sheet.classList.add('on');
        sheet.setAttribute('aria-hidden', 'false');
        document.body.classList.add('team-sheet-open');
        document.body.style.overflow = 'hidden';
        sheet.scrollTop = 0;
        sheet.querySelector<HTMLElement>('.sheet-scroll')?.scrollTo(0, 0);
        sheet.querySelector<HTMLButtonElement>('.sheet-x')?.focus();
      });
    });

    document.querySelectorAll('[data-sheet-close]').forEach((el) =>
      el.addEventListener('click', closeTeamSheet)
    );

    if (!teamKeyBound) {
      teamKeyBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.getElementById('team-sheet')?.classList.contains('on')) closeTeamSheet();
      });
    }
  }

  initTeamSheet();
  document.addEventListener('astro:page-load', initTeamSheet);
  document.addEventListener('astro:before-swap', closeTeamSheet);
</script>
