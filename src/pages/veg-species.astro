---
// DEV-ONLY mockup: ez-tree (MIT) Kolkata species archetypes, rendered with the
// approved panel-1 volumetric look (soft crowns + contact shadows + wind + variation).
// Open: http://localhost:4321/veg-species
---
<html lang="en">
<head>
<meta charset="utf-8" />
<title>ez-tree Kolkata species — mockup</title>
<style>
  :root{ --base:#070f11; --panel:#0b1416; --line:rgba(111,202,214,.16); --cyan:#6fcad6; --green:#5db98a; --paper:#eef1f2; --ink:#93a7a9; --faint:#5f7377; }
  *{margin:0;box-sizing:border-box}
  body{background:var(--base);color:var(--paper);font-family:system-ui,sans-serif;padding:22px}
  h1{font-size:17px;font-weight:800;letter-spacing:-.02em}
  .sub{color:var(--ink);font-size:12px;margin:4px 0 18px;max-width:82ch;line-height:1.5}
  .grid{display:grid;grid-template-columns:1.35fr 1fr;gap:14px}
  .cell{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .cell canvas{display:block;width:100%;height:460px}
  .cap{padding:11px 13px}
  .cap .n{font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);font-family:ui-monospace,monospace}
  .cap .t{font-size:13px;font-weight:700;margin:3px 0 4px}
  .cap p{font-size:10.5px;color:var(--ink);line-height:1.5}
  pre{font-size:9px;color:var(--faint);white-space:pre-wrap;max-height:120px;overflow:auto;margin-top:10px;font-family:ui-monospace,monospace}
  @media (max-width:1000px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
  <h1>ez-tree · Kolkata species archetypes <span style="color:var(--faint);font-weight:400;font-size:12px">(MIT · build-time, no shipped dep)</span></h1>
  <div class="sub">Neem, gulmohar and a palm generated procedurally with ez-tree, rendered in the approved volumetric look: contact shadows, per-instance scale/rotation, gentle wind. Left = the grove (shipping look); right = each species solo. If these land, we bake them to committed GLBs and instance per species.</div>
  <div class="grid">
    <div class="cell"><canvas id="grove"></canvas><div class="cap"><div class="n">the grove</div><div class="t">Mixed species over a fake canopy field</div><p>What a ward corner would look like — species mix, scale variation, shadows, wind.</p></div></div>
    <div class="cell"><canvas id="solo"></canvas><div class="cap"><div class="n">archetypes</div><div class="t">Neem · Gulmohar · Palm</div><p id="note">generating…</p><pre id="schema"></pre></div></div>
  </div>

<script>
import * as THREE from 'three';
import { Tree } from '@dgreenheck/ez-tree';

function baseScene(canvas){
  const r = new THREE.WebGLRenderer({ canvas, antialias:true });
  r.setPixelRatio(Math.min(2, devicePixelRatio));
  r.shadowMap.enabled = true; r.shadowMap.type = THREE.PCFSoftShadowMap;
  r.toneMapping = THREE.ACESFilmicToneMapping; r.toneMappingExposure = 1.45;
  const scene = new THREE.Scene(); scene.background = new THREE.Color(0x162a2b);
  scene.fog = new THREE.Fog(0x162a2b, 60, 140);
  const cam = new THREE.PerspectiveCamera(38, 1, 0.1, 300);
  scene.add(new THREE.HemisphereLight(0xcdeef2, 0x2a3a2a, 1.25));
  const sun = new THREE.DirectionalLight(0xfff0d6, 2.2); sun.position.set(18,28,10); sun.castShadow=true;
  sun.shadow.mapSize.set(2048,2048); sun.shadow.bias=-0.0004;
  const sc=sun.shadow.camera; sc.near=1; sc.far=90; sc.left=sc.bottom=-34; sc.right=sc.top=34; sc.updateProjectionMatrix();
  scene.add(sun);
  const g = new THREE.Mesh(new THREE.CircleGeometry(60,48), new THREE.MeshStandardMaterial({color:0x14201d, roughness:1}));
  g.rotation.x=-Math.PI/2; g.receiveShadow=true; scene.add(g);
  function resize(){ const w=canvas.clientWidth,h=canvas.clientHeight; r.setSize(w,h,false); cam.aspect=w/h; cam.updateProjectionMatrix(); }
  return { r, scene, cam, resize };
}
function shadowize(obj){ obj.traverse(o=>{ if(o.isMesh){ o.castShadow=true; o.receiveShadow=true; if(o.material){ o.material.side=THREE.DoubleSide; } } }); }

// ── species via ez-tree option tuning ──
// ez-tree default trees are ~40 units tall; scale to ~5-6u to sit among 4-6u buildings.
const SPECIES_SCALE = 0.14;
function makeSpecies(kind){
  const t = new Tree();
  const o = t.options;
  // compact, denser trees regardless of species
  o.branch.length[0] = 13; o.branch.length[1] = 11; o.branch.length[2] = 7;
  for (const k in o.branch.gnarliness) o.branch.gnarliness[k] *= 0.5;
  o.branch.radius[0] = 1.2;
  if (kind==='neem'){                    // large dense rounded broadleaf
    o.seed = 101; o.branch.levels = 3;
    o.branch.children[0] = 8; o.branch.children[1] = 8;
    o.leaves.count = 8; o.leaves.size = 1.9; o.leaves.sizeVariance = 0.4; o.leaves.tint = 0x4f9550;
  } else if (kind==='gulmohar'){         // wide, flatter umbrella crown
    o.seed = 202; o.branch.levels = 3;
    for (const k in o.branch.angle) o.branch.angle[k] = Math.min(88, o.branch.angle[k] + 18);
    o.branch.children[0] = 9;
    o.leaves.count = 7; o.leaves.size = 1.5; o.leaves.sizeVariance = 0.5; o.leaves.tint = 0x77b552;
  } else {                               // palm: tall bare trunk, few big fronds
    o.seed = 303; o.branch.levels = 1;
    o.branch.length[0] = 18; o.branch.children[0] = 7;
    o.leaves.count = 9; o.leaves.size = 3.0; o.leaves.sizeVariance = 0.2; o.leaves.tint = 0x4f8a4a;
  }
  t.generate();
  t.scale.setScalar(SPECIES_SCALE);
  shadowize(t);
  return t;
}

// dump the real options schema so we can refine params accurately
try {
  const probe = new Tree();
  document.getElementById('schema').textContent = 'options: '+Object.keys(probe.options).join(', ')
    + '\nbranch: '+JSON.stringify(probe.options.branch).slice(0,260)
    + '\nleaves: '+JSON.stringify(probe.options.leaves).slice(0,260);
} catch(e){ document.getElementById('schema').textContent = 'schema probe failed: '+e.message; }

const species = { neem: makeSpecies('neem'), gulmohar: makeSpecies('gulmohar'), palm: makeSpecies('palm') };
document.getElementById('note').textContent = 'Neem · Gulmohar · Palm — ez-tree generated';

// SOLO
const SOLO = baseScene(document.getElementById('solo'));
[['neem',-9],['gulmohar',0],['palm',9]].forEach(([k,x])=>{ const m=species[k].clone(); m.position.set(x,0,0); SOLO.scene.add(m); });

// GROVE — clone species, scatter, vary
const GROVE = baseScene(document.getElementById('grove'));
for (const [bx,bz,bh] of [[-14,-12,5],[8,-15,6],[15,6,4],[-15,7,4.5]]){ const b=new THREE.Mesh(new THREE.BoxGeometry(4,bh,4), new THREE.MeshStandardMaterial({color:0x33454a,roughness:.85})); b.position.set(bx,bh/2,bz); b.castShadow=b.receiveShadow=true; GROVE.scene.add(b); }
const swayers=[];
let n=0;
for (let i=0;i<11;i++) for (let j=0;j<11;j++){
  const x=(i/10-.5)*44, z=(j/10-.5)*44; if(Math.hypot(x,z)>22) continue; if((i*5+j*7)%3===0) continue;
  const roll=Math.random(); const kind = roll<0.5?'neem':roll<0.8?'gulmohar':'palm';
  const m=species[kind].clone();
  m.scale.setScalar(SPECIES_SCALE*(0.8+Math.random()*0.5)); m.position.set(x+(Math.random()-.5)*2, 0, z+(Math.random()-.5)*2); m.rotation.y=Math.random()*6;
  GROVE.scene.add(m); swayers.push({o:m, ph:Math.random()*6}); n++;
}

let t=0;
(function frame(){
  t+=0.006;
  for(const s of swayers){ s.o.rotation.z = Math.sin(t*1.2+s.ph)*0.012; }
  { const R=42; GROVE.cam.position.set(Math.cos(t*0.4)*R, 20, Math.sin(t*0.4)*R); GROVE.cam.lookAt(0,4,0); GROVE.resize(); GROVE.r.render(GROVE.scene,GROVE.cam); }
  { const R=26; SOLO.cam.position.set(Math.cos(t*0.5)*R, 9, Math.sin(t*0.5)*R); SOLO.cam.lookAt(0,4,0); SOLO.resize(); SOLO.r.render(SOLO.scene,SOLO.cam); }
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
