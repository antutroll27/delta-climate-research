---
import Base from '../../layouts/Base.astro';
import PairedBenchV2 from '../../components/ClimateEngine/compare/PairedBenchV2.astro';
/* OBOS v2 is the default UI (flip plan A.2): its one stylesheet is the LAST import. */
import '../../styles/obos-v2/index.css';
---
<Base
  title="Compare Urban Heat Scenarios — Delta Climate Research"
  description="Compare one modelled green-infrastructure package across two Kolkata study areas under a shared screening contract."
  noindex={true}
  nativeScroll={true}
  ui="v2"
>
  <PairedBenchV2 />
</Base>

<script>
  /* TWO MOUNTS, AND THEY DO NOT KNOW ABOUT EACH OTHER.
     `mountPairedBench` owns the bench: scenario state, the model run, the canvases,
     and the A/B selects inside the Analysis pane. `mountConsoleShell` owns the rail
     and which pane the sidebar shows — the same function the Explore route calls,
     which is the point: one console, one switcher, no second copy of it here.
     ORDER DOES NOT MATTER. Both only read server-rendered markup and attach
     listeners to it; neither creates an element the other looks for. The bench
     binds its root once and queries through it, and the shell queries within
     [data-console]. Disposed together on `astro:before-swap`, because the site runs
     Astro's ClientRouter and a listener left on a removed element fires against the
     wrong document. */
  let dispose: (() => void) | null = null;
  let disposeShell: (() => void) | null = null;
  let bootGeneration = 0;
  let disposeV2: (() => void) | null = null;
  /* OBOS v2: the page is rendered as v2, so this is always true. mountShellV2 binds the frame; it runs AFTER the mounts above. */
  const bootV2 = async (generation: number) => {
    if (document.documentElement.getAttribute('data-ui') !== 'v2' || disposeV2) return;
    const { mountShellV2 } = await import('../../scripts/climate-engine/v2/shell-v2');
    if (generation === bootGeneration && !disposeV2) disposeV2 = mountShellV2();
  };
  const boot = async () => {
    const generation = ++bootGeneration;
    if (!document.querySelector('[data-compare-root]')) return;
    if (!dispose) {
      const [{ mountPairedBench }, { mountConsoleShell }] = await Promise.all([
        import('../../scripts/climate-engine/compare/paired-controller'),
        import('../../scripts/climate-engine/shell/console-shell'),
      ]);
      if (generation === bootGeneration && document.querySelector('[data-compare-root]') && !dispose) {
        dispose = mountPairedBench();
        if (!disposeShell) disposeShell = mountConsoleShell();
      }
    }
    await bootV2(generation);
  };
  void boot();
  document.addEventListener('astro:page-load', () => { void boot(); });
  document.addEventListener('astro:before-swap', () => {
    dispose?.(); dispose = null;
    disposeShell?.(); disposeShell = null;
    disposeV2?.(); disposeV2 = null;
  });
</script>
