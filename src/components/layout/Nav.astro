---
const links = [
  { label: 'About', href: '/#about' },
  { label: 'Ongoing Projects', href: '/#projects' },
  { label: 'White Papers', href: '/#papers' },
  { label: 'Climate Highlights', href: '/climate-highlights' },
  { label: 'Our Team', href: '/team' },
];

// Mobile-menu social row. Placeholders for now: leave `href` empty and the label
// renders muted + non-clickable (no dead links). Fill in a URL and it becomes a
// real link automatically — no markup change needed.
const socials = [
  { label: 'LinkedIn', href: '' },
  { label: 'X', href: '' },
  { label: 'Instagram', href: '' },
];
---

<!-- sentinel: observed to toggle the nav's scrolled state without a scroll listener -->
<div id="nav-sentinel" aria-hidden="true"></div>

<header id="site-nav" class="fixed inset-x-0 top-8 z-50 h-20 bg-transparent" data-scrolled="false">
  <nav class="max-w-site mx-auto h-full px-gutter flex items-center justify-between" aria-label="Primary">
    <a href="/" class="font-bold text-cardtitle tracking-title text-paper no-underline" aria-label="Delta Climate Research home" data-navigation-static>
      Delta<span class="text-cyan">·</span>Climate<span class="text-cyan">·</span>Research
    </a>

    <ul class="nav-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
      <li>
        <a href="/#medni" class="databank">Medni (Data Library) <span aria-hidden="true">↗</span></a>
      </li>
    </ul>

    <button
      type="button"
      class="menu-toggle"
      data-navigation-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span></span><span></span>
    </button>
  </nav>
</header>

<!-- page scroll-progress line (driven by scroll-effects.ts) -->
<div class="nav-progress" data-progress aria-hidden="true"></div>

<!-- mobile full-screen overlay; generative background remains visible behind it -->
<div
  id="mobile-menu"
  class="mobile-menu"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  hidden
>
  <nav class="mm-nav" aria-label="Mobile">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} data-mobile-link>{l.label}</a></li>
      ))}
      <li><a href="/#medni" data-mobile-link class="databank">Medni (Data Library) <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
  <div class="mm-meta">
    <div class="mm-group">
      <p class="mm-label">Contact</p>
      <a class="mm-contact" href="mailto:angad@deltaclimate.earth,shirsha@deltaclimate.earth" data-mobile-link>angad@deltaclimate.earth</a>
    </div>
    <div class="mm-group">
      <p class="mm-label">Social</p>
      <ul class="mm-social">
        {socials.map((s) => (
          <li>
            {s.href
              ? <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
              : <span aria-disabled="true">{s.label}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .nav-progress {
    position: fixed;
    top: 0;
    left: 4rem;
    z-index: 50;
    width: 2px;
    height: 100dvh;
    background: var(--color-cyan);
    box-shadow: 0 0 12px rgb(111 202 214 / 0.5);
    transform: scaleY(0);
    transform-origin: 50% 0;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .nav-progress { left: 0; }
  }

  /* fallback trigger for pages without a #hero: a short strip pinned to the
     document top, so the backdrop arrives after ~200px of scroll */
  #nav-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 200px;
    pointer-events: none;
  }

  /* scrolled state — the sentinel observer flips data-scrolled once the page
     leaves the top. The bar docks flush to the viewport edge and a frosted
     layer fades in behind it so links stay legible over passing content. */
  #site-nav {
    top: 0;
    transform: translateY(2rem);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.35s ease,
      backdrop-filter 0.35s ease, box-shadow 0.35s ease;
  }
  #site-nav[data-scrolled='true'] {
    transform: translateY(0);
    padding-top: env(safe-area-inset-top); /* keep the docked bar clear of the notch/Dynamic Island */
    background: rgb(8 10 11 / 0.62);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 1px 0 rgb(244 246 248 / 0.08), 0 12px 32px rgb(0 0 0 / 0.25);
  }
  @media (prefers-reduced-motion: reduce) {
    #site-nav { transition: none; }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1.75rem, 2.6vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .nav-links a {
    color: rgb(244 246 248 / 0.85); /* lighter off-white, not pure white */
    font-weight: 300;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: #f4f6f8; }
  /* a touch more air before the CTA so it reads as separate from the links */
  .nav-links li:last-child { margin-left: clamp(0.5rem, 1.5vw, 1.5rem); }

  /* solid primary button (specific selector so color/weight beat .nav-links a) */
  .nav-links .databank {
    background-color: var(--color-cyan);
    color: var(--color-base);
    opacity: 1;
    font-weight: 500;
    border: 1px solid var(--color-cyan);
    border-radius: 8px;
    padding: 0.7rem 1.35rem;
    transition: background-color 0.25s ease, border-color 0.25s ease,
      color 0.25s ease, box-shadow 0.25s ease;
  }
  .nav-links .databank:hover {
    background-color: #f4f6f8;
    border-color: #f4f6f8;
    color: var(--color-base); /* off-black, not pure #000 */
    font-weight: 700;
    box-shadow: 0 0 30px rgb(244 246 248 / 0.5);
  }

  /* mobile toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
    min-width: 44px;
    min-height: 44px; /* WCAG touch-target floor; the bars alone were ~26px tall */
  }
  .menu-toggle span {
    width: 28px;
    height: 2px;
    background: var(--color-paper);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* left-aligned, top-anchored overlay (Anduril-style): links up top, a Contact
     block pinned to the base. Header (logo + ✕) shows above it via z-index. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    padding: 9.5rem var(--spacing-gutter) calc(2.25rem + env(safe-area-inset-bottom));
    background: rgb(5 6 6 / 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu[data-open='true'] { opacity: 1; pointer-events: auto; }

  .mm-nav ul { list-style: none; margin: 0; padding: 0; }
  .mm-nav li { margin: 0 0 0.55rem; }
  .mm-nav li:last-child { margin-bottom: 0; }
  .mobile-menu a {
    display: block;
    font-size: clamp(1.65rem, 7vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--color-paper);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .mobile-menu a:active { color: var(--color-cyan); }
  .mobile-menu .databank { color: var(--color-cyan); margin-top: 0.4rem; }
  .mobile-menu .databank span { font-size: 0.62em; }

  /* bottom meta — Contact + Social, pinned to the base like the reference */
  .mm-meta { margin-top: auto; padding-top: 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .mm-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze);
    margin: 0 0 0.55rem;
  }
  .mobile-menu .mm-contact {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-cyan);
  }
  .mm-social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .mm-social li { margin: 0; }
  .mobile-menu .mm-social a,
  .mobile-menu .mm-social span {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .mobile-menu .mm-social a { color: var(--color-paper); text-decoration: none; transition: color 0.2s ease; }
  .mobile-menu .mm-social a:active { color: var(--color-cyan); }
  /* placeholder — muted + non-interactive until a URL is added to the data */
  .mobile-menu .mm-social span { color: rgb(143 163 165 / 0.45); cursor: default; }

  @media (max-width: 820px) {
    .nav-links { display: none; }
    .menu-toggle { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span, .mobile-menu { transition: none; }
  }
</style>

<script>
  let navCleanup: (() => void) | undefined;

  function initNav() {
    const nav = document.getElementById('site-nav');
    const sentinel = document.getElementById('nav-sentinel');
    const toggle = document.querySelector<HTMLButtonElement>('[data-navigation-toggle]');
    const menu = document.getElementById('mobile-menu');
    if (!nav || !sentinel) return;
    // idempotency guard: initNav runs both inline AND on astro:page-load (which
    // fires on first load too), so without this the hamburger got TWO click
    // listeners — one opened the menu, the second closed it in the same tap, so
    // it never appeared. A view-transition nav swaps in a fresh #site-nav with
    // no flag, so it still re-binds correctly on the new DOM.
    if (nav.dataset.navReady) return;
    navCleanup?.();
    nav.dataset.navReady = '1';

    const ac = new AbortController();
    const { signal } = ac;

    // frosted state: on the home page, track the hero itself — the backdrop
    // appears only once the hero has scrolled past the nav and clears again
    // as soon as any of the hero is back under it. Other pages fall back to
    // the top sentinel (a short strip, so a zero-area target never misfires).
    const hero = document.getElementById('hero');
    const io = new IntersectionObserver(
      ([entry]) => nav.setAttribute('data-scrolled', String(!entry.isIntersecting)),
      { rootMargin: '-96px 0px 0px 0px', threshold: 0 }
    );
    io.observe(hero ?? sentinel);

    // mobile menu
    if (toggle && menu) {
      const mobileMedia = matchMedia('(max-width: 820px)');
      const staticNav = nav.querySelector<HTMLElement>('[data-navigation-static]');
      const staticTabIndex = staticNav?.getAttribute('tabindex') ?? null;
      const staticAriaHidden = staticNav?.getAttribute('aria-hidden') ?? null;
      let restoreFocus: HTMLElement | null = null;
      let inerted: HTMLElement[] = [];

      const setPageInert = (open: boolean) => {
        if (open) {
          inerted = [...document.body.children].filter((el) => {
            if (!(el instanceof HTMLElement)) return false;
            if (el === nav || el === menu || el.hasAttribute('inert')) return false;
            return true;
          }) as HTMLElement[];
          inerted.forEach((el) => el.setAttribute('inert', ''));
          staticNav?.setAttribute('tabindex', '-1');
          staticNav?.setAttribute('aria-hidden', 'true');
          return;
        }

        inerted.forEach((el) => el.removeAttribute('inert'));
        inerted = [];
        if (staticNav) {
          if (staticTabIndex === null) staticNav.removeAttribute('tabindex');
          else staticNav.setAttribute('tabindex', staticTabIndex);
          if (staticAriaHidden === null) staticNav.removeAttribute('aria-hidden');
          else staticNav.setAttribute('aria-hidden', staticAriaHidden);
        }
      };

      const menuFocusables = () => [
        toggle,
        ...menu.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        ),
      ].filter((el) => el.offsetParent !== null);

      const setOpen = (open: boolean, returnFocus = true) => {
        const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (open === wasOpen) return;

        if (open) restoreFocus = document.activeElement as HTMLElement | null;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.setAttribute('data-open', String(open));
        menu.hidden = !open;
        document.body.style.overflow = open ? 'hidden' : '';
        setPageInert(open);

        if (open) {
          menu.querySelector<HTMLElement>('a[href], button:not([disabled])')?.focus();
        } else if (returnFocus) {
          (restoreFocus?.isConnected ? restoreFocus : toggle).focus();
        }
      };
      toggle.addEventListener(
        'click',
        () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
        { signal }
      );
      menu.querySelectorAll('[data-mobile-link]').forEach((a) =>
        a.addEventListener('click', () => setOpen(false, false), { signal })
      );
      mobileMedia.addEventListener('change', (event) => {
        if (!event.matches) setOpen(false, false);
      }, { signal });
      document.addEventListener('keydown', (e) => {
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        if (e.key === 'Escape') {
          e.preventDefault();
          setOpen(false);
          return;
        }
        if (e.key !== 'Tab') return;

        const focusable = menuFocusables();
        if (!focusable.length) {
          e.preventDefault();
          toggle.focus();
          return;
        }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey && (active === first || !active || (!nav.contains(active) && !menu.contains(active)))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (active === last || !active || (!nav.contains(active) && !menu.contains(active)))) {
          e.preventDefault();
          first.focus();
        }
      }, { signal });

      navCleanup = () => {
        setOpen(false, false);
        io.disconnect();
        ac.abort();
      };
    } else {
      navCleanup = () => {
        io.disconnect();
        ac.abort();
      };
    }
  }

  function destroyNav() {
    navCleanup?.();
    navCleanup = undefined;
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
  document.addEventListener('astro:before-swap', destroyNav);
</script>
