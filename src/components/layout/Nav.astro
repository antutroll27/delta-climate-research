---
// Simple links shown before the dropdown menus.
const leadLinks = [
  { label: 'About', href: '/#about' },
  { label: 'Ongoing Projects', href: '/#projects' },
];

// Hover/focus mega-menus. Each item carries a short 3-5 word summary (sans-serif)
// under its mono title. `menuFlow` orders lead links, menus, then tail links so
// the desktop bar and mobile overlay stay in sync from one source.
const menus = [
  {
    label: 'Insights',
    items: [
      { label: 'White Papers', href: '/white-papers', summary: 'Peer-grade climate research' },
      { label: 'Blog', href: '/blog', summary: 'Musings, stories & ideas' },
      { label: 'Climate Highlights', href: '/climate-highlights', summary: 'Curated climate signals' },
      // CBAM lives under Interactive Tools, not here. It is an explainer bound to a
      // working instrument, not editorial — and a second nav link to /cbam would
      // burn its anchor text for nothing: only the first link to a given URL on a
      // page is generally counted.
    ],
  },
  {
    label: 'Interactive Tools',
    items: [
      { label: 'Heat Map', href: '/heat-map', summary: 'Interactive urban-heat explorer' },
      // THE CBAM PAIR, IN READING ORDER. Explainer first so a first-time visitor
      // walks the funnel by default — deep-linking straight to the estimator drops
      // them into a form asking for a CN code and a production route with nothing
      // saying what either is. Calculator second so a returning visitor who already
      // knows what CBAM is can skip it.
      //
      // BOTH ARE LISTED ON PURPOSE. The pair exists to serve two different search
      // intents — informational ("what is CBAM") and transactional ("CBAM
      // calculator") — and that only pays off if both URLs carry a sitewide nav
      // link. With only the explainer listed, the estimator's sole internal link
      // was one button on one page.
      //
      // Labels match destinations: "CBAM Calculator" pointing at an explainer is
      // link text that does not describe where it goes (WCAG 2.4.4).
      { label: 'CBAM Explained', href: '/cbam', summary: 'Carbon border rules, plainly' },
      { label: 'CBAM Calculator', href: '/cbam/cbam-calculator', summary: 'Estimate carbon border costs' },
    ],
  },
];

// Simple links shown after the dropdown menus.
const tailLinks = [
  { label: 'Our Team', href: '/team' },
];

// Mobile-menu social row. Placeholders for now: leave `href` empty and the label
// renders muted + non-clickable (no dead links). Fill in a URL and it becomes a
// real link automatically — no markup change needed.
const socials = [
  { label: 'LinkedIn', href: '' },
  { label: 'X', href: '' },
  { label: 'Instagram', href: '' },
];
---

<!-- sentinel: observed to toggle the nav's scrolled state without a scroll listener -->
<div id="nav-sentinel" aria-hidden="true"></div>

<header id="site-nav" class="fixed inset-x-0 top-8 z-50 h-20 bg-transparent" data-scrolled="false">
  <nav class="max-w-site mx-auto h-full px-gutter flex items-center justify-between" aria-label="Primary">
    <a href="/" class="brandmark font-bold text-cardtitle tracking-title text-paper no-underline" aria-label="Delta Climate Research home" data-navigation-static>
      {/* The mark is decorative: the anchor already carries the accessible name,
          so alt="" keeps a screen reader from announcing the brand twice.
          width/height are set to reserve the box before the image lands — a
          fixed-height nav shifting on load is the classic CLS source. */}
      <img
        src="/logo-mark-96.webp"
        alt=""
        width="34"
        height="34"
        decoding="async"
        fetchpriority="high"
        class="bm-mark"
      />
      <span>Delta<span class="text-cyan">·</span>Climate<span class="text-cyan">·</span>Research</span>
    </a>

    <ul class="nav-links">
      {leadLinks.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}

      {menus.map((m, i) => (
        <li class="has-menu" data-menu>
          <button
            type="button"
            class="trigger"
            aria-expanded="false"
            aria-controls={`nav-panel-${i}`}
          >
            {m.label}
            <svg viewBox="0 0 14 15" fill="none" aria-hidden="true">
              <path stroke="currentColor" stroke-width="1.5" d="M3.5 5.75 7 9.25l3.5-3.5" />
            </svg>
          </button>
          <div class="panel" id={`nav-panel-${i}`} aria-label={m.label}>
            <ul>
              {m.items.map((it) => (
                <li>
                  <a class="menu-item" href={it.href}>
                    <span class="mi-title">{it.label}</span>
                    <span class="mi-summary">{it.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}

      {tailLinks.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}

      <li>
        <a href="/#medni" class="databank">Medni (Data Library) <span aria-hidden="true">↗</span></a>
      </li>
    </ul>

    <button
      type="button"
      class="menu-toggle"
      data-navigation-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span></span><span></span>
    </button>
  </nav>
</header>

<!-- page scroll-progress line (driven by scroll-effects.ts) -->
<div class="nav-progress" data-progress aria-hidden="true"></div>

<!-- mobile full-screen overlay; generative background remains visible behind it -->
<div
  id="mobile-menu"
  class="mobile-menu"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  hidden
>
  <nav class="mm-nav" aria-label="Mobile">
    <ul>
      {leadLinks.map((l) => (
        <li><a href={l.href} data-mobile-link>{l.label}</a></li>
      ))}
    </ul>

    {menus.map((m) => (
      <div class="mm-section">
        <p class="mm-label">{m.label}</p>
        <ul>
          {m.items.map((it) => (
            <li>
              <a href={it.href} data-mobile-link class="mm-sub">
                <span class="mi-title">{it.label}</span>
                <span class="mi-summary">{it.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <ul>
      {tailLinks.map((l) => (
        <li><a href={l.href} data-mobile-link>{l.label}</a></li>
      ))}
      <li><a href="/#medni" data-mobile-link class="databank">Medni (Data Library) <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
  <div class="mm-meta">
    <div class="mm-group">
      <p class="mm-label">Contact</p>
      <a class="mm-contact" href="mailto:angad@deltaclimate.earth,shirsha@deltaclimate.earth" data-mobile-link>angad@deltaclimate.earth</a>
    </div>
    <div class="mm-group">
      <p class="mm-label">Social</p>
      <ul class="mm-social">
        {socials.map((s) => (
          <li>
            {s.href
              ? <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
              : <span aria-disabled="true">{s.label}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .nav-progress {
    position: fixed;
    top: 0;
    left: 4rem;
    z-index: 50;
    width: 2px;
    height: 100dvh;
    background: var(--color-cyan);
    box-shadow: 0 0 12px rgb(111 202 214 / 0.5);
    transform: scaleY(0);
    transform-origin: 50% 0;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .nav-progress { left: 0; }
  }

  /* fallback trigger for pages without a #hero: a short strip pinned to the
     document top, so the backdrop arrives after ~200px of scroll */
  #nav-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 200px;
    pointer-events: none;
  }

  /* scrolled state — the sentinel observer flips data-scrolled once the page
     leaves the top. The bar docks flush to the viewport edge and a frosted
     layer fades in behind it so links stay legible over passing content. */
  #site-nav {
    top: 0;
    transform: translateY(2rem);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.35s ease,
      backdrop-filter 0.35s ease, box-shadow 0.35s ease;
  }
  #site-nav[data-scrolled='true'] {
    transform: translateY(0);
    padding-top: env(safe-area-inset-top); /* keep the docked bar clear of the notch/Dynamic Island */
    background: rgb(8 10 11 / 0.62);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 1px 0 rgb(244 246 248 / 0.08), 0 12px 32px rgb(0 0 0 / 0.25);
  }
  @media (prefers-reduced-motion: reduce) {
    #site-nav { transition: none; }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1.75rem, 3vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .nav-links > li { position: relative; }
  .nav-links a,
  .nav-links .trigger {
    color: rgb(244 246 248 / 0.85); /* lighter off-white, not pure white */
    font-weight: 300;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-links a:hover,
  .nav-links .trigger:hover,
  .has-menu[data-open='true'] .trigger { color: #f4f6f8; }

  /* dropdown trigger — a button styled to sit flush with the mono links */
  .nav-links .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .trigger svg {
    width: 11px;
    height: 11px;
    opacity: 0.6;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }
  .has-menu[data-open='true'] .trigger svg { transform: rotate(180deg); opacity: 1; }

  /* invisible hover-bridge: spans the gap between trigger and panel so a
     diagonal cursor path doesn't drop the menu (paired with a JS close delay) */
  .has-menu::after {
    content: '';
    position: absolute;
    left: -1rem;
    right: -1rem;
    top: 100%;
    height: 1.75rem;
  }

  /* dropdown panel — 60fps: only opacity + transform animate, never layout */
  .panel {
    position: absolute;
    top: calc(100% + 1.75rem);
    left: 50%;
    min-width: 420px;
    padding: 1rem 1.25rem;
    background: rgb(10 13 14 / 0.92);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid rgb(244 246 248 / 0.08);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5), 0 1px 0 rgb(244 246 248 / 0.06) inset;
    opacity: 0;
    transform: translate(-50%, -8px) scale(0.98);
    pointer-events: none;
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .has-menu[data-open='true'] .panel {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    pointer-events: auto;
  }
  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* hard reset: no ancestor rule (e.g. a nav :last-child margin) may ever
     nudge a panel row horizontally — items align flush, always. */
  .panel li { margin: 0; }
  .panel .menu-item { margin: 0; }

  .menu-item {
    display: grid;
    gap: 0.7rem;
    padding: 1.05rem 1.9rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-item:hover { background: rgb(111 202 214 / 0.1); transform: translateX(3px); }
  .mi-title {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-paper-bright);
    transition: color 0.2s ease;
  }
  .menu-item:hover .mi-title { color: var(--color-cyan); }
  .mi-summary {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-cyan-muted);
    opacity: 0.85;
  }

  /* per-item rise on open (compositor-only), subtle stagger */
  .has-menu .menu-item {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .has-menu[data-open='true'] .menu-item { opacity: 1; transform: translateY(0); }
  .has-menu[data-open='true'] li:nth-child(2) .menu-item { transition-delay: 0.05s; }
  .has-menu[data-open='true'] li:nth-child(3) .menu-item { transition-delay: 0.09s; }
  /* a touch more air before the CTA so it reads as separate from the links.
     Anchored to the CTA element itself (not `:last-child`) so it can never
     leak into a dropdown panel's own last <li>. */

  /* solid primary button (specific selector so color/weight beat .nav-links a) */
  .nav-links .databank {
    /* MUST NOT BE `inline`. This carries a background, a border and a radius, and
       an inline box that wraps renders its background as TWO offset rectangles —
       one per line fragment — which read as a broken stepped block rather than a
       button. It was inheriting `inline` and doing exactly that below ~1100px,
       where "Medni (Data Library) ↗" no longer fits on one line. inline-flex keeps
       it a single unbreakable box; nowrap stops the wrap happening at all. */
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
    margin-left: clamp(0.5rem, 1.5vw, 1.5rem);
    background-color: var(--color-cyan);
    color: var(--color-base);
    opacity: 1;
    font-weight: 500;
    border: 1px solid var(--color-cyan);
    border-radius: 8px;
    padding: 0.7rem 1.35rem;
    transition: background-color 0.25s ease, border-color 0.25s ease,
      color 0.25s ease, box-shadow 0.25s ease;
  }
  .nav-links .databank:hover {
    background-color: #f4f6f8;
    border-color: #f4f6f8;
    color: var(--color-base); /* off-black, not pure #000 */
    font-weight: 700;
    box-shadow: 0 0 30px rgb(244 246 248 / 0.5);
  }

  /* mobile toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
    min-width: 44px;
    min-height: 44px; /* WCAG touch-target floor; the bars alone were ~26px tall */
  }
  .menu-toggle span {
    width: 28px;
    height: 2px;
    background: var(--color-paper);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* left-aligned, top-anchored overlay (Anduril-style): links up top, a Contact
     block pinned to the base. Header (logo + ✕) shows above it via z-index. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    padding: 9.5rem var(--spacing-gutter) calc(2.25rem + env(safe-area-inset-bottom));
    background: rgb(5 6 6 / 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu[data-open='true'] { opacity: 1; pointer-events: auto; }

  .mm-nav ul { list-style: none; margin: 0; padding: 0; }
  .mm-nav li { margin: 0 0 0.55rem; }
  .mm-nav li:last-child { margin-bottom: 0; }
  .mobile-menu a {
    display: block;
    font-size: clamp(1.65rem, 7vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--color-paper);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .mobile-menu a:active { color: var(--color-cyan); }
  .mobile-menu .databank { color: var(--color-cyan); margin-top: 0.4rem; }
  .mobile-menu .databank span { font-size: 0.62em; }

  /* mobile dropdown groups — the desktop menus flatten into labelled sections */
  .mm-section { margin-top: 1.75rem; }
  .mm-section .mm-label { margin-bottom: 0.9rem; }
  .mobile-menu .mm-sub {
    display: grid;
    gap: 0.3rem;
    margin-bottom: 1.1rem;
  }
  .mm-sub .mi-title {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-paper);
  }
  .mobile-menu .mm-sub:active .mi-title { color: var(--color-cyan); }
  .mm-sub .mi-summary {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-cyan-muted);
  }

  /* bottom meta — Contact + Social, pinned to the base like the reference */
  .mm-meta { margin-top: auto; padding-top: 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .mm-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze);
    margin: 0 0 0.55rem;
  }
  .mobile-menu .mm-contact {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-cyan);
  }
  .mm-social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .mm-social li { margin: 0; }
  .mobile-menu .mm-social a,
  .mobile-menu .mm-social span {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .mobile-menu .mm-social a { color: var(--color-paper); text-decoration: none; transition: color 0.2s ease; }
  .mobile-menu .mm-social a:active { color: var(--color-cyan); }
  /* placeholder — muted + non-interactive until a URL is added to the data */
  .mobile-menu .mm-social span { color: rgb(143 163 165 / 0.45); cursor: default; }

  /* Brand lockup: mark + wordmark on one baseline. The anchor was a plain text
     link, so it needs to become a flex row for the mark to sit beside the type
     rather than on its own line. The gap is optical, not the type's own spacing:
     the mark's triangle has visual weight at its base, so a touch more room
     reads as balanced than a metric-equal gap would. */
  .brandmark {
    display: inline-flex;
    align-items: center;
    gap: 0.58rem;
  }
  .brandmark .bm-mark {
    /* Sized in rem so the mark tracks the wordmark if its type scale changes,
       and never larger than the cap height it sits against. */
    width: 2.05rem;
    height: 2.05rem;
    flex: none;
    display: block;
  }
  /* The docked (scrolled) nav shrinks; the mark comes with it. */
  :global(#site-nav[data-scrolled='true']) .brandmark .bm-mark {
    width: 1.8rem;
    height: 1.8rem;
  }
  @media (max-width: 640px) {
    .brandmark { gap: 0.45rem; }
    .brandmark .bm-mark { width: 1.75rem; height: 1.75rem; }
  }

  /* THE NAV NEEDS MORE ROOM THAN THE REST OF THE SITE, so it switches to the
     mobile menu earlier than the site-wide 820px breakpoint.
     Measured: the wordmark ends at a fixed 269px while the links slide left as
     the viewport narrows, and the gap between them closes to ZERO at 1095px and
     below — "Delta·Climate·Research" then overlaps "About". Gap by width:
       1055px -> 0px (overlapping)   1100px -> 17px   1150px -> 59px
     So the desktop bar is only usable from about 1150px up.
     DELIBERATELY LOCAL to the nav. 820px is shared by nine other components
     (Faq, WhitePapers, Projects, ClimateClock, SoonDraft, SoonTide,
     HeatMapStage, section-effects' isDesktop); moving it globally would relayout
     all of them to fix one bar. The nav owns a complete mobile menu, so it can
     cross over on its own schedule without touching anything else.
     KEEP IN SYNC with the matchMedia query in the script below — if the CSS and
     the JS disagree, the bar hides while the toggle still thinks it is desktop. */
  /* RAISED FROM 1150 WHEN THE MARK JOINED THE WORDMARK. The lockup grew by the
     mark plus its gap (~43px), and that came straight out of the breathing room:
     at the old 1151px crossover the gap to "About" fell from 60px to 18px —
     back into the cramped band this breakpoint exists to avoid. Re-measured with
     the mark in place:
       1151px -> 18px (tight)   1200px -> 59px   1280px -> 125px
     1200 restores the same ~59px the bar had before the logo, so the standard is
     unchanged; only the width needed to meet it moved. */
  @media (max-width: 1200px) {
    .nav-links { display: none; }
    .menu-toggle { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span, .mobile-menu { transition: none; }
    .panel, .menu-item, .trigger svg {
      transition: opacity 0.15s linear !important;
      transform: none !important;
    }
    .has-menu[data-open='true'] .panel { transform: translateX(-50%) !important; }
  }
</style>

<script>
  let navCleanup: (() => void) | undefined;

  function initNav() {
    const nav = document.getElementById('site-nav');
    const sentinel = document.getElementById('nav-sentinel');
    const toggle = document.querySelector<HTMLButtonElement>('[data-navigation-toggle]');
    const menu = document.getElementById('mobile-menu');
    if (!nav || !sentinel) return;
    // idempotency guard: initNav runs both inline AND on astro:page-load (which
    // fires on first load too), so without this the hamburger got TWO click
    // listeners — one opened the menu, the second closed it in the same tap, so
    // it never appeared. A view-transition nav swaps in a fresh #site-nav with
    // no flag, so it still re-binds correctly on the new DOM.
    if (nav.dataset.navReady) return;
    navCleanup?.();
    nav.dataset.navReady = '1';

    const ac = new AbortController();
    const { signal } = ac;

    // frosted state: on the home page, track the hero itself — the backdrop
    // appears only once the hero has scrolled past the nav and clears again
    // as soon as any of the hero is back under it. Other pages fall back to
    // the top sentinel (a short strip, so a zero-area target never misfires).
    const hero = document.getElementById('hero');
    const io = new IntersectionObserver(
      ([entry]) => nav.setAttribute('data-scrolled', String(!entry.isIntersecting)),
      { rootMargin: '-96px 0px 0px 0px', threshold: 0 }
    );
    io.observe(hero ?? sentinel);

    // desktop hover/focus mega-menus. Open on pointer-enter or focus; close on
    // leave after a short grace delay so a diagonal cursor path from trigger to
    // panel doesn't snap it shut (paired with the CSS ::after hover-bridge).
    // Only opacity/transform animate (see CSS), so it holds 60fps.
    const CLOSE_DELAY = 140;
    nav.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
      const trigger = menu.querySelector<HTMLButtonElement>('.trigger');
      if (!trigger) return;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;
      const open = () => {
        clearTimeout(closeTimer);
        menu.setAttribute('data-open', 'true');
        trigger.setAttribute('aria-expanded', 'true');
      };
      const close = () => {
        menu.setAttribute('data-open', 'false');
        trigger.setAttribute('aria-expanded', 'false');
      };
      menu.addEventListener('mouseenter', open, { signal });
      menu.addEventListener('mouseleave', () => { closeTimer = setTimeout(close, CLOSE_DELAY); }, { signal });
      trigger.addEventListener('focus', open, { signal });
      // close when focus leaves the whole menu (Tab past the last link)
      menu.addEventListener('focusout', (e) => {
        // ...but NOT when the pointer is still inside it and focus went nowhere. macOS WebKit
        // does not focus links or buttons on mousedown, so clicking an item in an open panel
        // fires focusout with a NULL relatedTarget — and closing there sets the panel back to
        // `pointer-events: none` between mousedown and mouseup, so the click lands on <body>
        // and the navigation never happens. Measured in WebKit: the trusted click's target was
        // BODY with the panel already closed, while the same anchor's JS .click() navigated
        // fine. Chromium and Firefox focus the anchor, so relatedTarget is non-null there and
        // this arm was never reached — which is why it survived a Chromium-only suite.
        //
        // Guarded on the POINTER, not on the browser: a real Tab past the last link carries a
        // non-null relatedTarget and still closes, and a pointer that leaves has mouseleave's
        // CLOSE_DELAY timer to close it. Escape still closes and restores focus to the trigger.
        if (e.relatedTarget === null && menu.matches(':hover')) return;
        if (!menu.contains(e.relatedTarget as Node)) close();
      }, { signal });
      menu.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { close(); trigger.focus(); }
      }, { signal });
    });

    // mobile menu
    if (toggle && menu) {
      // KEEP IN SYNC with the `@media (max-width: 1200px)` rule in the styles
      // above, which hides .nav-links and shows .menu-toggle. If these two drift
      // apart the bar and the toggle disagree about which mode the page is in:
      // the links vanish while this still believes it is desktop, so the menu
      // never opens and the nav becomes unreachable.
      const mobileMedia = matchMedia('(max-width: 1200px)');
      const staticNav = nav.querySelector<HTMLElement>('[data-navigation-static]');
      const staticTabIndex = staticNav?.getAttribute('tabindex') ?? null;
      const staticAriaHidden = staticNav?.getAttribute('aria-hidden') ?? null;
      let restoreFocus: HTMLElement | null = null;
      let inerted: HTMLElement[] = [];

      const setPageInert = (open: boolean) => {
        if (open) {
          inerted = [...document.body.children].filter((el) => {
            if (!(el instanceof HTMLElement)) return false;
            if (el === nav || el === menu || el.hasAttribute('inert')) return false;
            return true;
          }) as HTMLElement[];
          inerted.forEach((el) => el.setAttribute('inert', ''));
          staticNav?.setAttribute('tabindex', '-1');
          staticNav?.setAttribute('aria-hidden', 'true');
          return;
        }

        inerted.forEach((el) => el.removeAttribute('inert'));
        inerted = [];
        if (staticNav) {
          if (staticTabIndex === null) staticNav.removeAttribute('tabindex');
          else staticNav.setAttribute('tabindex', staticTabIndex);
          if (staticAriaHidden === null) staticNav.removeAttribute('aria-hidden');
          else staticNav.setAttribute('aria-hidden', staticAriaHidden);
        }
      };

      const menuFocusables = () => [
        toggle,
        ...menu.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        ),
      ].filter((el) => el.offsetParent !== null);

      const setOpen = (open: boolean, returnFocus = true) => {
        const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (open === wasOpen) return;

        if (open) restoreFocus = document.activeElement as HTMLElement | null;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.setAttribute('data-open', String(open));
        menu.hidden = !open;
        document.body.style.overflow = open ? 'hidden' : '';
        setPageInert(open);

        if (open) {
          menu.querySelector<HTMLElement>('a[href], button:not([disabled])')?.focus();
        } else if (returnFocus) {
          (restoreFocus?.isConnected ? restoreFocus : toggle).focus();
        }
      };
      toggle.addEventListener(
        'click',
        () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
        { signal }
      );
      menu.querySelectorAll('[data-mobile-link]').forEach((a) =>
        a.addEventListener('click', () => setOpen(false, false), { signal })
      );
      mobileMedia.addEventListener('change', (event) => {
        if (!event.matches) setOpen(false, false);
      }, { signal });
      document.addEventListener('keydown', (e) => {
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        if (e.key === 'Escape') {
          e.preventDefault();
          setOpen(false);
          return;
        }
        if (e.key !== 'Tab') return;

        const focusable = menuFocusables();
        if (!focusable.length) {
          e.preventDefault();
          toggle.focus();
          return;
        }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey && (active === first || !active || (!nav.contains(active) && !menu.contains(active)))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (active === last || !active || (!nav.contains(active) && !menu.contains(active)))) {
          e.preventDefault();
          first.focus();
        }
      }, { signal });

      navCleanup = () => {
        setOpen(false, false);
        io.disconnect();
        ac.abort();
      };
    } else {
      navCleanup = () => {
        io.disconnect();
        ac.abort();
      };
    }
  }

  function destroyNav() {
    navCleanup?.();
    navCleanup = undefined;
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
  document.addEventListener('astro:before-swap', destroyNav);
</script>
