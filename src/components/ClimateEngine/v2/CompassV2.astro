---
// src/components/ClimateEngine/v2/CompassV2.astro — OBOS v2 spec §3.4
---
<button class="card compass" id="compass" type="button" title="Face north" aria-label="Reset the map to face north">
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <circle class="compass-ring" cx="24" cy="24" r="21.2" />
    <line class="compass-tick" x1="43.6" y1="24" x2="40.6" y2="24" />
    <line class="compass-tick" x1="4.4" y1="24" x2="7.4" y2="24" />
    <g id="compassDial">
      <path class="compass-n-tip" d="M24 10 L26.6 24 L21.4 24 Z" />
      <path class="compass-s-tail" d="M24 38 L21.4 24 L26.6 24 Z" />
      <circle class="compass-hub" cx="24" cy="24" r="1.4" />
      <text id="compassN" class="compass-n" x="24" y="6.4" text-anchor="middle" dominant-baseline="middle">N</text>
      <text id="compassS" class="compass-s" x="24" y="45.2" text-anchor="middle" dominant-baseline="middle">S</text>
      <g id="compassSun" class="c-sun is-below">
        <circle class="compass-sun-key" cx="24" cy="2.8" r="3.9" />
        <circle class="compass-sun" cx="24" cy="2.8" r="3.1" />
      </g>
    </g>
  </svg>
</button>
