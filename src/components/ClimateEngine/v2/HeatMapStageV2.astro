---
// OBOS v2 SKELETON TREE (spec 1.2, 1.6, 1.8). S0: every app-bound id exactly once, parked and unstyled.
// Each parked block leaves [data-v2-parking] in the slice named beside it. Copied from HeatMapStage.astro at 7eb32e8.
// Full-bleed instrument markup for one AREA of /heat-map. Behaviour is mounted by
// src/scripts/climate-engine/heat-map-app.ts (booted from the page). Styles are
// is:global but only bundled onto the heat-map routes (the sole pages importing
// this). Brand tokens are scoped to .stage so nothing leaks to :root; Mona Sans /
// Noplato Mono come from global.css.
import ConstructionStamp from '../../states/ConstructionStamp.astro';
import RailV2 from './RailV2.astro';
import Sym from './Sym.astro';
/* THE FOUR SHELL COMPONENTS, COMPOSED. Until this task each was imported by
   nothing: the rail, the scope switcher and the layer tree were built and proven
   against their own sources, and the toolbox had been moved out of this file with
   its seventeen runtime-queried ids intact. Here they become one console — a rail,
   a sidebar of panes, and a main column that keeps its top bar, its map and its
   ward strip. The toolbox's rules stay in the is:global block below because
   heat-map-app.ts classes its markup at runtime; see its own header. */
import ScopeSwitcher from '../shell/ScopeSwitcher.astro';
import LayerTree from '../shell/LayerTree.astro';
import InterventionPane from '../shell/InterventionPane.astro';
import '../../../styles/obos-v2/tokens.css';
import '../../../styles/obos-v2/atoms.css';
import '../../../styles/obos-v2/shell.css';
import '../../../styles/obos-v2/screens.css';
import '../../../styles/obos-v2/phone.css';
import '../../../styles/obos-v2/print.css';
import { symbolCssVars } from '../../../scripts/climate-engine/v2/symbols.ts';
import { areaKeysInCity } from '../../../scripts/climate-engine/scope/registry.ts';
import { isAirCity } from '../../../lib/aqi/stations.ts';
import { UNCOVERED_NOTE } from '../../../scripts/climate-engine/air/air-panel.ts';
import { areaPath, DEFAULT_AREA_PATH } from '../../../scripts/climate-engine/scope/paths.ts';
import { resolve, type ResolvedScope } from '../../../scripts/climate-engine/scope/resolve.ts';
import { newCityToAnnounce } from '../../../scripts/climate-engine/shell/new-city.ts';
import { renderableWardById as wardById, formatLatLon } from '../../../data/wards.ts';

/**
 * THE PAGE TELLS THE INSTRUMENT WHICH AREA IT IS, rather than both assuming.
 *
 * Until the URL carried the area, this file hardcoded Ballygunge's coordinate and
 * three literal `data-w` divs, and heat-map-app.ts separately hardcoded
 * `INITIAL_AREA`. Two places holding one opinion, agreeing only by hand — which is
 * the shape of every defect the scope migration exists to end. The one that had
 * already happened is recorded in tests/unit/standards-ward-record.test.mjs: the
 * download link's static href and the app's boot ward were pinned to each other by
 * a REGEX OVER BOTH SOURCE FILES, because nothing structural made them agree.
 *
 * Now the scope arrives once, from the route, and everything on the page — the
 * readout, the name, the scope switcher, the strip, the record link, the
 * `data-area` the app boots from — is derived from it. The regex has nothing left
 * to compare, because there is only one copy.
 */
interface Props {
  scope: ResolvedScope;
}

const { scope } = Astro.props;

/* The sibling areas, from the registry, IN THE SAME CITY. `AREA_KEYS` would put
   Al Quoz in Kolkata's ward strip: two cities, two climates, two currencies, and
   the second half shipping no artefacts at all. */
const siblings = areaKeysInCity(scope.key).map(resolve);

/** This page's own URL — so the Explore link points here rather than at a redirect. */
const here = areaPath(scope.key);

/**
 * Whether this BUILD has a Mapillary token, passed to the layer tree as its one
 * capability.
 *
 * READ HERE AND NOWHERE ELSE ON THE PAGE. `scope/layers.ts` takes capabilities as
 * a parameter precisely so the tree can be rendered in both states, and the
 * component's own header says why it must not read `import.meta.env` itself. This
 * is the single site that turns a build fact into that parameter, and it spells
 * the variable exactly as heat-map-app.ts does — the whole street-level feature
 * tree-shakes out when it is unset, so a row offered here against a token the
 * instrument does not have would be a control that could never do anything.
 */
const mapillary = ((import.meta.env.PUBLIC_MAPILLARY_TOKEN as string | undefined) ?? '') !== '';

/* The ward-table row, where one exists. Coordinate and the <em>-stressed wordmark
   live there and nowhere else; an area that is not in the table (Dubai's three,
   which are our own tiling rather than municipal units) has neither, and gets the
   registry's plain name and an em-dash instead of an invented coordinate. */
const ward = wardById(scope.area.id);

/**
 * The strip swatch, DERIVED from the ward table's baseline vegetation fraction.
 *
 * Three radial-gradient strings used to be pasted here, one per ward. They were
 * never arbitrary — they encode how green the ward is, which is the one thing the
 * strip is comparing — so they are computed from `veg` rather than kept as a fourth
 * per-ward table for someone to update in one place and not the other. It renders
 * the same three swatches it replaced: 0.12 → red/bronze, 0.28 → orange/bronze,
 * 0.62 → sage/cyan, from the legend's own five classes.
 *
 * Every colour here is written as `var()` and not as a hex. This string lands in
 * an inline `style` on `.ward .sw`, which is inside `.stage` — where the tokens
 * are declared — so they resolve; a `var()` used outside that subtree would
 * resolve to nothing and drop the declaration silently.
 */
const swatch = (veg: number): string => {
  const head = veg >= 0.5 ? 'var(--sage)' : veg >= 0.2 ? 'var(--orange)' : 'var(--red)';
  const mid = veg >= 0.5 ? 'var(--cyan) 60%' : 'var(--bronze) 55%';
  return `background:radial-gradient(circle at 40% 40%,${head},${mid},var(--surface2))`;
};

/**
 * The ward strip's rows: the siblings that actually ship artefacts.
 *
 * Built here rather than in the template so the ward-table lookup can be NARROWED
 * rather than asserted. `wardById` returns `Ward | undefined` and an inline `!`
 * would be a promise made to the compiler with nothing keeping it — registry check
 * 7 does in fact pin every data-shipping area to a ward row, but a `!` in the
 * markup would survive that check being weakened. `flatMap` drops a row that has
 * no ward instead, so the failure is a missing tile rather than a thrown render.
 *
 * The short label comes from the SAME descriptor the panel shows, cut at its first
 * separator: "Urban Core · Ward 68" → "Urban Core". The strip has room for the kind
 * and not the number, which is a layout fact, not a second name for the place.
 */
const strip = siblings.flatMap((sib) => {
  const row = wardById(sib.area.id);
  if (row === undefined || !sib.area.hasData) return [];
  return [{
    key: sib.key,
    id: sib.area.id,
    name: sib.area.name,
    kind: sib.area.descriptor.split(' · ')[0],
    swatch: swatch(row.veg),
  }];
});

/* The ward's own data record. `/api/wards/[id]` is generated one route per BARE id
   from src/data/wards.ts, so the key would 404 — and this link is a download, so
   the browser would save the 404 body under a plausible filename rather than show
   it. heat-map-app.ts's `updateReportHref` rebuilds this identically on every area
   switch; the two agree because both read the area id, not because anyone matched
   two strings by eye. */
const reportHref = `/api/wards/${scope.area.id}/metadata.json`;

/* THE OTHER CITY, ANNOUNCED ONCE. Server-rendered rather than drawn by the app:
   the markup is identical for every reader, and the two reader-specific facts —
   whether they dismissed it, and whether the window is still open on THEIR clock —
   are applied by console-shell.ts on mount. Rendering it client-side would mean a
   badge that pops in after the scene has settled.

   THE ARRIVAL DATE TRAVELS WITH IT, as `data-since`, and that is load-bearing.
   These pages are prerendered, so the `new Date()` this call uses is the BUILD
   clock: without the date on the element the shell could not tell a window that
   is still open from one that closed two months and no deploys ago. */
/* THE STORE IS PASSED EXPLICITLY AS NULL, not left to default. `newCityToAnnounce`
   falls back to `defaultStore()`, which returns null here — but only by accident of
   Node having no `localStorage`. A polyfill, or an adapter that gave the build one,
   would let a SINGLE dismissal at build time silence the badge for every reader of
   every prerendered page, silently and until someone redeployed. The server has no
   reader whose preference it could be consulting; the dismissal is re-checked on
   the client, which is the only place it exists. */
const newCity = scope.area.hasData
  ? newCityToAnnounce(scope.city.id, new Date(), null)
  : null;
---
<main id="main" class="stage obos-v2" data-console data-area={scope.key} style={symbolCssVars()}>
  {scope.area.hasData && <div id="mlmap"></div>}
  <RailV2 current="overview" hasData={scope.area.hasData} areaName={scope.area.name} />
  <div class="toolbar" role="toolbar" aria-label="Display" data-hud>
    <div class="seg" role="group" aria-label="Theme">
      <button type="button" data-pref="theme" data-v="light">Light</button><button type="button" data-pref="theme" data-v="dark">Dark</button>
    </div>
    <div class="seg" role="group" aria-label="Card style">
      <button type="button" data-pref="cards" data-v="glass">Glass</button><button type="button" data-pref="cards" data-v="plates">Plates</button>
    </div>
    <button class="key-btn place" type="button" data-pop-open="key" aria-expanded="false" aria-controls="v2Key">
      <span class="pl-g"><Sym shape="disc" c="ink" size={12} /></span>Key</button>
  </div>
  <aside class="side-panel" id="v2Side" data-hud aria-label="Section panel">
    <div class="sp-body" data-side-pane="explore"></div>
    <div class="sp-body" data-side-pane="solar"></div>
    <div class="sp-body" data-side-pane="air"></div>
  </aside>
  <div class="st-title" id="v2Title" data-hud></div>
  <div class="mapstack" id="v2MapStack" data-hud></div>
  <div class="st-dock" id="v2Dock"></div>
  <div class="toasts" id="v2Toasts" data-hud></div>
  <div data-v2-parking>
    {/* S0 PARKING. Copied verbatim from HeatMapStage.astro so the contract holds;
        each block leaves this box in the slice named beside it. */}
    {/* S8 */}
  <div class="entry" id="entryNote" hidden role="dialog" aria-modal="true" aria-labelledby="entry-h">
    <div class="entry-card">
      <p class="entry-k">OBOS · Urban heat instrument</p>
      <h2 class="entry-h" id="entry-h">Best on a <em>bigger screen</em></h2>
      <p class="entry-b">This is a full console — a live 3-D city, a heat field and its
        error bars. It works on a phone, but a laptop, desktop or tablet is where you
        can actually read it.</p>
      <p class="entry-b entry-b-sm">On a phone, turn it sideways for the full width.</p>
      <button class="entry-go" type="button" data-entry-close>Continue anyway</button>
    </div>
  </div>

  <div class="rotate-nudge" id="rotateNudge" hidden>
    <span class="rn-ico" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="2.5" width="10.5" height="19" rx="2"/><path d="M17.5 9.5a6 6 0 0 1 0 5"/><path d="M19.6 8l.4 2.2-2.2.3"/>
      </svg>
    </span>
    <span class="rn-txt">Turn your phone for the full instrument</span>
    <button class="rn-x" type="button" data-rn-dismiss aria-label="Dismiss">✕</button>
  </div>
    {/* S5 */}
    <ScopeSwitcher current={scope.key} />
    {/* S5 */}
    {scope.area.hasData ? <InterventionPane scope={scope} /> : null}
    {/* S2 */}
    <LayerTree current={scope.key} mapillary={mapillary} />
    {/* S7 */}
          {scope.area.publishes ? (
          <Fragment>
          <p class="pane-note">What is measured, the out-of-sample error and sample size, every
            source dataset with its licence, and the analysis CRS and bounding box.</p>
          <a class="cta" id="report-link" href={reportHref} download>Download ward record ↓</a>
          </Fragment>
          ) : (
          <p class="pane-note">No record ships for {scope.area.name}. The ward record states what
            was measured, with what error, from which datasets — and there is no measurement here
            to state.</p>
          )}
    {/* S6 */}
          <p class="pane-h" id="pane-solar-h">Solar · <span id="solPaneArea">{scope.area.name}</span></p>
          {scope.area.hasData ? (
          <Fragment>
          <p class="pane-note" id="solPaneSum">Loading the rooftop-solar screen…</p>
          {/* THE WARD BLOCK, at home in the pane rather than on the right panel, where it
              pushed the colour legend off-screen (2026-09-06). Same numbers, same
              painter, pane-prefixed ids. */}
          <div class="solblock" id="solPaneBlock">
            <div class="k legend-head"><span id="solPaneHead">Rooftop solar · installable, whole ward</span><span id="solPaneTier" class="bc-tier">screened</span></div>
            <div class="big" id="solPaneKwp">—<span class="u">MWp</span></div>
            <div class="conf screening" id="solPaneConf"></div>
            <p class="solfloor" id="solPaneFloor"></p>
            <p class="solfloor" id="solPaneSure"></p>
            <div class="mrow">
              <div><div class="k">Annual yield</div><div class="val" id="solPaneKwh">—</div></div>
              <div><div class="k">Worth at tariff</div><div class="val sun" id="solPaneRs">—</div></div>
              <div><div class="k" id="solPaneBigK">Roofs ≥ 3 kWp</div><div class="val" id="solPaneBig">—</div></div>
              <div><div class="k">Losing ≥ 5 %, of those</div><div class="val sun" id="solPaneSh">—</div></div>
            </div>
          </div>
          {/* The ward's conservative city case (spec D1, D6): every roof at full
              size, no subsidy, every kWh at the tariff. Painted by paintSolarWard. */}
          <p class="pane-note sol-small" id="solPanePay" hidden></p>
          <div class="sol-tariff">
            <label for="solTariff">Tariff · assumed · change it</label>
            <span><span id="solCur" aria-hidden="true"></span><input id="solTariff" type="number" inputmode="decimal" min="0" step="0.25" value="8.00" aria-describedby="solTariffNote"> / kWh</span>
          </div>
          {/* THE UTILITY IS NAMED ONLY WHERE ITS TARIFF WAS SOURCED. CESC is
              Kolkata's DISCOM; Bengaluru's is BESCOM, whose slabs we have not
              sourced — so this sentence shipped a Kolkata utility's rates onto
              Bengaluru's page, under a box pre-filled at 8.00. The other city
              asserts no rate rather than guessing one.
              ponytail: a city-id test, because one city has the datum and one does
              not. It becomes a registry field beside the cost basis the moment a
              second tariff is sourced — not before. */}
          <p class="pane-note sol-small" id="solTariffNote">{scope.city.id === 'kolkata'
            ? 'CESC domestic slabs run 4.07–9.21 per unit (2025-26 tariff order); a solar unit displaces the top of the bill. Not a rate we assert.'
            : 'No local tariff is sourced for this city yet, so the box above is an assumption you should change. Not a rate we assert.'}</p>
          <p class="pane-h">Best roofs by annual yield</p>
          <div class="roofs-scroll">
          <table class="roofs" aria-label="The ten best roofs by annual yield; each row selects its building on the map">
            <thead><tr><th scope="col">#</th><th scope="col">kWp</th><th scope="col">kWh/yr</th><th scope="col">range</th><th scope="col">shaded</th><th scope="col">m²</th></tr></thead>
            <tbody id="solList"></tbody>
          </table>
          </div>
          <p class="pane-note sol-small">Yield uses NASA POWER irradiance and a Mumbai packing factor; shading is computed from this ward's own geometry and canopy, and the mask rule is its largest uncertainty — "at least" is the strict-mask floor. Screening only, not bankable.</p>
          <a class="cta" id="solCsv" href="#" download>Download roof list · CSV ↓</a>
          </Fragment>
          ) : (
          <p class="pane-note">No solar screen ships for {scope.area.name}. The screen needs footprints, heights and canopy, and this area ships none.</p>
          )}
    {/* S7 */}
        <section class="pane-body" id="airPane" aria-labelledby="pane-air-h">
          <p class="pane-h" id="pane-air-h">Air · <span id="airPaneArea">{scope.area.name}</span></p>
          <p class="pane-note" id="airPaneBody">{isAirCity(scope.key) ? 'Loading air quality…' : UNCOVERED_NOTE}</p>
        </section>
      <p class="aq-sr" id="airStatus" role="status" aria-live="polite"></p>
    {/* S4 */}
    <p class="crumb"><span>{scope.country.name}</span><span>{scope.city.name}</span><b id="crumbArea">{scope.area.name}</b></p>
    <div class="topmeta">
      <div class="rig">{scope.area.hasData
        ? <Fragment><span id="bcount">— buildings</span> · <span id="simBackend" aria-live="polite">SELECTING ENGINE</span></Fragment>
        : <span>no artefacts · {scope.tier} tier</span>}</div>
      <div class="read">MEDNI · HEAT INSTRUMENT<br><b id="coord">{ward ? formatLatLon(ward.lat, ward.lon, ' · ', 3) : '—'}</b></div>
    </div>
    {scope.area.hasData && <Fragment>
      {/* S2/S4 */}
    <div class="synthetic"><span class="d"></span><span class="full">Live basemap + real footprints &amp; Google heights · </span>heat field modelled<span class="sp"> · block detail illustrative</span></div>
    <div class="stamp-slot"><ConstructionStamp /></div>
    <div class="loadchip" id="loadchip"></div>

    {newCity && (
      <div class="newcity" id="newCity" data-city={newCity.id} data-since={newCity.since} hidden>
        {/* NO aria-label. The visible text already reads "New city Bengaluru", and a
            label of "Bengaluru — newly added city" replaced it with a string those
            visible words are not contained in — Label in Name (WCAG 2.5.3), so
            "click New city" matched nothing by speech. The eyebrow is CLIPPED rather
            than display:none on phones, so the name keeps "New city" there too. */}
        <a href={newCity.href}>
          <span class="nc-eyebrow">New city</span>
          <span class="nc-name">{newCity.name} <span aria-hidden="true">→</span></span>
        </a>
        <button type="button" id="newCityHide" aria-label="Dismiss">×</button>
      </div>
    )}

    <!-- North reference. The idle orbit turns the map continuously, so without
         this there is no way to know which way you are facing, and no way back. -->
    <!-- Sun reading. A SIBLING of the compass, never a child: the compass is a
         button whose whole box resets the bearing, and text inside it would become
         part of that click target. Always visible rather than a hover tooltip, so
         it works on touch and so the caveat cannot hide. -->
    <p class="sunline" id="sunLine" hidden>
      <span id="sunLineText"></span>
      <span class="sunline-note" id="sunLineNote" tabindex="0" role="note">geometry only</span>
    </p>
    <button class="compass" id="compass" type="button" title="Face north" aria-label="Reset the map to face north">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="21.2" class="c-ring" />
        <!-- Everything that should point at the world lives in this group, which
             JS rotates to the inverse of the map bearing. The N and S letters
             ride along but are counter-rotated by the same angle about their own
             anchors, so they travel to the right compass point while staying
             upright — a letter lying on its side is decoration, not a reading. -->
        <g id="compassDial">
          <path d="M24 9 L29 26 L24 22.6 L19 26 Z" class="c-n" />
          <path d="M24 39 L19 22 L24 25.4 L29 22 Z" class="c-s" />
          <circle cx="38.4" cy="24" r="1.15" class="c-tick" />
          <circle cx="9.6" cy="24" r="1.15" class="c-tick" />
          <text id="compassN" x="24" y="6.4" class="c-lab c-lab-n">N</text>
          <text id="compassS" x="24" y="45.2" class="c-lab">S</text>
          <!-- Sun bearing. Rides INSIDE the rotating dial, like N and S, because
               it is a world direction: turn the map and the sun must stay over
               the ground it is actually shining on. Hidden outright when the sun
               is below the horizon — a bearing at midnight is not a dim reading,
               it is a meaningless one. -->
          <g id="compassSun" class="c-sun is-below">
            <circle cx="24" cy="24" r="1" class="c-sun-hub" />
            <line x1="24" y1="24" x2="24" y2="13.2" class="c-sun-ray" />
            <circle cx="24" cy="11.4" r="3.1" class="c-sun-disc" />
          </g>
        </g>
      </svg>
    </button>

    <!-- Live-reading freshness.
         NOT A CLOCK FOR THE MAP. The simulation is steady-state at one of two
         representative phases; it has no 14:32. This dial describes the DATA —
         the hour met.no's reading is valid for, and how long ago that was — which
         matters because that reading sets the sim's boundary conditions and was,
         until now, fetched once per ward per session and never refreshed. A tab
         left open overnight showed a pulsing green "live" dot over yesterday's
         weather. Click to re-read. -->
    <!-- TWO CONTROLS, NOT ONE. The tile used to be a single button whose click
         forced a live re-read — and that click is the ONLY re-read in the app
         (fetchLive runs on ward load and from here; the 60s timer just
         repaints). Handing the whole tile to a format toggle would leave a dial
         that reports data is 14 hours stale and offers no way to fix it. So the
         face toggles the format and the age line re-reads, each saying which. -->
    <div class="clockw" id="clockw" hidden>
      <!-- Stacked state indicator, the Braun/Rams idiom: BOTH halves of the day
           are always present and only the emphasis moves, so you read "PM out of
           AM/PM" rather than trusting a single changing label.

           The day above them is not decoration. These digits are the WARD's
           clock, not the viewer's — from London at 18:30 GMT this reads 00:00,
           and nothing said it was already tomorrow in Kolkata. This dial exists
           because a tab left open overnight showed a live dot over yesterday's
           weather; without the day it still could not name which day. -->
      <button class="k-face" id="clockFace" type="button" aria-pressed="false">
        <span class="k-stack" aria-hidden="true">
          <span class="k-day" id="clockDay">—</span>
          <!-- In 24-hour mode the meridiem is meaningless, so the pair is
               replaced by the mode itself rather than left dimmed and lying. -->
          <span class="k-mer" id="clockAm">AM</span>
          <span class="k-mer" id="clockPm">PM</span>
          <span class="k-mer k-h24" id="clock24">24H</span>
        </span>
        <span class="k-time" id="clockTime">--:--</span>
      </button>
      <button class="k-age" id="clockAge" type="button">
        <span class="k-sub"><span class="k-age-lab" id="clockAgeLab">—</span></span>
        <!-- Freshness survives the move to digits as a draining rule along the
             bottom edge: the digits say WHEN, the bar says HOW STALE, and the bar
             is the only thing that animates (one transform, no layout). -->
        <span class="k-bar" aria-hidden="true"><i id="clockBar"></i></span>
      </button>
    </div>

    <!-- Vegetation toggle: distinct widget directly below the clock. Shown when the
         ward's rasters resolve -- NOT when the weather arrives, which is a
         different fetch that these controls do not depend on. Binary on/off in
         the .modechip idiom. -->
    <div class="vegw" id="vegw" hidden>
      <span class="veg-lab">Trees</span>
      <div class="modechip" id="vegchip" title="Show or hide the modelled tree canopy">
        <button class="on" data-v="1" type="button">On</button>
        <button data-v="0" type="button">Off</button>
      </div>
    </div>

    <!-- Street-view toggle: same widget idiom as Trees, stacked directly below it. -->
    <div class="vegw" id="svw" hidden>
      <span class="veg-lab">Street</span>
      <div class="modechip" id="streetchip" title="Show Mapillary street-level coverage; click a point for the real photo"><button class="on" data-s="0">Off</button><button data-s="1">On</button></div>
    </div>

    <!-- First-run affordance: the buildings became clickable and nothing said so. -->
    <div class="tiphint" id="tiphint" hidden>
      <span>Click any building for its data</span>
      <button type="button" id="tipX" aria-label="Dismiss hint">✕</button>
    </div>

    <!-- Walk-time ring labels. Text is STATIC: the app only toggles `hidden` and
         writes a transform, so nothing rewrites strings on every repaint.
         Two lines each — the headline is the human unit (minutes), the second
         line is the caveat, because a circle drawn on a map reads as "you can
         reach all of this" and a straight-line radius is not that. -->
    <!-- Ring labels are RULER MARKINGS, not findings: one quiet mono line, in
         the ring's own colour, sitting on the circumference like a contour
         label. The old data-chip styling promised a per-building measurement
         and delivered a constant — the reader who commissioned the rings
         misread them twice for exactly that reason. -->
    <div class="ringlab" id="ringNear" hidden>1 min · 80 m</div>
    <div class="ringlab" id="ringFar" hidden>5 min · 400 m</div>

    <!-- The finding: nearest greenery, the number that changes with every
         click. Data-chip anatomy (big value, small label) in the cooling
         green so it belongs to the patches it stands on. -->
    <!-- Two nodes on purpose: the OUTER one is written by the render loop every
         repaint (translate3d onto the cooling patch), the INNER one owns the
         pop-in. Animating one element with both would have the frame loop
         stamping over the animation's transform sixty times a second. Same
         split as .bcard / .bcard-in. -->
    <div class="cooltag" id="coolTag" hidden>
      <div class="cooltag-in" id="coolTagIn">
        <b id="coolTagM">—</b><span>Nearest greenery</span>
      </div>
    </div>

    <!-- LANDMARK LABELS. The named buildings of a ward that ships an authored
         model — 0 in Indiranagar (a genuinely low-rise ward), 12 in MG Road, 35
         in Whitefield. These are the only buildings whose height the instrument
         asserts BY NAME, so every chip here has a citation behind it and one
         without a stated source is never drawn at all.

         Chips are created per ward by heat-map-app.ts and only TRANSFORMED per
         repaint — the text never changes once written. They are real buttons
         because the city is a <canvas>: this is the only way to reach a landmark
         from the keyboard. -->
    <div class="lmlabs" id="lmlabs" hidden></div>

    <!-- Click-to-inspect. Positioned from the building's own ward-metre centroid
         every time MapLibre repaints, so it tracks orbit, pan, zoom and flyTo. -->
    <div class="bsel" id="bsel" hidden aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="bcard" id="bcard" hidden role="dialog" aria-label="Selected building">
      <span class="lead"></span>
      <div class="bcard-in">
        <div class="bc-h"><span>Building</span><span id="bcId">—</span></div>
        <dl>
          <dt>Coordinates</dt><dd id="bcLL">—</dd>
          <dt>Height</dt><dd id="bcH">—</dd>
          <dt>Floors ≈</dt><dd id="bcF">—</dd>
          <dt>Footprint</dt><dd id="bcA">—</dd>
          <dt>Vegetation</dt><dd id="bcV">—</dd>
          <dt>Albedo</dt><dd id="bcAl">—</dd>
          <dt>Surface</dt><dd id="bcT">—</dd>
        </dl>
        {/* LANDMARK — shown only when the selected building is one of the ward's
            named buildings, and then it prints the published height AND where
            that height came from. The source row is not decoration: a height
            with no stated source is not drawn as a landmark at all, so this row
            is the reason the rest of the block is allowed to exist.

            ABOVE the rooftop-solar block and ruled off in cyan rather than the
            screening amber, because this is the best-evidenced number on the
            card and must never read as a sibling of the estimate below it. */}
        <div class="bc-lm" id="bcLm" hidden>
          <div class="bc-h"><span>Landmark</span></div>
          <p class="bc-lm-name" id="bcLmName">—</p>
          <dl>
            <dt>Published height</dt><dd id="bcLmH">—</dd>
            <dt>Source</dt><dd id="bcLmSrc">—</dd>
          </dl>
        </div>
        {/* ROOFTOP SOLAR — a screening estimate ABOUT the building, under the
            measured rows and in a different ink. Painted by paintSolarCard from
            the ward's solar file; hidden when none ships. "At least" is the
            strict-mask floor: the mask rule is the largest lever in the estimate,
            so the headline never prints without it (spec §2.4). */}
        <div class="bc-sol" id="bcSol" hidden>
          <div class="bc-h"><span>Rooftop solar</span><span id="bcSolTier" class="bc-tier">screened</span></div>
          <dl>
            <dt>Installable</dt><dd id="bcSolKwp" class="sun">—</dd>
            <dt>Yield</dt><dd id="bcSolKwh">—</dd>
            <dt>Shaded</dt><dd id="bcSolLoss">—</dd>
            <dt>At least</dt><dd id="bcSolFloor">—</dd>
            <dt>Raised 2 m</dt><dd id="bcSolRaised">—</dd>
            <dt>Worth</dt><dd id="bcSolRs">—</dd>
          </dl>
          <p class="bc-sol-note" id="bcSolNote">Screening estimate · not bankable · canopy Meta/WRI CHM v2 · 0.5 m grid · NASA POWER irradiance</p>
          {/* THE HOW-SURE LADDER (spec 2026-09-07-solar-guide §2.3). Every rung names a
              limit, the fix for it, and what the fix narrows it to — the middle <b>
              is this roof's own band, painted by paintSolarCard. The buttons open a
              pre-filled email and nothing else: the survey app does not exist, and a
              button that pretended it did would be the one dishonest thing on the card. */}
          <details class="bc-sure" id="bcSure">
            <summary>How sure, and what would make it surer</summary>
            <ul>
              <li data-limit="roof">Roof obstacles unknown: tanks, stair rooms, parapets. <b id="bcSureRoof"></b> A ten-minute walk of the roof with a phone narrows it to about ±10%. <button type="button" class="bc-ask" data-limit="roof" aria-label="Ask about roof obstacles">Ask about this</button></li>
              <li data-limit="canopy">Canopy over the roof: usable or not. <b id="bcSureCanopy"></b> One photo from the roof settles it. <button type="button" class="bc-ask" data-limit="canopy" aria-label="Ask about canopy over the roof">Ask about this</button></li>
              <li data-limit="irradiance">Sunlight from a coarse satellite cell. <b id="bcSureIrr"></b> The ground station inside that cell narrows yield to about ±5%, city-wide. <button type="button" class="bc-ask" data-limit="irradiance" aria-label="Ask about sunlight data">Ask about this</button></li>
              <li data-limit="height">Building height unverified for this roof. A survey or a drone pass fixes it. <button type="button" class="bc-ask" data-limit="height" aria-label="Ask about building height">Ask about this</button></li>
              <li data-limit="validation" id="bcSureValid">Never compared with real rooftops yet. The validation study is under way. <button type="button" class="bc-ask" data-limit="validation">Join the study</button></li>
            </ul>
          </details>
          {/* THE WAY OFF THE SCREEN. It renders #solBrief from this roof and hands the
              page to the browser's own print dialogue — no PDF library, no server.
              It was born `hidden`, because a styled button that does nothing is a lie
              the reader can click; the renderer exists now, so it does not stay one. */}
          <button class="bc-brief" id="bcBrief" type="button">Print the installer brief</button>
          {/* THE PAYBACK SHEET'S DOOR (spec 2026-09-30-solar-roi D7). Painted by
              paintSolarCard: hidden when the city has no sourced cost basis, disabled
              with its own reason when the roof takes under 1 kW. */}
          <button class="bc-brief" id="bcPay" type="button" hidden>Work out payback</button>
        </div>
        <div class="sv-thumb" id="svThumb" hidden></div>
        <p class="bc-rings" id="bcRings"></p>
        <p class="bc-ins" id="bcIns"></p>
        <p class="bc-prov" id="bcSrc"></p>
        <button class="bc-x" id="bcX" type="button" aria-label="Close building details">Close ✕</button>
      </div>
    </div>
      {/* S4 */}
    <div class="place">
      {/* `ward.name` carries <em> around the syllable the wordmark stresses, which
          is why this is set:html where `scope.area.name` - markup-stripped, for
          titles and machine-readable fields - is not. */}
      <div class="n" id="pname" set:html={ward?.name ?? scope.area.name}></div>
      <div class="z" id="pzone">{scope.area.descriptor}</div>
    </div>
    <div class="chiprow">
      <div class="modechip" id="modechip"><button class="on" data-m="relief">3D Relief</button><button data-m="iso">2D Isotherm</button></div>
      <div class="modechip" id="envchip"><button class="on" data-e="dark">Dark map</button><button data-e="studio">Clay studio</button></div>
      <div class="modechip" id="tintchip" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><button class="on" data-t="1">Gradient</button><button data-t="2">5-Class</button></div>
    </div>
      {/* S3 */}
    <aside class="panel right">
      {/* AIR FIRST (founder decision 1, 2026-10-07). The surface figure used to be the
          big number here and was read as the air temperature — 46.7 °C in the rain.
          What a person feels is the air; the modelled ground and rooftops follow,
          labelled as what they are. The source line names where "now" came from. */}
      <div class="metric livem">
        <div class="k"><span id="liveSrc">Air now</span> <span class="livedot" id="livedot"></span></div>
        {/* ONE ROW: air leads; feels-like, humidity and wind stack beside it. A separate
            RH/wind grid cost the rail ~40 px and pushed the legend under its fold. */}
        <div class="airrow">
          <div class="air"><b id="liveT">—</b><span class="u">°C air</span></div>
          <div class="side">
            <div class="feel"><b id="liveFeel">—</b><span class="u">°C feels</span></div>
            <div class="aux"><span id="liveRH">—</span>% RH · <span id="liveWind">—</span> m/s</div>
          </div>
        </div>
      </div>
      <div class="metric">
        <div class="k surface-k">Ground &amp; rooftop surface · <span id="lstPhase">modelled now</span></div>
        <div class="lst sec" id="lst" style="color:var(--red)">—<span class="u">°C</span></div>
        <div class="conf" id="conf"></div>
        {/* THE SEASON'S WARNING, when the current month is one in which the displayed
            mean breaks its own band (accuracy.ts SEASONAL_CAVEATS). Painted by the
            instrument from the committed artefact; hidden the rest of the year. */}
        <p class="season-note" id="seasonNote" hidden></p>
        {/* WHAT THE FIGURES BELOW ARE TAKEN OVER, for an area with an administrative
            boundary (ward-mask.ts): the mean, the share above 40 °C and the
            histogram are the polygon's, not the square's. Painted by the instrument;
            hidden for an area whose square is its study area. */}
        <p class="ward-scope" id="wardScope" hidden></p>
        {/* THE WEATHER LINE: condition, source, distance and observation time, and
            what the model is doing about it. Painted by the instrument (paintLive). */}
        <p class="wx-line" id="wxLine" hidden></p>
      </div>
      <div class="mrow">
        <div><div class="k" title="Modelled land-cover thermal contrast: this ward's mean surface temperature minus a fully-vegetated reference cell under identical forcing. NOT a measured urban heat island — published Kolkata surface UHI is 0.85–1.5 °C from 1 km satellite data, a different quantity.">Δ vs all-green ref</div><div class="val" style="color:var(--cyan)" id="uhi">—</div></div>
        <div><div class="k">Surface above 40 °C</div><div class="val" style="color:var(--red-ink)" id="area">—</div></div>
      </div>
      <div class="metric sep" style="padding-bottom:0"><div class="k">Surface temperature distribution</div></div>
      <div class="histo" id="histo"></div>
      {/* The ward record used to end this card. It is now the Reports pane's one
          piece of content — a download named after itself, in the section named
          after it, rather than a bronze button under a histogram. One element, one
          id; `updateReportHref` still finds it by name. */}
    </aside>
      {/* S3/S7 */}
    <div class="legend" id="legend">
      <div class="k legend-head" style="margin-bottom:.6rem"><span>What the colours mean</span></div>
      {/* `style` is an attribute whose CONTENT is CSS, unlike `stroke` above, so
          `var()` resolves here normally. These swatches are inside `.stage`, which
          is where the tokens are declared. */}
      <div class="cindex">
        <div class="ci"><span class="d" style="background:var(--red)"></span>Extreme</div>
        <div class="ci"><span class="d" style="background:var(--orange)"></span>Severe</div>
        <div class="ci"><span class="d" style="background:var(--bronze)"></span>Hot</div>
        <div class="ci"><span class="d" style="background:var(--sage)"></span>Warm</div>
        <div class="ci"><span class="d" style="background:var(--cyan)"></span>Comfortable</div>
      </div>
      <div class="k" style="margin:.9rem 0 .5rem"><span>Land Surface Temp</span><span>°C</span></div>
      <div class="ramp"></div>
      <!-- filled by syncRamp(): the scale moves with the weather, so hardcoded
           numbers here would contradict the colours above them. -->
      <div class="sc" id="rampSc"><span>26</span><span>32</span><span>37</span><span>42</span><span>48</span></div>
      <!-- Filled from accuracy.ts SPATIAL, never hardcoded here: the legend is
           where a reader goes to interpret the colours, so it is where the limit
           of what the colours mean belongs. -->
      <p class="pattern-note" id="patternNote"></p>
      {/* The ward's solar numbers, BELOW the colour key and folded to a header by
          default: the key is what a reader entering the console sees first
          (founder's call, 2026-09-06). On the Solar screen the script moves this
          block above the key and unfolds it. It sits above the attribution and the
          receipts button so the receipts panel's anchor never moves. Hidden until a
          solar screen ships. */}
      <div class="solblock legend-solar" id="solBlock" role="region" aria-label="Rooftop solar, whole ward" hidden>
        <div class="k legend-head"><span id="solHead">Rooftop solar · whole ward</span><button class="solbtn" id="solToggle" type="button" aria-expanded="false" aria-controls="solBody">Show ▾</button></div>
        <div class="solbody" id="solBody" hidden>
          <div class="big" id="solKwp">—<span class="u">MWp</span></div>
          <div class="conf screening" id="solConf"></div>
          <p class="solfloor" id="solFloor"></p>
          <div class="mrow">
            <div><div class="k">Annual yield</div><div class="val" id="solKwh">—</div></div>
            <div><div class="k">Worth at tariff</div><div class="val sun" id="solRs">—</div></div>
            <div><div class="k" id="solBigK">Roofs ≥ 3 kWp</div><div class="val" id="solBig">—</div></div>
            <div><div class="k">Losing ≥ 5 %, of those</div><div class="val sun" id="solSh">—</div></div>
          </div>
        </div>
      </div>
      {/* The area's air quality, painted by air-panel.ts cardHtml. Placed like the
          solar block: above the colour key while the Air pane is open, above the
          attribution otherwise. Hidden until a Kolkata payload (or its failure) lands. */}
      <div class="aqblock legend-air" id="aqiBlock" role="region" aria-label="Air quality" hidden></div>
      <div class="attr">Basemap © OpenStreetMap · OpenFreeMap · Footprints © Overture Maps Foundation (ODbL) · Heights Google Open Buildings 2.5D (CC BY 4.0) · Water © OpenStreetMap (ODbL) · Ground SRTM via AWS terrain tiles, <span id="terrLab">indicative</span> · Live weather © Met Norway (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>) · <span id="attrWard" hidden></span>Cloud deck drawn at 320 m, real base ~700 m · left-drag orbit · right-drag pan · scroll zoom</div>
      <button class="srcbtn" id="srcBtn" type="button" aria-expanded="false" aria-controls="srcPanel">Data receipts ↗</button>
      <div class="srcpanel" id="srcPanel" role="dialog" aria-label="Per-layer data provenance" hidden></div>
    </div>
      {/* S4 */}
  <div class="svmodal" id="svModal" hidden>
    <div class="svmodal-card">
      <button class="svmodal-x" id="svClose" type="button" aria-label="Close street view">✕</button>
      <div id="svViewer" class="svmodal-viewer"></div>
      <div class="svmodal-credit">Street imagery · <a href="https://www.mapillary.com" target="_blank" rel="noopener">Mapillary</a> · community-captured (CC BY-SA)</div>
    </div>
  </div>
  <div class="strip" id="strip">
    {strip.map((row) => (
      <div class:list={['ward', { on: row.key === scope.key }]} data-w={row.id}>
        <span class="sw" style={row.swatch}></span>
        <div><div class="nm">{row.name}</div><div class="ty">{row.kind}</div></div>
        <div class="big" id={`big-${row.id}`}>—<span>°C surface</span></div>
      </div>
    ))}
  </div>
    </Fragment>}
    {/* S5 */}
    {!scope.area.hasData && <Fragment>
  <section class="notyet" aria-labelledby="notyet-h">
    <p class="notyet-tier">{scope.tier} tier · {scope.city.koppen} climate</p>
    <h1 class="notyet-h" id="notyet-h">{scope.area.name}</h1>
    <p class="notyet-sub">{scope.area.descriptor} · {scope.city.name}, {scope.country.name}</p>
    {/* What is missing, stated, rather than a spinner or an apology. The gap between
        this tier and a validated one is the thing the twin is asking to be funded to
        close, so naming it is the page's whole content. */}
    <p class="notyet-body">
      This area is registered in the twin and has a permanent address, but no measured
      heat artefacts ship for it yet — no footprints, no surface temperature, no
      canopy. Nothing here would be a reading, so nothing is drawn. The instrument
      runs where the observations do.
    </p>
    <p class="notyet-links"><a href={DEFAULT_AREA_PATH}>Open a validated area →</a></p>
  </section>
    </Fragment>}
  </div>
  {/* S6: direct children of .stage (app:1077). UNCONDITIONAL, as in v1 (stage :847–962 sit outside the data gate). */}
  <section class="solpay" id="solPay" hidden role="dialog" aria-modal="true" aria-labelledby="spHead">
    <header class="sp-head">
      <h2 id="spHead">Payback for this roof</h2>
      <span class="bc-tier" id="spTag">screened · estimate, not a quote</span>
    </header>
    <div class="sp-sec">
      <label class="sp-k" for="spSize">System size</label>
      <span class="sp-size"><input id="spSize" type="range" min="1" step="0.5" value="3" aria-describedby="spSizeOut">
        <input id="spSizeNum" type="number" inputmode="decimal" min="1" step="0.5" value="3" aria-label="System size in kW" aria-describedby="spSizeOut"> kW</span>
      <p class="sp-note" id="spSizeOut">—</p>
    </div>
    <fieldset class="sp-sec sp-owner">
      <legend class="sp-k">Who owns the roof</legend>
      <label><input type="radio" name="spOwner" value="home" checked> Home</label>
      <label><input type="radio" name="spOwner" value="society"> Housing society</label>
      <label><input type="radio" name="spOwner" value="business"> Business</label>
      <p class="sp-note" id="spSubsidy">—</p>
    </fieldset>
    <div class="sp-sec">
      <span class="sp-k">Cost per kW, installed</span>
      <span class="sp-pair"><input id="spCostLo" type="number" inputmode="numeric" min="0" step="1000" aria-label="Lowest cost per kW" aria-describedby="spCostNote">
        – <input id="spCostHi" type="number" inputmode="numeric" min="0" step="1000" aria-label="Highest cost per kW" aria-describedby="spCostNote"></span>
      <p class="sp-note" id="spCostNote">—</p>
      <label class="sp-k" for="spTariff">Your tariff, per kWh</label>
      <input id="spTariff" type="number" inputmode="decimal" min="0" step="0.25" aria-describedby="spTariffNote">
      <p class="sp-note" id="spTariffNote">—</p>
      <p class="sp-note sp-warn" id="spFlat" hidden></p>
      <div id="spBill">
        <label class="sp-k" for="spUnits">Use my bill (optional): units a month</label>
        <input id="spUnits" type="number" inputmode="numeric" min="0" step="10" aria-describedby="spSizing">
        <p class="sp-note" id="spSizing" hidden></p>
        <p class="sp-note sp-warn" id="spWarn" hidden></p>
      </div>
    </div>
    <div class="sp-sec sp-res">
      <div><span class="sp-k">Pays back in</span><output class="sp-big" id="spPayback">—</output></div>
      <div><span class="sp-k">Net saving, 25 years</span><output class="sp-big" id="spSaving">—</output></div>
      <p class="sp-assume" id="spAssume">—</p>
    </div>
    <div class="sp-btns">
      <button class="bc-brief" id="spPrint" type="button">Print the installer brief</button>
      <a class="bc-brief" id="spCsv" href="#" download>Year-by-year CSV</a>
      <button class="sb-x" id="spClose" type="button">Close ✕</button>
    </div>
  </section>
  <section class="solbrief" id="solBrief" hidden role="dialog" aria-modal="true" aria-label="Installer brief">
    <header class="sb-head">
      <p class="sb-org">Delta Climate Research · Rooftop solar brief</p>
      <p class="sb-who">
        <span id="brWard">—</span><span id="brIdx">—</span><span id="brLatLon">—</span><span id="brDate">—</span><span id="brTier" class="bc-tier">screened</span>
      </p>
    </header>
    <div class="sb-cols">
      {/* The footprint as the registry holds it, drawn north-up. Empty in the
          markup: the ring is a per-building Float32Array, so the one <polygon>
          and the north arrow are written by renderBrief. */}
      <figure class="sb-fig">
        <svg id="brOutline" viewBox="0 0 200 200" role="img" aria-label="Roof outline, north up"></svg>
        <figcaption>Footprint · north up</figcaption>
      </figure>
      <dl class="sb-dl">
        <dt>Footprint</dt><dd id="brArea">—</dd>
        <dt>Height</dt><dd id="brHeight">—</dd>
        <dt>Installable</dt><dd id="brKwp">—</dd>
        <dt>Annual yield</dt><dd id="brKwh">—</dd>
        <dt>Shaded</dt><dd id="brLoss">—</dd>
        <dt>At least</dt><dd id="brFloor">—</dd>
        <dt>Raised 2 m</dt><dd id="brRaised">—</dd>
        <dt>Worth at tariff</dt><dd id="brRs">—</dd>
        <dt>Payback</dt><dd id="brPay">—</dd>
      </dl>
    </div>
    <p class="sb-basis" id="brPayAssume" hidden>—</p>
    <h2 class="sb-h2">How sure, and what would make it surer</h2>
    {/* Filled from the card's own ladder at render time, never retyped: two copies
        of five sentences would disagree the first time one of them was edited. */}
    <ol class="sb-sure" id="brSure"></ol>
    <h2 class="sb-h2">Questions to ask your installer</h2>
    <ol class="br-ask">
      <li>The proposed tilt and orientation, and why.</li>
      <li>The module count and DC capacity, against the range above.</li>
      <li>Their expected yield against ours, and the assumptions behind theirs.</li>
      <li>Whether a shading study was done, and how.</li>
      <li>The net-metering limit that applies to this connection.</li>
      <li>Their monitoring access, so generation can be checked against the promise.</li>
    </ol>
    <p class="sb-basis" id="brBasis">—</p>
    <footer class="sb-foot">
      {/* PAINTED, NOT FIXED. renderBrief runs this through the same tier-aware
          builder as the card's note, so a validated ward's sheet cannot wear a
          `validated` chip over a footer that still opens "Screening estimate". */}
      <span id="brFoot">Screening estimate · not bankable</span><span>deltaclimate.earth</span>
    </footer>
    {/* THE WAY BACK. On paper this button is nothing, so print hides it; on screen it
        is the only control the reader can see once an opaque sheet covers the
        console, and the three event paths that also close it are all invisible. */}
    <button class="sb-x" id="brClose" type="button">Close ✕</button>
  </section>
</main>
