---
// src/components/ClimateEngine/v2/LayersPopover.astro — OBOS v2 spec §3.7
import LayerTree from '../shell/LayerTree.astro';
import type { AreaKey } from '../../../scripts/climate-engine/scope/registry.ts';
interface Props { current: AreaKey; mapillary: boolean; hasData: boolean }
const { current, mapillary, hasData } = Astro.props;
---
<div class="layers-pop card" id="v2Layers" role="dialog" aria-label="Map and layers" tabindex="-1" data-open="false" data-hud>
  <div class="row"><h2 class="name-xl"><b>Map</b><span> &amp; layers</span></h2>
    <button class="sp-close" type="button" data-pop-close aria-label="Close map and layers">×</button></div>
  {hasData && <div class="lp-sec">
    <div class="lp-row"><span class="micro">View</span><div class="seg modechip" id="modechip"><button class="on" data-m="relief">3D Relief</button><button data-m="iso">2D Isotherm</button></div></div>
    <div class="lp-row" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><span class="micro">Colour</span>
      <div class="seg modechip" id="tintchip" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><button class="on" data-t="1">Gradient</button><button data-t="2">5-Class</button></div></div>
    <div class="lp-row"><span class="micro">Map look</span><div class="seg modechip" id="envchip"><button class="on" data-e="dark">Dark map</button><button data-e="studio">Clay studio</button></div></div>
    <p class="foot">Map look is its own choice; the theme switch pairs it only until you pick one here.</p>
  </div>}
  <div class="lp-sec v1-bridge"><LayerTree current={current} mapillary={mapillary} /></div>
</div>
