---
// src/components/ClimateEngine/v2/HeatCards.astro — OBOS v2 spec §4.3 [H]. Owner: Track A (plan S3.3).
// #histo and #rampSc live once, in the temperature card; this card holds the class key and the limits of what the colours mean.
import type { ResolvedScope } from '../../../scripts/climate-engine/scope/resolve.ts';
import Sym from './Sym.astro';
import { heatAccuracyClaim } from '../../../scripts/climate-engine/scope/accuracy-claim.ts';
interface Props { scope: ResolvedScope }
const { scope } = Astro.props;
/* The tier decides whether this city may print Kolkata's bands, caveats and "checked" wording (scope/accuracy-claim.ts). */
const claim = heatAccuracyClaim(scope.tier);
---
<article class="card" data-v2-card="heat-legend" data-sections="heat">
  <div class="row"><span class="micro">What the colours mean</span><span class="kind modelled">modelled</span></div>
  <div class="classes"><span><i class="hk h1"></i>Comfortable</span><span><i class="hk h2"></i>Warm</span><span><i class="hk h3"></i>Hot</span><span><i class="hk h4"></i>Severe</span><span><i class="hk h5"></i>Extreme</span></div>
  <p class="foot">Building colour: continuous ramp, or snapped to the 5 legend classes</p>
  <p class="foot pattern-note" id="patternNote"></p>
  <p class="foot">{claim.footLine}</p>
</article>
<article class="card" data-v2-card="method" data-sections="heat">
  {claim.kind === 'band' ? (<Fragment>
  <details class="disc"><summary>How this was checked <span class="chev" aria-hidden="true">›</span></summary>
    <div class="body"><ul class="method">{claim.figures.howChecked().map((r) => <li><span class="micro">{r.k}</span><span class="foot">{r.v}</span></li>)}</ul></div></details>
  <details class="disc"><summary>Caveats OBOS adds when they apply <span class="chev" aria-hidden="true">›</span></summary>
    <div class="body"><ul class="method">{claim.figures.limits(scope.area.id).map((r) => <li><span class="micro">{r.k}</span><span class="foot">{r.v}</span></li>)}</ul></div></details>
  </Fragment>) : (
  <details class="disc"><summary>How this was checked <span class="chev" aria-hidden="true">›</span></summary>
    <div class="body"><p class="foot">{claim.detail}</p></div></details>)}
  <details class="disc" open><summary>What is measured, what is modelled <span class="chev" aria-hidden="true">›</span></summary>
    <div class="body"><ul class="sym-list">
      <li><span class="sym-tile sm"><Sym shape="ward" c="ink" size={20} /></span><div><div class="sym-hd"><b>Measured</b> · ward boundary, footprints, satellite scenes</div><div class="sym-sub">Solid marks</div></div></li>
      <li><span class="sym-tile sm"><Sym shape="ward" c="heat-3" kind="modelled" size={20} /></span><div><div class="sym-hd"><b>Modelled</b> · the heat field on the map</div><div class="sym-sub">Outlined marks</div></div></li>
    </ul></div></details>
</article>
