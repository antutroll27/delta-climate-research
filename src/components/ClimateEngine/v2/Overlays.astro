---
// src/components/ClimateEngine/v2/Overlays.astro — OBOS v2 spec §3.10
import Sym from './Sym.astro';
import type { ResolvedScope } from '../../../scripts/climate-engine/scope/resolve.ts';
import { SENTINEL_CREDIT } from '../../../scripts/climate-engine/v2/credits.ts';
interface Props { scope: ResolvedScope }
const { scope } = Astro.props;
/* S2 audit F1: the chip lists only sources that area really draws. A DataMeet ward boundary exists only on the areas that ship one,
   and the app writes its credit (with the licence link) into MapLibre's control, which the credits popover mirrors; an area with no
   map says only "Credits". */
const chipLead = scope.area.hasData ? '© OpenStreetMap · OpenMapTiles · OpenFreeMap · Overture · ' : '';
---
<div class="key-pop card" id="v2Key" role="dialog" aria-label="How to read the marks" tabindex="-1" data-open="false" data-hud>
  <div class="row"><h2 class="name-xl"><b>How</b><span> to read the marks</span></h2><button class="sp-close" type="button" data-pop-close aria-label="Close the key">×</button></div>
  <div class="key-cols">
    <div><h3>Colour<span> · what is measured</span></h3><ul>
      <li><span class="ramp" style="width:44px;height:8px"></span><span><b>Heat ramp</b> · temperature only</span></li>
      <li><span class="aq-dots"><Sym shape="disc" c="aq-good" size={9} /><Sym shape="disc" c="aq-satisfactory" size={9} /><Sym shape="disc" c="aq-moderate" size={9} /><Sym shape="disc" c="aq-poor" size={9} /><Sym shape="disc" c="aq-very-poor" size={9} /><Sym shape="disc" c="aq-severe" size={9} /></span><span><b>India AQI bands</b> · air quality (CPCB's own colours)</span></li>
      <li><Sym shape="disc" c="solar" size={14} /><span><b>Straw</b> · sunlight, rooftop PV</span></li>
      <li><Sym shape="disc" c="water" size={14} /><span><b>Blue</b> · water, rain, humidity</span></li>
      <li><Sym shape="disc" c="green" size={14} /><span><b>Green</b> · trees, green cover</span></li>
      <li><Sym shape="disc" c="ink" size={14} /><span><b>Ink</b> · buildings, people, money</span></li></ul></div>
    <div><h3>Shape<span> · what kind of place</span></h3><ul>
      <li><Sym shape="disc" c="ink" size={14} /><span><b>Disc</b> · a point site: station, airport</span></li>
      <li><Sym shape="square" c="ink" size={14} /><span><b>Square</b> · a roof, a building</span></li>
      <li><Sym shape="quarter" c="ink" size={14} /><span><b>Quarter</b> · canopy, park</span></li>
      <li><Sym shape="bowl" c="ink" size={14} /><span><b>Bowl</b> · water, low ground</span></li>
      <li><Sym shape="bar" c="ink" size={14} /><span><b>Bar</b> · a street</span></li>
      <li><Sym shape="dome" c="ink" size={14} /><span><b>Dome</b> · a reference to compare with</span></li>
      <li><Sym shape="ward" c="ink" size={14} /><span><b>Tile</b> · the ward as a whole</span></li></ul></div>
    <div><h3>Fill<span> · how we know</span></h3><ul>
      <li><Sym shape="disc" c="ink" size={14} /><span><b>Solid</b> · measured or observed (CPCB monitor, METAR, satellite, survey)</span></li>
      <li><Sym shape="disc" c="ink" kind="modelled" size={14} /><span><b>Outlined</b> · modelled or estimated (the heat field, PV yield, scenarios)</span></li>
      <li><span class="kind measured">observed</span></li><li><span class="kind modelled">modelled</span></li></ul>
      <p class="foot">Red and orange belong to the heat ramp, and to India's AQI bands where an AQI band is shown.</p></div>
  </div>
</div>

<div class="st-attrib" data-hud><button class="attrib" type="button" data-pop-open="credits" aria-expanded="false" aria-controls="v2Credits">{chipLead && <span class="at-lead">{chipLead}</span>}Credits</button></div>
<div class="credits-pop card" id="v2Credits" role="dialog" aria-label="Data and credits" tabindex="-1" data-open="false" data-hud>
  <div class="row"><span class="micro">Data and credits</span><button class="sp-close" type="button" data-pop-close aria-label="Close credits">×</button></div>
  <ul>
    {scope.area.hasData ? (<Fragment>
      <li>Basemap © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> · <a href="https://openfreemap.org" target="_blank" rel="noopener noreferrer">OpenFreeMap</a> · <a href="https://www.openmaptiles.org/" target="_blank" rel="noopener noreferrer">© OpenMapTiles</a><small>ODbL</small></li>
      <li>Footprints © <a href="https://overturemaps.org" target="_blank" rel="noopener noreferrer">Overture Maps Foundation</a><small>ODbL</small></li>
      <li>Heights Google Open Buildings 2.5D<small><a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></small></li>
      <li>Water © OpenStreetMap<small>ODbL</small></li>
      <li>Surface vegetation and albedo · {SENTINEL_CREDIT.lead}<small><a href={SENTINEL_CREDIT.url ?? undefined} target="_blank" rel="noopener noreferrer">{SENTINEL_CREDIT.licence}</a></small></li>
      <li>Ground SRTM via AWS terrain tiles, <span id="terrLab">indicative</span></li>
      <li>Live weather © Met Norway<small><a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></small></li>
      <li><span id="attrWard" hidden></span></li>
      <li data-v2-map-attrib hidden></li>
      <li>Cloud deck drawn at 320 m, real base ~700 m</li>
      <li data-v2-street-credit hidden>Street imagery · <a href="https://www.mapillary.com" target="_blank" rel="noopener noreferrer">Mapillary</a> · community-captured<small>CC BY-SA</small></li>
      <li class="foot">left-drag orbit · right-drag pan · scroll zoom</li>
    </Fragment>) : (<li>Nothing is mapped for this area yet.</li>)}
  </ul>
</div>

<p class="flash glass" data-v2-flash role="status" aria-live="polite"></p>

{/* S8.1 Step 4: the phone entry note and the rotate nudge, v1's words exactly (stage :180-200), driven by phone-console.ts unchanged
    (it finds them by id and by [data-entry-close] / [data-rn-dismiss]). Hidden attribute = off; shown only on touch screens, once per session. */}
<div class="entry" id="entryNote" hidden role="dialog" aria-modal="true" aria-labelledby="entry-h">
  <div class="entry-card card">
    <p class="entry-k micro">OBOS · Urban heat instrument</p>
    <h2 class="entry-h name-xl" id="entry-h">Best on a <span class="thin">bigger screen</span></h2>
    <p class="entry-b body-s">This is a full console — a live 3-D city, a heat field and its
      error bars. It works on a phone, but a laptop, desktop or tablet is where you
      can actually read it.</p>
    <p class="entry-b entry-b-sm body-s">On a phone, turn it sideways for the full width.</p>
    <button class="entry-go pill" type="button" data-entry-close>Continue anyway</button>
  </div>
</div>
<div class="rotate-nudge rnudge toast" id="rotateNudge" hidden>
  <span class="rn-ico" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="2.5" width="10.5" height="19" rx="2"/><path d="M17.5 9.5a6 6 0 0 1 0 5"/><path d="M19.6 8l.4 2.2-2.2.3"/>
    </svg>
  </span>
  <span class="rn-txt">Turn your phone for the full instrument</span>
  <button class="rn-x" type="button" data-rn-dismiss aria-label="Dismiss">✕</button>
</div>
