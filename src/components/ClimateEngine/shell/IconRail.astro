---
/**
 * THE ICON RAIL — the console's only navigation.
 *
 * OBOS is an ops console rather than a map with panels floating over it, and this
 * 56px column is the whole of its navigation. Explore and Compare used to be tabs
 * in the stage header; they are now two of the five places the rail can take you.
 * Everything that used to be a second navigation is gone, because one navigation
 * is easier to learn than two.
 *
 * THE RAIL CARRIES THE MODE, AND THE VERBS ARE MIXED ON PURPOSE:
 *
 *   Map        the Explore route, and the toolbox pane once you are on it
 *   Layers     swaps the sidebar pane
 *   Analysis   navigates to /heat-map/compare/     (was the Compare tab)
 *   Reports    swaps the sidebar pane
 *   Scenarios  swaps the sidebar pane
 *
 * Two of the five change the URL and four of them change what the sidebar shows.
 * Every ops console works this way, and the alternative — a rail for routes and a
 * second control for panes — is the two-navigations problem again.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * TWO PROPS, BECAUSE THERE ARE TWO QUESTIONS. `route` is WHICH PAGE THIS IS;
 * `pane` is WHICH SIDEBAR BODY IS SHOWING. The first version of this component
 * conflated them into one `active`, and flagged the consequence itself: with
 * `active="layers"` on the Explore route, Map still rendered as an `<a>` pointing
 * at the URL the reader was already standing on — the self-link spec 1 removed,
 * reintroduced by the act of opening a pane.
 *
 * Split, the rule is simple and holds in every combination: A SECTION IS A LINK
 * ONLY WHEN IT NAVIGATES SOMEWHERE ELSE. The section whose id equals `route` has
 * its href taken away by `items` below, so no arm of the template can render it as
 * an anchor, whatever pane happens to be open.
 *
 * The two facts are then stated separately in the output, because they ARE
 * separate: `aria-current="page"` on the route (a fact about the document) and
 * `aria-pressed` on the pane sections (a fact about the sidebar). A screen reader
 * hears both, without either having to stand in for the other.
 *
 * `pane` LIVES IN MEMORY, NOT IN THE URL. The switcher in
 * scripts/climate-engine/shell/console-shell.ts owns that decision and writes down
 * why; this prop is only the state the SERVER renders first.
 *
 * ONE BRAND, ONE PLACE. The mark at the top is the link home. The stage's top bar
 * used to carry a second one directly to its right — composed, that was two brands
 * eight pixels apart, both going to `/`. The top bar kept the breadcrumb and the
 * readout; the mark moved here, where the navigation already is.
 *
 * NO SETTINGS CONTROL. The first version shipped one, inert, and said so. Nothing
 * exists for it to open, and a control that does nothing is the defect this project
 * has repeatedly deleted — so it is deleted rather than wired to a panel that would
 * have had to be invented to justify it.
 *
 * The icons are the founder-approved set from the shell mockup, path data copied
 * verbatim.
 */
import { DEFAULT_AREA_PATH } from '../../../scripts/climate-engine/scope/paths.ts';

/** The five places the rail can be. Exported for callers to name one. */
export type RailSection = 'map' | 'layers' | 'analysis' | 'reports' | 'scenarios';

interface Props {
  /**
   * The section the page IS. The one that renders as a button rather than as a
   * link to itself, and the one that carries `aria-current="page"`.
   */
  route: RailSection;
  /**
   * The sidebar body showing right now. Independent of `route`: you can stand on
   * Explore with the Layers pane open, which is the case the single-prop version
   * could not express without lying about one of the two.
   */
  pane: RailSection;
  /**
   * Where Map goes. The page knows its own area; the rail does not, and guessing
   * would put a second copy of the default area URL in a second file.
   */
  explorePath?: string;
}

const { route, pane, explorePath = DEFAULT_AREA_PATH } = Astro.props;

/** The compare route, written once. `paths.ts` owns the per-area URLs, not this. */
const COMPARE_PATH = '/heat-map/compare/';

/**
 * One rail glyph: an optional circle plus a path, both drawn on a 24-unit box.
 *
 * Structured rather than a blob of markup passed to `set:html`, because Astro's
 * scoping hash only lands on elements Astro itself renders — an `<svg>` injected
 * as raw HTML would silently miss `.rail-btn svg` and lose its stroke.
 */
interface Icon {
  readonly circle?: readonly [cx: number, cy: number, r: number];
  readonly d: string;
}

interface Section {
  readonly id: RailSection;
  readonly label: string;
  /** where it navigates, or null when it navigates nowhere */
  readonly href: string | null;
  /** whether it owns a sidebar body */
  readonly pane: boolean;
  readonly icon: Icon;
}

/* TWO FIELDS, AND THEY ARE NOT ONE OPINION WRITTEN TWICE. The first version
   carried only `href`, with `href: null` doing double duty as "this one swaps a
   pane" — which was true only while no section did both. Map does both: it is the
   Explore ROUTE from anywhere else, and the toolbox PANE once you are standing on
   it. So the two facts are declared separately, and Analysis — which navigates and
   owns no sidebar body — is the entry that proves they vary independently. */
const SECTIONS: readonly Section[] = [
  { id: 'map', label: 'Map', href: explorePath, pane: true, icon: {
    d: 'M9 3 3 6v15l6-3 6 3 6-3V3l-6 3-6-3zM9 3v15M15 6v15' } },
  { id: 'layers', label: 'Layers', href: null, pane: true, icon: {
    d: 'M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5' } },
  { id: 'analysis', label: 'Analysis', href: COMPARE_PATH, pane: false, icon: {
    d: 'M3 3v18h18M7 15l4-5 3 3 5-7' } },
  { id: 'reports', label: 'Reports', href: null, pane: true, icon: {
    d: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h6' } },
  { id: 'scenarios', label: 'Scenarios', href: null, pane: true, icon: {
    circle: [12, 12, 9], d: 'M12 8v4l3 2' } },
];

/* THE ONE LINE THAT MAKES THE CURRENT ROUTE A BUTTON. Taking the href away is what
   removes the self-link, and it removes it for every section at once rather than
   leaving each one to remember. The template then only has to ask whether a
   section has somewhere to go — and because this reads `route` and never `pane`,
   opening a pane cannot put the self-link back. */
const items = SECTIONS.map((s) => {
  const current = s.id === route;
  return {
    ...s,
    current,
    /* `undefined`, not `false`, on a section that owns no pane: `aria-pressed`
       announces a toggle, and Analysis is not one. Astro drops the attribute
       entirely when the value is undefined — and the shell script reads the
       ATTRIBUTE back to learn which sections have panes, so its absence is the
       fact rather than a spelling of "off". The literals are spelled out because
       `aria-pressed` is a string enum, not a boolean attribute: `String(x)` is
       the same two words with the type thrown away. */
    pressed: s.pane ? (s.id === pane ? 'true' as const : 'false' as const) : undefined,
    href: current ? null : s.href,
  };
});
---
<nav class="rail" aria-label="OBOS sections">
  {/* THE ONE BRAND ON THE PAGE, and the way out of the console. `aria-label`
      rather than `title`: title is not a reliable accessible name — ignored by
      some screen readers, never surfaced on touch — and the two letters are a
      mark, not a sentence anyone can act on. */}
  <a class="mark" href="/" aria-label="Delta Climate Research home"><span aria-hidden="true">OB</span></a>

  {items.map((s) => s.href === null ? (
    <button
      type="button"
      class="rail-btn"
      data-rail={s.id}
      aria-current={s.current ? 'page' : undefined}
      aria-pressed={s.pressed}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {s.icon.circle && <circle cx={s.icon.circle[0]} cy={s.icon.circle[1]} r={s.icon.circle[2]} />}
        <path d={s.icon.d} />
      </svg>
      <span class="rail-label">{s.label}</span>
    </button>
  ) : (
    <a class="rail-btn" data-rail={s.id} href={s.href}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {s.icon.circle && <circle cx={s.icon.circle[0]} cy={s.icon.circle[1]} r={s.icon.circle[2]} />}
        <path d={s.icon.d} />
      </svg>
      <span class="rail-label">{s.label}</span>
    </a>
  ))}
</nav>

<style>
  /* SCOPED, NOT is:global. The stage's own block is global for a reason that does
     not extend here: MapLibre injects DOM the stage never rendered and
     heat-map-app.ts re-classes elements at runtime, so Astro's scoping hash cannot
     reach them. Every element in this file is Astro-rendered and static, the hash
     reaches all of it, and the global surface shrinks rather than grows.

     Colours are var() throughout. Task 2's guard fails the build on any hex
     written more than once in a file — comments included — so the two below are
     the mark's own gradient stop and its inked lettering, each written once and
     nowhere else. --rail-ground is declared beside the rest of the palette in
     HeatMapStage.astro, which is where the tokens live. */

  .rail {
    inline-size: var(--rail, 56px);
    background: var(--rail-ground);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 0;
  }

  .mark {
    inline-size: 30px;
    block-size: 30px;
    flex: none;
    margin-bottom: 14px;
    border-radius: 7px;
    background: linear-gradient(145deg, var(--cyan), #2b7d88);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: .72rem;
    font-weight: 700;
    color: #04191b;
    text-decoration: none;
    transition: transform .18s;
  }

  .mark:hover { transform: scale(1.06); }
  .mark:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }

  /* One class for both arms: a link and a button that look identical, because
     which one you get is a fact about where you already are, not a difference the
     eye should have to resolve. */
  .rail-btn {
    inline-size: 38px;
    block-size: 38px;
    flex: none;
    position: relative;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    padding: 0;
    background: none;
    color: var(--faint);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color .18s, background .18s;
  }

  .rail-btn svg {
    inline-size: 19px;
    block-size: 19px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rail-btn:hover { color: var(--ink); background: rgb(111 202 214 / .06); }

  /* A rail you cannot see focus on is unusable by keyboard, and this is the only
     navigation there is. */
  .rail-btn:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
    color: var(--ink);
  }

  /* TWO STATES, TWO WEIGHTS, because they are two different facts and the reader
     has to be able to tell them apart. The OPEN PANE is the loud one — cyan and
     the accent bar — because it is what the sidebar is showing right now and what
     a second click will close. The CURRENT ROUTE is the quiet one: a page you are
     already on is worth stating and is not worth shouting, and on the Explore
     route with Layers open the two are different sections. */
  .rail-btn[aria-current="page"] { color: var(--paper); }
  .rail-btn[aria-pressed="true"] { color: var(--cyan); background: rgb(111 202 214 / .1); }

  /* The accent bar, flush against the rail's left edge — which is what the
     square-left, round-right radius is for. The offset is DERIVED: the button is
     centred in the rail, so its own left edge sits (rail − 38px) / 2 inwards, and
     50% − rail/2 is exactly that distance back out. The mockup's literal -12px was
     measured against different geometry and lands at −3px, off the rail entirely. */
  .rail-btn[aria-pressed="true"]::before {
    content: "";
    position: absolute;
    left: calc(50% - var(--rail, 56px) / 2);
    top: 9px;
    bottom: 9px;
    inline-size: 2px;
    border-radius: 0 2px 2px 0;
    background: var(--cyan);
  }

  /* THE LABEL IS THE ACCESSIBLE NAME AND THE TOOLTIP, one span doing both jobs.
     An icon on its own announces nothing, and `title` is not a reliable
     accessible name — it is ignored outright by some screen readers and never
     surfaces on touch. A hidden label beside a separate tooltip would be two
     copies of one word, free to drift; this is one. `opacity: 0` hides it from
     the eye while leaving it in the accessibility tree, which is exactly the
     split we want — unlike `display: none` or `visibility: hidden`, which would
     take the name away with the pixels. */
  .rail-label {
    position: absolute;
    left: 46px;
    z-index: 40;
    white-space: nowrap;
    padding: 3px 8px;
    border: 1px solid rgb(111 202 214 / .3);
    border-radius: 5px;
    background: var(--surface2);
    color: var(--paper);
    font-size: .74rem;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-4px);
    transition: opacity .15s, transform .15s;
  }

  /* Keyboard focus reveals it too, or the tooltip would be mouse-only. */
  .rail-btn:hover .rail-label,
  .rail-btn:focus-visible .rail-label { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .mark,
    .rail-btn,
    .rail-label { transition: none; }
  }
</style>
