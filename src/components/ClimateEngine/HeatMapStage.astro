---
// Full-bleed instrument markup for one AREA of /heat-map. Behaviour is mounted by
// src/scripts/climate-engine/heat-map-app.ts (booted from the page). Styles are
// is:global but only bundled onto the heat-map routes (the sole pages importing
// this). Brand tokens are scoped to .stage so nothing leaks to :root; Mona Sans /
// Noplato Mono come from global.css.
import ConstructionStamp from '../states/ConstructionStamp.astro';
/* THE FOUR SHELL COMPONENTS, COMPOSED. Until this task each was imported by
   nothing: the rail, the scope switcher and the layer tree were built and proven
   against their own sources, and the toolbox had been moved out of this file with
   its seventeen runtime-queried ids intact. Here they become one console — a rail,
   a sidebar of panes, and a main column that keeps its top bar, its map and its
   ward strip. The toolbox's rules stay in the is:global block below because
   heat-map-app.ts classes its markup at runtime; see its own header. */
import IconRail from './shell/IconRail.astro';
import ScopeSwitcher from './shell/ScopeSwitcher.astro';
import PanelToggle from './shell/PanelToggle.astro';
import LayerTree from './shell/LayerTree.astro';
import InterventionPane from './shell/InterventionPane.astro';
import { areaKeysInCity } from '../../scripts/climate-engine/scope/registry.ts';
import { areaPath, DEFAULT_AREA_PATH } from '../../scripts/climate-engine/scope/paths.ts';
import { resolve, type ResolvedScope } from '../../scripts/climate-engine/scope/resolve.ts';
import { wardById } from '../../data/wards.ts';

/**
 * THE PAGE TELLS THE INSTRUMENT WHICH AREA IT IS, rather than both assuming.
 *
 * Until the URL carried the area, this file hardcoded Ballygunge's coordinate and
 * three literal `data-w` divs, and heat-map-app.ts separately hardcoded
 * `INITIAL_AREA`. Two places holding one opinion, agreeing only by hand — which is
 * the shape of every defect the scope migration exists to end. The one that had
 * already happened is recorded in tests/unit/standards-ward-record.test.mjs: the
 * download link's static href and the app's boot ward were pinned to each other by
 * a REGEX OVER BOTH SOURCE FILES, because nothing structural made them agree.
 *
 * Now the scope arrives once, from the route, and everything on the page — the
 * readout, the name, the scope switcher, the strip, the record link, the
 * `data-area` the app boots from — is derived from it. The regex has nothing left
 * to compare, because there is only one copy.
 */
interface Props {
  scope: ResolvedScope;
}

const { scope } = Astro.props;

/* The sibling areas, from the registry, IN THE SAME CITY. `AREA_KEYS` would put
   Al Quoz in Kolkata's ward strip: two cities, two climates, two currencies, and
   the second half shipping no artefacts at all. */
const siblings = areaKeysInCity(scope.key).map(resolve);

/** This page's own URL — so the Explore link points here rather than at a redirect. */
const here = areaPath(scope.key);

/**
 * Whether this BUILD has a Mapillary token, passed to the layer tree as its one
 * capability.
 *
 * READ HERE AND NOWHERE ELSE ON THE PAGE. `scope/layers.ts` takes capabilities as
 * a parameter precisely so the tree can be rendered in both states, and the
 * component's own header says why it must not read `import.meta.env` itself. This
 * is the single site that turns a build fact into that parameter, and it spells
 * the variable exactly as heat-map-app.ts does — the whole street-level feature
 * tree-shakes out when it is unset, so a row offered here against a token the
 * instrument does not have would be a control that could never do anything.
 */
const mapillary = ((import.meta.env.PUBLIC_MAPILLARY_TOKEN as string | undefined) ?? '') !== '';

/* The ward-table row, where one exists. Coordinate and the <em>-stressed wordmark
   live there and nowhere else; an area that is not in the table (Dubai's three,
   which are our own tiling rather than municipal units) has neither, and gets the
   registry's plain name and an em-dash instead of an invented coordinate. */
const ward = wardById(scope.area.id);

/**
 * The strip swatch, DERIVED from the ward table's baseline vegetation fraction.
 *
 * Three radial-gradient strings used to be pasted here, one per ward. They were
 * never arbitrary — they encode how green the ward is, which is the one thing the
 * strip is comparing — so they are computed from `veg` rather than kept as a fourth
 * per-ward table for someone to update in one place and not the other. It renders
 * the same three swatches it replaced: 0.12 → red/bronze, 0.28 → orange/bronze,
 * 0.62 → sage/cyan, from the legend's own five classes.
 *
 * Every colour here is written as `var()` and not as a hex. This string lands in
 * an inline `style` on `.ward .sw`, which is inside `.stage` — where the tokens
 * are declared — so they resolve; a `var()` used outside that subtree would
 * resolve to nothing and drop the declaration silently.
 */
const swatch = (veg: number): string => {
  const head = veg >= 0.5 ? 'var(--sage)' : veg >= 0.2 ? 'var(--orange)' : 'var(--red)';
  const mid = veg >= 0.5 ? 'var(--cyan) 60%' : 'var(--bronze) 55%';
  return `background:radial-gradient(circle at 40% 40%,${head},${mid},var(--surface2))`;
};

/**
 * The ward strip's rows: the siblings that actually ship artefacts.
 *
 * Built here rather than in the template so the ward-table lookup can be NARROWED
 * rather than asserted. `wardById` returns `Ward | undefined` and an inline `!`
 * would be a promise made to the compiler with nothing keeping it — registry check
 * 7 does in fact pin every data-shipping area to a ward row, but a `!` in the
 * markup would survive that check being weakened. `flatMap` drops a row that has
 * no ward instead, so the failure is a missing tile rather than a thrown render.
 *
 * The short label comes from the SAME descriptor the panel shows, cut at its first
 * separator: "Urban Core · Ward 68" → "Urban Core". The strip has room for the kind
 * and not the number, which is a layout fact, not a second name for the place.
 */
const strip = siblings.flatMap((sib) => {
  const row = wardById(sib.area.id);
  if (row === undefined || !sib.area.hasData) return [];
  return [{
    key: sib.key,
    id: sib.area.id,
    name: sib.area.name,
    kind: sib.area.descriptor.split(' · ')[0],
    swatch: swatch(row.veg),
  }];
});

/* The ward's own data record. `/api/wards/[id]` is generated one route per BARE id
   from src/data/wards.ts, so the key would 404 — and this link is a download, so
   the browser would save the 404 body under a plausible filename rather than show
   it. heat-map-app.ts's `updateReportHref` rebuilds this identically on every area
   switch; the two agree because both read the area id, not because anyone matched
   two strings by eye. */
const reportHref = `/api/wards/${scope.area.id}/metadata.json`;
---
{/* `data-console` is how shell/console-shell.ts finds a page with a rail and
    panes on it. It is deliberately NOT `.stage`: Compare has a console too and
    is not a stage, and keying the pane switcher on the stage is what left the
    compare route's rail buttons inert. `data-area` stays the stage's own — it
    is the scope half's subject, and Compare has no single area to declare. */}
<main id="main" class="stage" data-console data-area={scope.key}>
  {/* THE RAIL IS THE ONLY NAVIGATION. It replaces the Explore/Compare pair that
      used to sit in the top bar beside a second brand link, and it carries the
      page's one brand mark home. `route` and `pane` are two different questions —
      which page this is, and which sidebar body is showing — and the rail's own
      header explains why conflating them put a self-link back on the page. The
      pane rendered open here is the state the shell script reads back as its
      starting point; it is never restated in script. */}
  {/* PHONE FURNITURE. Both are inert above the phone breakpoints — the CSS at the
      foot of this file is the only thing that gives them a box.

      THE NUDGE IS A NUDGE, NOT A GATE. It suggests rotating and can be dismissed,
      because screen.orientation.lock() needs fullscreen and iOS Safari does not
      implement it at all — a true lock is not available on the platform most of
      this traffic arrives on. A gate would strand anyone with rotation locked. */}
  {/* THE ENTRY NOTE. First thing a small screen sees, and easy to leave: the
      console is a desktop instrument and saying so once is kinder than letting
      someone conclude it is broken. Shown once per session, on touch screens only
      — a desktop never sees it. Dismissed by the button, the backdrop, or Escape. */}
  <div class="entry" id="entryNote" hidden role="dialog" aria-modal="true" aria-labelledby="entry-h">
    <div class="entry-card">
      <p class="entry-k">OBOS · Urban heat instrument</p>
      <h2 class="entry-h" id="entry-h">Best on a <em>bigger screen</em></h2>
      <p class="entry-b">This is a full console — a live 3-D city, a heat field and its
        error bars. It works on a phone, but a laptop, desktop or tablet is where you
        can actually read it.</p>
      <p class="entry-b entry-b-sm">On a phone, turn it sideways for the full width.</p>
      <button class="entry-go" type="button" data-entry-close>Continue anyway</button>
    </div>
  </div>

  <div class="rotate-nudge" id="rotateNudge" hidden>
    <span class="rn-ico" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="2.5" width="10.5" height="19" rx="2"/><path d="M17.5 9.5a6 6 0 0 1 0 5"/><path d="M19.6 8l.4 2.2-2.2.3"/>
      </svg>
    </span>
    <span class="rn-txt">Turn your phone for the full instrument</span>
    <button class="rn-x" type="button" data-rn-dismiss aria-label="Dismiss">✕</button>
  </div>
  {/* Tap-anywhere-else close for the landscape sheet. It drives the panel's own
      chevron rather than the panel, so one writer still owns the state. */}
  <button class="sheet-scrim" type="button" data-sheet-scrim tabindex="-1" aria-hidden="true"></button>

  <IconRail route="map" pane="map" explorePath={here} />

  <aside class="sidebar">
    {/* SCOPE SITS ABOVE THE PANES, not inside one of them, because it is global to
        all four: the toolbox, the layer tree, the reports and the scenarios are all
        answers ABOUT somewhere, and the somewhere is chosen once.

        THE PANEL'S CHEVRON RIDES ON ITS HEADING ROW, because that row is the top
        of this column and the reader is already looking at it. The switcher takes
        it as a slot and knows nothing about what it does; console-shell.ts binds
        it to the same state the rail's own click path collapses. */}
    <ScopeSwitcher current={scope.key}>
      <PanelToggle slot="head-control" />
    </ScopeSwitcher>

    <div class="panes">
      {/* Map's pane. The toolbox is what the Map section shows once you are already
          standing on the Explore route — the rail's Map entry navigates from
          anywhere else and swaps this in from here.

          GATED ON THE SAME FLAG AS THE MAP, and this is not symmetry for its own
          sake. The toolbox used to live INSIDE the data gate below, so an area
          with no artefacts never rendered it; the sidebar renders on every area
          page, and moving the toolbox here without the gate put three live
          sliders and a segmented control on the one page whose entire content is
          a statement that nothing can be computed for it. Nothing is mounted to
          hear them — the instrument boots only where `#mlmap` exists — so every
          drag would have moved a thumb, changed a number, and left the score
          reading "move a slider to intervene". */}
      <div class="pane is-on" data-pane="map">{scope.area.hasData
        ? <InterventionPane scope={scope} />
        : <section class="pane-body" aria-labelledby="pane-map-h">
            <p class="pane-h" id="pane-map-h">Interventions</p>
            <p class="pane-note">There is nothing to intervene in here. The toolbox plants
              canopy, raises albedo and greens facades over a MEASURED surface, and
              {' '}{scope.area.name} ships none — so a slider would move a number that stands
              for nothing.</p>
            <p class="pane-note">It comes back with the artefacts, unchanged: the model is not
              per-city, only the observations are.</p>
          </section>}</div>

      <div class="pane" data-pane="layers"><LayerTree current={scope.key} mapillary={mapillary} /></div>

      <div class="pane" data-pane="reports">
        <section class="pane-body" aria-labelledby="pane-reports-h">
          <p class="pane-h" id="pane-reports-h">Reports</p>
          {/* THE EXISTING RECORD LINK, MOVED HERE — not copied. It was the last
              thing in the evidence rail on the right; there is now one of it, in
              the pane named after it, and it keeps its id because
              `updateReportHref` rewrites that href on every area switch. A second
              copy left behind would be two elements with one id: invalid HTML, and
              `getElementById` hands back whichever the parser reached first, so
              the visible one would go on offering the ward the page opened at. */}
          {/* GATED, LIKE THE TOOLBOX, and for a sharper reason than layout.
              `/api/wards/[id]` is generated one route per row of src/data/wards.ts,
              and an area with no artefacts has no row — so on such a page this href
              names a route the build never emitted. It is a DOWNLOAD, so the
              browser would not show the 404: it would save the error body under
              `metadata.json` and hand someone a file that looks like a record. */}
          {scope.area.hasData ? (
          <Fragment>
          <p class="pane-note">What is measured, the out-of-sample error and sample size, every
            source dataset with its licence, and the analysis CRS and bounding box.</p>
          <a class="cta" id="report-link" href={reportHref} download>Download ward record ↓</a>
          </Fragment>
          ) : (
          <p class="pane-note">No record ships for {scope.area.name}. The ward record states what
            was measured, with what error, from which datasets — and there is no measurement here
            to state.</p>
          )}
        </section>
      </div>

      <div class="pane" data-pane="scenarios">
        <section class="pane-body" aria-labelledby="pane-scenarios-h">
          <p class="pane-h" id="pane-scenarios-h">Scenarios</p>
          {/* NOT BUILT, SAID PLAINLY. An empty box under a heading reads as a pane
              that failed to load, which is the one impression this console must
              never give; naming the file the model already lives in is what makes
              this a status rather than an apology. The toolbox next door runs ONE
              scenario at a time and throws its result away — saving, naming and
              comparing them is the thing that does not exist yet. */}
          <p class="pane-note">Not built yet. The toolbox under Map runs one scenario at a time
            and keeps none of them: there is nowhere to save an intervention set, name it, or
            put two of them side by side.</p>
          <p class="pane-note">The scoring model it would draw on is already here —
            <code>src/scripts/climate-engine/dc-urs-scenario.ts</code> — which is why this pane
            says so instead of rendering an empty panel.</p>
        </section>
      </div>
    </div>
  </aside>

  <div class="col">
  <header class="top">
    {/* BREADCRUMB, NOT NAVIGATION. Every part of it is a place you are, and none of
        the three is somewhere you can go: there is no country page and no city
        page, and the scope switcher two columns left is the control that moves you.
        So it is a statement rather than a <nav> of links that would have to invent
        destinations to justify its shape.

        THE AREA CELL CARRIES AN ID BECAUSE IT HAS TO FOLLOW THE WARD. This is
        server-rendered once, and an in-place switch reloads nothing — so without a
        writer it went on naming the ward the page was opened at while `#pname`,
        about two hundred pixels to the right, named the one actually loaded. The
        country and city cells need no id: `console-shell.ts` navigates rather than
        switching in place whenever a selection would cross either, so neither can
        change without a page load. */}
    <p class="crumb"><span>{scope.country.name}</span><span>{scope.city.name}</span><b id="crumbArea">{scope.area.name}</b></p>
    {/* THE READOUT IS GATED, and it is the subtlest half-render on the page.
        `#bcount` and `#simBackend` are written by the instrument; their static values
        are the states it starts in. Left standing where no instrument mounts, an area
        with no artefacts would sit for ever under "— buildings · SELECTING ENGINE" —
        which does not read as "nothing ships here", it reads as still loading, and
        that is the one impression this page must not give. So it says what is true
        instead: no artefacts, and the tier that follows from that. */}
    {/* TWO BLOCKS, SET APART, BECAUSE THEY ANSWER DIFFERENT QUESTIONS.
        `.rig` is what the instrument is running on RIGHT NOW — a count that moves
        with the area and an engine name that changes once the GPU is picked. The
        `.read` beside it is what the page IS, and barely changes at all. Run
        together on one line they read as a single sentence, and the live half
        disappears into the static half. A gap is the cheapest thing that says
        these are two readings rather than one.

        The COORDINATE keeps its own line and its bold: it is the only value here
        a reader might copy, and mid-sentence it would be furniture. */}
    <div class="topmeta">
      <div class="rig">{scope.area.hasData
        ? <Fragment><span id="bcount">— buildings</span> · <span id="simBackend" aria-live="polite">SELECTING ENGINE</span></Fragment>
        : <span>no artefacts · {scope.tier} tier</span>}</div>
      <div class="read">MEDNI · HEAT INSTRUMENT<br><b id="coord">{ward?.coord ?? '—'}</b></div>
    </div>
  </header>

  {/* THE DATA GATE, AND IT IS A GATE RATHER THAN A SET OF EMPTY PANELS.
      An area the registry says ships no artefacts has nothing for the model to run
      over. The tempting shape — render the instrument anyway and let it show em-
      dashes — is the exact silent degradation scope/paths.ts was written against: a
      map with no buildings, a legend with no ramp and a resilience score reading
      "unavailable" is indistinguishable at a glance from a city that simply has not
      finished loading, and the only evidence is a console nobody has open.

      Omitting `#mlmap` is also what stops the instrument booting: the page's boot
      script returns early without it, and mountHeatMap centres a MapLibre map on
      `wardOf(area)` BEFORE any of loadWard's refusals can run — an area with no
      ward row has no coordinates, so it would fly to NaN and leave a dead canvas
      under a spinner that never clears. */}
  {scope.area.hasData ? (
  <Fragment>
  <div class="map">
    <div id="mlmap"></div>
    <div class="synthetic"><span class="d"></span><span class="full">Live basemap + real footprints &amp; Google heights · </span>heat field modelled<span class="sp"> · block detail illustrative</span></div>
    <div class="stamp-slot"><ConstructionStamp /></div>
    <div class="loadchip" id="loadchip">Building ward…</div>

    <!-- North reference. The idle orbit turns the map continuously, so without
         this there is no way to know which way you are facing, and no way back. -->
    <!-- Sun reading. A SIBLING of the compass, never a child: the compass is a
         button whose whole box resets the bearing, and text inside it would become
         part of that click target. Always visible rather than a hover tooltip, so
         it works on touch and so the caveat cannot hide. -->
    <p class="sunline" id="sunLine" hidden>
      <span id="sunLineText"></span>
      <span class="sunline-note" id="sunLineNote" tabindex="0" role="note">geometry only</span>
    </p>
    <button class="compass" id="compass" type="button" title="Face north" aria-label="Reset the map to face north">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="21.2" class="c-ring" />
        <!-- Everything that should point at the world lives in this group, which
             JS rotates to the inverse of the map bearing. The N and S letters
             ride along but are counter-rotated by the same angle about their own
             anchors, so they travel to the right compass point while staying
             upright — a letter lying on its side is decoration, not a reading. -->
        <g id="compassDial">
          <path d="M24 9 L29 26 L24 22.6 L19 26 Z" class="c-n" />
          <path d="M24 39 L19 22 L24 25.4 L29 22 Z" class="c-s" />
          <circle cx="38.4" cy="24" r="1.15" class="c-tick" />
          <circle cx="9.6" cy="24" r="1.15" class="c-tick" />
          <text id="compassN" x="24" y="6.4" class="c-lab c-lab-n">N</text>
          <text id="compassS" x="24" y="45.2" class="c-lab">S</text>
          <!-- Sun bearing. Rides INSIDE the rotating dial, like N and S, because
               it is a world direction: turn the map and the sun must stay over
               the ground it is actually shining on. Hidden outright when the sun
               is below the horizon — a bearing at midnight is not a dim reading,
               it is a meaningless one. -->
          <g id="compassSun" class="c-sun is-below">
            <circle cx="24" cy="24" r="1" class="c-sun-hub" />
            <line x1="24" y1="24" x2="24" y2="13.2" class="c-sun-ray" />
            <circle cx="24" cy="11.4" r="3.1" class="c-sun-disc" />
          </g>
        </g>
      </svg>
    </button>

    <!-- Live-reading freshness.
         NOT A CLOCK FOR THE MAP. The simulation is steady-state at one of two
         representative phases; it has no 14:32. This dial describes the DATA —
         the hour met.no's reading is valid for, and how long ago that was — which
         matters because that reading sets the sim's boundary conditions and was,
         until now, fetched once per ward per session and never refreshed. A tab
         left open overnight showed a pulsing green "live" dot over yesterday's
         weather. Click to re-read. -->
    <!-- TWO CONTROLS, NOT ONE. The tile used to be a single button whose click
         forced a live re-read — and that click is the ONLY re-read in the app
         (fetchLive runs on ward load and from here; the 60s timer just
         repaints). Handing the whole tile to a format toggle would leave a dial
         that reports data is 14 hours stale and offers no way to fix it. So the
         face toggles the format and the age line re-reads, each saying which. -->
    <div class="clockw" id="clockw" hidden>
      <!-- Stacked state indicator, the Braun/Rams idiom: BOTH halves of the day
           are always present and only the emphasis moves, so you read "PM out of
           AM/PM" rather than trusting a single changing label.

           The day above them is not decoration. These digits are the WARD's
           clock, not the viewer's — from London at 18:30 GMT this reads 00:00,
           and nothing said it was already tomorrow in Kolkata. This dial exists
           because a tab left open overnight showed a live dot over yesterday's
           weather; without the day it still could not name which day. -->
      <button class="k-face" id="clockFace" type="button" aria-pressed="false">
        <span class="k-stack" aria-hidden="true">
          <span class="k-day" id="clockDay">—</span>
          <!-- In 24-hour mode the meridiem is meaningless, so the pair is
               replaced by the mode itself rather than left dimmed and lying. -->
          <span class="k-mer" id="clockAm">AM</span>
          <span class="k-mer" id="clockPm">PM</span>
          <span class="k-mer k-h24" id="clock24">24H</span>
        </span>
        <span class="k-time" id="clockTime">--:--</span>
      </button>
      <button class="k-age" id="clockAge" type="button">
        <span class="k-sub"><span class="k-age-lab" id="clockAgeLab">—</span></span>
        <!-- Freshness survives the move to digits as a draining rule along the
             bottom edge: the digits say WHEN, the bar says HOW STALE, and the bar
             is the only thing that animates (one transform, no layout). -->
        <span class="k-bar" aria-hidden="true"><i id="clockBar"></i></span>
      </button>
    </div>

    <!-- Vegetation toggle: distinct widget directly below the clock. Shown when the
         ward's rasters resolve -- NOT when the weather arrives, which is a
         different fetch that these controls do not depend on. Binary on/off in
         the .modechip idiom. -->
    <div class="vegw" id="vegw" hidden>
      <span class="veg-lab">Trees</span>
      <div class="modechip" id="vegchip" title="Show or hide the modelled tree canopy">
        <button class="on" data-v="1" type="button">On</button>
        <button data-v="0" type="button">Off</button>
      </div>
    </div>

    <!-- Street-view toggle: same widget idiom as Trees, stacked directly below it. -->
    <div class="vegw" id="svw" hidden>
      <span class="veg-lab">Street</span>
      <div class="modechip" id="streetchip" title="Show Mapillary street-level coverage; click a point for the real photo"><button class="on" data-s="0">Off</button><button data-s="1">On</button></div>
    </div>

    <!-- First-run affordance: the buildings became clickable and nothing said so. -->
    <div class="tiphint" id="tiphint" hidden>
      <span>Click any building for its data</span>
      <button type="button" id="tipX" aria-label="Dismiss hint">✕</button>
    </div>

    <!-- Walk-time ring labels. Text is STATIC: the app only toggles `hidden` and
         writes a transform, so nothing rewrites strings on every repaint.
         Two lines each — the headline is the human unit (minutes), the second
         line is the caveat, because a circle drawn on a map reads as "you can
         reach all of this" and a straight-line radius is not that. -->
    <!-- Ring labels are RULER MARKINGS, not findings: one quiet mono line, in
         the ring's own colour, sitting on the circumference like a contour
         label. The old data-chip styling promised a per-building measurement
         and delivered a constant — the reader who commissioned the rings
         misread them twice for exactly that reason. -->
    <div class="ringlab" id="ringNear" hidden>1 min · 80 m</div>
    <div class="ringlab" id="ringFar" hidden>5 min · 400 m</div>

    <!-- The finding: nearest greenery, the number that changes with every
         click. Data-chip anatomy (big value, small label) in the cooling
         green so it belongs to the patches it stands on. -->
    <!-- Two nodes on purpose: the OUTER one is written by the render loop every
         repaint (translate3d onto the cooling patch), the INNER one owns the
         pop-in. Animating one element with both would have the frame loop
         stamping over the animation's transform sixty times a second. Same
         split as .bcard / .bcard-in. -->
    <div class="cooltag" id="coolTag" hidden>
      <div class="cooltag-in" id="coolTagIn">
        <b id="coolTagM">—</b><span>Nearest greenery</span>
      </div>
    </div>

    <!-- Click-to-inspect. Positioned from the building's own ward-metre centroid
         every time MapLibre repaints, so it tracks orbit, pan, zoom and flyTo. -->
    <div class="bsel" id="bsel" hidden aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="bcard" id="bcard" hidden role="dialog" aria-label="Selected building">
      <span class="lead"></span>
      <div class="bcard-in">
        <div class="bc-h"><span>Building</span><span id="bcId">—</span></div>
        <dl>
          <dt>Coordinates</dt><dd id="bcLL">—</dd>
          <dt>Height</dt><dd id="bcH">—</dd>
          <dt>Floors ≈</dt><dd id="bcF">—</dd>
          <dt>Footprint</dt><dd id="bcA">—</dd>
          <dt>Vegetation</dt><dd id="bcV">—</dd>
          <dt>Albedo</dt><dd id="bcAl">—</dd>
          <dt>Surface</dt><dd id="bcT">—</dd>
        </dl>
        {/* ROOFTOP SOLAR — a screening estimate ABOUT the building, under the
            measured rows and in a different ink. Painted by paintSolarCard from
            the ward's solar file; hidden when none ships. "At least" is the
            strict-mask floor: the mask rule is the largest lever in the estimate,
            so the headline never prints without it (spec §2.4). */}
        <div class="bc-sol" id="bcSol" hidden>
          <div class="bc-h"><span>Rooftop solar</span><span>screening</span></div>
          <dl>
            <dt>Installable</dt><dd id="bcSolKwp" class="sun">—</dd>
            <dt>Yield</dt><dd id="bcSolKwh">—</dd>
            <dt>Shaded</dt><dd id="bcSolLoss">—</dd>
            <dt>At least</dt><dd id="bcSolFloor">—</dd>
            <dt>Raised 2 m</dt><dd id="bcSolRaised">—</dd>
            <dt>Worth</dt><dd id="bcSolRs">—</dd>
          </dl>
          <p class="bc-sol-note">Screening estimate · not bankable · canopy Meta/WRI CHM v2 · 0.5 m grid · NASA POWER irradiance</p>
        </div>
        <div class="sv-thumb" id="svThumb" hidden></div>
        <p class="bc-rings" id="bcRings"></p>
        <p class="bc-ins" id="bcIns"></p>
        <p class="bc-prov" id="bcSrc"></p>
        <button class="bc-x" id="bcX" type="button" aria-label="Close building details">Close ✕</button>
      </div>
    </div>

    <div class="place">
      {/* `ward.name` carries <em> around the syllable the wordmark stresses, which
          is why this is set:html where `scope.area.name` - markup-stripped, for
          titles and machine-readable fields - is not. */}
      <div class="n" id="pname" set:html={ward?.name ?? scope.area.name}></div>
      <div class="z" id="pzone">{scope.area.descriptor}</div>
    </div>
    <div class="chiprow">
      <div class="modechip" id="modechip"><button class="on" data-m="relief">3D Relief</button><button data-m="iso">2D Isotherm</button></div>
      <div class="modechip" id="envchip"><button class="on" data-e="dark">Dark map</button><button data-e="studio">Clay studio</button></div>
      <div class="modechip" id="tintchip" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><button class="on" data-t="1">Gradient</button><button data-t="2">5-Class</button></div>
    </div>

    {/* The toolbox WAS here, floating over the map's left edge. It is now the Map
        section's pane in the sidebar, mounted once, up in the console shell. */}

    <div class="rail-r">
    <aside class="panel right">
      <div class="metric livem">
        <div class="k">Live ambient · Met Norway <span class="livedot" id="livedot"></span></div>
        <div class="liverow">
          <div><b id="liveT">—</b><span>air °C</span></div>
          <div><b id="liveFeel">—</b><span>feels °C</span></div>
          <div><b id="liveRH">—</b><span>% RH</span></div>
          <div><b id="liveWind">—</b><span>m/s wind</span></div>
        </div>
      </div>
      <div class="metric">
        <div class="k">Mean surface temp · <span id="lstPhase">modelled now</span></div>
        <div class="lst" id="lst" style="color:var(--red)">—<span class="u">°C</span></div>
        <div class="conf" id="conf"></div>
      </div>
      <div class="mrow">
        <div><div class="k" title="Modelled land-cover thermal contrast: this ward's mean surface temperature minus a fully-vegetated reference cell under identical forcing. NOT a measured urban heat island — published Kolkata surface UHI is 0.85–1.5 °C from 1 km satellite data, a different quantity.">Δ vs all-green ref</div><div class="val" style="color:var(--cyan)" id="uhi">—</div></div>
        <div><div class="k">Area above 40 °C</div><div class="val" style="color:var(--red-ink)" id="area">—</div></div>
      </div>
      <div class="metric" style="border-top:1px solid var(--line);padding-bottom:0"><div class="k">Heat-stress distribution</div></div>
      <div class="histo" id="histo"></div>
      {/* ROOFTOP SOLAR, whole ward. Amber, not cyan: the heat above is CALIBRATED
          against ECOSTRESS; this is a SCREENING estimate, and the chip says so.
          Every number is the laboratory's (`totals`, `stratum` in the ward's solar
          file); the browser multiplies by the tariff and nothing else. Hidden when
          no screen ships for the area. */}
      <div class="metric sep solm" id="solm" hidden>
        <div class="k">Rooftop solar · installable, whole ward</div>
        <div class="lst sun" id="solKwp">—<span class="u">MWp</span></div>
        <div class="conf screening" id="solConf"></div>
      </div>
      <div class="mrow solm" id="solRows" hidden>
        <div><div class="k">Annual yield</div><div class="val" id="solKwh">—</div></div>
        <div><div class="k">Worth at tariff</div><div class="val sun" id="solRs">—</div></div>
        <div><div class="k">Roofs ≥ 3 kWp</div><div class="val" id="solBig">—</div></div>
        <div><div class="k">Losing ≥ 5 %, of those</div><div class="val sun" id="solSh">—</div></div>
      </div>
      <p class="solfloor" id="solFloor" hidden></p>
      {/* The ward record used to end this card. It is now the Reports pane's one
          piece of content — a download named after itself, in the section named
          after it, rather than a bronze button under a histogram. One element, one
          id; `updateReportHref` still finds it by name. */}
    </aside>

    <div class="legend">
      <div class="k" style="margin-bottom:.6rem"><span>What the colours mean</span></div>
      {/* `style` is an attribute whose CONTENT is CSS, unlike `stroke` above, so
          `var()` resolves here normally. These swatches are inside `.stage`, which
          is where the tokens are declared. */}
      <div class="cindex">
        <div class="ci"><span class="d" style="background:var(--red)"></span>Extreme</div>
        <div class="ci"><span class="d" style="background:var(--orange)"></span>Severe</div>
        <div class="ci"><span class="d" style="background:var(--bronze)"></span>Hot</div>
        <div class="ci"><span class="d" style="background:var(--sage)"></span>Warm</div>
        <div class="ci"><span class="d" style="background:var(--cyan)"></span>Comfortable</div>
      </div>
      <div class="k" style="margin:.9rem 0 .5rem"><span>Land Surface Temp</span><span>°C</span></div>
      <div class="ramp"></div>
      <!-- filled by syncRamp(): the scale moves with the weather, so hardcoded
           numbers here would contradict the colours above them. -->
      <div class="sc" id="rampSc"><span>26</span><span>32</span><span>37</span><span>42</span><span>48</span></div>
      <!-- Filled from accuracy.ts SPATIAL, never hardcoded here: the legend is
           where a reader goes to interpret the colours, so it is where the limit
           of what the colours mean belongs. -->
      <p class="pattern-note" id="patternNote"></p>
      <div class="attr">Basemap © OpenStreetMap · OpenFreeMap · Footprints © Overture Maps Foundation (ODbL) · Heights Google Open Buildings 2.5D (CC BY 4.0) · Water © OpenStreetMap (ODbL) · Ground SRTM via AWS terrain tiles, <span id="terrLab">indicative</span> · Live weather © Met Norway (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>) · Cloud deck drawn at 320 m, real base ~700 m · left-drag orbit · right-drag pan · scroll zoom</div>
      <button class="srcbtn" id="srcBtn" type="button" aria-expanded="false" aria-controls="srcPanel">Data receipts ↗</button>
      <div class="srcpanel" id="srcPanel" role="dialog" aria-label="Per-layer data provenance" hidden></div>
    </div>
    </div>
  </div>

  <!-- Street-view viewer: top-level (outside backdrop-filtered panels) so position:fixed resolves to the viewport. mapillary-js mounts into #svViewer. -->
  <div class="svmodal" id="svModal" hidden>
    <div class="svmodal-card">
      <button class="svmodal-x" id="svClose" type="button" aria-label="Close street view">✕</button>
      <div id="svViewer" class="svmodal-viewer"></div>
      <div class="svmodal-credit">Street imagery · <a href="https://www.mapillary.com" target="_blank" rel="noopener">Mapillary</a> · community-captured (CC BY-SA)</div>
    </div>
  </div>

  {/* The strip only ever lists areas that ship artefacts - it is a comparison of
      measured means, and a tile that can never carry a number is a row of em-dashes
      pretending to be a reading. `big-{id}` takes a BARE id because heat-map-app.ts
      writes into it by that name, from src/data/wards.ts. */}
  <div class="strip" id="strip">
    {strip.map((row) => (
      <div class:list={['ward', { on: row.key === scope.key }]} data-w={row.id}>
        <span class="sw" style={row.swatch}></span>
        <div><div class="nm">{row.name}</div><div class="ty">{row.kind}</div></div>
        <div class="big" id={`big-${row.id}`}>—<span>°C mean</span></div>
      </div>
    ))}
  </div>
  </Fragment>
  ) : (
  <section class="notyet" aria-labelledby="notyet-h">
    <p class="notyet-tier">{scope.tier} tier · {scope.city.koppen} climate</p>
    <h1 class="notyet-h" id="notyet-h">{scope.area.name}</h1>
    <p class="notyet-sub">{scope.area.descriptor} · {scope.city.name}, {scope.country.name}</p>
    {/* What is missing, stated, rather than a spinner or an apology. The gap between
        this tier and a validated one is the thing the twin is asking to be funded to
        close, so naming it is the page's whole content. */}
    <p class="notyet-body">
      This area is registered in the twin and has a permanent address, but no measured
      heat artefacts ship for it yet — no footprints, no surface temperature, no
      canopy. Nothing here would be a reading, so nothing is drawn. The instrument
      runs where the observations do.
    </p>
    <p class="notyet-links"><a href={DEFAULT_AREA_PATH}>Open a validated area →</a></p>
  </section>
  )}
  </div>
</main>

<style is:global>
  body{ overflow:hidden; }
  .stage{
    --base:#050606; --surface:#0b2c2e; --surface2:#093a3e;
    /* --faint IS LIGHTER THAN IT WAS, because the value it held missed the 4.5:1
       floor on every ground it was ever drawn on — measured from rendered pixels
       at 3.52–3.93:1 across thirteen nodes: the breadcrumb, "Location", the
       live-ambient units and the legend's scale numbers. It now clears 4.5:1
       against rgb(19,29,31), the lightest ground the panels can produce once
       --rail-ground is opaque enough to bound it, so it holds on every frame
       rather than on the one that happened to be sampled. It stays clearly below
       --ink, which is the whole job of the third ramp step. */
    --paper:#ecedf0; --ink:#8fa3a5; --faint:#6e8789; --line:rgb(111 202 214 / 0.14);
    /* The louder rule, for a line that has to be FOUND rather than merely felt: an
       unchecked checkbox in the layer tree, and the breadcrumb's separators.
       Declared here, with the rest of the palette, because a token resolves from
       where it is DECLARED — and until this task it was declared NOWHERE while
       shell/LayerTree.astro already painted with it. An undefined custom property
       does not fall back: `border: 1px solid var(--line-hi)` is invalid at
       computed-value time, so the whole shorthand unsets and every unchecked box in
       the tree had no border at all. Nothing failed; the boxes were simply
       invisible until ticked. */
    --line-hi:rgb(111 202 214 / 0.32);
    --cyan:#6fcad6; --bronze:#b08d57; --red:#e5484d;
    /* THE SAME RED, ONE STEP UP, FOR WHEN IT IS A WORD RATHER THAN A SWATCH.
       --red is the heat ramp's Extreme class and the compass's north needle —
       both areas of colour, which WCAG scores against a 3:1 non-text floor it
       clears comfortably. As 16.8px TEXT in the delta readout the floor is 4.5:1
       and the same value reads 4.39:1, missing by a fortieth. Lightening --red
       itself would restate the top of the heat legend in order to fix a number in
       a metric card; this leaves the ramp alone. */
    --red-ink:#eb4a4f;
    /* The confidence-tier green — the `validated` badge on the scope switcher,
       and nothing else. DELIBERATELY NOT --sage, which is the heat ramp's
       Comfortable class: one token serving both a heat class and a trust label
       means tuning the legend silently restates how much we trust a city. */
    --green:#5db98a;
    /* The legend's five heat classes, in order: Comfortable, Warm, Hot, Severe,
       Extreme. The first, third and fifth were already tokens; --sage and --orange
       complete the ramp instead of being spelled by hand in three places each. */
    --sage:#9fb98a; --orange:#d46b4a;
    /* The compass sun: one colour across its disc, ray and hub. */
    --sun:#f2b544;
    /* THREE OF THE LAYER TREE'S SIX DOTS. The other three are --red, --green and
       --ink, which the palette already held; these are the colours the founder's
       mockup wrote as bare hexes beside them. They are declared HERE, with the
       rest of the palette, for the reason --rail-ground gives: a token resolves
       from where it is DECLARED, so shell/LayerTree.astro's scoped rules reach
       them only once the tree is inside .stage, which is where Task 7 puts it.
       --pine is the deeper green that tells individual tree instances from the
       canopy raster; --slate the dimmer grey that tells extruded heights from
       footprint outlines; --gold the one warm mark in the Ground-truth group. */
    --pine:#3f8f66; --slate:#6b7f81; --gold:#c9a227;
    /* The icon rail's ground — a fully saturated near-black at the cold end of
       this palette, and it sits ABOVE --base rather than under it.

       IT USED TO BE #040808, "a shade under --base", and the intent did not
       survive contact: it differed from --base by one step in one channel and
       read as nothing at all — 1.01:1. A navigation column that cannot be seen is
       not a subtle navigation column.

       IT WAS THEN A WARM NEUTRAL, and that argument is retired rather than merely
       outvoted. It read the rail as "not part of the instrument" and gave it a
       neutral ink to say so — which made it the one surface on the console
       standing outside the family every other surface belongs to, and made the
       sidebar beside it the only warm thing on a cold page.

       THE VALUE NOW IS THE PALETTE'S OWN COLD END, TAKEN ALL THE WAY DOWN: 197°
       at full saturation and 4.9% lightness. --base, --surface and --surface2 run
       180–185°, and this is the darkest member of that run rather than a visitor
       to it. That is a hue --cyan also lives in, which is a real objection and
       survives on the numbers: --cyan is a mid-lightness accent and this is
       ground at a twentieth of it, so nothing on the heat ramp is within reach of
       being confused with it — the two are 10.08:1 apart.

       WHAT IT COSTS, STATED RATHER THAN BURIED: against --base the rail is now
       1.06:1 where the warm neutral was 1.20:1, so where the sidebar is collapsed
       and the rail meets the map column directly, the 1px --line border is doing
       most of the work of the edge. That is not the first version's failure
       repeated — the hue difference is large where that one had none — but it is
       the same axis, and it is the thing to look at first if the rail ever stops
       reading as a column.

       WHAT IT BUYS: every ink the rail paints with gains against it. The resting
       label goes 7.14:1 to 8.07:1, the active section 14.42:1 to 16.30:1, the
       open-pane accent 8.92:1 to 10.08:1.

       Declared here with the rest of the palette rather than inside
       shell/IconRail.astro, because a token resolves from where it is DECLARED:
       the rail's scoped styles reach it only once the rail is inside .stage,
       which is where Task 7 puts it. */
    /* ALPHA f5, NOT d6, AND THE READABILITY OF THE WHOLE CONSOLE RESTS ON IT.
       At d6 (0.84) the panels admitted about a sixth of the LIVE MAP, so no
       element inside them had a fixed background: the ground moved with the
       basemap, the zoom, the hour and the heat field. A contrast floor cannot be
       met against a ground that is not knowable, and measuring the stylesheet
       instead of the frame hides that completely — the token maths said 3.93:1
       for the worst small text while the rendered pixels said 2.87:1.
       At f5 (0.96) the worst ground the panel can produce is bounded: a pure
       white map pixel composites to rgb(19,29,31), so every ink here can be
       chosen against a PROVABLE worst case rather than a sampled one. That is
       also what preserves the ink ramp — cleared against rgb(19,29,31), --faint
       lands well below --ink; cleared against the old wandering ground it had to
       rise almost to it and the three-step ramp would have collapsed to two.
       The blur is untouched, which is where the glass actually reads. */
    --rail-ground:#091416f5;
    /* The sidebar's ground — the rail's neighbour in the same cold family, one
       step forward.

       ITS OWN TOKEN, NOT --surface. The sidebar used --surface, which is also the
       ground under the readout cards, the brief and the paired bench: repointing
       it to move ONE panel would have repainted every card on three routes. A
       colour wanted in one place gets a name for that place.

       ONE STEP ABOVE THE RAIL, NOT EQUAL TO IT. Identical values would merge the
       navigation column into the panel it opens and lose the edge between them;
       far apart would read as two unrelated surfaces. A single step is what says
       "same family, different job" — the rail is the deeper column you navigate
       FROM, this is the working surface you read.

       DERIVED AGAINST TWO EDGES, NOT ONE. It carries the rail's OKLCH hue and
       chroma, and its lightness is chosen to hold BOTH of the boundaries it has:
       the rail below it, and --surface, which is what .seg in the intervention
       pane is drawn on INSIDE it. Those pull in opposite directions — every step
       away from the rail is a step towards --surface — and the warm-neutral panel
       resolved that by ignoring it, sitting 1.06:1 from --surface and separated
       from it only by hue, which stops working the moment the panel joins the
       cold family. Balanced instead, both edges land above anything this console
       has shipped: 1.12:1 to the rail (was 1.07:1) and 1.14:1 to --surface (was
       1.06:1), with every ink in the sidebar gaining — --paper 13.45 to 14.52,
       --ink 5.96 to 6.43, --cyan 8.32 to 8.98. */
    --panel-ground:var(--rail-ground);
    /* Studio (light) mode's three inks — the same descending-emphasis idea as
       --paper/--ink/--faint above, inverted for a light ground. They live here
       rather than on `body.studio` because every element they colour is inside
       .stage, and a token resolves from where it is DECLARED, not where the
       theme class sits. */
    --studio-ink:#16292b; --studio-muted:#4a5c5e; --studio-accent:#0e7b8c;
    --sans:'Mona Sans',system-ui,sans-serif; --mono:'Noplato Mono',ui-monospace,'SF Mono',monospace;
    /* The sidebar's width, named because three rules read it and because the pane
       cross-fade's whole argument is about not animating this number. */
    --sidebar:300px;
    position:fixed; inset:0; display:grid;
    /* THREE COLUMNS: rail, sidebar, everything else. The rail and the sidebar are
       FULL HEIGHT — the top bar and the ward strip belong to the map, not to the
       console, so they live in the third column and stop at its edges. That is the
       one structural thing this layout says: navigation is beside the instrument,
       not above it. `auto` on the first two so each column is sized by what is in
       it (the rail's own inline-size, the sidebar's) rather than by a third copy
       of those numbers here. */
    grid-template-columns:auto auto minmax(0,1fr); grid-template-rows:100%;
    background:var(--base); color:var(--paper); font-family:var(--sans);
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  }
  .stage *{ box-sizing:border-box; margin:0; }

  /* The main column keeps the rows the stage used to have: top bar, map, strip.

     EXPLICITLY IN COLUMN 3, and this is load-bearing rather than tidy. Grid
     auto-placement fills the first free column, so the moment the sidebar leaves
     the flow — collapsed, or shed at the narrow breakpoint — the main column slid
     LEFT into column 2 and sized itself `auto` against its own content, leaving
     the 1fr column empty and a third of the viewport black. Naming the column is
     what keeps the layout a statement about where things go rather than a
     consequence of how many of them happen to exist. */
  .col{grid-column:3;display:grid;grid-template-rows:auto minmax(0,1fr) auto;min-inline-size:0;overflow:hidden}

  /* ── the sidebar ──────────────────────────────────────────────────────────
     Scope pinned at the top, panes filling the rest. */
  /* THE SECOND FLOATING PANEL, matching the rail beside it — same ground, same
     radius, same hairline, held apart by a gap rather than by a shared edge. The
     margins are asymmetric on purpose: 10px from the rail, 10px from the map, and
     the rail supplies the outer 10px against the viewport. */
  .sidebar{grid-column:2;inline-size:var(--sidebar);display:flex;flex-direction:column;min-block-size:0;
    background:var(--panel-ground);border:1px solid var(--line);border-radius:12px;
    margin:10px 10px 10px 10px}
  /* COLLAPSE IS INSTANT, AND THAT IS THE POINT. Animating a column's width means a
     full relayout of the map beside it on every frame — and MapLibre's
     ResizeObserver reallocates its GL drawing buffer to match, so the cost is a
     canvas resize per frame as well. The panes cross-fade (transform and opacity
     only, below); the column itself simply is or is not there. */
  .sidebar.is-collapsed{display:none}
  /* THE SAME FACT, READ BEFORE THE SIDEBAR EXISTS. shell/layout-state.ts's
     pre-paint script runs where the rail is, at the top of this column's
     neighbour, and the parser has not reached this element yet — so the stored
     preference lands on <html> and this rule carries it down. console-shell.ts's
     `paint` writes BOTH this attribute and the class above, in one function, so
     they cannot disagree; the class is the element's own state and this is the
     document-level mirror that exists only to be applied early. Without it the
     sidebar renders open on every load and then vanishes once the module script
     mounts — 300px of the map, arriving late. */
  html[data-panel="collapsed"] .sidebar{display:none}

  /* One grid cell, every pane stacked in it, so the cross-fade has nothing to
     reflow: the outgoing and incoming panes occupy the same box at the same time. */
  .panes{flex:1;min-block-size:0;display:grid}
  /* `visibility`, not `display`, is what takes a hidden pane out of the tab order
     and the accessibility tree while still letting opacity animate — display:none
     would cancel the transition outright, and opacity alone would leave the
     invisible pane focusable, so a Tab press would land in a pane nobody can see.
     Its transition is stepped: instant on the way in, delayed to the end of the
     fade on the way out. */
  .pane{grid-area:1/1;min-block-size:0;display:flex;flex-direction:column;overflow:hidden;
    opacity:0;transform:translateY(6px);visibility:hidden;pointer-events:none;
    transition:opacity .22s ease,transform .22s ease,visibility 0s .22s}
  .pane.is-on{opacity:1;transform:none;visibility:visible;pointer-events:auto;
    transition:opacity .22s ease,transform .22s ease,visibility 0s}
  @media (prefers-reduced-motion: reduce){ .pane,.pane.is-on{transition:none} }

  .pane-body{padding:14px;display:flex;flex-direction:column;gap:.7rem;overflow-y:auto}
  .pane-h{font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)}
  .pane-note{font-size:.78rem;line-height:1.62;color:var(--ink)}
  .pane-note code{font-family:var(--mono);font-size:.7rem;color:var(--cyan);overflow-wrap:anywhere}

  /* The toolbox, unfloated. It arrived as `position:absolute` over the map, which
     is what it was; in the sidebar it is a column that fills its pane. The rules
     stay in this file because the component ships no stylesheet of its own — see
     its header for why that is deliberate. */
  .sidebar .panel.left{position:static;inline-size:100%;inset:auto;flex:1;min-block-size:0;
    padding-bottom:16px;overflow-y:auto;background:none;border-radius:0;
    backdrop-filter:none;box-shadow:none}

  /* THE HEIGHT WAS NEVER THE PADDING'S ALONE, which is why the padding came back
     to where it started and the bar is still shorter than it was. The readout used
     to be THREE stacked lines at 1.7 leading, and that block — not this 18px — was
     what set the bar's height. Splitting the rig readout out beside the mono line
     and tightening the leading took two rows out of it; the padding is once again
     the founder's original number, spent on breathing room rather than on
     absorbing a tall block.
     The horizontal 26px is untouched: it is the inset the compass and the rest of
     the floating furniture align to. */
  .top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:18px 26px;border-bottom:1px solid var(--line);position:relative;z-index:5;background:rgb(5 6 6 /.55);backdrop-filter:blur(8px)}
  /* The breadcrumb: three places, separated by a drawn mark rather than a typed
     one, so the separator cannot be selected, read aloud, or copied into a
     citation as part of a name. */
  .crumb{display:flex;align-items:baseline;gap:.55rem;min-inline-size:0;font-family:var(--mono);font-size:.62rem;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);white-space:nowrap;overflow:hidden}
  .crumb b{font-weight:400;color:var(--paper)}
  .crumb>*+*::before{content:"/";margin-inline-end:.55rem;color:var(--line-hi)}
  /* ── north compass ────────────────────────────────────────────────────────
     Sits opposite the legend so it never fights the right rail. The needle is
     rotated by JS on MapLibre's `render`; only the inner <g> turns, so the dial
     and the label stay upright and readable at any bearing. */
  /* 312px WAS THE TOOLBOX'S RIGHT EDGE PLUS A GAP — .left floated over the map at
     270px wide and a 26px offset, and the compass had to clear it. The toolbox is
     now a column of the console rather than a panel over the map, so the map's own
     left edge is free and the compass sits at the same 26px inset the rest of the
     floating furniture uses. The breakpoint overrides that followed the panel down
     went with it. */
  /* OPAQUE, AND THAT LAST 4% WAS NOT DECORATION — IT WAS THE FAILURE.
     At .96 the live map bleeds through the dial, so the ground under the "N"
     is not a colour in this stylesheet: it moves with the basemap, the zoom and
     the heat field. Measured, the same letter on the same page scored 4.50:1 on
     one machine and 4.49:1 on a CI runner — the WCAG floor is 4.5, so the
     identical build passed locally and failed in CI on a difference of one
     hundredth, decided by which pixels the map happened to be drawing.
     A 62px dial gains nothing from being see-through and pays for it in a
     contrast figure nobody can reproduce, so the ground is now a fixed colour and
     the letter's ratio is a property of the design rather than of the map. */
  .compass{position:absolute;left:26px;bottom:26px;z-index:6;width:62px;height:62px;padding:0;cursor:pointer;
    background:rgb(9 20 22);border:1px solid var(--line);border-radius:50%;
    display:grid;place-items:center;transition:border-color .2s,transform .2s}
  .compass:hover{border-color:var(--cyan);transform:scale(1.06)}
  .compass:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
  .compass svg{width:56px;height:56px;display:block}
  .compass .c-ring{fill:none;stroke:var(--line);stroke-width:1}
  .compass .c-n{fill:var(--red)}
  .compass .c-s{fill:rgb(236 237 240 /.34)}
  .compass .c-tick{fill:rgb(236 237 240 /.28)}
  .compass .c-lab{font-family:var(--sans);font-weight:700;font-size:8.4px;text-anchor:middle;
    fill:rgb(236 237 240 /.62)}
  /* --red-ink, NOT --red, for the same reason `#area` uses it: this is TEXT at
     8.4px, so it answers to the 4.5:1 body floor rather than to the 3:1 a shape
     gets, and --red is the shape red. The needle above keeps --red because a
     filled triangle is not text. On the dial's fixed ground the letter now
     measures 5.0:1 — margin, rather than the hundredth it was clearing by. */
  .compass .c-lab-n{fill:var(--red-ink)}
  /* The sun is the one warm thing on a cool dial, so it reads at a glance
     without competing with the red north needle for "most important mark". */
  .compass .c-sun-disc{fill:var(--sun)}
  .compass .c-sun-ray{stroke:var(--sun);stroke-width:1;opacity:.5}
  .compass .c-sun-hub{fill:var(--sun);opacity:.45}
  /* `hidden` is not an SVG attribute — a class is, and it types cleanly. */
  .compass .c-sun.is-below{display:none}
  /* Sits directly above the compass, sharing its left edge so the two read as one
     cluster. Kept narrow: `.tiphint` is centred at bottom:88px, so a long line here
     would collide with it on a normal viewport. */
  /* Same plate as the compass it sits above, and for the same reason: this is 7px
     type on the open map. It read 1.33:1 on Clay, where the pale basemap meets a
     near-white ink chosen for the dark one. The alpha on the colour goes too —
     52 % of white over a photograph is a decoration, not a caption. */
  .sunline{position:absolute;left:26px;bottom:104px;z-index:6;margin:0;max-width:200px;
    font-family:var(--mono);font-size:7.5px;letter-spacing:.09em;line-height:1.45;
    color:#c3cbcc;text-transform:uppercase;pointer-events:none;white-space:nowrap;
    background:rgb(9 20 22 /.94);border-radius:6px;padding:.3rem .5rem;backdrop-filter:blur(8px)}
  .sunline[hidden]{display:none}
  /* The caveat is dimmer than the numbers but never hidden — a reader who sees a sun
     on a heat map will assume the model uses it, and it does not. */
  .sunline-note{display:block;font-size:7px;color:rgb(242 181 68 /.85);letter-spacing:.07em;pointer-events:auto;cursor:help}
  .sunline-note:focus-visible{outline:1px solid var(--cyan);outline-offset:2px}
  /* ── live-reading freshness dial ───────────────────────────────────────────
     Sits directly above the compass and borrows its whole visual language, so
     the two read as one instrument cluster: where you are facing, and when the
     data is from. Deliberately NOT styled as a wall clock — no minute hand, no
     numerals — because the map has no time of day to show. */
  /* Digital readout, not a dial, parked immediately left of the evidence rail.
     It qualifies the LIVE AMBIENT block — same row, arm's length — so the
     freshness sits beside the readings it describes rather than beside the
     compass, which answers an unrelated question.

     top: 76 IS LOAD-BEARING, NOT TASTE. The honesty banner is centred and grows
     with its own text, so at 1280 it reaches x 955 while this sits at 891 —
     they overlap horizontally and only the vertical gap keeps them apart. At
     top:52 that gap was 3px, which held on macOS and collided on CI's Linux
     font metrics. 76 puts a real ~27px between them on both. */
  /* SOLID BLOCK, NOT A GLASS PANEL. The numerals sit straight on the colour —
     the Braun/Rams digital-clock idiom — instead of on a translucent tile, so
     the readout is the loudest thing in the component rather than its chrome.

     COLOUR NOW CARRIES THE MAP THEME, SO STALENESS CANNOT. It used to turn the
     digits red; with the block itself coloured per basemap that channel is
     spent, and hue-shifting a red tile to red says nothing. Stale drains the
     colour OUT to grey instead: same reading in both themes, and it is the
     same metaphor the bar already uses. */
  .clockw{--c:var(--cyan);--on:#051416;
    position:absolute;right:var(--instr-inset);top:76px;z-index:6;padding:9px 13px 10px;
    display:flex;flex-direction:column;
    border-radius:12px;border:0;background:var(--c);
    box-shadow:0 7px 20px rgb(0 0 0 /.38);
    transition:background-color .45s ease}
  /* Both children are real buttons; they inherit the block's ink and keep the
     grid the face needs. Hover lifts the whole tile so it still reads as one
     object rather than two stacked chips. */
  .clockw button{appearance:none;background:none;border:0;padding:0;margin:0;
    font:inherit;color:inherit;text-align:left;cursor:pointer;width:100%;display:block}
  .clockw button:focus-visible{outline:2px solid var(--on);outline-offset:2px;border-radius:5px}
  .clockw .k-face{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;
    transition:transform .2s}
  .clockw .k-face:hover{transform:translateY(-1px)}
  .clockw .k-age{margin-top:3px;transition:opacity .2s}
  .clockw .k-age:hover{opacity:.72}
  .clockw .k-age[disabled]{cursor:progress;opacity:.6}
  body.studio .clockw{--c:var(--red);--on:#1b0405}
  /* Grey is a hue-free "not live" that reads identically on either basemap.
     BOTH SELECTORS ARE REQUIRED, AND THIS BLOCK MUST COME LAST. A lone
     `.clockw[data-age="stale"]` ties `body.studio .clockw` on specificity
     (0,2,0 each), so source order decided it and Clay studio kept a stale dial
     RED — the exact warning this component exists to give, lost, and lost in
     the one hue the legend already spends on "Extreme". */
  .clockw[data-age="stale"],
  body.studio .clockw[data-age="stale"]{--c:#8d9698;--on:#141a1b}

  /* the stacked indicator: day over an always-present AM/PM pair */
  .clockw .k-stack{display:flex;flex-direction:column;line-height:1.14}
  /* A size step, not a divider: the day and the meridiem are different KINDS of
     fact — which day, versus which half of it — so scale separates them. */
  .clockw .k-day{font-family:var(--sans);font-weight:750;font-size:.66rem;
    letter-spacing:.01em;color:var(--on);margin-bottom:4px}
  .clockw .k-mer{font-family:var(--sans);font-weight:750;font-size:.47rem;
    letter-spacing:.03em;color:rgb(5 6 6 /.32);transition:color .2s}
  .clockw .k-mer.on{color:var(--on)}
  /* The stack shows EITHER the meridiem pair or the mode, never both — a dimmed
     AM/PM beside a 24-hour readout would be stating something untrue. */
  .clockw .k-h24{display:none;color:var(--on)}
  .clockw[data-h12="false"] #clockAm,
  .clockw[data-h12="false"] #clockPm{display:none}
  .clockw[data-h12="false"] .k-h24{display:block}

  /* tabular-nums so the digits do not reflow as minutes tick over */
  .clockw .k-time{font-family:var(--sans);font-weight:640;font-size:1.98rem;line-height:.9;
    letter-spacing:-.035em;color:var(--on);font-variant-numeric:tabular-nums;text-align:right}
  .clockw .k-sub{display:block;text-align:right;
    font-family:var(--sans);font-weight:600;font-size:.47rem;color:rgb(5 6 6 /.62)}
  .clockw[data-age="stale"] .k-sub{color:rgb(5 6 6 /.8)}
  .clockw .k-bar{display:block;width:100%;height:2px;margin-top:7px;
    border-radius:1px;background:rgb(5 6 6 /.17);overflow:hidden}
  /* scaleX only — transform, never width, so ageing costs no layout */
  .clockw .k-bar i{display:block;height:100%;background:rgb(5 6 6 /.6);border-radius:1px;
    transform-origin:left center;transform:scaleX(1);transition:transform .5s ease}
  @media (prefers-reduced-motion: reduce){ .clockw .k-bar i{transition:none} }

  .vegw{position:absolute;right:var(--instr-inset);top:186px;z-index:6;display:flex;align-items:center;gap:6px;
    /* THE WORST OF THEM: .7 let THIRTY PER CENT of the map through, under a
       label. This is the element CI named — "Trees" at 4.564:1 on Clay in one
       frame and under 4.5 in another, from the same build. A chip this small
       carries no glass effect worth that. */
    padding:4px 7px;border-radius:9px;background:rgb(5 6 6);border:1px solid var(--line);
    box-shadow:0 6px 18px rgb(0 0 0 /.30)}
  .vegw .veg-lab{font-family:var(--mono);font-size:.52rem;letter-spacing:.13em;color:var(--ink);text-transform:uppercase}
  .vegw .modechip{padding:2px;gap:2px}
  .vegw .modechip button{font-size:.52rem;padding:.3rem .62rem;letter-spacing:.12em}
  #svw{top:222px}

  /* Opaque here too, and for the reason given on `.compass`: the pale dial has
     the same map bleeding through it, and Clay is the theme where the map behind
     is bright enough to move a ratio further. One rule, one behaviour, both
     basemaps. */
  /* the Trees/Street pill labels sat at exactly 4.50:1 on Clay — the one map-borne
     label the studio pass missed — and the WCAG gate rounds that as a miss. */
  body.studio .vegw .veg-lab{color:#b6c5c8}
  body.studio .compass{background:rgb(245 244 241);border-color:rgb(20 40 42 /.2)}
  body.studio .compass .c-s{fill:rgb(20 40 42 /.34)}
  body.studio .compass .c-tick{fill:rgb(20 40 42 /.28)}
  body.studio .compass .c-lab{fill:rgb(20 40 42 /.66)}

  /* ── first-run hint ── */
  .tiphint{position:absolute;left:50%;bottom:88px;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:.6rem;
    background:rgb(9 20 22 /.96);border:1px solid rgb(111 202 214 /.35);border-radius:99px;padding:.5rem .55rem .5rem .95rem;
    backdrop-filter:blur(10px);font-family:var(--mono);font-size:.53rem;letter-spacing:.12em;text-transform:uppercase;color:var(--paper);
    animation:tipIn .45s cubic-bezier(.2,0,0,1) both}
  .tiphint button{background:none;border:0;color:var(--ink);cursor:pointer;font-size:.6rem;line-height:1;padding:.25rem .4rem;border-radius:50%}
  .tiphint button:hover{color:var(--paper)}
  .tiphint button:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
  @keyframes tipIn{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
  body.studio .tiphint{background:rgb(245 244 241 /.97);color:var(--studio-ink);border-color:rgb(20 40 42 /.25)}
  /* THE DISMISS BUTTON DID NOT FOLLOW ITS OWN HINT INTO THE LIGHT THEME. The rule
     above recolours `.tiphint`, but `.tiphint button` sets `color:var(--ink)`
     explicitly, so the ✕ stayed the dark theme's pale grey on a near-white pill:
     2.36:1, the worst thing left on Clay once the grounds were fixed. */
  body.studio .tiphint button{color:var(--studio-ink)}
  body.studio .tiphint button:hover{color:#000}
  @media (prefers-reduced-motion: reduce){ .tiphint{animation:none} }

  /* ── walk-time ring labels ──
     Contour-label treatment: one quiet mono line in the ring's own cyan,
     sitting on the circumference. Constant things must LOOK constant — the
     previous data-chip styling (filled pill, bold Mona Sans value) made two
     fixed radii read as per-building findings, and the reader misread them
     twice. The finding lives in .cooltag; this is just the ruler. */
  .ringlab{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-9px 0 0 -52px;width:104px;text-align:center;white-space:nowrap;
    font-family:var(--mono);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;
    color:var(--cyan);background:rgb(9 20 22 /.82);border:1px solid rgb(111 202 214 /.4);
    border-radius:99px;padding:.22rem 0}
  body.studio .ringlab{background:rgb(245 244 241 /.88);color:#0d6b7d;border-color:rgb(13 107 125 /.4)}

  /* ── nearest-greenery tag: the FINDING, so it gets the data-chip anatomy ──
     Big value over a small label, in the cooling green of the patches it
     stands on. Anchored at the nearest cooling cell; the value is written once
     per selection and only the transform moves per frame. */
  /* Caribbean green, solid, no border. Ink is the stage's own near-black rather
     than pure black: 9.7:1 on this fill, and the label at 72% still measures
     5.9:1, so both clear AA without the value having to shout. The fill is a
     flat brand colour in a panel language built on translucency — that is the
     point, it is the one element on the map that is a finding rather than
     chrome, and it is the same green as the patch it stands on. */
  .cooltag{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-16px 0 0 -73px;width:146px;text-align:center;line-height:1.14}
  .cooltag-in{background:#00cc99;border-radius:9px;padding:.34rem .28rem .36rem;
    box-shadow:0 7px 18px rgb(0 32 24 /.42);will-change:transform,opacity}
  /* No mono anywhere inside: this is a spoken result ("about a hundred and fifty
     metres"), not a machine readout, and Mona Sans reads faster at a glance.
     tabular-nums keeps the count-up from jittering as digits change width. */
  .cooltag b{display:block;font-family:var(--sans);font-weight:750;font-size:1.02rem;
    letter-spacing:-.02em;color:#052018;font-variant-numeric:tabular-nums}
  /* Sentence case, not caps: the label is a phrase to read, and uppercase costs
     the word-shapes that make it readable at this size. The weight makes up the
     presence the caps were providing, and the tracking comes back to near-normal
     because letter-spacing set for caps loosens sentence case badly. */
  .cooltag span{display:block;font-family:var(--sans);font-weight:600;font-size:.56rem;
    letter-spacing:.005em;color:rgb(5 32 24 /.78);margin-top:1px}
  body.studio .cooltag-in{box-shadow:0 8px 22px rgb(0 32 24 /.24)}

  /* The sentence that says what the rings are FOR. Lives inside the building
     card, which is the only time the rings exist. */
  .bc-rings{margin:.5rem 0 0;padding:.45rem .55rem;border-radius:7px;
    background:rgb(111 202 214 /.09);border:1px solid rgb(111 202 214 /.2);
    font-size:.62rem;line-height:1.5;color:var(--paper);text-transform:none;letter-spacing:0}
  .bc-rings b{color:var(--cyan);font-weight:550}
  body.studio .bc-rings{background:rgb(13 107 125 /.08);border-color:rgb(13 107 125 /.22);color:var(--studio-ink)}

  /* MapLibre's own scale bar — a geospatial tool with no distance reference is
     asking the reader to guess. Restyled to the instrument's language.
     NOT :global(...): this whole block is `is:global`, so Astro runs no scoping
     pass and would ship the :global() verbatim, which the browser discards as an
     invalid selector — taking the entire rule with it. That is exactly how the
     bar ended up unstyled and sitting on top of the toolbox. The attribution
     rules below have always used plain selectors for the same reason. */
  /* Made to read as a RULER, not a chip. The ⊔ bracket — rule along the bottom,
     ticks turning up at each end — is the cartographic idiom, and it was being
     smothered: a filled background with a full rounded border turned it into a
     label box, and 7.4px type put the number below any useful reading size.
     Now: no fill, brighter 1.5px bracket, the number sitting above the rule at
     a legible size with a shadow so it survives a bright basemap. */
  .maplibregl-ctrl-scale{background:none!important;border:1.5px solid rgb(111 202 214 /.72)!important;
    border-top:0!important;border-radius:0!important;color:var(--paper)!important;
    font-family:var(--sans)!important;font-weight:600!important;font-size:.58rem!important;
    letter-spacing:.01em!important;padding:0 0 9px!important;text-align:center!important;
    text-shadow:0 1px 3px rgb(0 0 0 /.85);
    /* Quarter ticks, drawn as a repeating gradient rather than markup because
       MapLibre owns this element's contents — it rewrites the label on every
       zoom and would discard any children. Percentage stops mean the ticks stay
       at the quarter points as the bar's pixel width changes with zoom, which is
       what makes them readable as subdivisions rather than decoration. */
    background-image:repeating-linear-gradient(90deg,
      rgb(111 202 214 /.72) 0 1.5px, transparent 1.5px 25%)!important;
    background-size:100% 7px!important;background-repeat:no-repeat!important;
    background-position:left bottom!important;background-origin:padding-box!important}
  body.studio .maplibregl-ctrl-scale{color:var(--studio-ink)!important;border-color:rgb(13 107 125 /.7)!important;
    text-shadow:0 1px 3px rgb(255 255 255 /.85);
    background-image:repeating-linear-gradient(90deg,
      rgb(13 107 125 /.7) 0 1.5px, transparent 1.5px 25%)!important}
  /* Clear of the compass, which is 62px wide at a 26px inset. It used to be clear
     of the toolbox as well, at 396px; the toolbox is no longer over the map. */
  .maplibregl-ctrl-bottom-left{margin:0 0 30px 110px}

  /* ── click-to-inspect ─────────────────────────────────────────────────────
     Both nodes are positioned in CSS pixels by heat-map-app.ts on MapLibre's
     `render` event, which only fires when a repaint actually happened. They move
     with transform ONLY — never left/top — so tracking the camera costs no
     layout, and the pointer must stay off the map or the card would eat the
     drag-to-orbit gesture. */
  .bsel{position:absolute;z-index:6;pointer-events:none;width:54px;height:54px;margin:-27px 0 0 -27px;
    will-change:transform;transition:opacity .18s ease}
  .bsel i{position:absolute;width:13px;height:13px;border:1.6px solid var(--cyan)}
  .bsel i:nth-child(1){left:0;top:0;border-right:0;border-bottom:0}
  .bsel i:nth-child(2){right:0;top:0;border-left:0;border-bottom:0}
  .bsel i:nth-child(3){left:0;bottom:0;border-right:0;border-top:0}
  .bsel i:nth-child(4){right:0;bottom:0;border-left:0;border-top:0}

  /* The −50% lives on THIS node, not on .bcard-in: `.lead` is positioned at
     top:50% of .bcard, and a transform on a child does not move the parent box
     the percentage resolves against — so shifting the inner card alone left the
     leader line pinned to the card's bottom edge instead of the building. */
  .bcard{position:absolute;z-index:7;width:230px;will-change:transform;pointer-events:none}
  .bcard .lead{position:absolute;top:50%;width:30px;height:1px;background:rgb(111 202 214 /.55)}
  .bcard .lead::before{content:'';position:absolute;top:-3px;width:6px;height:6px;border-radius:50%;background:var(--cyan)}
  .bcard[data-side='right'] .lead{right:100%}
  .bcard[data-side='right'] .lead::before{left:-3px}
  .bcard[data-side='left'] .lead{left:100%}
  .bcard[data-side='left'] .lead::before{right:-3px}
  .bcard-in{pointer-events:auto;background:rgb(5 6 6 /.86);backdrop-filter:blur(9px);
    border:1px solid rgb(111 202 214 /.4);border-radius:11px;padding:11px 13px;
    box-shadow:0 14px 40px rgb(0 0 0 /.45);
    max-height:calc(100dvh - 24px);overflow-y:auto;overscroll-behavior:contain}
  .bc-h{display:flex;justify-content:space-between;font:400 .5rem var(--mono);letter-spacing:.16em;
    text-transform:uppercase;color:var(--cyan);margin-bottom:.5rem}
  .bcard dl{display:grid;grid-template-columns:auto 1fr;gap:.22rem .7rem;margin:0;font-size:.7rem}
  .bcard dt{font:400 .5rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink);align-self:baseline}
  .bcard dd{margin:0;text-align:right;font-weight:550;letter-spacing:-.01em;color:var(--paper)}
  .bcard dd small{display:block;font:400 .46rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--bronze)}
  /* The Height row carries HEIGHTS.note as its title (heat-map-app.ts). Without an
     affordance nobody hovers a plain <dd>, so the whole ICESat-2 caveat goes unread
     — same reasoning as .conf, which is the precedent. */
  #bcH{cursor:help}
  .bc-ins{margin:.55rem 0 0;padding-top:.5rem;border-top:1px solid rgb(111 202 214 /.18);
    font:400 .5rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink);line-height:1.75}
  .bc-ins b{font-weight:400}
  .bc-ins .hot{color:var(--red)} .bc-ins .cool{color:var(--cyan)}
  /* HOW THE FOOTPRINT WAS MADE, as a card footnote rather than a qualifier hung
     under the source name. It reads standalone ("Footprint model · confidence
     0.85") because at the foot of the card it no longer sits beneath the
     "Footprint by" label that used to supply its subject. */
  .bc-prov{margin:.4rem 0 0;font:400 .46rem var(--mono);letter-spacing:.08em;
    text-transform:uppercase;color:var(--bronze);line-height:1.6}
  .bc-prov:empty{display:none}
  /* ROOFTOP SOLAR on the card: the card's own grid and notes, ruled off and headed
     in amber, because it is a screening estimate about the building and must never
     read as one of the measured rows above it. */
  .bc-sol{margin:.55rem 0 0;padding-top:.5rem;border-top:1px solid rgb(242 181 68 /.35)}
  .bc-sol .bc-h{color:var(--sun);margin-bottom:.35rem}
  .bc-sol dd.sun{color:var(--sun)}
  .bc-sol-note{margin:.4rem 0 0;font:400 .46rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--bronze);line-height:1.6}
  /* Clay: amber on the near-white card is 1.7:1, so the card's amber steps down
     to an ink at 6.3:1 (computed against rgb(245 244 241); the contrast gate never
     opens a card, so the number is the receipt). The bronze notes were already
     2.8:1 on Clay in .bc-prov; both step down to an ink at 7:1. */
  body.studio .bc-sol .bc-h,body.studio .bc-sol dd.sun{color:#7a5200}
  body.studio .bc-prov,body.studio .bc-sol-note{color:#6b4d1f}
  body.studio .bc-sol{border-top-color:rgb(122 82 0 /.35)}
  /* Per-layer "data receipts" panel — populated from {ward}-layers.json (provenance.ts). */
  .srcbtn{margin:.4rem 0 0;cursor:pointer;font:400 .48rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);background:none;border:0;padding:.15rem 0}
  .srcbtn:hover{color:var(--paper)}
  .srcbtn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  .srcpanel{position:absolute;right:18px;bottom:66px;width:326px;max-height:54vh;overflow:auto;z-index:6;background:rgb(5 6 6 /.9);backdrop-filter:blur(11px);border:1px solid var(--line);border-radius:12px;padding:13px 15px;box-shadow:0 18px 50px rgb(0 0 0 /.5)}
  .srcpanel[hidden]{display:none}
  .srcpanel h4{margin:0 0 9px;font:400 .55rem var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--ink)}
  .src-row{padding:8px 0;border-top:1px solid var(--line)}
  .src-row:first-of-type{border-top:0}
  .src-row .l{display:flex;justify-content:space-between;gap:8px;align-items:baseline}
  .src-row .nm{font-weight:600;font-size:.74rem;letter-spacing:-.01em;color:var(--paper)}
  .src-row .k{flex:none;font:400 .44rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--base);background:var(--cyan);border-radius:4px;padding:1px 5px}
  .src-row .k.modelled,.src-row .k.reference{background:var(--bronze)}
  .src-row .s{margin-top:2px;font-size:.62rem;line-height:1.45;color:var(--ink)}
  .src-row .s a{color:var(--cyan)}
  .src-row .meta{margin-top:3px;font:400 .46rem var(--mono);letter-spacing:.06em;color:var(--faint);line-height:1.5}
  body.studio .srcpanel{background:rgb(244 246 246 /.95);border-color:rgb(20 48 54 /.16)}
  body.studio .src-row .nm{color:#13232a}
  body.studio .src-row .s,body.studio .srcpanel h4{color:var(--studio-muted)}
  body.studio .src-row .meta{color:#7f9296}
  .svmodal{position:fixed;inset:0;z-index:40;display:none;place-items:center;background:rgb(2 9 10 /.72);backdrop-filter:blur(3px)}
  .svmodal:not([hidden]){display:grid}
  .svmodal-card{position:relative;width:min(1100px,92vw);height:min(680px,80vh);background:#02090a;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgb(0 0 0 /.5)}
  .svmodal-viewer{width:100%;height:100%}
  .svmodal-x{position:absolute;top:10px;right:10px;z-index:2;width:32px;height:32px;border-radius:50%;border:0;background:rgb(2 9 10 /.8);color:#eef1f2;cursor:pointer;font-size:15px}
  .svmodal-credit{position:absolute;left:10px;bottom:8px;z-index:2;font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:#c9d4d5;background:rgb(2 9 10 /.6);padding:3px 7px;border-radius:5px}
  .svmodal-credit a{color:var(--cyan)}
  .sv-thumb{margin-top:.5rem}
  .sv-thumb img{width:100%;border-radius:8px;display:block;cursor:pointer;border:1px solid var(--line)}
  .sv-thumb .sv-none{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--faint);text-transform:uppercase}
  .bc-x{margin-top:.55rem;width:100%;cursor:pointer;font:400 .48rem var(--mono);letter-spacing:.12em;
    text-transform:uppercase;color:var(--ink);background:rgb(9 58 62 /.4);border:1px solid var(--line);
    border-radius:6px;padding:.4rem 0}
  .bc-x:hover{color:var(--paper)}
  .bc-x:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  body.studio .bcard-in{background:rgb(245 244 241 /.9);border-color:rgb(20 40 42 /.22);box-shadow:0 14px 40px rgb(20 40 42 /.16)}
  body.studio .bcard dd{color:var(--studio-ink)}
  body.studio .bc-x{background:rgb(20 40 42 /.06);color:var(--studio-muted)}
  @media (max-width: 640px){ .bcard{width:196px} }

  /* `.tool-modes` and `.tabs` were here. The first was the Explore/Compare pair the
     rail replaced; the second was a THIRD area switcher, after the scope switcher's
     Area select and the ward strip below — all three reading the same `data-w`, all
     three doing the same thing. Two of the three are gone.
     THE STRIP IS THE ONE KEPT, because it is the only control that puts the wards
     BESIDE each other: three tiles, each with its greenness swatch, its kind and a
     `big-{id}` slot for its mean. Worth knowing while reading it: heat-map-app.ts
     fills that slot only for the ward it has loaded, so the other two carry an
     em-dash until they are opened. The comparison the strip is shaped for is
     therefore still half-drawn — the shape is right and the data is per-visit. */
  /* The two right-hand blocks, held apart. `align-items:baseline` rather than
     center: the pair is type of one size, and baselines are what the eye lines up
     on a row of text — centring would sit the one-line block optically high beside
     the two-line one. */
  .top .topmeta{display:flex;align-items:baseline;gap:2.4rem;min-inline-size:0}
  .top .read{text-align:right;font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;color:var(--faint);line-height:1.45;text-transform:uppercase;white-space:nowrap}
  /* Same type as .read, deliberately: it is the same voice reporting a different
     fact, and giving the live half its own size would make it look like a status
     badge rather than a reading. */
  .top .rig{font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;color:var(--faint);line-height:1.45;text-transform:uppercase;white-space:nowrap}
  .top .read b{color:var(--cyan);font-weight:400}

  /* THE RIGHT-HAND INSTRUMENT COLUMN, DECLARED ONCE.
     The ward clock and the vegetation widget both hang off `--instr-inset`, and
     the overlays that centre themselves on the map subtract `--instr-berth` before
     doing it. Two anchors, one number: written separately they drifted, and the
     drift is invisible until the window is narrow enough for them to touch.

     WHAT IT COST TO NOT HAVE THIS. `.stamp-slot` centred on the FULL map width
     while `.clockw` sat at a fixed right inset, so the gap between them closed as
     the viewport did — measured 10px of overlap at 1536, 58px at 1440, 95px at
     1366 and 122px at 1280, where only the "U" of "Under Construction" was still
     legible. `.loadchip` was worse and quieter: at 1280 its whole box sat inside
     the clock's, at z-index 3 against the clock's 6, so "Building ward…" was
     painted over completely — the one message that only ever appears while a
     reader is waiting for something.

     CENTRING IS THE THING THAT HAD TO CHANGE, not the vertical order. The top band
     is full — the honesty banner ends at 49px and the clock starts at 76px, and
     the stamp needs 35 — so no amount of moving things up or down separates them,
     and any fix that only works at today's widths is not a fix. Subtracting the
     berth makes the centring width-invariant instead: these overlays now centre in
     the space that is actually free, which is what "centred" meant all along.

     `--instr-w` is a RESERVE rather than the clock's measured width (122px at the
     time of writing). The clock is content-sized — the day name and the AM/PM vs
     24H pair both move it — so pinning the reserve to today's render would put the
     collision back the first time a longer weekday came round. */
  .map{position:relative;overflow:hidden;
    --instr-inset:320px;--instr-w:140px;--instr-berth:calc(var(--instr-inset) + var(--instr-w))}
  #mlmap{position:absolute;inset:0}
  .maplibregl-ctrl-attrib{font-family:var(--mono);font-size:.46rem}
  .maplibregl-ctrl-bottom-right{z-index:1}
  .place{position:absolute;left:50%;top:34%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;z-index:1}
  .place .n{font-weight:600;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.92;letter-spacing:-.04em;text-shadow:0 4px 40px rgb(0 0 0 /.85);opacity:.82}
  .place .n em{font-style:normal;color:var(--cyan)}
  /* THE SUBTITLE CARRIES ITS OWN GROUND; the ward name above it does not need to.
     `.n` is 4rem, so it clears the 3:1 large-text floor on any basemap. These
     tracked caps are 9px on whatever the map happens to be — measured 2.25:1 on
     Slate and 2.99:1 on Clay — and no colour fixes a ground that is a photograph.
     `opacity:.9` is gone with it: dimming the one line that already failed was
     working against the only thing it had. */
  .place .z{display:inline-block;font-family:var(--mono);font-size:.58rem;letter-spacing:.34em;color:var(--bronze);margin-top:.7rem;text-transform:uppercase;
    background:rgb(5 6 6 /.94);padding:.24rem .62rem .24rem .68rem;border-radius:5px;backdrop-filter:blur(6px)}
  .chiprow{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);display:flex;gap:8px;z-index:3}
  .modechip{display:flex;gap:2px;background:rgb(5 6 6 /.94);border:1px solid var(--line);border-radius:9px;padding:3px;backdrop-filter:blur(8px)}
  .modechip button{font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;color:var(--ink);background:none;border:0;cursor:pointer;padding:.4rem .8rem;border-radius:6px;text-transform:uppercase}
  .modechip button.on{background:var(--surface2);color:var(--paper)}
  body.studio .place .n{color:#232b2d;text-shadow:0 4px 34px rgb(255 255 255/.6)}
  body.studio .place .n em{color:var(--studio-accent)}
  /* GONE, NOT RECOLOURED. #8a6d3f was the darker bronze this label needed while it
     sat directly on Clay's pale basemap. It now carries its own dark plate in both
     themes, so that value became dark bronze on a dark plate — 2.64:1, worse than
     the problem it was introduced to solve. The plate makes the theme fork
     unnecessary: one colour, one ground, both basemaps. */
  body.studio .loadchip{color:var(--studio-accent)}

  /* CENTRED BY MARGIN, NOT BY `left:50%`, AND THE DIFFERENCE IS THREE LINES OF TEXT.
     An absolutely positioned shrink-to-fit box offered `left:50%` may only use the
     space from that point to the containing block's right edge — HALF the stage. The
     banner fitted on one line while the stage was the full viewport; once the rail
     and the sidebar took their columns, half of what remained was 389px, the honesty
     text wrapped to three lines, and the pill grew down onto the clock tile below it
     (measured: 0.3px of clearance, where the layout contract asks for 10).
     `inset-inline:0` gives the box the WHOLE width to shrink against and `margin-inline:
     auto` still centres it, so the pill is one line again at the stage's real width and
     the narrow-viewport rules below still get to wrap it when it genuinely cannot fit. */
  /* A BRONZE WASH IS NOT A GROUND. The pill used to be `rgb(176 141 87 /.14)` —
     bronze text on a 14 % bronze tint over the live map — so the sentence scored
     3.83:1 on Slate and 2.24:1 on Clay. It is the one line on this page whose
     entire job is to be read, and it was the least readable thing on it.
     A dark fill keeps the bronze identity where the identity actually lives (the
     border, the pulsing dot, the text) and gives the words a ground that does not
     move with the map beneath. */
  .synthetic{position:absolute;top:20px;inset-inline:0;margin-inline:auto;width:max-content;max-width:calc(100% - 2rem);display:flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.56rem;letter-spacing:.2em;color:var(--bronze);background:rgb(9 20 22 /.94);border:1px solid rgb(176 141 87 /.42);border-radius:20px;padding:.42rem .9rem;z-index:3;text-transform:uppercase;backdrop-filter:blur(8px)}
  .synthetic .sp{opacity:.82}
  .synthetic .d{width:6px;height:6px;border-radius:50%;background:var(--bronze);animation:hmPulse 2.2s infinite}
  @keyframes hmPulse{0%,100%{opacity:1}50%{opacity:.3}}
  /* Build-status stamp, grouped with the honesty banner directly above it —
     both are bronze status chrome and belong together. Centred over the map's
     dark upper region, NOT over the ward model: the first placement put it mid-
     canvas at 9px over pale rooftops, where it was illegible and interrupted the
     one thing the page exists to show.

     NOT aria-hidden here (unlike SoonDraft, which repeats it in prose) — this is
     the page's only statement that the tool is still being built, so it must be
     announced. Smaller than the placeholder-page stamp: this page has a working
     instrument, and the stamp is a caveat on it, not the headline. */
  /* CENTRED IN THE FREE SPACE, NOT ON THE MAP — see `--instr-berth` on `.map`.
     `inset-inline:0 var(--instr-berth)` with `margin-inline:auto` and a
     max-content width is the same shape the honesty banner above uses; the only
     difference is that the right edge stops short of the instrument column
     instead of at the map's edge. */
  .stamp-slot{position:absolute;inset-inline:0 var(--instr-berth);margin-inline:auto;
    width:max-content;max-width:calc(100% - var(--instr-berth) - 1rem);
    top:68px;z-index:3;pointer-events:none;
              --stamp-size:.62rem;--stamp-pad:.5rem 1rem;--stamp-tracking:.26em;--stamp-rot:-2.5deg}
  /* NOT :global(.con-stamp) — this block is `is:global`, so Astro runs no scoping pass
     over it and never strips the `:global()`. It would ship verbatim, and the browser
     drops the whole rule as an invalid selector, leaving the stamp unbacked over the
     basemap. Inside is:global every selector is already global. */
  .stamp-slot .con-stamp{opacity:1;background:rgb(6 14 16 /.94);backdrop-filter:blur(8px)}
  /* The within-ward caveat. Bronze, like every other provenance statement on
     this page, and directly under the colour ramp it qualifies. */
  .pattern-note{margin:.32rem 0 0;font-family:var(--mono);font-size:.5rem;line-height:1.75;
                letter-spacing:.09em;color:var(--bronze);text-transform:uppercase;
                border-top:1px solid rgb(176 141 87 /.22);padding-top:.42rem;white-space:nowrap}
  /* Same berth as the stamp, and for a sharper reason: this chip's whole box sat
     inside the clock's at 1280 — z-index 3 under the clock's 6 — so "Building
     ward…" was painted over exactly when a reader was waiting to be told
     something. It is only ever visible during a load, which is why nobody caught
     it by looking. */
  .loadchip{position:absolute;top:118px;inset-inline:0 var(--instr-berth);margin-inline:auto;
    width:max-content;max-width:calc(100% - var(--instr-berth) - 1rem);
    font-family:var(--mono);font-size:.52rem;letter-spacing:.26em;color:var(--cyan);z-index:3;text-transform:uppercase;opacity:0;transition:opacity .25s}
  .loadchip.on{opacity:1}

  /* Borderless glass. The 1px --line stroke was the last piece of the "grid of
     boxes" read, and it also fought the legend directly beneath it in the same
     rail. Separation is now DEPTH, not a line — which is how the reference UI
     separates its cards too.
     The fill goes .82 -> .88 and the shadow deepens to compensate: over a dark
     3D scene an unbordered translucent panel loses its edge, and the fix for
     that is contrast + shadow, not a stroke by another name. */
  /* Two shadows, not one big one: a tight contact shadow that DEFINES the edge,
     and a soft ambient that lifts the card. The single 0 24px 70px pooled
     across the rail gap and glued this to the legend below it. The ambient is
     kept short (18px, not 70) for the same reason — it must not reach the next
     card. */
  /* OPAQUE, FOR THE REASON `.compass` IS — and this is the surface that proved
     the rule matters on BOTH themes rather than one.

     At .96 the live map contributed 4% of this panel's ground. On Slate that is
     4% of a dark basemap and changes nothing measurable. On CLAY it is 4% of a
     PALE one, which lightens the ground under text that is already light: measured,
     `% RH` and `m/s wind` cleared the 4.5 floor by 0.035 and the vegetation chip's
     label by 0.064 — margins smaller than the variation the map itself introduces
     between two frames. That is how a suite goes green on a pull request and red on
     main with identical code, which is exactly what happened.

     4% of translucency is invisible on a panel this size and is not worth a
     contrast figure that cannot be reproduced. The blur goes with it: it composites
     what is behind, and there is no longer anything behind to see. */
  .panel{position:absolute;background:rgb(9 20 22);border-radius:14px;box-shadow:0 1px 2px rgb(0 0 0 /.45),0 8px 18px rgb(0 0 0 /.35);z-index:4}
  .panel .h{font-family:var(--mono);font-size:.58rem;letter-spacing:.18em;color:var(--ink);padding:14px 18px 0;text-transform:uppercase}
  /* `.left`'s floating geometry is gone: the toolbox is a pane of the sidebar now,
     and `.sidebar .panel.left` up in the layout block gives it a column's shape.
     The rules kept here are the ones that describe the CONTROLS inside it, which
     did not move. */
  /* right rail: one bounded column so the data card + legend can
     never overlap — the data card scrolls internally when the viewport is short,
     the legend stays pinned to the bottom via margin-top:auto. */
  /* gap 14 -> 22. When the panels lost their 1px border the border stopped
     doing a job nobody had named: SEPARATING the readout card from the legend
     directly beneath it. A 70px shadow then spilled across a 14px gap and the
     two read as one slab. Space has to do that job now, and 14px is not enough
     space to read as a break between two dark surfaces. */
  /* THE RAIL STARTS BELOW THE HONESTY BANNER, because it was CUTTING THE SENTENCE
     IN HALF. The banner is centred on the map and the rail is 242px of opaque card
     at z-index 4 against the banner's 3, so the pill's right end ran underneath it
     and the line read "… HEAT FIELD MODELLE" with the rest painted over — measured
     at 1280 AND 1600, so it is not a narrow-window artefact.
     Raising the rail's top past the pill is the fix that does not move anything
     else: the banner, the build stamp, the load chip and the ward name all centre
     on the same axis and stay where they are. The rail is `overflow-y:auto`, so the
     34px it gives up costs reach, not content. */
  .rail-r{position:absolute;right:26px;top:60px;bottom:26px;width:242px;display:flex;flex-direction:column;gap:22px;overflow-y:auto;z-index:4}
  .right{position:static;width:100%;flex:none}

  /* NO RULE BETWEEN THE ROWS. Each `.ctl` used to carry a border-bottom, which
     drew a hairline between every slider and the next — five lines down a column
     whose rows are already separated by their own padding and by a label sitting
     directly above each control. A divider earns its place by grouping things
     that would otherwise run together; between three sliders that each have a
     name and a number, it only added ruled paper. The `:last-child` reset that
     removed the final one goes with it — it existed solely to undo this rule. */
  .ctl{padding:14px 18px}
  .ctl label{display:flex;justify-content:space-between;font-size:.72rem;color:var(--paper);margin-bottom:.5rem}
  .ctl label .v{font-family:var(--mono);color:var(--cyan);letter-spacing:.05em}
  .stage input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:3px;border-radius:2px;background:var(--surface2);outline:none}
  .stage input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--cyan);cursor:pointer;box-shadow:0 0 0 4px rgb(111 202 214 /.15)}
  .stage input[type=range]:focus-visible{box-shadow:0 0 0 2px var(--cyan)}
  .seg{display:flex;gap:2px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:3px;margin-top:.3rem}
  .seg button{flex:1;font-family:var(--mono);font-size:.54rem;letter-spacing:.1em;color:var(--ink);background:none;border:0;cursor:pointer;padding:.45rem;border-radius:5px;text-transform:uppercase}
  .seg button.on{background:var(--surface2);color:var(--paper)}
  /* The stated absence where the segmented control would be. Prose, not a box:
     an empty .seg is a hairline rectangle with nothing in it, which reads as a
     control that has not finished loading. */
  .segnone{margin-top:.3rem;font-size:.62rem;line-height:1.45;color:var(--ink);opacity:.78}

  .score{display:flex;align-items:center;gap:14px;padding:16px 18px}
  .score .g{position:relative;width:64px;height:64px;flex:none}
  /* Both circles paint stroke:currentColor, so `color` is what actually carries
     the token — see the note beside the <svg>. Setting it per circle rather than
     on the <svg> keeps the two strokes independent, which is what the two hex
     attributes used to do. */
  .score .g .track{color:var(--surface2)}
  .score .g #scoreArc{color:var(--cyan)}
  .score .g .num{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--mono);font-size:1.05rem;color:var(--cyan)}
  .subs{display:flex;gap:1px;background:var(--line);margin:0 18px 16px;border-radius:7px;overflow:hidden}
  .subs>div{flex:1;background:rgb(9 20 22 /.55);padding:8px 4px;text-align:center}
  .subs b{display:block;font-family:var(--mono);font-weight:400;font-size:.92rem;color:var(--cyan);letter-spacing:.02em}
  .subs span{font-family:var(--mono);font-size:.42rem;letter-spacing:.09em;color:var(--ink);text-transform:uppercase}
  .score .t{font-size:.66rem;color:var(--ink);line-height:1.5}
  .score .t b{display:block;color:var(--paper);font-size:.82rem;font-family:var(--sans);font-weight:600;letter-spacing:-.01em;margin-bottom:2px}
  /* Own line: the tier is a verdict, not a prefix to the sentence beneath it.
     Inline it ran straight into the text — "Vulnerable24 pts reachable". */
  .score .t .tier{display:block;font-family:var(--mono);font-size:.5rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:3px}
  .scoreconf{margin:0 18px 16px}
  .conf[hidden]{display:none}
  /* the pillar the missing indicator sits in, in the colour this instrument
     already uses for "not decision-grade" */
  .subs b.soft{color:var(--bronze)}

  /* "01 quiet". The card was 100 % mono and 100 % uppercase, which in a 242 px
     rail reads as shouting. Labels move to the sans that was ALREADY loaded and
     ALREADY declared as --sans on .stage (line ~329) — it was simply never used
     in here, so this costs no font, no bundle, no request. NUMBERS STAY MONO.
     Sentence case, so text-transform goes with it. Padding lands on a 4 px
     rhythm; the old 11/13/9/12/7/2 literals were the other half of the noise.
     border-bottom is gone: separation is space now, not rules. */
  .metric{padding:16px}
  /* the live block already pays 16px at the bottom — don't pay it twice */
  .metric + .metric{padding-top:0}
  .metric .k{font-family:var(--sans);font-size:.68rem;font-weight:450;letter-spacing:.005em;color:var(--ink);line-height:1.35}
  /* .attr had no anchor rule, so a link here would render as default browser
     blue on a near-black panel. Inherit the credits colour and mark it with a
     cyan underline instead — the same restraint .tool-modes a uses. */
  .attr a{color:inherit;text-decoration:underline;text-decoration-color:rgb(111 202 214 /.45);text-underline-offset:2px}
  .attr a:hover{color:var(--paper)}
  .attr a:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  .metric .lst{font-family:var(--mono);font-weight:400;font-size:2.1rem;line-height:1;margin-top:8px;letter-spacing:.01em;transition:color .4s}
  .metric .lst .u{font-size:.84rem;color:var(--ink);margin-left:.15rem}
  /* measured uncertainty, not decoration — the model's out-of-sample error
     against ECOSTRESS for the phase on screen (see accuracy.ts) */
  .metric .lst .band{font-size:.74rem;color:var(--ink);margin-left:.5rem;letter-spacing:.02em}
  /* THE HONESTY BANNER. Restyled, deliberately NOT demoted — same colour, same
     place, larger type than before (.48rem -> .6rem). Border removed to match
     the rest of the card; the tint still carries it. Words in sans, FIGURES in
     mono via <b> (written by applyConfidence in heat-map-app.ts) — that is the
     type rule applied honestly rather than picking one face per element. */
  .cta{display:block;text-align:center;text-decoration:none}
  .conf{font-family:var(--sans);font-size:.6rem;letter-spacing:.005em;margin-top:10px;padding:5px 9px;border-radius:8px;display:inline-block;cursor:help}
  .conf b{font-family:var(--mono);font-weight:400;letter-spacing:.02em}
  .conf.quantitative{color:var(--cyan);background:rgb(111 202 214 /.1)}
  .conf.indicative{color:var(--bronze);background:rgb(176 141 87 /.14)}
  .livem .k{display:flex;align-items:center;gap:.5rem}
  .livedot{width:6px;height:6px;border-radius:50%;background:var(--bronze);display:inline-block;flex:none}
  .livedot.on{background:#3fb950;box-shadow:0 0 0 3px rgb(63 185 80 /.18);animation:hmPulse 2.4s infinite}
  /* was `gap:1px` over a --line background — a trick that fakes four 1 px rules.
     That is what made this read as a grid of boxes. Real gaps, no cell fills. */
  .liverow{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
  .liverow b{display:block;font-family:var(--mono);font-weight:400;font-size:.9rem;color:var(--cyan);letter-spacing:.02em}
  .liverow span{font-family:var(--sans);font-size:.56rem;color:var(--faint);line-height:1.3;display:block;margin-top:2px}
  .mrow{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 16px 16px}
  .mrow .k{font-family:var(--sans);font-size:.62rem;font-weight:450;letter-spacing:.005em;color:var(--ink);line-height:1.35}
  .mrow .val{font-family:var(--mono);font-weight:400;font-size:1.05rem;margin-top:4px}
  /* THE DISTRIBUTION HAD 16px TO DRAW IN. `height:32px` with `padding:12px 16px
     4px` and border-box sizing leaves a SIXTEEN pixel content box, so a bar at
     100% was 16px and the chart could not read as a chart at any value. */
  /* THE BARS NEED A FLOOR THAT IS NOT THE CARD'S EDGE. The first attempt set
     `padding:… 0` and put the baseline on `border-bottom`, which lands on the
     PADDING BOX — i.e. exactly where the card ends. The chart drew correctly and
     still looked broken: bars running into a rounded corner with nothing beneath
     them, which reads as clipped rather than as finished.
     So the baseline is drawn at the bars' FEET by a pseudo-element, and the
     padding below it is the card's own breathing room. */
  .histo{position:relative;display:flex;align-items:flex-end;gap:3px;height:78px;padding:10px 16px 16px}
  /* ROOFTOP SOLAR block: the heat panel's grammar in the screening ink. The
     panel ground is dark in both themes, so amber clears 4.5:1 unaided (11:1
     on rgb(9 20 22)). */
  .metric.sep{border-top:1px solid var(--line)}
  .solm .lst.sun{color:var(--sun)}
  .mrow .val.sun{color:var(--sun)}
  .mrow .val small{display:block;font-family:var(--mono);font-size:.5rem;letter-spacing:.08em;text-transform:uppercase;color:var(--bronze);margin-top:2px}
  .conf.screening{background:rgb(242 181 68 /.1);border:1px solid rgb(242 181 68 /.4);color:var(--paper)}
  .conf.screening b{font-family:var(--mono);font-weight:400}
  .solfloor{margin:0;padding:0 16px 16px;font-family:var(--sans);font-size:.66rem;line-height:1.45;color:var(--sun)}
  .histo::after{content:"";position:absolute;inset-inline:16px;bottom:16px;height:1px;background:var(--line)}

  /* SOLID, NOT A GRADIENT, AND THAT WAS THE SECOND HALF OF THE BUG. The fill was
     `linear-gradient(var(--cyan), var(--surface2))` — cyan at the top, near the
     panel's own colour at the bottom. A bar is anchored at the bottom and grows
     up, so a SHORT bar showed only the dark end: the smallest counts were painted
     in the least visible colour in the ramp, on top of being the shortest. Height
     already encodes the value; colour encoding it a second time is what made a few
     cells indistinguishable from none.

     NO `min-height`. It used to be 2px, which is what those dashes were — every
     empty bin painting a stub the same size as a real one. An empty bin is now
     genuinely empty and the baseline below is what says the bin exists. */
  .histo i{flex:1;background:var(--cyan);border-radius:2px 2px 0 0;opacity:.85;transition:height .4s}
  .cta{margin:12px 16px 16px;display:block;width:calc(100% - 32px);background:var(--bronze);color:#0d0a05;border:0;border-radius:8px;padding:9px;font-family:var(--sans);font-size:.7rem;font-weight:600;letter-spacing:.005em;cursor:pointer}

  /* position:relative + z-index so the panel sits ABOVE maplibre's attribution
     control, which is z-index 1 and anchored to the same corner. As `static` the
     z-index never applied, and the control has been covering the bottom of this
     panel — the source attribution line was already half-hidden before the
     pattern note made it obvious. */
  /* same rail, same family — it has to lose the stroke with .panel or it reads
     as the one thing on screen that is still outlined */
  /* Same shadow recipe as .panel. Fill nudged lighter (.88 -> .84) so the legend
     is visibly a DIFFERENT surface from the readout above it — two identical
     dark rectangles 22px apart still want to fuse; a tonal step stops that. */
  /* .96 like --rail-ground, and for the same reason: at .84 the legend's own
     scale numbers sat on whatever the map happened to be showing under them. */
  .legend{position:relative;z-index:5;width:100%;flex:none;margin-top:auto;background:rgb(9 20 22 /.96);border-radius:12px;backdrop-filter:blur(16px);box-shadow:0 1px 2px rgb(0 0 0 /.45),0 8px 18px rgb(0 0 0 /.35);padding:12px 15px 7px}
  .legend .k{font-family:var(--mono);font-size:.54rem;letter-spacing:.16em;color:var(--ink);display:flex;justify-content:space-between;margin-bottom:.55rem;text-transform:uppercase}
  /* A gradient colour stop takes var() like any other colour; .ramp is inside
     .legend, inside .stage, so the tokens are in scope. */
  .ramp{height:9px;border-radius:4px;background:linear-gradient(90deg,var(--cyan),var(--sage),var(--bronze),var(--orange),var(--red))}
  .legend .sc{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.52rem;color:var(--faint);margin-top:.4rem}
  .cindex{display:flex;flex-direction:column;gap:.34rem}
  .cindex .ci{display:flex;align-items:center;gap:.6rem;font-size:.7rem;color:var(--paper)}
  .cindex .ci .d{width:15px;height:15px;border-radius:4px;flex:none}
  .legend .attr{font-family:var(--mono);font-size:.48rem;letter-spacing:.05em;color:var(--faint);margin-top:.8rem;line-height:1.75;text-transform:none}

  .strip{display:flex;gap:1px;background:var(--line);border-top:1px solid var(--line);position:relative;z-index:5}
  .ward{flex:1;background:rgb(5 6 6 /.85);padding:12px 20px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:.2s}
  .ward:hover{background:var(--surface)}
  .ward.on{background:var(--surface)}
  .ward .sw{width:44px;height:44px;border-radius:8px;flex:none;border:1px solid var(--line)}
  .ward .nm{font-weight:600;font-size:.86rem;letter-spacing:-.01em}
  .ward .ty{font-family:var(--mono);font-size:.5rem;letter-spacing:.12em;color:var(--ink);margin-top:2px;text-transform:uppercase}
  .ward .big{margin-left:auto;text-align:right;font-family:var(--mono);font-weight:400;font-size:1.35rem}
  .ward .big span{font-size:.55rem;color:var(--ink);display:block;letter-spacing:.14em;margin-top:2px;text-transform:uppercase}

  /* The un-instrumented state — an area the registry names but ships no artefacts
     for. Deliberately plain: it is a statement, not a degraded instrument, and
     anything that looked like a dial here would imply a reading behind it. */
  .notyet{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.5rem;padding:6vh 8vw;overflow:auto}
  .notyet-tier{font-family:var(--mono);font-size:.58rem;letter-spacing:.34em;text-transform:uppercase;color:var(--bronze)}
  .notyet-h{font-weight:600;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.92;letter-spacing:-.04em}
  .notyet-sub{font-family:var(--mono);font-size:.58rem;letter-spacing:.24em;text-transform:uppercase;color:var(--ink)}
  .notyet-body{max-width:52ch;margin-top:1.2rem;color:var(--ink);font-size:.92rem;line-height:1.65}
  .notyet-links{margin-top:1.4rem}
  .notyet-links a{font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);text-decoration:none;border-bottom:1px solid var(--line);padding-bottom:.3rem}
  .notyet-links a:hover{border-bottom-color:var(--cyan)}

  @media (prefers-reduced-motion: reduce){ .synthetic .d,.livedot{animation:none} }

  /* ── responsive: the console layout is desktop-first. The rail and the sidebar
     are real columns now, so narrowing takes width from the SIDEBAR rather than
     from the map — the map is the thing being read. Below 820px the sidebar goes
     entirely and the rail's panes have nowhere to open; that width already has no
     true phone layout (bottom sheets are the separate P5 mobile task), and a 300px
     column over a 520px map would leave neither usable. ── */
  @media (max-width:1180px){
    .stage{--sidebar:270px}
    /* Above the chip row, not beside it: from here the centred chips reach far
       enough left to sit under the compass. */
    .compass{bottom:120px}
    .maplibregl-ctrl-bottom-left{margin:0 0 22px 110px}
    .rail-r{width:222px;right:18px;top:18px;bottom:18px}
    .place .n{font-size:clamp(1.7rem,3.2vw,2.7rem)}
    .synthetic{font-size:.5rem;letter-spacing:.16em}
    .stamp-slot{top:62px;--stamp-size:.54rem;--stamp-pad:.4rem .8rem;--stamp-tracking:.2em}
  }
  @media (max-width:1120px){
    .stage{--sidebar:250px}
    /* BOTH right-hand blocks, not just .read. The rig readout used to be a line
       INSIDE .read and went away with it here; split into its own element it would
       have reappeared on the one width where there is no room for it. */
    .top .topmeta{display:none}
  }
  @media (max-width:980px){
    /* index retreats — the ward name is already in the breadcrumb + bottom strip */
    .place,.legend{display:none}
    .synthetic .full{display:none}      /* short honesty tag ("heat field modelled") fits the gap */
    #envchip,#tintchip{display:none}    /* keep the primary 3D/2D view toggle; drop the style refinements */
  }
  /* ═══════════════════════════════════════════════════════════════════════════
     PHONES. Everything below is gated on a COARSE POINTER, so no laptop or
     narrow desktop window ever sees it — the desktop console keeps the four
     width breakpoints above unchanged.

     The shape is a handheld HUD, not a shrunken desktop: the map is the whole
     screen and every control floats over it, small, tucked into a corner, and
     dismissible. Nothing permanent is taller than 44px.

     WHY LANDSCAPE GETS THE REBUILD. Measured before writing any of this: at
     844x390 the console sits ABOVE its own 820px breakpoint, so the full desktop
     layout returned — rail, 250px sidebar, scope switcher — three columns of
     chrome over a 390px-tall map, with ten elements measured off-screen. A phone
     in landscape was getting the WORST layout, which is why the nudge alone
     would not have been enough.
     ═══════════════════════════════════════════════════════════════════════ */

  /* BOTH PHONE ELEMENTS ARE DISPLAY:NONE BY DEFAULT, AND THAT IS LOAD-BEARING.
     They are direct children of `.stage`, which is a grid with ONE declared row
     (grid-template-rows:100%). A child with any other display becomes a grid item,
     auto-places into an implicit SECOND row, and the main column — pushed into it —
     collapses: measured `744px 22px` on the stage with the map at 0px tall and the
     ward strip rendering below the viewport. Scoping the scrim's display:none to the
     landscape media query alone did exactly that on every other width, desktop
     included. Give them no box unless their own query is live. */
  .rotate-nudge,.sheet-scrim,.entry{display:none}

  /* ── the entry note (touch screens, once per session) ── */
  @media (pointer:coarse){
    .entry:not([hidden]){
      position:fixed; inset:0; z-index:70; display:grid; place-items:center;
      padding:5vh 5vw; background:rgb(5 6 6 /.82); backdrop-filter:blur(6px);
      animation:entry-in .32s cubic-bezier(.16,1,.3,1) both;
    }
    .entry-card{
      max-inline-size:34rem; padding:clamp(1.2rem,4vw,2rem);
      background:var(--panel-ground,rgb(9 20 22 /.97));
      border:1px solid var(--line); border-radius:14px;
      box-shadow:0 24px 60px rgb(0 0 0 /.6);
    }
    .entry-k{font-family:var(--mono);font-size:.56rem;letter-spacing:.2em;
             text-transform:uppercase;color:var(--bronze);margin-bottom:.9rem}
    .entry-h{font-size:clamp(1.5rem,5vw,2.1rem);font-weight:500;letter-spacing:-.03em;
             line-height:1.06;color:var(--paper);margin-bottom:.9rem}
    .entry-h em{font-style:normal;color:var(--cyan)}
    .entry-b{font-size:.94rem;font-weight:300;line-height:1.55;color:var(--ink);margin-bottom:.7rem}
    .entry-b-sm{font-family:var(--mono);font-size:.58rem;letter-spacing:.13em;
                text-transform:uppercase;color:var(--ink-faint,var(--ink));margin-bottom:1.3rem}
    .entry-go{
      inline-size:100%; min-block-size:48px; border:0; border-radius:9px; cursor:pointer;
      font-family:var(--mono); font-size:.68rem; letter-spacing:.16em; text-transform:uppercase;
      color:var(--base); background:var(--cyan);
    }
    @keyframes entry-in{from{opacity:0}to{opacity:1}}
  }
  @media (prefers-reduced-motion: reduce){ .entry:not([hidden]){animation:none} }
  /* landscape phones: the card cannot be taller than the screen */
  @media (pointer:coarse) and (orientation:landscape) and (max-height:560px){
    .entry-card{max-block-size:86vh;overflow:auto}
    .entry-h{font-size:1.25rem}
    .entry-b{font-size:.82rem}
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     TABLETS. A coarse pointer with room — the desktop layout is right here, and
     the phone HUD would waste the screen. What a tablet needs is not a different
     shape but BIGGER TARGETS: the desktop console is built for a cursor, and a
     finger is about 44px wide.

     WHY LANDSCAPE NEEDED ITS OWN RULE. Measured: at 1133x744 and 1180x820 the
     sidebar rendered 2px tall, the readout 0px, and the ward strip BELOW the
     viewport — the console's `--sidebar` column plus a full-height right rail
     leaves no room on a screen that is wide but short. Landscape tablets get the
     sidebar narrowed and the readout capped instead.
     ═══════════════════════════════════════════════════════════════════════ */
  /* min-height guards the phone HUD: a landscape phone at 1024x460 CSS px matches
     min-width:821px too, and these rules — written later — were overriding it. */
  @media (pointer:coarse) and (min-width:821px) and (min-height:561px){
    /* fingers, not cursors */
    .modechip button{padding:9px 14px;font-size:.6rem}
    .ward{padding:14px 18px}
    .seg button{min-block-size:40px}
    .bcard{width:250px}
    .bcard dl{font-size:.76rem}
    .bc-x{min-block-size:42px}
    /* the toolbox sliders are the smallest thing a finger has to hit */
    input[type=range]{block-size:34px}
    input[type=range]::-webkit-slider-thumb{width:22px;height:22px}
  }
  /* landscape tablets: wide but short */
  @media (pointer:coarse) and (min-width:821px) and (orientation:landscape) and (min-height:561px) and (max-height:900px){
    .stage{--sidebar:250px}
    /* SCROLLS RATHER THAN CLIPS. Capping this column with overflow:hidden cut the
       colour legend off the bottom — the one thing that explains what the map's
       colours mean. A tablet has room to scroll for it. */
    .rail-r{width:210px;top:56px;bottom:26px;max-block-size:none;overflow-y:auto;overscroll-behavior:contain}
    .rail-r .histo,.rail-r #histo{display:none}
    .ward{padding:10px 14px}
    .ward .sw{width:34px;height:34px}
    .ward .big{font-size:1.1rem}
    .compass{bottom:112px}
  }

  /* ── the nudge (portrait phones only) ── */
  @media (pointer:coarse) and (orientation:portrait){
    .rotate-nudge:not([hidden]){
      position:fixed; left:10px; right:10px; bottom:calc(10px + env(safe-area-inset-bottom));
      z-index:60; display:flex; align-items:center; gap:9px;
      padding:9px 10px; border-radius:11px;
      background:rgb(9 20 22 /.95); border:1px solid rgb(111 202 214 /.28);
      backdrop-filter:blur(10px); box-shadow:0 8px 28px rgb(0 0 0 /.5);
      animation:rn-in .5s cubic-bezier(.16,1,.3,1) both;
    }
    .rn-ico{flex:none;width:19px;height:19px;color:var(--cyan)}
    .rn-ico svg{width:100%;height:100%;animation:rn-tip 2.6s ease-in-out infinite}
    .rn-txt{flex:1;font-family:var(--mono);font-size:.58rem;letter-spacing:.11em;
            text-transform:uppercase;color:var(--paper);line-height:1.35}
    .rn-x{flex:none;width:30px;height:30px;border:0;background:none;color:var(--ink);
          font-size:.8rem;cursor:pointer;border-radius:8px}
    @keyframes rn-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
    @keyframes rn-tip{0%,62%,100%{transform:rotate(0)}80%{transform:rotate(-82deg)}}
  }
  @media (prefers-reduced-motion: reduce){
    .rotate-nudge:not([hidden]){animation:none}
    .rn-ico svg{animation:none}
  }

  /* ── landscape phones: the HUD ── */
  /* PHONES, EITHER ORIENTATION. Portrait still gets the nudge — sideways is a
     better read — but someone who ignores it should not get a console that
     overflows its own screen. Measured before: a 639px canvas in a 390px
     viewport, the map cut off at the right edge. */
  @media (pointer:coarse) and (max-width:560px),
         (pointer:coarse) and (orientation:landscape) and (max-height:560px){
    .stage{grid-template-columns:minmax(0,1fr)}
    .col{grid-column:1}
    .rotate-nudge{display:none}

    .top{padding:5px 10px;min-height:0}
    .top .read,.top .topmeta{display:none}

    /* The rail's bottom-bar form lives in IconRail.astro — its styles are scoped,
       so a bare `.rail` here could never outrank them. */

    /* THE SIDEBAR BECOMES A SHEET. Driven by data-panel on <html>, which
       console-shell.ts already writes when a rail button opens a pane — so the
       sheet needs no state of its own and cannot disagree with the rail. */
    .sidebar{
      position:fixed; inset-inline:0; bottom:0; top:auto;
      /* the desktop panel floats on an inset margin; a full-width sheet must not */
      margin:0;
      inline-size:100%; max-block-size:62vh; z-index:45;
      border-radius:14px 14px 0 0; border-inline:0; border-block-end:0;
      padding-bottom:calc(44px + env(safe-area-inset-bottom));
      transform:translateY(101%); transition:transform .32s cubic-bezier(.16,1,.3,1);
      overflow:hidden auto; overscroll-behavior:contain;
    }
    html[data-panel="expanded"] .sidebar{transform:none}
    .sidebar.is-collapsed{transform:translateY(101%)}
    .sidebar::before{
      content:''; position:sticky; top:0; display:block; z-index:2;
      inline-size:34px; block-size:3px; margin:7px auto 3px;
      border-radius:2px; background:rgb(236 237 240 /.3);
    }
    .sheet-scrim{display:none; position:fixed; inset:0; z-index:44;
                 border:0; background:rgb(5 6 6 /.5); backdrop-filter:blur(1px)}
    html[data-panel="expanded"] .sheet-scrim{display:block}

    /* THE READOUT COLLAPSES. The 242px column was a quarter of the width; the
       first card carries the ward, its mean and the band, and the rest is a tap
       away in the sheet. */
    .rail-r{
      inset:32px 8px auto auto; inline-size:auto;
      max-inline-size:44vw; max-block-size:none;
      flex-direction:column; gap:5px; overflow:visible;
    }
    /* only the first card rides the HUD; the rest are a tap away in the sheet */
    .rail-r > * + *{display:none}
    /* AND THE CARD ITSELF SHRINKS RATHER THAN CLIPS. Capping its height cut the
       mean surface temperature in half — the one number the card exists to show.
       Scaling the type down instead keeps the whole reading, band included. */
    .rail-r .panel{padding:7px 9px;border-radius:9px;gap:5px}
    .rail-r .liverow{font-size:.52rem;letter-spacing:.08em}
    .rail-r .mrow{gap:7px}
    .rail-r .metric .val{font-size:.82rem}
    .rail-r .metric .k,.rail-r .metric .u{font-size:.42rem;letter-spacing:.07em}
    .rail-r .lst{font-size:1.5rem}
    .rail-r .conf{font-size:.46rem;padding:.22rem .4rem}
    /* the distribution chart is the tallest thing in the card and the least
       legible at this size — it is in the sheet, a tap away, at a usable size */
    .rail-r .histo,.rail-r #histo{display:none}
    /* and a hard stop, so no future addition to this card can push it off-screen */
    .rail-r .panel{max-block-size:calc(100dvh - 92px);overflow:hidden}

    /* THE WARD STRIP BECOMES CHIPS. The cards are 200px+ each and cannot
       survive; the swatch, the name and the mean fit a 30px chip. */
    .strip{
      position:fixed; left:8px; bottom:calc(50px + env(safe-area-inset-bottom));
      right:auto; z-index:30; gap:5px; background:none; border:0;
    }
    .ward{
      flex:none; gap:6px; padding:5px 8px; border-radius:9px;
      background:rgb(9 20 22 /.9); border:1px solid var(--line);
      backdrop-filter:blur(8px);
    }
    .ward .sw{width:15px;height:15px;border-radius:4px}
    .ward .nm{font-size:.6rem;font-weight:500}
    .ward .ty{display:none}
    .ward .big{margin-left:4px;font-size:.76rem}
    .ward .big span{display:none}

    /* the rest of the HUD: smaller, tucked to the edges */
    /* the bottom edge is a STACK, not a row — the ward chips and the mode chips
       were both at 50px and overlapped ('Barrackpore' over '3D RELIEF') */
    .chiprow{bottom:calc(92px + env(safe-area-inset-bottom));gap:5px}
    .modechip button{padding:5px 9px;font-size:.5rem;letter-spacing:.1em}
    .compass{width:44px;height:44px;bottom:auto;top:34px;left:8px}
    .sunline{left:58px;bottom:auto;top:40px;font-size:.46rem;max-width:150px}
    .synthetic{top:34px;font-size:.42rem;letter-spacing:.1em;padding:.26rem .5rem}
    .synthetic .full,.synthetic .sp{display:none}
    .stamp-slot,.place,.legend,.tiphint{display:none}
    .loadchip{font-size:.5rem;padding:.3rem .6rem}
    .maplibregl-ctrl-bottom-left,.maplibregl-ctrl-bottom-right{display:none}
    .bcard{width:180px}
    .bcard dl{font-size:.62rem}

    /* THE CLOCK AND THE TREES TOGGLE MOVE TO THE LEFT COLUMN. Both are pinned with
       `right:var(--instr-inset)` — a desktop offset sized for the right rail, which
       on a 390px screen puts them off the LEFT edge (measured: both cut off). Under
       the compass they have the one column the HUD leaves free. */
    .clockw{right:auto;left:8px;top:86px;padding:6px 9px 7px}
