---
// Full-bleed instrument markup for /heat-map. Behaviour is mounted by
// src/scripts/climate-engine/heat-map-app.ts (booted from the page). Styles are
// is:global but only bundled onto /heat-map (the sole page importing this).
// Brand tokens are scoped to .stage so nothing leaks to :root; Mona Sans /
// Noplato Mono come from global.css.
---
<div class="stage">
  <header class="top">
    <a class="brand" href="/" aria-label="Back to Delta Climate Research home"><span class="ar" aria-hidden="true">←</span>Delta<span class="dot">·</span>Climate<span class="dot">·</span>Research</a>
    <div class="tabs" id="tabs">
      <button class="tab on" data-w="ballygunge">Ballygunge</button>
      <button class="tab" data-w="baruipur">Baruipur</button>
      <button class="tab" data-w="barrackpore">Barrackpore</button>
    </div>
    <div class="read">MEDNI · HEAT INSTRUMENT<br><b id="coord">22.528° N · 88.366° E</b><br><span id="bcount">— buildings</span> · GPU SIM</div>
  </header>

  <div class="map">
    <div id="mlmap"></div>
    <div class="synthetic"><span class="d"></span><span class="full">Live basemap + real footprints &amp; Google heights · </span>heat field modelled</div>
    <div class="loadchip" id="loadchip">Building ward…</div>

    <div class="place">
      <div class="n" id="pname">Bally<em>gunge</em></div>
      <div class="z" id="pzone">Urban Core · Ward 68</div>
    </div>
    <div class="chiprow">
      <div class="modechip" id="modechip"><button class="on" data-m="relief">3D Relief</button><button data-m="iso">2D Isotherm</button></div>
      <div class="modechip" id="envchip"><button class="on" data-e="dark">Dark map</button><button data-e="studio">Clay studio</button></div>
      <div class="modechip" id="tintchip" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><button class="on" data-t="1">Gradient</button><button data-t="2">5-Class</button></div>
    </div>

    <aside class="panel left">
      <div class="h">Green Infrastructure Toolbox</div>
      <div class="ctl"><label>Tree canopy corridors <span class="v" id="v1">0</span></label><input type="range" id="ivTrees" min="0" max="50" value="0" aria-label="Tree canopy corridors"></div>
      <div class="ctl"><label>Cool-roof albedo <span class="v" id="v2">0%</span></label><input type="range" id="ivRoof" min="0" max="100" value="0" step="5" aria-label="Cool-roof albedo, percent of roofs treated"></div>
      <div class="ctl"><label>Vertical green facades <span class="v" id="v4">0</span></label><input type="range" id="ivFacades" min="0" max="15" value="0" aria-label="Vertical green facades"></div>
      <div class="ctl"><label style="margin-bottom:.35rem">Diurnal phase</label><div class="seg" id="segPhase"><button class="on" data-p="peak">13:00 Peak</button><button data-p="night">22:00 Retained</button></div></div>
      <div class="ctl"><label style="margin-bottom:.35rem">Projection pathway</label><div class="seg" id="segPath"><button data-p="2025">2025</button><button class="on" data-p="target">Δ-Target ’30</button><button data-p="bau">BAU ’40</button></div></div>
      <div class="score">
        <div class="g">
          <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15.5" fill="none" stroke="#093a3e" stroke-width="3"></circle><circle id="scoreArc" cx="18" cy="18" r="15.5" fill="none" stroke="#6fcad6" stroke-width="3" stroke-dasharray="97" stroke-dashoffset="97" stroke-linecap="round" transform="rotate(-90 18 18)"></circle></svg>
          <div class="num" id="scoreNum">—</div>
        </div>
        <div class="t"><b>Green Score</b><span id="scoreTxt">move a slider to intervene</span></div>
      </div>
    </aside>

    <aside class="panel right">
      <div class="metric livem">
        <div class="k">Live ambient · Met Norway <span class="livedot" id="livedot"></span></div>
        <div class="liverow">
          <div><b id="liveT">—</b><span>air °C</span></div>
          <div><b id="liveFeel">—</b><span>feels °C</span></div>
          <div><b id="liveRH">—</b><span>% RH</span></div>
          <div><b id="liveWind">—</b><span>m/s wind</span></div>
        </div>
      </div>
      <div class="metric">
        <div class="k">Mean Surface Temp · modelled</div>
        <div class="lst" id="lst" style="color:var(--red)">—<span class="u">°C</span></div>
      </div>
      <div class="mrow">
        <div><div class="k">UHI Δ vs rural</div><div class="val" style="color:var(--cyan)" id="uhi">—</div></div>
        <div><div class="k">Area &gt; 40°C</div><div class="val" style="color:var(--red)" id="area">—</div></div>
      </div>
      <div class="metric" style="border-top:1px solid var(--line);border-bottom:0"><div class="k">Heat-stress distribution</div></div>
      <div class="histo" id="histo"></div>
      <button class="cta">Generate ward report ↗</button>
    </aside>

    <div class="legend">
      <div class="k" style="margin-bottom:.6rem"><span>What the colours mean</span></div>
      <div class="cindex">
        <div class="ci"><span class="d" style="background:#e5484d"></span>Extreme</div>
        <div class="ci"><span class="d" style="background:#d46b4a"></span>Severe</div>
        <div class="ci"><span class="d" style="background:#b08d57"></span>Hot</div>
        <div class="ci"><span class="d" style="background:#9fb98a"></span>Warm</div>
        <div class="ci"><span class="d" style="background:#6fcad6"></span>Comfortable</div>
      </div>
      <div class="k" style="margin:.9rem 0 .5rem"><span>Land Surface Temp</span><span>°C</span></div>
      <div class="ramp"></div>
      <div class="sc"><span>26</span><span>32</span><span>37</span><span>42</span><span>48+</span></div>
      <div class="attr">Basemap © OpenStreetMap · OpenFreeMap · Footprints © Microsoft (ODbL) · Heights Google Open Buildings 2.5D (CC BY 4.0) · left-drag orbit · right-drag pan · scroll zoom</div>
    </div>
  </div>

  <div class="strip" id="strip">
    <div class="ward on" data-w="ballygunge"><span class="sw" style="background:radial-gradient(circle at 40% 40%,#e5484d,#b08d57 55%,#093a3e)"></span><div><div class="nm">Ballygunge</div><div class="ty">Urban Core</div></div><div class="big" id="big-ballygunge">—<span>°C mean</span></div></div>
    <div class="ward" data-w="baruipur"><span class="sw" style="background:radial-gradient(circle at 40% 40%,#9fb98a,#6fcad6 60%,#093a3e)"></span><div><div class="nm">Baruipur</div><div class="ty">Peri-Urban Fringe</div></div><div class="big" id="big-baruipur">—<span>°C mean</span></div></div>
    <div class="ward" data-w="barrackpore"><span class="sw" style="background:radial-gradient(circle at 40% 40%,#d46b4a,#b08d57 55%,#093a3e)"></span><div><div class="nm">Barrackpore</div><div class="ty">Industrial Corridor</div></div><div class="big" id="big-barrackpore">—<span>°C mean</span></div></div>
  </div>
</div>

<style is:global>
  body{ overflow:hidden; }
  .stage{
    --base:#050606; --surface:#0b2c2e; --surface2:#093a3e;
    --paper:#ecedf0; --ink:#8fa3a5; --faint:#5c7173; --line:rgb(111 202 214 / 0.14);
    --cyan:#6fcad6; --bronze:#b08d57; --red:#e5484d;
    --sans:'Mona Sans',system-ui,sans-serif; --mono:'Noplato Mono',ui-monospace,'SF Mono',monospace;
    position:fixed; inset:0; display:grid; grid-template-rows:auto 1fr auto;
    background:var(--base); color:var(--paper); font-family:var(--sans);
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  }
  .stage *{ box-sizing:border-box; margin:0; }

  .top{display:flex;align-items:center;justify-content:space-between;padding:18px 26px;border-bottom:1px solid var(--line);position:relative;z-index:5;background:rgb(5 6 6 /.55);backdrop-filter:blur(8px)}
  .brand{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:.98rem;letter-spacing:-.01em;color:var(--paper);text-decoration:none;transition:color .2s}
  .brand .ar{color:var(--cyan);opacity:.5;font-weight:400;transition:opacity .2s,transform .2s}
  .brand:hover{color:#fff}
  .brand:hover .ar{opacity:1;transform:translateX(-3px)}
  .brand:focus-visible{outline:2px solid var(--cyan);outline-offset:4px;border-radius:5px}
  .brand .dot{color:var(--cyan)}
  .tabs{display:flex;gap:4px;background:rgb(9 58 62 /.5);border:1px solid var(--line);border-radius:10px;padding:4px}
  .tab{font-family:var(--mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);background:none;border:0;cursor:pointer;padding:.55rem .95rem;border-radius:7px;transition:.2s}
  .tab.on{background:var(--cyan);color:var(--base);font-weight:400}
  .top .read{text-align:right;font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;color:var(--faint);line-height:1.7;text-transform:uppercase}
  .top .read b{color:var(--cyan);font-weight:400}

  .map{position:relative;overflow:hidden}
  #mlmap{position:absolute;inset:0}
  .maplibregl-ctrl-attrib{font-family:var(--mono);font-size:.46rem}
  .maplibregl-ctrl-bottom-right{z-index:1}
  .place{position:absolute;left:50%;top:34%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;z-index:1}
  .place .n{font-weight:600;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.92;letter-spacing:-.04em;text-shadow:0 4px 40px rgb(0 0 0 /.85);opacity:.82}
  .place .n em{font-style:normal;color:var(--cyan)}
  .place .z{font-family:var(--mono);font-size:.58rem;letter-spacing:.34em;color:var(--bronze);margin-top:.7rem;text-transform:uppercase;opacity:.9}
  .chiprow{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);display:flex;gap:8px;z-index:3}
  .modechip{display:flex;gap:2px;background:rgb(5 6 6 /.7);border:1px solid var(--line);border-radius:9px;padding:3px;backdrop-filter:blur(8px)}
  .modechip button{font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;color:var(--ink);background:none;border:0;cursor:pointer;padding:.4rem .8rem;border-radius:6px;text-transform:uppercase}
  .modechip button.on{background:var(--surface2);color:var(--paper)}
  body.studio .place .n{color:#232b2d;text-shadow:0 4px 34px rgb(255 255 255/.6)}
  body.studio .place .n em{color:#0e7b8c}
  body.studio .place .z{color:#8a6d3f}
  body.studio .loadchip{color:#0e7b8c}

  .synthetic{position:absolute;top:20px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.56rem;letter-spacing:.2em;color:var(--bronze);background:rgb(176 141 87 /.14);border:1px solid rgb(176 141 87 /.3);border-radius:20px;padding:.42rem .9rem;z-index:3;text-transform:uppercase;backdrop-filter:blur(8px)}
  .synthetic .d{width:6px;height:6px;border-radius:50%;background:var(--bronze);animation:hmPulse 2.2s infinite}
  @keyframes hmPulse{0%,100%{opacity:1}50%{opacity:.3}}
  .loadchip{position:absolute;top:58px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:.52rem;letter-spacing:.26em;color:var(--cyan);z-index:3;text-transform:uppercase;opacity:0;transition:opacity .25s}
  .loadchip.on{opacity:1}

  .panel{position:absolute;background:rgb(9 20 22 /.82);border:1px solid var(--line);border-radius:14px;backdrop-filter:blur(16px);box-shadow:0 20px 60px rgb(0 0 0 /.5);z-index:4}
  .panel .h{font-family:var(--mono);font-size:.58rem;letter-spacing:.18em;color:var(--ink);padding:14px 18px 0;text-transform:uppercase}
  .left{left:26px;top:26px;bottom:26px;width:270px;padding-bottom:16px;overflow:auto}
  .right{right:26px;top:26px;width:280px}

  .ctl{padding:14px 18px;border-bottom:1px solid var(--line)}
  .ctl:last-child{border-bottom:0}
  .ctl label{display:flex;justify-content:space-between;font-size:.72rem;color:var(--paper);margin-bottom:.5rem}
  .ctl label .v{font-family:var(--mono);color:var(--cyan);letter-spacing:.05em}
  .stage input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:3px;border-radius:2px;background:var(--surface2);outline:none}
  .stage input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--cyan);cursor:pointer;box-shadow:0 0 0 4px rgb(111 202 214 /.15)}
  .stage input[type=range]:focus-visible{box-shadow:0 0 0 2px var(--cyan)}
  .seg{display:flex;gap:2px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:3px;margin-top:.3rem}
  .seg button{flex:1;font-family:var(--mono);font-size:.54rem;letter-spacing:.1em;color:var(--ink);background:none;border:0;cursor:pointer;padding:.45rem;border-radius:5px;text-transform:uppercase}
  .seg button.on{background:var(--surface2);color:var(--paper)}

  .score{display:flex;align-items:center;gap:14px;padding:16px 18px}
  .score .g{position:relative;width:64px;height:64px;flex:none}
  .score .g .num{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--mono);font-size:1.05rem;color:var(--cyan)}
  .score .t{font-size:.66rem;color:var(--ink);line-height:1.5}
  .score .t b{display:block;color:var(--paper);font-size:.82rem;font-family:var(--sans);font-weight:600;letter-spacing:-.01em;margin-bottom:2px}

  .metric{padding:16px 18px;border-bottom:1px solid var(--line)}
  .metric .k{font-family:var(--mono);font-size:.54rem;letter-spacing:.16em;color:var(--ink);text-transform:uppercase}
  .metric .lst{font-family:var(--mono);font-weight:400;font-size:2.7rem;line-height:1;margin-top:.35rem;letter-spacing:.01em;transition:color .4s}
  .metric .lst .u{font-size:1rem;color:var(--ink);margin-left:.15rem}
  .livem .k{display:flex;align-items:center;gap:.5rem}
  .livedot{width:6px;height:6px;border-radius:50%;background:var(--bronze);display:inline-block;flex:none}
  .livedot.on{background:#3fb950;box-shadow:0 0 0 3px rgb(63 185 80 /.18);animation:hmPulse 2.4s infinite}
  .liverow{display:flex;gap:1px;background:var(--line);margin-top:.6rem;border-radius:7px;overflow:hidden}
  .liverow>div{flex:1;background:rgb(9 20 22 /.55);padding:9px 4px;text-align:center}
  .liverow b{display:block;font-family:var(--mono);font-weight:400;font-size:1.05rem;color:var(--cyan);letter-spacing:.02em}
  .liverow span{font-family:var(--mono);font-size:.43rem;letter-spacing:.09em;color:var(--ink);text-transform:uppercase}
  .mrow{display:flex;gap:1px;background:var(--line)}
  .mrow>div{flex:1;background:rgb(9 20 22 /.4);padding:13px 16px}
  .mrow .k{font-family:var(--mono);font-size:.5rem;letter-spacing:.14em;color:var(--ink);text-transform:uppercase}
  .mrow .val{font-family:var(--mono);font-weight:400;font-size:1.15rem;margin-top:.3rem}
  .histo{display:flex;align-items:flex-end;gap:3px;height:40px;padding:14px 18px 4px}
  .histo i{flex:1;background:linear-gradient(var(--cyan),var(--surface2));border-radius:1px;opacity:.8;min-height:2px;transition:height .4s}
  .cta{margin:14px 18px 18px;display:block;width:calc(100% - 36px);background:var(--bronze);color:#0d0a05;border:0;border-radius:9px;padding:.8rem;font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;font-weight:400;cursor:pointer}

  .legend{position:absolute;right:26px;bottom:26px;width:280px;background:rgb(9 20 22 /.82);border:1px solid var(--line);border-radius:12px;backdrop-filter:blur(16px);padding:13px 16px;z-index:4}
  .legend .k{font-family:var(--mono);font-size:.52rem;letter-spacing:.16em;color:var(--ink);display:flex;justify-content:space-between;margin-bottom:.5rem;text-transform:uppercase}
  .ramp{height:8px;border-radius:4px;background:linear-gradient(90deg,#6fcad6,#9fb98a,#b08d57,#d46b4a,#e5484d)}
  .legend .sc{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.5rem;color:var(--faint);margin-top:.35rem}
  .cindex{display:flex;flex-direction:column;gap:.42rem}
  .cindex .ci{display:flex;align-items:center;gap:.55rem;font-size:.68rem;color:var(--paper)}
  .cindex .ci .d{width:14px;height:14px;border-radius:4px;flex:none}
  .legend .attr{font-family:var(--mono);font-size:.46rem;letter-spacing:.05em;color:var(--faint);margin-top:.8rem;line-height:1.7;text-transform:none}

  .strip{display:flex;gap:1px;background:var(--line);border-top:1px solid var(--line);position:relative;z-index:5}
  .ward{flex:1;background:rgb(5 6 6 /.85);padding:12px 20px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:.2s}
  .ward:hover{background:var(--surface)}
  .ward.on{background:var(--surface)}
  .ward .sw{width:44px;height:44px;border-radius:8px;flex:none;border:1px solid var(--line)}
  .ward .nm{font-weight:600;font-size:.86rem;letter-spacing:-.01em}
  .ward .ty{font-family:var(--mono);font-size:.5rem;letter-spacing:.12em;color:var(--ink);margin-top:2px;text-transform:uppercase}
  .ward .big{margin-left:auto;text-align:right;font-family:var(--mono);font-weight:400;font-size:1.35rem}
  .ward .big span{font-size:.55rem;color:var(--ink);display:block;letter-spacing:.14em;margin-top:2px;text-transform:uppercase}

  @media (prefers-reduced-motion: reduce){ .synthetic .d,.livedot{animation:none} }

  /* ── responsive: the floating-instrument layout is desktop-first. It compresses
     through these tiers, then sheds the editorial ward index + meta so nothing
     collides with the data cards (user-reported). Panels stay floating down to
     ~540px; true phone layout (bottom sheets) is the separate P5 mobile task. ── */
  @media (max-width:1180px){
    .left{width:250px;left:18px;top:18px;bottom:18px}
    .right{width:256px;right:18px;top:18px}
    .legend{width:256px;right:18px;bottom:18px}
    .place .n{font-size:clamp(1.7rem,3.2vw,2.7rem)}
    .synthetic{font-size:.5rem;letter-spacing:.16em}
  }
  @media (max-width:980px){
    /* index retreats — the ward name is already in the active tab + bottom strip */
    .place,.legend,.top .read{display:none}
    .top{justify-content:space-between}
    .synthetic .full{display:none}      /* short honesty tag ("heat field modelled") fits the gap */
    #envchip,#tintchip{display:none}    /* keep the primary 3D/2D view toggle; drop the style refinements */
  }
  @media (max-width:820px){
    .tabs{display:none}                 /* ward switch lives in the bottom strip at this width */
    .left,.right{width:238px}
    .synthetic{font-size:.44rem;letter-spacing:.12em;padding:.34rem .62rem}
  }
</style>
