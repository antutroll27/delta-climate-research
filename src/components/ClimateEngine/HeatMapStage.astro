---
// Full-bleed instrument markup for one AREA of /heat-map. Behaviour is mounted by
// src/scripts/climate-engine/heat-map-app.ts (booted from the page). Styles are
// is:global but only bundled onto the heat-map routes (the sole pages importing
// this). Brand tokens are scoped to .stage so nothing leaks to :root; Mona Sans /
// Noplato Mono come from global.css.
import ConstructionStamp from '../states/ConstructionStamp.astro';
import { areaKeysInCity } from '../../scripts/climate-engine/scope/registry.ts';
import { areaPath, DEFAULT_AREA_PATH } from '../../scripts/climate-engine/scope/paths.ts';
import { resolve, type ResolvedScope } from '../../scripts/climate-engine/scope/resolve.ts';
import { tabKind } from '../../scripts/climate-engine/scope/reachability.ts';
import { wardById } from '../../data/wards.ts';

/**
 * THE PAGE TELLS THE INSTRUMENT WHICH AREA IT IS, rather than both assuming.
 *
 * Until the URL carried the area, this file hardcoded Ballygunge's coordinate and
 * three literal `data-w` divs, and heat-map-app.ts separately hardcoded
 * `INITIAL_AREA`. Two places holding one opinion, agreeing only by hand — which is
 * the shape of every defect the scope migration exists to end. The one that had
 * already happened is recorded in tests/unit/standards-ward-record.test.mjs: the
 * download link's static href and the app's boot ward were pinned to each other by
 * a REGEX OVER BOTH SOURCE FILES, because nothing structural made them agree.
 *
 * Now the scope arrives once, from the route, and everything on the page — the
 * readout, the name, the tabs, the strip, the record link, the `data-area` the app
 * boots from — is derived from it. The regex has nothing left to compare, because
 * there is only one copy.
 */
interface Props {
  scope: ResolvedScope;
}

const { scope } = Astro.props;

/* The sibling areas, from the registry, IN THE SAME CITY. `AREA_KEYS` would put
   Al Quoz in Kolkata's tab strip: two cities, two climates, two currencies, and
   the second half shipping no artefacts at all. */
const siblings = areaKeysInCity(scope.key).map(resolve);

/** This page's own URL — so the Explore link points here rather than at a redirect. */
const here = areaPath(scope.key);

/* The ward-table row, where one exists. Coordinate and the <em>-stressed wordmark
   live there and nowhere else; an area that is not in the table (Dubai's three,
   which are our own tiling rather than municipal units) has neither, and gets the
   registry's plain name and an em-dash instead of an invented coordinate. */
const ward = wardById(scope.area.id);

/**
 * The strip swatch, DERIVED from the ward table's baseline vegetation fraction.
 *
 * Three radial-gradient strings used to be pasted here, one per ward. They were
 * never arbitrary — they encode how green the ward is, which is the one thing the
 * strip is comparing — so they are computed from `veg` rather than kept as a fourth
 * per-ward table for someone to update in one place and not the other. It renders
 * the same three swatches it replaced: 0.12 → red/bronze, 0.28 → orange/bronze,
 * 0.62 → sage/cyan, from the legend's own five classes.
 *
 * Every colour here is written as `var()` and not as a hex. This string lands in
 * an inline `style` on `.ward .sw`, which is inside `.stage` — where the tokens
 * are declared — so they resolve; a `var()` used outside that subtree would
 * resolve to nothing and drop the declaration silently.
 */
const swatch = (veg: number): string => {
  const head = veg >= 0.5 ? 'var(--sage)' : veg >= 0.2 ? 'var(--orange)' : 'var(--red)';
  const mid = veg >= 0.5 ? 'var(--cyan) 60%' : 'var(--bronze) 55%';
  return `background:radial-gradient(circle at 40% 40%,${head},${mid},var(--surface2))`;
};

/**
 * The ward strip's rows: the siblings that actually ship artefacts.
 *
 * Built here rather than in the template so the ward-table lookup can be NARROWED
 * rather than asserted. `wardById` returns `Ward | undefined` and an inline `!`
 * would be a promise made to the compiler with nothing keeping it — registry check
 * 7 does in fact pin every data-shipping area to a ward row, but a `!` in the
 * markup would survive that check being weakened. `flatMap` drops a row that has
 * no ward instead, so the failure is a missing tile rather than a thrown render.
 *
 * The short label comes from the SAME descriptor the panel shows, cut at its first
 * separator: "Urban Core · Ward 68" → "Urban Core". The strip has room for the kind
 * and not the number, which is a layout fact, not a second name for the place.
 */
const strip = siblings.flatMap((sib) => {
  const row = wardById(sib.area.id);
  if (row === undefined || !sib.area.hasData) return [];
  return [{
    key: sib.key,
    id: sib.area.id,
    name: sib.area.name,
    kind: sib.area.descriptor.split(' · ')[0],
    swatch: swatch(row.veg),
  }];
});

/* The ward's own data record. `/api/wards/[id]` is generated one route per BARE id
   from src/data/wards.ts, so the key would 404 — and this link is a download, so
   the browser would save the 404 body under a plausible filename rather than show
   it. heat-map-app.ts's `updateReportHref` rebuilds this identically on every area
   switch; the two agree because both read the area id, not because anyone matched
   two strings by eye. */
const reportHref = `/api/wards/${scope.area.id}/metadata.json`;
---
<main id="main" class="stage" data-area={scope.key}>
  <header class="top">
    <div class="top-start">
      <a class="brand" href="/" aria-label="Back to Delta Climate Research home"><span class="ar" aria-hidden="true">←</span><img class="bm" src="/logo-mark-96.webp" alt="" width="30" height="30" decoding="async" /></a>
      <nav class="tool-modes" aria-label="Heat explorer modes">
        {/* `here`, not "/heat-map/". The old href claimed aria-current="page" while
            pointing somewhere else entirely - a link that is both a lie to a screen
            reader and, since /heat-map now redirects, an extra hop for everyone who
            clicks it. Both halves are fixed by pointing it at the page it is on. */}
        <a href={here} aria-current="page">Explore</a>
        <a id="compare-mode-link" href="/heat-map/compare/">Compare</a>
      </nav>
    </div>
    {/* TWO SHAPES, because two different things happen when you press one. A button
        is an in-place area switch handled by heat-map-app.ts, which reads `data-w`
        and rewrites the address bar to match; a link is a navigation the next page
        answers. `tabKind` owns the choice and its docblock owns the reasoning - the
        short version is that BOTH flags matter, and this branched on only one of
        them: the page's, so a non-shipping sibling rendered as a button that reached
        loadWard and was refused in silence. */}
    <div class="tabs" id="tabs">
      {siblings.map((sib) => (tabKind({ pageShipsData: scope.area.hasData, tabShipsData: sib.area.hasData }) === 'switch'
        ? <button class:list={['tab', { on: sib.key === scope.key }]} data-w={sib.area.id}>{sib.area.name}</button>
        : <a class:list={['tab', { on: sib.key === scope.key }]} href={areaPath(sib.key)}>{sib.area.name}</a>))}
    </div>
    {/* THE THIRD LINE IS GATED TOO, and it is the subtlest half-render on the page.
        `#bcount` and `#simBackend` are written by the instrument; their static values
        are the states it starts in. Left standing where no instrument mounts, an area
        with no artefacts would sit for ever under "— buildings · SELECTING ENGINE" —
        which does not read as "nothing ships here", it reads as still loading, and
        that is the one impression this page must not give. So it says what is true
        instead: no artefacts, and the tier that follows from that. */}
    <div class="read">MEDNI · HEAT INSTRUMENT<br><b id="coord">{ward?.coord ?? '—'}</b><br>{scope.area.hasData
      ? <Fragment><span id="bcount">— buildings</span> · <span id="simBackend" aria-live="polite">SELECTING ENGINE</span></Fragment>
      : <span>no artefacts · {scope.tier} tier</span>}</div>
  </header>

  {/* THE DATA GATE, AND IT IS A GATE RATHER THAN A SET OF EMPTY PANELS.
      An area the registry says ships no artefacts has nothing for the model to run
      over. The tempting shape — render the instrument anyway and let it show em-
      dashes — is the exact silent degradation scope/paths.ts was written against: a
      map with no buildings, a legend with no ramp and a resilience score reading
      "unavailable" is indistinguishable at a glance from a city that simply has not
      finished loading, and the only evidence is a console nobody has open.

      Omitting `#mlmap` is also what stops the instrument booting: the page's boot
      script returns early without it, and mountHeatMap centres a MapLibre map on
      `wardOf(area)` BEFORE any of loadWard's refusals can run — an area with no
      ward row has no coordinates, so it would fly to NaN and leave a dead canvas
      under a spinner that never clears. */}
  {scope.area.hasData ? (
  <Fragment>
  <div class="map">
    <div id="mlmap"></div>
    <div class="synthetic"><span class="d"></span><span class="full">Live basemap + real footprints &amp; Google heights · </span>heat field modelled<span class="sp"> · block detail illustrative</span></div>
    <div class="stamp-slot"><ConstructionStamp /></div>
    <div class="loadchip" id="loadchip">Building ward…</div>

    <!-- North reference. The idle orbit turns the map continuously, so without
         this there is no way to know which way you are facing, and no way back. -->
    <!-- Sun reading. A SIBLING of the compass, never a child: the compass is a
         button whose whole box resets the bearing, and text inside it would become
         part of that click target. Always visible rather than a hover tooltip, so
         it works on touch and so the caveat cannot hide. -->
    <p class="sunline" id="sunLine" hidden>
      <span id="sunLineText"></span>
      <span class="sunline-note" id="sunLineNote" tabindex="0" role="note">geometry only</span>
    </p>
    <button class="compass" id="compass" type="button" title="Face north" aria-label="Reset the map to face north">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="21.2" class="c-ring" />
        <!-- Everything that should point at the world lives in this group, which
             JS rotates to the inverse of the map bearing. The N and S letters
             ride along but are counter-rotated by the same angle about their own
             anchors, so they travel to the right compass point while staying
             upright — a letter lying on its side is decoration, not a reading. -->
        <g id="compassDial">
          <path d="M24 9 L29 26 L24 22.6 L19 26 Z" class="c-n" />
          <path d="M24 39 L19 22 L24 25.4 L29 22 Z" class="c-s" />
          <circle cx="38.4" cy="24" r="1.15" class="c-tick" />
          <circle cx="9.6" cy="24" r="1.15" class="c-tick" />
          <text id="compassN" x="24" y="6.4" class="c-lab c-lab-n">N</text>
          <text id="compassS" x="24" y="45.2" class="c-lab">S</text>
          <!-- Sun bearing. Rides INSIDE the rotating dial, like N and S, because
               it is a world direction: turn the map and the sun must stay over
               the ground it is actually shining on. Hidden outright when the sun
               is below the horizon — a bearing at midnight is not a dim reading,
               it is a meaningless one. -->
          <g id="compassSun" class="c-sun is-below">
            <circle cx="24" cy="24" r="1" class="c-sun-hub" />
            <line x1="24" y1="24" x2="24" y2="13.2" class="c-sun-ray" />
            <circle cx="24" cy="11.4" r="3.1" class="c-sun-disc" />
          </g>
        </g>
      </svg>
    </button>

    <!-- Live-reading freshness.
         NOT A CLOCK FOR THE MAP. The simulation is steady-state at one of two
         representative phases; it has no 14:32. This dial describes the DATA —
         the hour met.no's reading is valid for, and how long ago that was — which
         matters because that reading sets the sim's boundary conditions and was,
         until now, fetched once per ward per session and never refreshed. A tab
         left open overnight showed a pulsing green "live" dot over yesterday's
         weather. Click to re-read. -->
    <!-- TWO CONTROLS, NOT ONE. The tile used to be a single button whose click
         forced a live re-read — and that click is the ONLY re-read in the app
         (fetchLive runs on ward load and from here; the 60s timer just
         repaints). Handing the whole tile to a format toggle would leave a dial
         that reports data is 14 hours stale and offers no way to fix it. So the
         face toggles the format and the age line re-reads, each saying which. -->
    <div class="clockw" id="clockw" hidden>
      <!-- Stacked state indicator, the Braun/Rams idiom: BOTH halves of the day
           are always present and only the emphasis moves, so you read "PM out of
           AM/PM" rather than trusting a single changing label.

           The day above them is not decoration. These digits are the WARD's
           clock, not the viewer's — from London at 18:30 GMT this reads 00:00,
           and nothing said it was already tomorrow in Kolkata. This dial exists
           because a tab left open overnight showed a live dot over yesterday's
           weather; without the day it still could not name which day. -->
      <button class="k-face" id="clockFace" type="button" aria-pressed="false">
        <span class="k-stack" aria-hidden="true">
          <span class="k-day" id="clockDay">—</span>
          <!-- In 24-hour mode the meridiem is meaningless, so the pair is
               replaced by the mode itself rather than left dimmed and lying. -->
          <span class="k-mer" id="clockAm">AM</span>
          <span class="k-mer" id="clockPm">PM</span>
          <span class="k-mer k-h24" id="clock24">24H</span>
        </span>
        <span class="k-time" id="clockTime">--:--</span>
      </button>
      <button class="k-age" id="clockAge" type="button">
        <span class="k-sub"><span class="k-age-lab" id="clockAgeLab">—</span></span>
        <!-- Freshness survives the move to digits as a draining rule along the
             bottom edge: the digits say WHEN, the bar says HOW STALE, and the bar
             is the only thing that animates (one transform, no layout). -->
        <span class="k-bar" aria-hidden="true"><i id="clockBar"></i></span>
      </button>
    </div>

    <!-- Vegetation toggle: distinct widget directly below the clock. Shown when the
         clock unhides (ward loaded). Binary on/off in the .modechip idiom. -->
    <div class="vegw" id="vegw" hidden>
      <span class="veg-lab">Trees</span>
      <div class="modechip" id="vegchip" title="Show or hide the modelled tree canopy">
        <button class="on" data-v="1" type="button">On</button>
        <button data-v="0" type="button">Off</button>
      </div>
    </div>

    <!-- Street-view toggle: same widget idiom as Trees, stacked directly below it. -->
    <div class="vegw" id="svw" hidden>
      <span class="veg-lab">Street</span>
      <div class="modechip" id="streetchip" title="Show Mapillary street-level coverage; click a point for the real photo"><button class="on" data-s="0">Off</button><button data-s="1">On</button></div>
    </div>

    <!-- First-run affordance: the buildings became clickable and nothing said so. -->
    <div class="tiphint" id="tiphint" hidden>
      <span>Click any building for its data</span>
      <button type="button" id="tipX" aria-label="Dismiss hint">✕</button>
    </div>

    <!-- Walk-time ring labels. Text is STATIC: the app only toggles `hidden` and
         writes a transform, so nothing rewrites strings on every repaint.
         Two lines each — the headline is the human unit (minutes), the second
         line is the caveat, because a circle drawn on a map reads as "you can
         reach all of this" and a straight-line radius is not that. -->
    <!-- Ring labels are RULER MARKINGS, not findings: one quiet mono line, in
         the ring's own colour, sitting on the circumference like a contour
         label. The old data-chip styling promised a per-building measurement
         and delivered a constant — the reader who commissioned the rings
         misread them twice for exactly that reason. -->
    <div class="ringlab" id="ringNear" hidden>1 min · 80 m</div>
    <div class="ringlab" id="ringFar" hidden>5 min · 400 m</div>

    <!-- The finding: nearest greenery, the number that changes with every
         click. Data-chip anatomy (big value, small label) in the cooling
         green so it belongs to the patches it stands on. -->
    <!-- Two nodes on purpose: the OUTER one is written by the render loop every
         repaint (translate3d onto the cooling patch), the INNER one owns the
         pop-in. Animating one element with both would have the frame loop
         stamping over the animation's transform sixty times a second. Same
         split as .bcard / .bcard-in. -->
    <div class="cooltag" id="coolTag" hidden>
      <div class="cooltag-in" id="coolTagIn">
        <b id="coolTagM">—</b><span>Nearest greenery</span>
      </div>
    </div>

    <!-- Click-to-inspect. Positioned from the building's own ward-metre centroid
         every time MapLibre repaints, so it tracks orbit, pan, zoom and flyTo. -->
    <div class="bsel" id="bsel" hidden aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="bcard" id="bcard" hidden role="dialog" aria-label="Selected building">
      <span class="lead"></span>
      <div class="bcard-in">
        <div class="bc-h"><span>Building</span><span id="bcId">—</span></div>
        <dl>
          <dt>Coordinates</dt><dd id="bcLL">—</dd>
          <dt>Height</dt><dd id="bcH">—</dd>
          <dt>Floors ≈</dt><dd id="bcF">—</dd>
          <dt>Footprint</dt><dd id="bcA">—</dd>
          <dt>Vegetation</dt><dd id="bcV">—</dd>
          <dt>Albedo</dt><dd id="bcAl">—</dd>
          <dt>Surface</dt><dd id="bcT">—</dd>
        </dl>
        <div class="sv-thumb" id="svThumb" hidden></div>
        <p class="bc-rings" id="bcRings"></p>
        <p class="bc-ins" id="bcIns"></p>
        <p class="bc-prov" id="bcSrc"></p>
        <button class="bc-x" id="bcX" type="button" aria-label="Close building details">Close ✕</button>
      </div>
    </div>

    <div class="place">
      {/* `ward.name` carries <em> around the syllable the wordmark stresses, which
          is why this is set:html where `scope.area.name` - markup-stripped, for
          titles and machine-readable fields - is not. */}
      <div class="n" id="pname" set:html={ward?.name ?? scope.area.name}></div>
      <div class="z" id="pzone">{scope.area.descriptor}</div>
    </div>
    <div class="chiprow">
      <div class="modechip" id="modechip"><button class="on" data-m="relief">3D Relief</button><button data-m="iso">2D Isotherm</button></div>
      <div class="modechip" id="envchip"><button class="on" data-e="dark">Dark map</button><button data-e="studio">Clay studio</button></div>
      <div class="modechip" id="tintchip" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><button class="on" data-t="1">Gradient</button><button data-t="2">5-Class</button></div>
    </div>

    <aside class="panel left">
      <div class="h">Green Infrastructure Toolbox</div>
      <div class="ctl"><label>Tree canopy corridors <span class="v" id="v1">0</span></label><input type="range" id="ivTrees" min="0" max="50" value="0" aria-label="Tree canopy corridors"></div>
      <div class="ctl"><label>Cool-roof albedo <span class="v" id="v2">0%</span></label><input type="range" id="ivRoof" min="0" max="100" value="0" step="5" aria-label="Cool-roof albedo, percent of roofs treated"></div>
      <div class="ctl"><label>Vertical green facades <span class="v" id="v4">0</span></label><input type="range" id="ivFacades" min="0" max="15" value="0" aria-label="Vertical green facades"></div>
      <div class="ctl"><label style="margin-bottom:.35rem">Diurnal phase</label><div class="seg" id="segPhase"><button class="on" data-p="now">Now</button><button data-p="peak">13:00 Peak</button><button data-p="night">22:00 Retained</button><button data-p="heatwave">Heatwave</button></div></div>
      {/* THE BUTTONS ARE THE SCOPE'S TABLE, DRAWN. Three were written out here -
          data-p="2025" | "ssp245" | "ssp585" - under a title citing an Indian paper,
          while `pathwayDelta` in heat-map-model.ts fails closed against whatever
          table the scope actually carries. Two countries, one hardcoded control: a
          country with a DIFFERENT populated table would render India's three and
          throw out of the click handler on the first press, and a country with an
          empty table would render three buttons that do nothing, under a citation
          for research it has not adopted. See `PathwayControl`. */}
      <div class="ctl"><label style="margin-bottom:.35rem" title={scope.pathway.source ?? undefined}>Warming pathway</label>{scope.pathway.options.length > 0
        ? <div class="seg" id="segPath">{scope.pathway.options.map((opt) => (
            <button class:list={{ on: opt.key === scope.pathway.initial }} data-p={opt.key}>{opt.label}</button>))}</div>
        /* NOT AN EMPTY <div class="seg">, which would render as a hairline box with
           nothing in it and read as a control still loading. An empty table is a
           DECLARED absence - no regional projection has been adopted - and that is a
           different fact from zero warming, so the control says which. */
        : <p class="segnone">No regional warming pathway has been adopted for {scope.country.name}, so there is nothing to project. This is a stated absence, not a projection of no warming.</p>}</div>
      <div class="score">
        <div class="g">
          {/* `stroke` is an SVG PRESENTATION ATTRIBUTE, not CSS, so `var(--surface2)`
              written here would not resolve — an attribute is parsed by the SVG
              attribute grammar, which has no custom properties. `currentColor` is
              the bridge: it defers to the element's own `color`, which IS CSS and
              takes the token (see `.score .g .track` / `#scoreArc` below).

              #scoreArc keeps its attribute writable on purpose — heat-map-app.ts
              setAttribute('stroke', tier.colour)s it once a score exists, and no CSS
              rule sets `stroke`, so the runtime value still wins. The token only
              paints the pre-score state, exactly as the cyan literal here did. */}
          <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="track" cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-width="3"></circle><circle id="scoreArc" cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="97" stroke-dashoffset="97" stroke-linecap="round" transform="rotate(-90 18 18)"></circle></svg>
          <div class="num" id="scoreNum">—</div>
        </div>
        <div class="t"><b>Resilience Score</b><span class="tier" id="scoreTier">—</span><span id="scoreTxt">move a slider to intervene</span></div>
      </div>
      <!-- The three pillars, shown raw. A composite index is only trustworthy if
           you can see what it is made of; the Green Score published its three
           components for the same reason. Exposure and hazard are shown as their
           COMPLEMENTS (1 − EVI, 1 − THI) so that on every bar, higher is better —
           mixing polarities in one strip is how a reader misreads the worst ward
           as the best. -->
      <div class="subs" id="subs" title="DC-URS pillars, IPCC AR6 framing. Capacity: greenness, albedo and refuge access. Exposure: shown as 1 − EVI, so higher is better; driven by population, built density and social vulnerability, none of which any intervention can move. Hazard: shown as 1 − THI, from measured ECOSTRESS surface temperature.">
        <div><b id="sGreen">—</b><span>capacity</span></div>
        <div><b id="sCool">—</b><span>exposure</span></div>
        <div><b id="sEff">—</b><span>hazard</span></div>
      </div>
      <!-- Written by the app from unmeasured(), which reads the data file's own
           provenance. Deliberately no copy in this file for anyone to forget to
           delete: when socio.json lands the chip removes itself. -->
      <div class="conf indicative scoreconf" id="scoreConf" hidden></div>
    </aside>

    <div class="rail-r">
    <aside class="panel right">
      <div class="metric livem">
        <div class="k">Live ambient · Met Norway <span class="livedot" id="livedot"></span></div>
        <div class="liverow">
          <div><b id="liveT">—</b><span>air °C</span></div>
          <div><b id="liveFeel">—</b><span>feels °C</span></div>
          <div><b id="liveRH">—</b><span>% RH</span></div>
          <div><b id="liveWind">—</b><span>m/s wind</span></div>
        </div>
      </div>
      <div class="metric">
        <div class="k">Mean surface temp · <span id="lstPhase">modelled now</span></div>
        <div class="lst" id="lst" style="color:var(--red)">—<span class="u">°C</span></div>
        <div class="conf" id="conf"></div>
      </div>
      <div class="mrow">
        <div><div class="k" title="Modelled land-cover thermal contrast: this ward's mean surface temperature minus a fully-vegetated reference cell under identical forcing. NOT a measured urban heat island — published Kolkata surface UHI is 0.85–1.5 °C from 1 km satellite data, a different quantity.">Δ vs all-green ref</div><div class="val" style="color:var(--cyan)" id="uhi">—</div></div>
        <div><div class="k">Area above 40 °C</div><div class="val" style="color:var(--red)" id="area">—</div></div>
      </div>
      <div class="metric" style="border-top:1px solid var(--line);padding-bottom:0"><div class="k">Heat-stress distribution</div></div>
      <div class="histo" id="histo"></div>
      {/* `/api/wards/[id]` is generated from src/data/wards.ts, one route per BARE
          id, so this takes the area id and not the key. It used to be a literal that
          a regex over two source files pinned to the app's boot ward; both now come
          from one scope, so the agreement is structural. */}
      <a class="cta" id="report-link" href={reportHref} download
         title="The ward's full data record: what is measured, the out-of-sample error and sample size, every source dataset with its licence, and the analysis CRS and bounding box.">Download ward record ↓</a>
    </aside>

    <div class="legend">
      <div class="k" style="margin-bottom:.6rem"><span>What the colours mean</span></div>
      {/* `style` is an attribute whose CONTENT is CSS, unlike `stroke` above, so
          `var()` resolves here normally. These swatches are inside `.stage`, which
          is where the tokens are declared. */}
      <div class="cindex">
        <div class="ci"><span class="d" style="background:var(--red)"></span>Extreme</div>
        <div class="ci"><span class="d" style="background:var(--orange)"></span>Severe</div>
        <div class="ci"><span class="d" style="background:var(--bronze)"></span>Hot</div>
        <div class="ci"><span class="d" style="background:var(--sage)"></span>Warm</div>
        <div class="ci"><span class="d" style="background:var(--cyan)"></span>Comfortable</div>
      </div>
      <div class="k" style="margin:.9rem 0 .5rem"><span>Land Surface Temp</span><span>°C</span></div>
      <div class="ramp"></div>
      <!-- filled by syncRamp(): the scale moves with the weather, so hardcoded
           numbers here would contradict the colours above them. -->
      <div class="sc" id="rampSc"><span>26</span><span>32</span><span>37</span><span>42</span><span>48</span></div>
      <!-- Filled from accuracy.ts SPATIAL, never hardcoded here: the legend is
           where a reader goes to interpret the colours, so it is where the limit
           of what the colours mean belongs. -->
      <p class="pattern-note" id="patternNote"></p>
      <div class="attr">Basemap © OpenStreetMap · OpenFreeMap · Footprints © Overture Maps Foundation (ODbL) · Heights Google Open Buildings 2.5D (CC BY 4.0) · Water © OpenStreetMap (ODbL) · Ground SRTM via AWS terrain tiles, <span id="terrLab">indicative</span> · Live weather © Met Norway (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>) · Cloud deck drawn at 320 m, real base ~700 m · left-drag orbit · right-drag pan · scroll zoom</div>
      <button class="srcbtn" id="srcBtn" type="button" aria-expanded="false" aria-controls="srcPanel">Data receipts ↗</button>
      <div class="srcpanel" id="srcPanel" role="dialog" aria-label="Per-layer data provenance" hidden></div>
    </div>
    </div>
  </div>

  <!-- Street-view viewer: top-level (outside backdrop-filtered panels) so position:fixed resolves to the viewport. mapillary-js mounts into #svViewer. -->
  <div class="svmodal" id="svModal" hidden>
    <div class="svmodal-card">
      <button class="svmodal-x" id="svClose" type="button" aria-label="Close street view">✕</button>
      <div id="svViewer" class="svmodal-viewer"></div>
      <div class="svmodal-credit">Street imagery · <a href="https://www.mapillary.com" target="_blank" rel="noopener">Mapillary</a> · community-captured (CC BY-SA)</div>
    </div>
  </div>

  {/* The strip only ever lists areas that ship artefacts - it is a comparison of
      measured means, and a tile that can never carry a number is a row of em-dashes
      pretending to be a reading. `big-{id}` takes a BARE id because heat-map-app.ts
      writes into it by that name, from src/data/wards.ts. */}
  <div class="strip" id="strip">
    {strip.map((row) => (
      <div class:list={['ward', { on: row.key === scope.key }]} data-w={row.id}>
        <span class="sw" style={row.swatch}></span>
        <div><div class="nm">{row.name}</div><div class="ty">{row.kind}</div></div>
        <div class="big" id={`big-${row.id}`}>—<span>°C mean</span></div>
      </div>
    ))}
  </div>
  </Fragment>
  ) : (
  <section class="notyet" aria-labelledby="notyet-h">
    <p class="notyet-tier">{scope.tier} tier · {scope.city.koppen} climate</p>
    <h1 class="notyet-h" id="notyet-h">{scope.area.name}</h1>
    <p class="notyet-sub">{scope.area.descriptor} · {scope.city.name}, {scope.country.name}</p>
    {/* What is missing, stated, rather than a spinner or an apology. The gap between
        this tier and a validated one is the thing the twin is asking to be funded to
        close, so naming it is the page's whole content. */}
    <p class="notyet-body">
      This area is registered in the twin and has a permanent address, but no measured
      heat artefacts ship for it yet — no footprints, no surface temperature, no
      canopy. Nothing here would be a reading, so nothing is drawn. The instrument
      runs where the observations do.
    </p>
    <p class="notyet-links"><a href={DEFAULT_AREA_PATH}>Open a validated area →</a></p>
  </section>
  )}
</main>

<style is:global>
  body{ overflow:hidden; }
  .stage{
    --base:#050606; --surface:#0b2c2e; --surface2:#093a3e;
    --paper:#ecedf0; --ink:#8fa3a5; --faint:#5c7173; --line:rgb(111 202 214 / 0.14);
    --cyan:#6fcad6; --bronze:#b08d57; --red:#e5484d;
    /* The confidence-tier green — the `validated` badge on the scope switcher,
       and nothing else. DELIBERATELY NOT --sage, which is the heat ramp's
       Comfortable class: one token serving both a heat class and a trust label
       means tuning the legend silently restates how much we trust a city. */
    --green:#5db98a;
    /* The legend's five heat classes, in order: Comfortable, Warm, Hot, Severe,
       Extreme. The first, third and fifth were already tokens; --sage and --orange
       complete the ramp instead of being spelled by hand in three places each. */
    --sage:#9fb98a; --orange:#d46b4a;
    /* The compass sun: one colour across its disc, ray and hub. */
    --sun:#f2b544;
    /* THREE OF THE LAYER TREE'S SIX DOTS. The other three are --red, --green and
       --ink, which the palette already held; these are the colours the founder's
       mockup wrote as bare hexes beside them. They are declared HERE, with the
       rest of the palette, for the reason --rail-ground gives: a token resolves
       from where it is DECLARED, so shell/LayerTree.astro's scoped rules reach
       them only once the tree is inside .stage, which is where Task 7 puts it.
       --pine is the deeper green that tells individual tree instances from the
       canopy raster; --slate the dimmer grey that tells extruded heights from
       footprint outlines; --gold the one warm mark in the Ground-truth group. */
    --pine:#3f8f66; --slate:#6b7f81; --gold:#c9a227;
    /* The icon rail's ground — a shade under --base, so the console's navigation
       column reads as a step behind the surface it navigates. It is declared here
       with the rest of the palette rather than inside shell/IconRail.astro,
       because a token resolves from where it is DECLARED: the rail's scoped
       styles reach it only once the rail is inside .stage, which is where Task 7
       puts it. */
    --rail-ground:#040808;
    /* Studio (light) mode's three inks — the same descending-emphasis idea as
       --paper/--ink/--faint above, inverted for a light ground. They live here
       rather than on `body.studio` because every element they colour is inside
       .stage, and a token resolves from where it is DECLARED, not where the
       theme class sits. */
    --studio-ink:#16292b; --studio-muted:#4a5c5e; --studio-accent:#0e7b8c;
    --sans:'Mona Sans',system-ui,sans-serif; --mono:'Noplato Mono',ui-monospace,'SF Mono',monospace;
    position:fixed; inset:0; display:grid; grid-template-rows:auto 1fr auto;
    background:var(--base); color:var(--paper); font-family:var(--sans);
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  }
  .stage *{ box-sizing:border-box; margin:0; }

  .top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;padding:18px 26px;border-bottom:1px solid var(--line);position:relative;z-index:5;background:rgb(5 6 6 /.55);backdrop-filter:blur(8px)}
  .top-start{display:flex;align-items:center;gap:clamp(.7rem,1.4vw,1.2rem);min-width:0}
  /* Mark, not wordmark: the tool header is a dense instrument bar and the name is
     already in <title> + the aria-label. Same asset as the site nav on purpose —
     /favicon.svg is the SIMPLIFIED cut drawn for the 16px favicon slot (no contour
     lines), so using it here would show a different logo than every other page. */
  .brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none}
  .brand .ar{color:var(--cyan);opacity:.5;font-size:.98rem;line-height:1;transition:opacity .2s,transform .2s}
  .brand .bm{width:30px;height:30px;display:block;transition:opacity .2s}
  .brand:hover .ar{opacity:1;transform:translateX(-3px)}
  .brand:hover .bm{opacity:.82}
  .brand:focus-visible{outline:2px solid var(--cyan);outline-offset:4px;border-radius:5px}
  /* ── north compass ────────────────────────────────────────────────────────
     Sits opposite the legend so it never fights the right rail. The needle is
     rotated by JS on MapLibre's `render`; only the inner <g> turns, so the dial
     and the label stay upright and readable at any bearing. */
  /* Sits clear of the toolbox, not under it: .left is 270 px wide at a 26 px
     offset, so its right edge is 296 px and anything below 312 px would be
     overlapped. The two follow the panel down at each breakpoint. */
  .compass{position:absolute;left:312px;bottom:26px;z-index:6;width:62px;height:62px;padding:0;cursor:pointer;
    background:rgb(9 20 22 /.82);border:1px solid var(--line);border-radius:50%;backdrop-filter:blur(12px);
    display:grid;place-items:center;transition:border-color .2s,transform .2s}
  .compass:hover{border-color:var(--cyan);transform:scale(1.06)}
  .compass:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
  .compass svg{width:56px;height:56px;display:block}
  .compass .c-ring{fill:none;stroke:var(--line);stroke-width:1}
  .compass .c-n{fill:var(--red)}
  .compass .c-s{fill:rgb(236 237 240 /.34)}
  .compass .c-tick{fill:rgb(236 237 240 /.28)}
  .compass .c-lab{font-family:var(--sans);font-weight:700;font-size:8.4px;text-anchor:middle;
    fill:rgb(236 237 240 /.62)}
  .compass .c-lab-n{fill:var(--red)}
  /* The sun is the one warm thing on a cool dial, so it reads at a glance
     without competing with the red north needle for "most important mark". */
  .compass .c-sun-disc{fill:var(--sun)}
  .compass .c-sun-ray{stroke:var(--sun);stroke-width:1;opacity:.5}
  .compass .c-sun-hub{fill:var(--sun);opacity:.45}
  /* `hidden` is not an SVG attribute — a class is, and it types cleanly. */
  .compass .c-sun.is-below{display:none}
  /* Sits directly above the compass, sharing its left edge so the two read as one
     cluster. Kept narrow: `.tiphint` is centred at bottom:88px, so a long line here
     would collide with it on a normal viewport. */
  .sunline{position:absolute;left:312px;bottom:104px;z-index:6;margin:0;max-width:200px;
    font-family:var(--mono);font-size:7.5px;letter-spacing:.09em;line-height:1.45;
    color:rgb(236 237 240 /.52);text-transform:uppercase;pointer-events:none;white-space:nowrap}
  .sunline[hidden]{display:none}
  /* The caveat is dimmer than the numbers but never hidden — a reader who sees a sun
     on a heat map will assume the model uses it, and it does not. */
  .sunline-note{display:block;font-size:7px;color:rgb(242 181 68 /.5);letter-spacing:.07em;pointer-events:auto;cursor:help}
  .sunline-note:focus-visible{outline:1px solid var(--cyan);outline-offset:2px}
  /* ── live-reading freshness dial ───────────────────────────────────────────
     Sits directly above the compass and borrows its whole visual language, so
     the two read as one instrument cluster: where you are facing, and when the
     data is from. Deliberately NOT styled as a wall clock — no minute hand, no
     numerals — because the map has no time of day to show. */
  /* Digital readout, not a dial, parked immediately left of the evidence rail.
     It qualifies the LIVE AMBIENT block — same row, arm's length — so the
     freshness sits beside the readings it describes rather than beside the
     compass, which answers an unrelated question.

     top: 76 IS LOAD-BEARING, NOT TASTE. The honesty banner is centred and grows
     with its own text, so at 1280 it reaches x 955 while this sits at 891 —
     they overlap horizontally and only the vertical gap keeps them apart. At
     top:52 that gap was 3px, which held on macOS and collided on CI's Linux
     font metrics. 76 puts a real ~27px between them on both. */
  /* SOLID BLOCK, NOT A GLASS PANEL. The numerals sit straight on the colour —
     the Braun/Rams digital-clock idiom — instead of on a translucent tile, so
     the readout is the loudest thing in the component rather than its chrome.

     COLOUR NOW CARRIES THE MAP THEME, SO STALENESS CANNOT. It used to turn the
     digits red; with the block itself coloured per basemap that channel is
     spent, and hue-shifting a red tile to red says nothing. Stale drains the
     colour OUT to grey instead: same reading in both themes, and it is the
     same metaphor the bar already uses. */
  .clockw{--c:var(--cyan);--on:#051416;
    position:absolute;right:320px;top:76px;z-index:6;padding:9px 13px 10px;
    display:flex;flex-direction:column;
    border-radius:12px;border:0;background:var(--c);
    box-shadow:0 7px 20px rgb(0 0 0 /.38);
    transition:background-color .45s ease}
  /* Both children are real buttons; they inherit the block's ink and keep the
     grid the face needs. Hover lifts the whole tile so it still reads as one
     object rather than two stacked chips. */
  .clockw button{appearance:none;background:none;border:0;padding:0;margin:0;
    font:inherit;color:inherit;text-align:left;cursor:pointer;width:100%;display:block}
  .clockw button:focus-visible{outline:2px solid var(--on);outline-offset:2px;border-radius:5px}
  .clockw .k-face{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;
    transition:transform .2s}
  .clockw .k-face:hover{transform:translateY(-1px)}
  .clockw .k-age{margin-top:3px;transition:opacity .2s}
  .clockw .k-age:hover{opacity:.72}
  .clockw .k-age[disabled]{cursor:progress;opacity:.6}
  body.studio .clockw{--c:var(--red);--on:#1b0405}
  /* Grey is a hue-free "not live" that reads identically on either basemap.
     BOTH SELECTORS ARE REQUIRED, AND THIS BLOCK MUST COME LAST. A lone
     `.clockw[data-age="stale"]` ties `body.studio .clockw` on specificity
     (0,2,0 each), so source order decided it and Clay studio kept a stale dial
     RED — the exact warning this component exists to give, lost, and lost in
     the one hue the legend already spends on "Extreme". */
  .clockw[data-age="stale"],
  body.studio .clockw[data-age="stale"]{--c:#8d9698;--on:#141a1b}

  /* the stacked indicator: day over an always-present AM/PM pair */
  .clockw .k-stack{display:flex;flex-direction:column;line-height:1.14}
  /* A size step, not a divider: the day and the meridiem are different KINDS of
     fact — which day, versus which half of it — so scale separates them. */
  .clockw .k-day{font-family:var(--sans);font-weight:750;font-size:.66rem;
    letter-spacing:.01em;color:var(--on);margin-bottom:4px}
  .clockw .k-mer{font-family:var(--sans);font-weight:750;font-size:.47rem;
    letter-spacing:.03em;color:rgb(5 6 6 /.32);transition:color .2s}
  .clockw .k-mer.on{color:var(--on)}
  /* The stack shows EITHER the meridiem pair or the mode, never both — a dimmed
     AM/PM beside a 24-hour readout would be stating something untrue. */
  .clockw .k-h24{display:none;color:var(--on)}
  .clockw[data-h12="false"] #clockAm,
  .clockw[data-h12="false"] #clockPm{display:none}
  .clockw[data-h12="false"] .k-h24{display:block}

  /* tabular-nums so the digits do not reflow as minutes tick over */
  .clockw .k-time{font-family:var(--sans);font-weight:640;font-size:1.98rem;line-height:.9;
    letter-spacing:-.035em;color:var(--on);font-variant-numeric:tabular-nums;text-align:right}
  .clockw .k-sub{display:block;text-align:right;
    font-family:var(--sans);font-weight:600;font-size:.47rem;color:rgb(5 6 6 /.62)}
  .clockw[data-age="stale"] .k-sub{color:rgb(5 6 6 /.8)}
  .clockw .k-bar{display:block;width:100%;height:2px;margin-top:7px;
    border-radius:1px;background:rgb(5 6 6 /.17);overflow:hidden}
  /* scaleX only — transform, never width, so ageing costs no layout */
  .clockw .k-bar i{display:block;height:100%;background:rgb(5 6 6 /.6);border-radius:1px;
    transform-origin:left center;transform:scaleX(1);transition:transform .5s ease}
  @media (prefers-reduced-motion: reduce){ .clockw .k-bar i{transition:none} }

  .vegw{position:absolute;right:320px;top:186px;z-index:6;display:flex;align-items:center;gap:6px;
    padding:4px 7px;border-radius:9px;background:rgb(5 6 6 /.7);border:1px solid var(--line);
    backdrop-filter:blur(8px);box-shadow:0 6px 18px rgb(0 0 0 /.30)}
  .vegw .veg-lab{font-family:var(--mono);font-size:.52rem;letter-spacing:.13em;color:var(--ink);text-transform:uppercase}
  .vegw .modechip{padding:2px;gap:2px}
  .vegw .modechip button{font-size:.52rem;padding:.3rem .62rem;letter-spacing:.12em}
  #svw{top:222px}

  body.studio .compass{background:rgb(245 244 241 /.86);border-color:rgb(20 40 42 /.2)}
  body.studio .compass .c-s{fill:rgb(20 40 42 /.34)}
  body.studio .compass .c-tick{fill:rgb(20 40 42 /.28)}
  body.studio .compass .c-lab{fill:rgb(20 40 42 /.66)}

  /* ── first-run hint ── */
  .tiphint{position:absolute;left:50%;bottom:88px;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:.6rem;
    background:rgb(9 20 22 /.86);border:1px solid rgb(111 202 214 /.35);border-radius:99px;padding:.5rem .55rem .5rem .95rem;
    backdrop-filter:blur(10px);font-family:var(--mono);font-size:.53rem;letter-spacing:.12em;text-transform:uppercase;color:var(--paper);
    animation:tipIn .45s cubic-bezier(.2,0,0,1) both}
  .tiphint button{background:none;border:0;color:var(--ink);cursor:pointer;font-size:.6rem;line-height:1;padding:.25rem .4rem;border-radius:50%}
  .tiphint button:hover{color:var(--paper)}
  .tiphint button:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
  @keyframes tipIn{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
  body.studio .tiphint{background:rgb(245 244 241 /.9);color:var(--studio-ink);border-color:rgb(20 40 42 /.25)}
  @media (prefers-reduced-motion: reduce){ .tiphint{animation:none} }

  /* ── walk-time ring labels ──
     Contour-label treatment: one quiet mono line in the ring's own cyan,
     sitting on the circumference. Constant things must LOOK constant — the
     previous data-chip styling (filled pill, bold Mona Sans value) made two
     fixed radii read as per-building findings, and the reader misread them
     twice. The finding lives in .cooltag; this is just the ruler. */
  .ringlab{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-9px 0 0 -52px;width:104px;text-align:center;white-space:nowrap;
    font-family:var(--mono);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;
    color:var(--cyan);background:rgb(9 20 22 /.82);border:1px solid rgb(111 202 214 /.4);
    border-radius:99px;padding:.22rem 0}
  body.studio .ringlab{background:rgb(245 244 241 /.88);color:#0d6b7d;border-color:rgb(13 107 125 /.4)}

  /* ── nearest-greenery tag: the FINDING, so it gets the data-chip anatomy ──
     Big value over a small label, in the cooling green of the patches it
     stands on. Anchored at the nearest cooling cell; the value is written once
     per selection and only the transform moves per frame. */
  /* Caribbean green, solid, no border. Ink is the stage's own near-black rather
     than pure black: 9.7:1 on this fill, and the label at 72% still measures
     5.9:1, so both clear AA without the value having to shout. The fill is a
     flat brand colour in a panel language built on translucency — that is the
     point, it is the one element on the map that is a finding rather than
     chrome, and it is the same green as the patch it stands on. */
  .cooltag{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-16px 0 0 -73px;width:146px;text-align:center;line-height:1.14}
  .cooltag-in{background:#00cc99;border-radius:9px;padding:.34rem .28rem .36rem;
    box-shadow:0 7px 18px rgb(0 32 24 /.42);will-change:transform,opacity}
  /* No mono anywhere inside: this is a spoken result ("about a hundred and fifty
     metres"), not a machine readout, and Mona Sans reads faster at a glance.
     tabular-nums keeps the count-up from jittering as digits change width. */
  .cooltag b{display:block;font-family:var(--sans);font-weight:750;font-size:1.02rem;
    letter-spacing:-.02em;color:#052018;font-variant-numeric:tabular-nums}
  /* Sentence case, not caps: the label is a phrase to read, and uppercase costs
     the word-shapes that make it readable at this size. The weight makes up the
     presence the caps were providing, and the tracking comes back to near-normal
     because letter-spacing set for caps loosens sentence case badly. */
  .cooltag span{display:block;font-family:var(--sans);font-weight:600;font-size:.56rem;
    letter-spacing:.005em;color:rgb(5 32 24 /.78);margin-top:1px}
  body.studio .cooltag-in{box-shadow:0 8px 22px rgb(0 32 24 /.24)}

  /* The sentence that says what the rings are FOR. Lives inside the building
     card, which is the only time the rings exist. */
  .bc-rings{margin:.5rem 0 0;padding:.45rem .55rem;border-radius:7px;
    background:rgb(111 202 214 /.09);border:1px solid rgb(111 202 214 /.2);
    font-size:.62rem;line-height:1.5;color:var(--paper);text-transform:none;letter-spacing:0}
  .bc-rings b{color:var(--cyan);font-weight:550}
  body.studio .bc-rings{background:rgb(13 107 125 /.08);border-color:rgb(13 107 125 /.22);color:var(--studio-ink)}

  /* MapLibre's own scale bar — a geospatial tool with no distance reference is
     asking the reader to guess. Restyled to the instrument's language.
     NOT :global(...): this whole block is `is:global`, so Astro runs no scoping
     pass and would ship the :global() verbatim, which the browser discards as an
     invalid selector — taking the entire rule with it. That is exactly how the
     bar ended up unstyled and sitting on top of the toolbox. The attribution
     rules below have always used plain selectors for the same reason. */
  /* Made to read as a RULER, not a chip. The ⊔ bracket — rule along the bottom,
     ticks turning up at each end — is the cartographic idiom, and it was being
     smothered: a filled background with a full rounded border turned it into a
     label box, and 7.4px type put the number below any useful reading size.
     Now: no fill, brighter 1.5px bracket, the number sitting above the rule at
     a legible size with a shadow so it survives a bright basemap. */
  .maplibregl-ctrl-scale{background:none!important;border:1.5px solid rgb(111 202 214 /.72)!important;
    border-top:0!important;border-radius:0!important;color:var(--paper)!important;
    font-family:var(--sans)!important;font-weight:600!important;font-size:.58rem!important;
    letter-spacing:.01em!important;padding:0 0 9px!important;text-align:center!important;
    text-shadow:0 1px 3px rgb(0 0 0 /.85);
    /* Quarter ticks, drawn as a repeating gradient rather than markup because
       MapLibre owns this element's contents — it rewrites the label on every
       zoom and would discard any children. Percentage stops mean the ticks stay
       at the quarter points as the bar's pixel width changes with zoom, which is
       what makes them readable as subdivisions rather than decoration. */
    background-image:repeating-linear-gradient(90deg,
      rgb(111 202 214 /.72) 0 1.5px, transparent 1.5px 25%)!important;
    background-size:100% 7px!important;background-repeat:no-repeat!important;
    background-position:left bottom!important;background-origin:padding-box!important}
  body.studio .maplibregl-ctrl-scale{color:var(--studio-ink)!important;border-color:rgb(13 107 125 /.7)!important;
    text-shadow:0 1px 3px rgb(255 255 255 /.85);
    background-image:repeating-linear-gradient(90deg,
      rgb(13 107 125 /.7) 0 1.5px, transparent 1.5px 25%)!important}
