---
// Full-bleed instrument markup for /heat-map. Behaviour is mounted by
// src/scripts/climate-engine/heat-map-app.ts (booted from the page). Styles are
// is:global but only bundled onto /heat-map (the sole page importing this).
// Brand tokens are scoped to .stage so nothing leaks to :root; Mona Sans /
// Noplato Mono come from global.css.
import ConstructionStamp from '../states/ConstructionStamp.astro';
---
<main id="main" class="stage">
  <header class="top">
    <div class="top-start">
      <a class="brand" href="/" aria-label="Back to Delta Climate Research home"><span class="ar" aria-hidden="true">←</span><img class="bm" src="/logo-mark-96.webp" alt="" width="30" height="30" decoding="async" /></a>
      <nav class="tool-modes" aria-label="Heat explorer modes">
        <a href="/heat-map/" aria-current="page">Explore</a>
        <a id="compare-mode-link" href="/heat-map/compare/">Compare</a>
      </nav>
    </div>
    <div class="tabs" id="tabs">
      <button class="tab on" data-w="ballygunge">Ballygunge</button>
      <button class="tab" data-w="baruipur">Baruipur</button>
      <button class="tab" data-w="barrackpore">Barrackpore</button>
    </div>
    <div class="read">MEDNI · HEAT INSTRUMENT<br><b id="coord">22.528° N · 88.366° E</b><br><span id="bcount">— buildings</span> · GPU SIM</div>
  </header>

  <div class="map">
    <div id="mlmap"></div>
    <div class="synthetic"><span class="d"></span><span class="full">Live basemap + real footprints &amp; Google heights · </span>heat field modelled<span class="sp"> · block detail illustrative</span></div>
    <div class="stamp-slot"><ConstructionStamp /></div>
    <div class="loadchip" id="loadchip">Building ward…</div>

    <!-- North reference. The idle orbit turns the map continuously, so without
         this there is no way to know which way you are facing, and no way back. -->
    <button class="compass" id="compass" type="button" title="Face north" aria-label="Reset the map to face north">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18.2" class="c-ring" />
        <g id="compassNeedle">
          <path d="M20 6 L24.4 21 L20 18.4 L15.6 21 Z" class="c-n" />
          <path d="M20 34 L15.6 19 L20 21.6 L24.4 19 Z" class="c-s" />
        </g>
      </svg>
      <span class="c-lab" id="compassLab">N</span>
    </button>

    <!-- First-run affordance: the buildings became clickable and nothing said so. -->
    <div class="tiphint" id="tiphint" hidden>
      <span>Click any building for its data</span>
      <button type="button" id="tipX" aria-label="Dismiss hint">✕</button>
    </div>

    <!-- Walk-time ring labels. Text is STATIC: the app only toggles `hidden` and
         writes a transform, so nothing rewrites strings on every repaint.
         Two lines each — the headline is the human unit (minutes), the second
         line is the caveat, because a circle drawn on a map reads as "you can
         reach all of this" and a straight-line radius is not that. -->
    <!-- Ring labels are RULER MARKINGS, not findings: one quiet mono line, in
         the ring's own colour, sitting on the circumference like a contour
         label. The old data-chip styling promised a per-building measurement
         and delivered a constant — the reader who commissioned the rings
         misread them twice for exactly that reason. -->
    <div class="ringlab" id="ringNear" hidden>1 min · 80 m</div>
    <div class="ringlab" id="ringFar" hidden>5 min · 400 m</div>

    <!-- The finding: nearest greenery, the number that changes with every
         click. Data-chip anatomy (big value, small label) in the cooling
         green so it belongs to the patches it stands on. -->
    <!-- Two nodes on purpose: the OUTER one is written by the render loop every
         repaint (translate3d onto the cooling patch), the INNER one owns the
         pop-in. Animating one element with both would have the frame loop
         stamping over the animation's transform sixty times a second. Same
         split as .bcard / .bcard-in. -->
    <div class="cooltag" id="coolTag" hidden>
      <div class="cooltag-in" id="coolTagIn">
        <b id="coolTagM">—</b><span>Nearest greenery</span>
      </div>
    </div>

    <!-- Click-to-inspect. Positioned from the building's own ward-metre centroid
         every time MapLibre repaints, so it tracks orbit, pan, zoom and flyTo. -->
    <div class="bsel" id="bsel" hidden aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="bcard" id="bcard" hidden role="dialog" aria-label="Selected building">
      <span class="lead"></span>
      <div class="bcard-in">
        <div class="bc-h"><span>Building</span><span id="bcId">—</span></div>
        <dl>
          <dt>Height</dt><dd id="bcH">—</dd>
          <dt>Floors ≈</dt><dd id="bcF">—</dd>
          <dt>Footprint</dt><dd id="bcA">—</dd>
          <dt>Vegetation</dt><dd id="bcV">—</dd>
          <dt>Albedo</dt><dd id="bcAl">—</dd>
          <dt>Surface</dt><dd id="bcT">—</dd>
        </dl>
        <p class="bc-rings" id="bcRings"></p>
        <p class="bc-ins" id="bcIns"></p>
        <button class="bc-x" id="bcX" type="button" aria-label="Close building details">Close ✕</button>
      </div>
    </div>

    <div class="place">
      <div class="n" id="pname">Bally<em>gunge</em></div>
      <div class="z" id="pzone">Urban Core · Ward 68</div>
    </div>
    <div class="chiprow">
      <div class="modechip" id="modechip"><button class="on" data-m="relief">3D Relief</button><button data-m="iso">2D Isotherm</button></div>
      <div class="modechip" id="envchip"><button class="on" data-e="dark">Dark map</button><button data-e="studio">Clay studio</button></div>
      <div class="modechip" id="tintchip" title="Building colour: continuous ramp, or snapped to the 5 legend classes"><button class="on" data-t="1">Gradient</button><button data-t="2">5-Class</button></div>
    </div>

    <aside class="panel left">
      <div class="h">Green Infrastructure Toolbox</div>
      <div class="ctl"><label>Tree canopy corridors <span class="v" id="v1">0</span></label><input type="range" id="ivTrees" min="0" max="50" value="0" aria-label="Tree canopy corridors"></div>
      <div class="ctl"><label>Cool-roof albedo <span class="v" id="v2">0%</span></label><input type="range" id="ivRoof" min="0" max="100" value="0" step="5" aria-label="Cool-roof albedo, percent of roofs treated"></div>
      <div class="ctl"><label>Vertical green facades <span class="v" id="v4">0</span></label><input type="range" id="ivFacades" min="0" max="15" value="0" aria-label="Vertical green facades"></div>
      <div class="ctl"><label style="margin-bottom:.35rem">Diurnal phase</label><div class="seg" id="segPhase"><button class="on" data-p="peak">13:00 Peak</button><button data-p="night">22:00 Retained</button></div></div>
      <div class="ctl"><label style="margin-bottom:.35rem" title="All-India warming deltas from Dhara et al. 2025, PLOS Climate (post-AR6). No emissions scenario produces regional cooling, so there is no negative pathway.">Warming pathway</label><div class="seg" id="segPath"><button class="on" data-p="2025">2025</button><button data-p="ssp245">SSP2-4.5 ’50</button><button data-p="ssp585">SSP5-8.5 ’80</button></div></div>
      <div class="score">
        <div class="g">
          <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15.5" fill="none" stroke="#093a3e" stroke-width="3"></circle><circle id="scoreArc" cx="18" cy="18" r="15.5" fill="none" stroke="#6fcad6" stroke-width="3" stroke-dasharray="97" stroke-dashoffset="97" stroke-linecap="round" transform="rotate(-90 18 18)"></circle></svg>
          <div class="num" id="scoreNum">—</div>
        </div>
        <div class="t"><b>Resilience Score</b><span class="tier" id="scoreTier">—</span><span id="scoreTxt">move a slider to intervene</span></div>
      </div>
      <!-- The three pillars, shown raw. A composite index is only trustworthy if
           you can see what it is made of; the Green Score published its three
           components for the same reason. Exposure and hazard are shown as their
           COMPLEMENTS (1 − EVI, 1 − THI) so that on every bar, higher is better —
           mixing polarities in one strip is how a reader misreads the worst ward
           as the best. -->
      <div class="subs" id="subs" title="DC-URS pillars, IPCC AR6 framing. Capacity: greenness, albedo and refuge access. Exposure: shown as 1 − EVI, so higher is better; driven by population, built density and social vulnerability, none of which any intervention can move. Hazard: shown as 1 − THI, from measured ECOSTRESS surface temperature.">
        <div><b id="sGreen">—</b><span>capacity</span></div>
        <div><b id="sCool">—</b><span>exposure</span></div>
        <div><b id="sEff">—</b><span>hazard</span></div>
      </div>
      <!-- Written by the app from unmeasured(), which reads the data file's own
           provenance. Deliberately no copy in this file for anyone to forget to
           delete: when socio.json lands the chip removes itself. -->
      <div class="conf indicative scoreconf" id="scoreConf" hidden></div>
    </aside>

    <div class="rail-r">
    <aside class="panel right">
      <div class="metric livem">
        <div class="k">Live ambient · Met Norway <span class="livedot" id="livedot"></span></div>
        <div class="liverow">
          <div><b id="liveT">—</b><span>air °C</span></div>
          <div><b id="liveFeel">—</b><span>feels °C</span></div>
          <div><b id="liveRH">—</b><span>% RH</span></div>
          <div><b id="liveWind">—</b><span>m/s wind</span></div>
        </div>
      </div>
      <div class="metric">
        <div class="k">Mean Surface Temp · modelled</div>
        <div class="lst" id="lst" style="color:var(--red)">—<span class="u">°C</span></div>
        <div class="conf" id="conf"></div>
      </div>
      <div class="mrow">
        <div><div class="k" title="Modelled land-cover thermal contrast: this ward's mean surface temperature minus a fully-vegetated reference cell under identical forcing. NOT a measured urban heat island — published Kolkata surface UHI is 0.85–1.5 °C from 1 km satellite data, a different quantity.">Δ vs all-green ref</div><div class="val" style="color:var(--cyan)" id="uhi">—</div></div>
        <div><div class="k">Area &gt; 40°C</div><div class="val" style="color:var(--red)" id="area">—</div></div>
      </div>
      <div class="metric" style="border-top:1px solid var(--line);border-bottom:0"><div class="k">Heat-stress distribution</div></div>
      <div class="histo" id="histo"></div>
      <button class="cta">Generate ward report ↗</button>
    </aside>

    <div class="legend">
      <div class="k" style="margin-bottom:.6rem"><span>What the colours mean</span></div>
      <div class="cindex">
        <div class="ci"><span class="d" style="background:#e5484d"></span>Extreme</div>
        <div class="ci"><span class="d" style="background:#d46b4a"></span>Severe</div>
        <div class="ci"><span class="d" style="background:#b08d57"></span>Hot</div>
        <div class="ci"><span class="d" style="background:#9fb98a"></span>Warm</div>
        <div class="ci"><span class="d" style="background:#6fcad6"></span>Comfortable</div>
      </div>
      <div class="k" style="margin:.9rem 0 .5rem"><span>Land Surface Temp</span><span>°C</span></div>
      <div class="ramp"></div>
      <!-- filled by syncRamp(): the scale moves with the weather, so hardcoded
           numbers here would contradict the colours above them. -->
      <div class="sc" id="rampSc"><span>26</span><span>32</span><span>37</span><span>42</span><span>48</span></div>
      <!-- Filled from accuracy.ts SPATIAL, never hardcoded here: the legend is
           where a reader goes to interpret the colours, so it is where the limit
           of what the colours mean belongs. -->
      <p class="pattern-note" id="patternNote"></p>
      <div class="attr">Basemap © OpenStreetMap · OpenFreeMap · Footprints © Microsoft (ODbL) · Heights Google Open Buildings 2.5D (CC BY 4.0) · left-drag orbit · right-drag pan · scroll zoom</div>
    </div>
    </div>
  </div>

  <div class="strip" id="strip">
    <div class="ward on" data-w="ballygunge"><span class="sw" style="background:radial-gradient(circle at 40% 40%,#e5484d,#b08d57 55%,#093a3e)"></span><div><div class="nm">Ballygunge</div><div class="ty">Urban Core</div></div><div class="big" id="big-ballygunge">—<span>°C mean</span></div></div>
    <div class="ward" data-w="baruipur"><span class="sw" style="background:radial-gradient(circle at 40% 40%,#9fb98a,#6fcad6 60%,#093a3e)"></span><div><div class="nm">Baruipur</div><div class="ty">Peri-Urban Fringe</div></div><div class="big" id="big-baruipur">—<span>°C mean</span></div></div>
    <div class="ward" data-w="barrackpore"><span class="sw" style="background:radial-gradient(circle at 40% 40%,#d46b4a,#b08d57 55%,#093a3e)"></span><div><div class="nm">Barrackpore</div><div class="ty">Industrial Corridor</div></div><div class="big" id="big-barrackpore">—<span>°C mean</span></div></div>
  </div>
</main>

<style is:global>
  body{ overflow:hidden; }
  .stage{
    --base:#050606; --surface:#0b2c2e; --surface2:#093a3e;
    --paper:#ecedf0; --ink:#8fa3a5; --faint:#5c7173; --line:rgb(111 202 214 / 0.14);
    --cyan:#6fcad6; --bronze:#b08d57; --red:#e5484d;
    --sans:'Mona Sans',system-ui,sans-serif; --mono:'Noplato Mono',ui-monospace,'SF Mono',monospace;
    position:fixed; inset:0; display:grid; grid-template-rows:auto 1fr auto;
    background:var(--base); color:var(--paper); font-family:var(--sans);
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  }
  .stage *{ box-sizing:border-box; margin:0; }

  .top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;padding:18px 26px;border-bottom:1px solid var(--line);position:relative;z-index:5;background:rgb(5 6 6 /.55);backdrop-filter:blur(8px)}
  .top-start{display:flex;align-items:center;gap:clamp(.7rem,1.4vw,1.2rem);min-width:0}
  /* Mark, not wordmark: the tool header is a dense instrument bar and the name is
     already in <title> + the aria-label. Same asset as the site nav on purpose —
     /favicon.svg is the SIMPLIFIED cut drawn for the 16px favicon slot (no contour
     lines), so using it here would show a different logo than every other page. */
  .brand{display:inline-flex;align-items:center;gap:9px;text-decoration:none}
  .brand .ar{color:var(--cyan);opacity:.5;font-size:.98rem;line-height:1;transition:opacity .2s,transform .2s}
  .brand .bm{width:30px;height:30px;display:block;transition:opacity .2s}
  .brand:hover .ar{opacity:1;transform:translateX(-3px)}
  .brand:hover .bm{opacity:.82}
  .brand:focus-visible{outline:2px solid var(--cyan);outline-offset:4px;border-radius:5px}
  /* ── north compass ────────────────────────────────────────────────────────
     Sits opposite the legend so it never fights the right rail. The needle is
     rotated by JS on MapLibre's `render`; only the inner <g> turns, so the dial
     and the label stay upright and readable at any bearing. */
  /* Sits clear of the toolbox, not under it: .left is 270 px wide at a 26 px
     offset, so its right edge is 296 px and anything below 312 px would be
     overlapped. The two follow the panel down at each breakpoint. */
  .compass{position:absolute;left:312px;bottom:26px;z-index:6;width:46px;height:46px;padding:0;cursor:pointer;
    background:rgb(9 20 22 /.8);border:1px solid var(--line);border-radius:50%;backdrop-filter:blur(12px);
    display:grid;place-items:center;transition:border-color .2s,transform .2s}
  .compass:hover{border-color:var(--cyan);transform:scale(1.05)}
  .compass:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
  .compass svg{width:40px;height:40px;position:absolute}
  .compass .c-ring{fill:none;stroke:var(--line);stroke-width:1}
  .compass .c-n{fill:var(--red)}
  .compass .c-s{fill:rgb(236 237 240 /.35)}
  .compass #compassNeedle{transform-origin:20px 20px;transition:transform .12s linear}
  .compass .c-lab{position:relative;font-family:var(--mono);font-size:.44rem;letter-spacing:.1em;
    color:var(--ink);transform:translateY(13px)}
  body.studio .compass{background:rgb(245 244 241 /.86);border-color:rgb(20 40 42 /.2)}

  /* ── first-run hint ── */
  .tiphint{position:absolute;left:50%;bottom:88px;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:.6rem;
    background:rgb(9 20 22 /.86);border:1px solid rgb(111 202 214 /.35);border-radius:99px;padding:.5rem .55rem .5rem .95rem;
    backdrop-filter:blur(10px);font-family:var(--mono);font-size:.53rem;letter-spacing:.12em;text-transform:uppercase;color:var(--paper);
    animation:tipIn .45s cubic-bezier(.2,0,0,1) both}
  .tiphint button{background:none;border:0;color:var(--ink);cursor:pointer;font-size:.6rem;line-height:1;padding:.25rem .4rem;border-radius:50%}
  .tiphint button:hover{color:var(--paper)}
  .tiphint button:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
  @keyframes tipIn{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
  body.studio .tiphint{background:rgb(245 244 241 /.9);color:#16292b;border-color:rgb(20 40 42 /.25)}
  @media (prefers-reduced-motion: reduce){ .tiphint{animation:none} }

  /* ── walk-time ring labels ──
     Contour-label treatment: one quiet mono line in the ring's own cyan,
     sitting on the circumference. Constant things must LOOK constant — the
     previous data-chip styling (filled pill, bold Mona Sans value) made two
     fixed radii read as per-building findings, and the reader misread them
     twice. The finding lives in .cooltag; this is just the ruler. */
  .ringlab{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-9px 0 0 -52px;width:104px;text-align:center;white-space:nowrap;
    font-family:var(--mono);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;
    color:var(--cyan);background:rgb(9 20 22 /.82);border:1px solid rgb(111 202 214 /.4);
    border-radius:99px;padding:.22rem 0}
  body.studio .ringlab{background:rgb(245 244 241 /.88);color:#0d6b7d;border-color:rgb(13 107 125 /.4)}

  /* ── nearest-greenery tag: the FINDING, so it gets the data-chip anatomy ──
     Big value over a small label, in the cooling green of the patches it
     stands on. Anchored at the nearest cooling cell; the value is written once
     per selection and only the transform moves per frame. */
  /* Caribbean green, solid, no border. Ink is the stage's own near-black rather
     than pure black: 9.7:1 on this fill, and the label at 72% still measures
     5.9:1, so both clear AA without the value having to shout. The fill is a
     flat brand colour in a panel language built on translucency — that is the
     point, it is the one element on the map that is a finding rather than
     chrome, and it is the same green as the patch it stands on. */
  .cooltag{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-16px 0 0 -73px;width:146px;text-align:center;line-height:1.14}
  .cooltag-in{background:#00cc99;border-radius:9px;padding:.34rem .28rem .36rem;
    box-shadow:0 7px 18px rgb(0 32 24 /.42);will-change:transform,opacity}
  /* No mono anywhere inside: this is a spoken result ("about a hundred and fifty
     metres"), not a machine readout, and Mona Sans reads faster at a glance.
     tabular-nums keeps the count-up from jittering as digits change width. */
  .cooltag b{display:block;font-family:var(--sans);font-weight:750;font-size:1.02rem;
    letter-spacing:-.02em;color:#052018;font-variant-numeric:tabular-nums}
  /* Sentence case, not caps: the label is a phrase to read, and uppercase costs
     the word-shapes that make it readable at this size. The weight makes up the
     presence the caps were providing, and the tracking comes back to near-normal
     because letter-spacing set for caps loosens sentence case badly. */
  .cooltag span{display:block;font-family:var(--sans);font-weight:600;font-size:.56rem;
    letter-spacing:.005em;color:rgb(5 32 24 /.78);margin-top:1px}
  body.studio .cooltag-in{box-shadow:0 8px 22px rgb(0 32 24 /.24)}

  /* The sentence that says what the rings are FOR. Lives inside the building
     card, which is the only time the rings exist. */
  .bc-rings{margin:.5rem 0 0;padding:.45rem .55rem;border-radius:7px;
    background:rgb(111 202 214 /.09);border:1px solid rgb(111 202 214 /.2);
    font-size:.62rem;line-height:1.5;color:var(--paper);text-transform:none;letter-spacing:0}
  .bc-rings b{color:var(--cyan);font-weight:550}
  body.studio .bc-rings{background:rgb(13 107 125 /.08);border-color:rgb(13 107 125 /.22);color:#16292b}

  /* MapLibre's own scale bar — a geospatial tool with no distance reference is
     asking the reader to guess. Restyled to the instrument's language.
     NOT :global(...): this whole block is `is:global`, so Astro runs no scoping
     pass and would ship the :global() verbatim, which the browser discards as an
     invalid selector — taking the entire rule with it. That is exactly how the
     bar ended up unstyled and sitting on top of the toolbox. The attribution
     rules below have always used plain selectors for the same reason. */
  .maplibregl-ctrl-scale{background:rgb(9 20 22 /.72)!important;border:1px solid var(--line)!important;
    border-top:0!important;color:var(--ink)!important;font-family:var(--mono)!important;font-size:.46rem!important;
    letter-spacing:.1em!important;padding:1px 5px 2px!important;border-radius:0 0 5px 5px!important;backdrop-filter:blur(10px)}
  .maplibregl-ctrl-bottom-left{margin:0 0 30px 372px}

  /* ── click-to-inspect ─────────────────────────────────────────────────────
     Both nodes are positioned in CSS pixels by heat-map-app.ts on MapLibre's
     `render` event, which only fires when a repaint actually happened. They move
     with transform ONLY — never left/top — so tracking the camera costs no
     layout, and the pointer must stay off the map or the card would eat the
     drag-to-orbit gesture. */
  .bsel{position:absolute;z-index:6;pointer-events:none;width:54px;height:54px;margin:-27px 0 0 -27px;
    will-change:transform;transition:opacity .18s ease}
  .bsel i{position:absolute;width:13px;height:13px;border:1.6px solid var(--cyan)}
  .bsel i:nth-child(1){left:0;top:0;border-right:0;border-bottom:0}
  .bsel i:nth-child(2){right:0;top:0;border-left:0;border-bottom:0}
  .bsel i:nth-child(3){left:0;bottom:0;border-right:0;border-top:0}
  .bsel i:nth-child(4){right:0;bottom:0;border-left:0;border-top:0}

  /* The −50% lives on THIS node, not on .bcard-in: `.lead` is positioned at
     top:50% of .bcard, and a transform on a child does not move the parent box
     the percentage resolves against — so shifting the inner card alone left the
     leader line pinned to the card's bottom edge instead of the building. */
  .bcard{position:absolute;z-index:7;width:230px;will-change:transform;pointer-events:none}
  .bcard .lead{position:absolute;top:50%;width:30px;height:1px;background:rgb(111 202 214 /.55)}
  .bcard .lead::before{content:'';position:absolute;top:-3px;width:6px;height:6px;border-radius:50%;background:var(--cyan)}
  .bcard[data-side='right'] .lead{right:100%}
  .bcard[data-side='right'] .lead::before{left:-3px}
  .bcard[data-side='left'] .lead{left:100%}
  .bcard[data-side='left'] .lead::before{right:-3px}
  .bcard-in{pointer-events:auto;background:rgb(5 6 6 /.86);backdrop-filter:blur(9px);
    border:1px solid rgb(111 202 214 /.4);border-radius:11px;padding:11px 13px;
    box-shadow:0 14px 40px rgb(0 0 0 /.45)}
  .bc-h{display:flex;justify-content:space-between;font:400 .5rem var(--mono);letter-spacing:.16em;
