  /* SOLID BLOCK, NOT A GLASS PANEL. The numerals sit straight on the colour —
     the Braun/Rams digital-clock idiom — instead of on a translucent tile, so
     the readout is the loudest thing in the component rather than its chrome.

     COLOUR NOW CARRIES THE MAP THEME, SO STALENESS CANNOT. It used to turn the
     digits red; with the block itself coloured per basemap that channel is
     spent, and hue-shifting a red tile to red says nothing. Stale drains the
     colour OUT to grey instead: same reading in both themes, and it is the
     same metaphor the bar already uses. */
  .clockw{--c:var(--cyan);--on:#051416;
    position:absolute;right:320px;top:76px;z-index:6;padding:9px 13px 10px;
    display:flex;flex-direction:column;
    border-radius:12px;border:0;background:var(--c);
    box-shadow:0 7px 20px rgb(0 0 0 /.38);
    transition:background-color .45s ease}
  /* Both children are real buttons; they inherit the block's ink and keep the
     grid the face needs. Hover lifts the whole tile so it still reads as one
     object rather than two stacked chips. */
  .clockw button{appearance:none;background:none;border:0;padding:0;margin:0;
    font:inherit;color:inherit;text-align:left;cursor:pointer;width:100%;display:block}
  .clockw button:focus-visible{outline:2px solid var(--on);outline-offset:2px;border-radius:5px}
  .clockw .k-face{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;
    transition:transform .2s}
  .clockw .k-face:hover{transform:translateY(-1px)}
  .clockw .k-age{margin-top:3px;transition:opacity .2s}
  .clockw .k-age:hover{opacity:.72}
  .clockw .k-age[disabled]{cursor:progress;opacity:.6}
  body.studio .clockw{--c:var(--red);--on:#1b0405}
  /* Grey is a hue-free "not live" that reads identically on either basemap.
     BOTH SELECTORS ARE REQUIRED, AND THIS BLOCK MUST COME LAST. A lone
     `.clockw[data-age="stale"]` ties `body.studio .clockw` on specificity
     (0,2,0 each), so source order decided it and Clay studio kept a stale dial
     RED — the exact warning this component exists to give, lost, and lost in
     the one hue the legend already spends on "Extreme". */
  .clockw[data-age="stale"],
  body.studio .clockw[data-age="stale"]{--c:#8d9698;--on:#141a1b}

  /* the stacked indicator: day over an always-present AM/PM pair */
  .clockw .k-stack{display:flex;flex-direction:column;line-height:1.14}
  /* A size step, not a divider: the day and the meridiem are different KINDS of
     fact — which day, versus which half of it — so scale separates them. */
  .clockw .k-day{font-family:var(--sans);font-weight:750;font-size:.66rem;
    letter-spacing:.01em;color:var(--on);margin-bottom:4px}
  .clockw .k-mer{font-family:var(--sans);font-weight:750;font-size:.47rem;
    letter-spacing:.03em;color:rgb(5 6 6 /.32);transition:color .2s}
  .clockw .k-mer.on{color:var(--on)}
  /* The stack shows EITHER the meridiem pair or the mode, never both — a dimmed
     AM/PM beside a 24-hour readout would be stating something untrue. */
  .clockw .k-h24{display:none;color:var(--on)}
  .clockw[data-h12="false"] #clockAm,
  .clockw[data-h12="false"] #clockPm{display:none}
  .clockw[data-h12="false"] .k-h24{display:block}

  /* tabular-nums so the digits do not reflow as minutes tick over */
  .clockw .k-time{font-family:var(--sans);font-weight:640;font-size:1.98rem;line-height:.9;
    letter-spacing:-.035em;color:var(--on);font-variant-numeric:tabular-nums;text-align:right}
  .clockw .k-sub{display:block;text-align:right;
    font-family:var(--sans);font-weight:600;font-size:.47rem;color:rgb(5 6 6 /.62)}
  .clockw[data-age="stale"] .k-sub{color:rgb(5 6 6 /.8)}
  .clockw .k-bar{display:block;width:100%;height:2px;margin-top:7px;
    border-radius:1px;background:rgb(5 6 6 /.17);overflow:hidden}
  /* scaleX only — transform, never width, so ageing costs no layout */
  .clockw .k-bar i{display:block;height:100%;background:rgb(5 6 6 /.6);border-radius:1px;
    transform-origin:left center;transform:scaleX(1);transition:transform .5s ease}
  @media (prefers-reduced-motion: reduce){ .clockw .k-bar i{transition:none} }

  .vegw{position:absolute;right:320px;top:186px;z-index:6;display:flex;align-items:center;gap:6px;
    padding:4px 7px;border-radius:9px;background:rgb(5 6 6 /.7);border:1px solid var(--line);
    backdrop-filter:blur(8px);box-shadow:0 6px 18px rgb(0 0 0 /.30)}
  .vegw .veg-lab{font-family:var(--mono);font-size:.52rem;letter-spacing:.13em;color:var(--ink);text-transform:uppercase}
  .vegw .modechip{padding:2px;gap:2px}
  .vegw .modechip button{font-size:.52rem;padding:.3rem .62rem;letter-spacing:.12em}
  #svw{top:222px}

  body.studio .compass{background:rgb(245 244 241 /.86);border-color:rgb(20 40 42 /.2)}
  body.studio .compass .c-s{fill:rgb(20 40 42 /.34)}
  body.studio .compass .c-tick{fill:rgb(20 40 42 /.28)}
  body.studio .compass .c-lab{fill:rgb(20 40 42 /.66)}

  /* ── first-run hint ── */
  .tiphint{position:absolute;left:50%;bottom:88px;transform:translateX(-50%);z-index:7;display:flex;align-items:center;gap:.6rem;
    background:rgb(9 20 22 /.86);border:1px solid rgb(111 202 214 /.35);border-radius:99px;padding:.5rem .55rem .5rem .95rem;
    backdrop-filter:blur(10px);font-family:var(--mono);font-size:.53rem;letter-spacing:.12em;text-transform:uppercase;color:var(--paper);
    animation:tipIn .45s cubic-bezier(.2,0,0,1) both}
  .tiphint button{background:none;border:0;color:var(--ink);cursor:pointer;font-size:.6rem;line-height:1;padding:.25rem .4rem;border-radius:50%}
  .tiphint button:hover{color:var(--paper)}
  .tiphint button:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
  @keyframes tipIn{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
  body.studio .tiphint{background:rgb(245 244 241 /.9);color:var(--studio-ink);border-color:rgb(20 40 42 /.25)}
  @media (prefers-reduced-motion: reduce){ .tiphint{animation:none} }

  /* ── walk-time ring labels ──
     Contour-label treatment: one quiet mono line in the ring's own cyan,
     sitting on the circumference. Constant things must LOOK constant — the
     previous data-chip styling (filled pill, bold Mona Sans value) made two
     fixed radii read as per-building findings, and the reader misread them
     twice. The finding lives in .cooltag; this is just the ruler. */
  .ringlab{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-9px 0 0 -52px;width:104px;text-align:center;white-space:nowrap;
    font-family:var(--mono);font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;
    color:var(--cyan);background:rgb(9 20 22 /.82);border:1px solid rgb(111 202 214 /.4);
    border-radius:99px;padding:.22rem 0}
  body.studio .ringlab{background:rgb(245 244 241 /.88);color:#0d6b7d;border-color:rgb(13 107 125 /.4)}

  /* ── nearest-greenery tag: the FINDING, so it gets the data-chip anatomy ──
     Big value over a small label, in the cooling green of the patches it
     stands on. Anchored at the nearest cooling cell; the value is written once
     per selection and only the transform moves per frame. */
  /* Caribbean green, solid, no border. Ink is the stage's own near-black rather
     than pure black: 9.7:1 on this fill, and the label at 72% still measures
     5.9:1, so both clear AA without the value having to shout. The fill is a
     flat brand colour in a panel language built on translucency — that is the
     point, it is the one element on the map that is a finding rather than
     chrome, and it is the same green as the patch it stands on. */
  .cooltag{position:absolute;z-index:6;pointer-events:none;will-change:transform;
    margin:-16px 0 0 -73px;width:146px;text-align:center;line-height:1.14}
  .cooltag-in{background:#00cc99;border-radius:9px;padding:.34rem .28rem .36rem;
    box-shadow:0 7px 18px rgb(0 32 24 /.42);will-change:transform,opacity}
  /* No mono anywhere inside: this is a spoken result ("about a hundred and fifty
     metres"), not a machine readout, and Mona Sans reads faster at a glance.
     tabular-nums keeps the count-up from jittering as digits change width. */
  .cooltag b{display:block;font-family:var(--sans);font-weight:750;font-size:1.02rem;
    letter-spacing:-.02em;color:#052018;font-variant-numeric:tabular-nums}
  /* Sentence case, not caps: the label is a phrase to read, and uppercase costs
     the word-shapes that make it readable at this size. The weight makes up the
     presence the caps were providing, and the tracking comes back to near-normal
     because letter-spacing set for caps loosens sentence case badly. */
  .cooltag span{display:block;font-family:var(--sans);font-weight:600;font-size:.56rem;
    letter-spacing:.005em;color:rgb(5 32 24 /.78);margin-top:1px}
  body.studio .cooltag-in{box-shadow:0 8px 22px rgb(0 32 24 /.24)}

  /* The sentence that says what the rings are FOR. Lives inside the building
     card, which is the only time the rings exist. */
  .bc-rings{margin:.5rem 0 0;padding:.45rem .55rem;border-radius:7px;
    background:rgb(111 202 214 /.09);border:1px solid rgb(111 202 214 /.2);
    font-size:.62rem;line-height:1.5;color:var(--paper);text-transform:none;letter-spacing:0}
  .bc-rings b{color:var(--cyan);font-weight:550}
  body.studio .bc-rings{background:rgb(13 107 125 /.08);border-color:rgb(13 107 125 /.22);color:var(--studio-ink)}

  /* MapLibre's own scale bar — a geospatial tool with no distance reference is
     asking the reader to guess. Restyled to the instrument's language.
     NOT :global(...): this whole block is `is:global`, so Astro runs no scoping
     pass and would ship the :global() verbatim, which the browser discards as an
     invalid selector — taking the entire rule with it. That is exactly how the
     bar ended up unstyled and sitting on top of the toolbox. The attribution
     rules below have always used plain selectors for the same reason. */
  /* Made to read as a RULER, not a chip. The ⊔ bracket — rule along the bottom,
     ticks turning up at each end — is the cartographic idiom, and it was being
     smothered: a filled background with a full rounded border turned it into a
     label box, and 7.4px type put the number below any useful reading size.
     Now: no fill, brighter 1.5px bracket, the number sitting above the rule at
     a legible size with a shadow so it survives a bright basemap. */
  .maplibregl-ctrl-scale{background:none!important;border:1.5px solid rgb(111 202 214 /.72)!important;
    border-top:0!important;border-radius:0!important;color:var(--paper)!important;
    font-family:var(--sans)!important;font-weight:600!important;font-size:.58rem!important;
    letter-spacing:.01em!important;padding:0 0 9px!important;text-align:center!important;
    text-shadow:0 1px 3px rgb(0 0 0 /.85);
    /* Quarter ticks, drawn as a repeating gradient rather than markup because
       MapLibre owns this element's contents — it rewrites the label on every
       zoom and would discard any children. Percentage stops mean the ticks stay
       at the quarter points as the bar's pixel width changes with zoom, which is
       what makes them readable as subdivisions rather than decoration. */
    background-image:repeating-linear-gradient(90deg,
      rgb(111 202 214 /.72) 0 1.5px, transparent 1.5px 25%)!important;
    background-size:100% 7px!important;background-repeat:no-repeat!important;
    background-position:left bottom!important;background-origin:padding-box!important}
  body.studio .maplibregl-ctrl-scale{color:var(--studio-ink)!important;border-color:rgb(13 107 125 /.7)!important;
    text-shadow:0 1px 3px rgb(255 255 255 /.85);
    background-image:repeating-linear-gradient(90deg,
      rgb(13 107 125 /.7) 0 1.5px, transparent 1.5px 25%)!important}
  /* Clear of the compass, which is 62px wide at a 26px inset. It used to be clear
     of the toolbox as well, at 396px; the toolbox is no longer over the map. */
  .maplibregl-ctrl-bottom-left{margin:0 0 30px 110px}

  /* ── click-to-inspect ─────────────────────────────────────────────────────
     Both nodes are positioned in CSS pixels by heat-map-app.ts on MapLibre's
     `render` event, which only fires when a repaint actually happened. They move
     with transform ONLY — never left/top — so tracking the camera costs no
     layout, and the pointer must stay off the map or the card would eat the
     drag-to-orbit gesture. */
  .bsel{position:absolute;z-index:6;pointer-events:none;width:54px;height:54px;margin:-27px 0 0 -27px;
    will-change:transform;transition:opacity .18s ease}
  .bsel i{position:absolute;width:13px;height:13px;border:1.6px solid var(--cyan)}
  .bsel i:nth-child(1){left:0;top:0;border-right:0;border-bottom:0}
  .bsel i:nth-child(2){right:0;top:0;border-left:0;border-bottom:0}
  .bsel i:nth-child(3){left:0;bottom:0;border-right:0;border-top:0}
  .bsel i:nth-child(4){right:0;bottom:0;border-left:0;border-top:0}

  /* The −50% lives on THIS node, not on .bcard-in: `.lead` is positioned at
     top:50% of .bcard, and a transform on a child does not move the parent box
     the percentage resolves against — so shifting the inner card alone left the
     leader line pinned to the card's bottom edge instead of the building. */
  .bcard{position:absolute;z-index:7;width:230px;will-change:transform;pointer-events:none}
  .bcard .lead{position:absolute;top:50%;width:30px;height:1px;background:rgb(111 202 214 /.55)}
  .bcard .lead::before{content:'';position:absolute;top:-3px;width:6px;height:6px;border-radius:50%;background:var(--cyan)}
  .bcard[data-side='right'] .lead{right:100%}
  .bcard[data-side='right'] .lead::before{left:-3px}
  .bcard[data-side='left'] .lead{left:100%}
  .bcard[data-side='left'] .lead::before{right:-3px}
  .bcard-in{pointer-events:auto;background:rgb(5 6 6 /.86);backdrop-filter:blur(9px);
    border:1px solid rgb(111 202 214 /.4);border-radius:11px;padding:11px 13px;
    box-shadow:0 14px 40px rgb(0 0 0 /.45)}
  .bc-h{display:flex;justify-content:space-between;font:400 .5rem var(--mono);letter-spacing:.16em;
    text-transform:uppercase;color:var(--cyan);margin-bottom:.5rem}
  .bcard dl{display:grid;grid-template-columns:auto 1fr;gap:.22rem .7rem;margin:0;font-size:.7rem}
  .bcard dt{font:400 .5rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink);align-self:baseline}
  .bcard dd{margin:0;text-align:right;font-weight:550;letter-spacing:-.01em;color:var(--paper)}
  .bcard dd small{display:block;font:400 .46rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--bronze)}
  /* The Height row carries HEIGHTS.note as its title (heat-map-app.ts). Without an
     affordance nobody hovers a plain <dd>, so the whole ICESat-2 caveat goes unread
     — same reasoning as .conf, which is the precedent. */
  #bcH{cursor:help}
  .bc-ins{margin:.55rem 0 0;padding-top:.5rem;border-top:1px solid rgb(111 202 214 /.18);
    font:400 .5rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink);line-height:1.75}
  .bc-ins b{font-weight:400}
  .bc-ins .hot{color:var(--red)} .bc-ins .cool{color:var(--cyan)}
  /* HOW THE FOOTPRINT WAS MADE, as a card footnote rather than a qualifier hung
     under the source name. It reads standalone ("Footprint model · confidence
     0.85") because at the foot of the card it no longer sits beneath the
     "Footprint by" label that used to supply its subject. */
  .bc-prov{margin:.4rem 0 0;font:400 .46rem var(--mono);letter-spacing:.08em;
    text-transform:uppercase;color:var(--bronze);line-height:1.6}
  .bc-prov:empty{display:none}
  /* Per-layer "data receipts" panel — populated from {ward}-layers.json (provenance.ts). */
  .srcbtn{margin:.4rem 0 0;cursor:pointer;font:400 .48rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);background:none;border:0;padding:.15rem 0}
  .srcbtn:hover{color:var(--paper)}
  .srcbtn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  .srcpanel{position:absolute;right:18px;bottom:66px;width:326px;max-height:54vh;overflow:auto;z-index:6;background:rgb(5 6 6 /.9);backdrop-filter:blur(11px);border:1px solid var(--line);border-radius:12px;padding:13px 15px;box-shadow:0 18px 50px rgb(0 0 0 /.5)}
  .srcpanel[hidden]{display:none}
  .srcpanel h4{margin:0 0 9px;font:400 .55rem var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--ink)}
  .src-row{padding:8px 0;border-top:1px solid var(--line)}
  .src-row:first-of-type{border-top:0}
  .src-row .l{display:flex;justify-content:space-between;gap:8px;align-items:baseline}
  .src-row .nm{font-weight:600;font-size:.74rem;letter-spacing:-.01em;color:var(--paper)}
  .src-row .k{flex:none;font:400 .44rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--base);background:var(--cyan);border-radius:4px;padding:1px 5px}
  .src-row .k.modelled,.src-row .k.reference{background:var(--bronze)}
  .src-row .s{margin-top:2px;font-size:.62rem;line-height:1.45;color:var(--ink)}
  .src-row .s a{color:var(--cyan)}
  .src-row .meta{margin-top:3px;font:400 .46rem var(--mono);letter-spacing:.06em;color:var(--faint);line-height:1.5}
  body.studio .srcpanel{background:rgb(244 246 246 /.95);border-color:rgb(20 48 54 /.16)}
  body.studio .src-row .nm{color:#13232a}
  body.studio .src-row .s,body.studio .srcpanel h4{color:var(--studio-muted)}
  body.studio .src-row .meta{color:#7f9296}
  .svmodal{position:fixed;inset:0;z-index:40;display:none;place-items:center;background:rgb(2 9 10 /.72);backdrop-filter:blur(3px)}
  .svmodal:not([hidden]){display:grid}
  .svmodal-card{position:relative;width:min(1100px,92vw);height:min(680px,80vh);background:#02090a;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgb(0 0 0 /.5)}
  .svmodal-viewer{width:100%;height:100%}
  .svmodal-x{position:absolute;top:10px;right:10px;z-index:2;width:32px;height:32px;border-radius:50%;border:0;background:rgb(2 9 10 /.8);color:#eef1f2;cursor:pointer;font-size:15px}
  .svmodal-credit{position:absolute;left:10px;bottom:8px;z-index:2;font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:#c9d4d5;background:rgb(2 9 10 /.6);padding:3px 7px;border-radius:5px}
  .svmodal-credit a{color:var(--cyan)}
  .sv-thumb{margin-top:.5rem}
  .sv-thumb img{width:100%;border-radius:8px;display:block;cursor:pointer;border:1px solid var(--line)}
  .sv-thumb .sv-none{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--faint);text-transform:uppercase}
  .bc-x{margin-top:.55rem;width:100%;cursor:pointer;font:400 .48rem var(--mono);letter-spacing:.12em;
    text-transform:uppercase;color:var(--ink);background:rgb(9 58 62 /.4);border:1px solid var(--line);
    border-radius:6px;padding:.4rem 0}
  .bc-x:hover{color:var(--paper)}
  .bc-x:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
  body.studio .bcard-in{background:rgb(245 244 241 /.9);border-color:rgb(20 40 42 /.22);box-shadow:0 14px 40px rgb(20 40 42 /.16)}
  body.studio .bcard dd{color:var(--studio-ink)}
  body.studio .bc-x{background:rgb(20 40 42 /.06);color:var(--studio-muted)}
  @media (max-width: 640px){ .bcard{width:196px} }

  /* `.tool-modes` and `.tabs` were here. The first was the Explore/Compare pair the
     rail replaced; the second was a THIRD area switcher, after the scope switcher's
     Area select and the ward strip below — all three reading the same `data-w`, all
     three doing the same thing. Two of the three are gone.
     THE STRIP IS THE ONE KEPT, because it is the only control that puts the wards
     BESIDE each other: three tiles, each with its greenness swatch, its kind and a
     `big-{id}` slot for its mean. Worth knowing while reading it: heat-map-app.ts
     fills that slot only for the ward it has loaded, so the other two carry an
     em-dash until they are opened. The comparison the strip is shaped for is
     therefore still half-drawn — the shape is right and the data is per-visit. */
  .top .read{text-align:right;font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;color:var(--faint);line-height:1.7;text-transform:uppercase;white-space:nowrap}
  .top .read b{color:var(--cyan);font-weight:400}

  .map{position:relative;overflow:hidden}
  #mlmap{position:absolute;inset:0}
  .maplibregl-ctrl-attrib{font-family:var(--mono);font-size:.46rem}
  .maplibregl-ctrl-bottom-right{z-index:1}
  .place{position:absolute;left:50%;top:34%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;z-index:1}
  .place .n{font-weight:600;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.92;letter-spacing:-.04em;text-shadow:0 4px 40px rgb(0 0 0 /.85);opacity:.82}
  .place .n em{font-style:normal;color:var(--cyan)}
  .place .z{font-family:var(--mono);font-size:.58rem;letter-spacing:.34em;color:var(--bronze);margin-top:.7rem;text-transform:uppercase;opacity:.9}
  .chiprow{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);display:flex;gap:8px;z-index:3}
  .modechip{display:flex;gap:2px;background:rgb(5 6 6 /.7);border:1px solid var(--line);border-radius:9px;padding:3px;backdrop-filter:blur(8px)}
  .modechip button{font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;color:var(--ink);background:none;border:0;cursor:pointer;padding:.4rem .8rem;border-radius:6px;text-transform:uppercase}
  .modechip button.on{background:var(--surface2);color:var(--paper)}
  body.studio .place .n{color:#232b2d;text-shadow:0 4px 34px rgb(255 255 255/.6)}
  body.studio .place .n em{color:var(--studio-accent)}
  body.studio .place .z{color:#8a6d3f}
  body.studio .loadchip{color:var(--studio-accent)}

  .synthetic{position:absolute;top:20px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.56rem;letter-spacing:.2em;color:var(--bronze);background:rgb(176 141 87 /.14);border:1px solid rgb(176 141 87 /.3);border-radius:20px;padding:.42rem .9rem;z-index:3;text-transform:uppercase;backdrop-filter:blur(8px)}
  .synthetic .sp{opacity:.82}
  .synthetic .d{width:6px;height:6px;border-radius:50%;background:var(--bronze);animation:hmPulse 2.2s infinite}
  @keyframes hmPulse{0%,100%{opacity:1}50%{opacity:.3}}
  /* Build-status stamp, grouped with the honesty banner directly above it —
     both are bronze status chrome and belong together. Centred over the map's
     dark upper region, NOT over the ward model: the first placement put it mid-
     canvas at 9px over pale rooftops, where it was illegible and interrupted the
     one thing the page exists to show.

     NOT aria-hidden here (unlike SoonDraft, which repeats it in prose) — this is
     the page's only statement that the tool is still being built, so it must be
     announced. Smaller than the placeholder-page stamp: this page has a working
     instrument, and the stamp is a caveat on it, not the headline. */
  .stamp-slot{position:absolute;left:50%;top:68px;transform:translateX(-50%);z-index:3;pointer-events:none;
              --stamp-size:.62rem;--stamp-pad:.5rem 1rem;--stamp-tracking:.26em;--stamp-rot:-2.5deg}
  /* NOT :global(.con-stamp) — this block is `is:global`, so Astro runs no scoping pass
     over it and never strips the `:global()`. It would ship verbatim, and the browser
     drops the whole rule as an invalid selector, leaving the stamp unbacked over the
     basemap. Inside is:global every selector is already global. */
  .stamp-slot .con-stamp{opacity:1;background:rgb(6 14 16 /.72);backdrop-filter:blur(8px)}
  /* The within-ward caveat. Bronze, like every other provenance statement on
     this page, and directly under the colour ramp it qualifies. */
  .pattern-note{margin:.32rem 0 0;font-family:var(--mono);font-size:.5rem;line-height:1.75;
                letter-spacing:.09em;color:var(--bronze);text-transform:uppercase;
                border-top:1px solid rgb(176 141 87 /.22);padding-top:.42rem;white-space:nowrap}
  .loadchip{position:absolute;top:118px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:.52rem;letter-spacing:.26em;color:var(--cyan);z-index:3;text-transform:uppercase;opacity:0;transition:opacity .25s}
  .loadchip.on{opacity:1}

  /* Borderless glass. The 1px --line stroke was the last piece of the "grid of
     boxes" read, and it also fought the legend directly beneath it in the same
     rail. Separation is now DEPTH, not a line — which is how the reference UI
     separates its cards too.
     The fill goes .82 -> .88 and the shadow deepens to compensate: over a dark
     3D scene an unbordered translucent panel loses its edge, and the fix for
     that is contrast + shadow, not a stroke by another name. */
  /* Two shadows, not one big one: a tight contact shadow that DEFINES the edge,
     and a soft ambient that lifts the card. The single 0 24px 70px pooled
     across the rail gap and glued this to the legend below it. The ambient is
     kept short (18px, not 70) for the same reason — it must not reach the next
     card. */
  .panel{position:absolute;background:rgb(9 20 22 /.88);border-radius:14px;backdrop-filter:blur(16px);box-shadow:0 1px 2px rgb(0 0 0 /.45),0 8px 18px rgb(0 0 0 /.35);z-index:4}
  .panel .h{font-family:var(--mono);font-size:.58rem;letter-spacing:.18em;color:var(--ink);padding:14px 18px 0;text-transform:uppercase}
  /* `.left`'s floating geometry is gone: the toolbox is a pane of the sidebar now,
     and `.sidebar .panel.left` up in the layout block gives it a column's shape.
     The rules kept here are the ones that describe the CONTROLS inside it, which
     did not move. */
  /* right rail: one bounded column so the data card + legend can
     never overlap — the data card scrolls internally when the viewport is short,
     the legend stays pinned to the bottom via margin-top:auto. */
  /* gap 14 -> 22. When the panels lost their 1px border the border stopped
     doing a job nobody had named: SEPARATING the readout card from the legend
     directly beneath it. A 70px shadow then spilled across a 14px gap and the
     two read as one slab. Space has to do that job now, and 14px is not enough
     space to read as a break between two dark surfaces. */
  .rail-r{position:absolute;right:26px;top:26px;bottom:26px;width:242px;display:flex;flex-direction:column;gap:22px;overflow-y:auto;z-index:4}
  .right{position:static;width:100%;flex:none}

  .ctl{padding:14px 18px;border-bottom:1px solid var(--line)}
  .ctl:last-child{border-bottom:0}
  .ctl label{display:flex;justify-content:space-between;font-size:.72rem;color:var(--paper);margin-bottom:.5rem}
  .ctl label .v{font-family:var(--mono);color:var(--cyan);letter-spacing:.05em}
  .stage input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:3px;border-radius:2px;background:var(--surface2);outline:none}
  .stage input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--cyan);cursor:pointer;box-shadow:0 0 0 4px rgb(111 202 214 /.15)}
  .stage input[type=range]:focus-visible{box-shadow:0 0 0 2px var(--cyan)}
  .seg{display:flex;gap:2px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:3px;margin-top:.3rem}
  .seg button{flex:1;font-family:var(--mono);font-size:.54rem;letter-spacing:.1em;color:var(--ink);background:none;border:0;cursor:pointer;padding:.45rem;border-radius:5px;text-transform:uppercase}
  .seg button.on{background:var(--surface2);color:var(--paper)}
  /* The stated absence where the segmented control would be. Prose, not a box:
     an empty .seg is a hairline rectangle with nothing in it, which reads as a
     control that has not finished loading. */
  .segnone{margin-top:.3rem;font-size:.62rem;line-height:1.45;color:var(--ink);opacity:.78}

  .score{display:flex;align-items:center;gap:14px;padding:16px 18px}
  .score .g{position:relative;width:64px;height:64px;flex:none}
  /* Both circles paint stroke:currentColor, so `color` is what actually carries
     the token — see the note beside the <svg>. Setting it per circle rather than
     on the <svg> keeps the two strokes independent, which is what the two hex
     attributes used to do. */
  .score .g .track{color:var(--surface2)}
  .score .g #scoreArc{color:var(--cyan)}
