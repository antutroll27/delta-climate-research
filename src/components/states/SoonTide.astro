---
// "In preparation" page body (Research side) — shared by /white-papers,
// /white-papers/[slug], /cbam, /blog and /climate-highlights.
//
// 2026-09-02: re-set in the landing page's current typographic language
// (About 01 / OBOS 02 / Studies 03): a width-filling title, the outlined
// numeral top-right, small mono straps, a hairline-ruled status table, one
// filled call. The night-tide furniture — three drifting wave SVGs, the tick
// gauge, the corner crosshairs, the bobbing numeral — is gone; the star field
// stays, quietly. Same props, same slots, same mailto, so every consumer
// keeps working unchanged. `gaugeLabel` now renders as the small mono line
// bottom-right rather than a gauge.
//
// Stars are generated deterministically at build time; the page ships as
// static HTML with pure-CSS animation, and everything stills under reduced
// motion. Title goes in the default slot so pages can mark up <em> accents.
interface StatusRow {
  k: string;
  v: string;
  live?: boolean;
}
interface Props {
  kicker: string;
  sub: string;
  ghost: string;
  gaugeLabel?: string;
  statusRows?: StatusRow[];
  backHref?: string;
  backLabel?: string;
  nextHref?: string;
  nextLabel?: string;
  notifySubject: string;
}
const {
  kicker,
  sub,
  ghost,
  gaugeLabel,
  statusRows = [],
  backHref = '/',
  backLabel = 'Back to home',
  nextHref,
  nextLabel,
  notifySubject,
} = Astro.props;

let starSeed = `${ghost}:${kicker}`.split('').reduce(
  (seed, character) => Math.imul(seed ^ character.charCodeAt(0), 16777619) >>> 0,
  2166136261,
);
const starRandom = () => {
  starSeed = (starSeed + 0x6d2b79f5) >>> 0;
  let value = starSeed;
  value = Math.imul(value ^ (value >>> 15), value | 1);
  value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
  return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
};
const stars = Array.from({ length: 60 }, () => ({
  x: +(starRandom() * 100).toFixed(2),
  y: +(starRandom() * 70).toFixed(2),
  d: +(starRandom() * 4).toFixed(2),
  o: +(0.15 + starRandom() * 0.4).toFixed(2),
}));
const live = statusRows.find((r) => r.live);
const mailto = `mailto:angad@deltaclimate.earth,shirsha@deltaclimate.earth?subject=${encodeURIComponent(notifySubject)}`;
---

<main id="main" tabindex="-1" class="soon">
  <div class="stars" aria-hidden="true">
    {stars.map((s) => <i style={`left:${s.x}%; top:${s.y}%; animation-delay:${s.d}s; --o:${s.o}`}></i>)}
  </div>

  <span class="ghost-index soon-ghost" aria-hidden="true">{ghost}</span>

  <div class="wrap core" data-reveal-group data-stagger="110">
    <div class="head">
      <p class="kicker">{kicker}</p>
      {live && <p class="state"><i class="dot"></i>{live.v}</p>}
    </div>

    <h1 class="sec-title soon-title"><slot /></h1>

    <p class="sub">{sub}</p>

    {statusRows.length > 0 && (
      <dl class="status">
        {statusRows.map((r) => (
          <div class="row">
            <dt>{r.k}</dt>
            <dd class:list={[{ live: r.live }]}>{r.live && <i class="dot"></i>}{r.v}</dd>
          </div>
        ))}
      </dl>
    )}

    <!-- Optional call to action. A coming-soon page can point somewhere real
         instead of only offering a mailto (cbam.astro uses this for the estimator). -->
    <slot name="extra" />

    <div class="actions">
      <a class="go" href={mailto}>Request a notification <span aria-hidden="true">↗</span></a>
      <a class="roll-link" href={backHref} data-roll>{backLabel} <span class="arrow" aria-hidden="true">↙</span></a>
      {nextHref && nextLabel && (
        <a class="roll-link" href={nextHref} data-roll>{nextLabel} <span class="arrow" aria-hidden="true">↗</span></a>
      )}
    </div>
  </div>

  {gaugeLabel && <span class="meta" aria-hidden="true">{gaugeLabel}</span>}
</main>

<style>
  .soon {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 9rem 6rem;
    background:
      radial-gradient(55% 45% at 70% 25%, rgb(111 202 214 / 0.05), transparent 65%),
      var(--color-base);
  }

  /* star field — quiet, and the only thing that moves */
  .stars { position: absolute; inset: 0; z-index: 0; }
  .stars i {
    position: absolute; width: 2px; height: 2px; border-radius: 50%;
    background: var(--color-cyan-muted);
    opacity: var(--o, 0.3);
    animation: soon-twinkle 5.5s ease-in-out infinite;
  }
  @keyframes soon-twinkle { 0%, 100% { opacity: 0.1; } 50% { opacity: var(--o, 0.5); } }

  /* the numeral — display face, heavy, outlined, top-right. Keeps .ghost-index
     so section-effects' opacity/scale scrub still applies. */
  .soon-ghost {
    position: absolute;
    right: clamp(1rem, 4vw, 4rem);
    top: clamp(5rem, 12vh, 8rem);
    z-index: 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(9rem, 21vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    -webkit-text-stroke: 1px rgb(176 141 87 / 0.26);
    pointer-events: none;
  }

  .core { position: relative; z-index: 2; width: 100%; }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .kicker,
  .state {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-cyan-muted);
  }
  .dot {
    display: inline-block; width: 5px; height: 5px; border-radius: 50%;
    background: var(--color-cyan); margin-right: 0.55em; vertical-align: middle;
    animation: soon-blink 2.4s ease-in-out infinite;
  }
  @keyframes soon-blink { 50% { opacity: 0.25; } }

  /* THE TITLE — the About treatment, one step down for three-line paper titles */
  .soon-title {
    margin: clamp(2rem, 4.5vh, 3.2rem) 0 0;
    max-width: 14ch;
    font-weight: 500;
    font-size: clamp(2.8rem, 6.8vw, 6.6rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--color-paper);
  }
  /* accent in the same face and weight — colour only. Overrides the global
     serif-800 / scaleY(1.18) / capitalised-first-letter accent. */
  .soon-title :global(em) {
    font-family: inherit;
    font-weight: inherit;
    font-style: normal;
    color: var(--color-cyan);
    letter-spacing: inherit;
    display: inline;
    transform: none;
  }
  .soon-title :global(em)::first-letter { text-transform: none; }

  .sub {
    margin: clamp(1.4rem, 3vh, 2.2rem) 0 0;
    max-width: 44ch;
    font-size: clamp(0.98rem, 1.25vw, 1.15rem);
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  /* status — hairline rows, not a card */
  .status {
    margin: clamp(2.2rem, 5vh, 3.4rem) 0 0;
    max-width: 44ch;
    border-top: 1px solid rgb(176 141 87 / 0.35);
  }
  .status .row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .status dt { color: var(--color-ink-faint); }
  .status dd { margin: 0; color: var(--color-paper); }
  .status dd.live { color: var(--color-cyan); }

  .actions {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 2.2rem;
    margin-top: clamp(2rem, 4.5vh, 3.2rem);
  }
  .go {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-base);
    background: var(--color-cyan);
    padding: 0.95rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .go:hover { background: var(--color-paper-bright); }

  /* the draft line — small mono, bottom right, where the gauge used to be */
  .meta {
    position: absolute;
    right: clamp(1.6rem, 4vw, 3.2rem);
    bottom: clamp(1.6rem, 4vw, 3rem);
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  @media (max-width: 760px) {
    .soon-ghost { font-size: clamp(6rem, 30vw, 10rem); right: 0.5rem; top: 4.5rem; opacity: 0.7; }
    .head { flex-direction: column; gap: 0.4rem; }
    .soon-title { max-width: none; font-size: clamp(2.2rem, 11vw, 3.2rem); }
    .status .row { grid-template-columns: 7rem 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stars i, .dot { animation: none; }
  }
</style>
