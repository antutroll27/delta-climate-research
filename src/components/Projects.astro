---
// Section 3 — Projects. Horizontal-scroll case-study cards.
const projects = [
  {
    id: '01',
    title: 'Project Kolkata',
    sub: 'Urban Heat Mitigation',
    tags: 'ECOSTRESS · HVI',
    blurb: 'Street-scale heat diagnostics to ward-level intervention spec.',
    href: '/projects/kolkata',
  },
  {
    id: '02',
    title: 'Mangrove Blue Carbon',
    sub: 'Biochar Sequestration',
    tags: 'VERRA VM0033 · MRV',
    blurb: 'Soil-carbon-rigorous restoration accounting for premium credits.',
    href: '/projects/mangrove-blue-carbon',
  },
  {
    id: '03',
    title: 'Sustainable Materials Trading',
    sub: 'UAE–India Corridor',
    tags: 'EPD · CBAM',
    blurb: 'Embodied-carbon dossiers and CBAM compliance for exporters.',
    href: '/projects/materials-trading',
  },
];
---

<section id="projects" class="section divider-top" aria-labelledby="projects-title">
  <span class="draw-line" data-draw aria-hidden="true"></span>
  <div class="wrap flex items-end justify-between gap-6 mb-head-mb" data-reveal>
    <div>
      <p class="sec-index">02 — Projects</p>
      <h2 id="projects-title" class="sec-title">Proof, before <em>theory.</em></h2>
    </div>
    <a class="accent-link" href="/projects">All case studies ↗</a>
  </div>

  <div class="wrap">
    <div class="rail-wrap overflow-x-auto">
      <ul class="rail grid grid-flow-col auto-cols-[minmax(280px,1fr)] gap-5 list-none m-0" role="list" data-reveal-group data-stagger="90">
      {projects.map((p) => (
        <li class="card">
          <a href={p.href} class="card-link flex flex-col h-full border border-hairline rounded-card overflow-hidden bg-surface no-underline">
            <span class="cover" aria-hidden="true"></span>
            <span class="card-body flex flex-col px-5 pt-5 pb-2xl">
              <span class="card-tags font-mono text-tag tracking-widest uppercase text-cyan-muted">{p.tags}</span>
              <span class="card-title mt-sm font-bold text-cardtitle tracking-title text-paper">
                <span class="card-id font-mono text-meta text-bronze mr-2">{p.id}</span>{p.title}
              </span>
              <span class="card-sub mt-3xs text-body-sm text-ink-muted">{p.sub}</span>
              <span class="card-blurb mt-lg text-body-sm leading-normal text-ink-faint max-w-[40ch]">{p.blurb}</span>
              <span class="card-arrow mt-xl text-cyan text-arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Retained: scrollbar-width has no utility; snap + media kept verbatim. */
  .rail-wrap { scrollbar-width: thin; }
  .rail { scroll-snap-type: x mandatory; }
  @media (max-width: 720px) {
    .rail { grid-auto-columns: minmax(82vw, 82vw); }
  }

  .card { scroll-snap-align: start; }

  /* Retained: hover + transition (not in no-hover screenshots). */
  .card-link { transition: border-color 0.25s ease, transform 0.25s ease; }
  .card-link:hover { border-color: var(--color-cyan); transform: translateY(-3px); }

  /* Retained: gradient cover, aspect-ratio, grayscale filter + hover. */
  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(70% 90% at 30% 20%, rgb(111 202 214 / 0.12), transparent 60%),
      linear-gradient(140deg, #0e3236, #07191b);
    filter: grayscale(0.6);
    transition: filter 0.4s ease;
  }
  .card-link:hover .cover { filter: grayscale(0); }

  /* Retained: arrow transition + hover. */
  .card-arrow { transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .card-link:hover .card-arrow { transform: translate(3px, -3px); }
</style>
