---
// "Drafting table" coming-soon page body (Projects side). The page reads as an
// unfinished survey sheet: grid + contour lines drawing themselves, a bronze
// UNDER CONSTRUCTION stamp, a plotting cursor after the title, and a survey
// readout (coords / sheet / rev) in the corner. Pure CSS/SVG animation —
// everything freezes gracefully under prefers-reduced-motion.
// Title goes in the default slot so pages can mark up <em> accents.
interface Props {
  kicker: string;
  sub: string;
  coords: string;
  sheet: string;
  rev: string;
  progress?: number; // 0..1 along the field→published meter
  backHref?: string;
  backLabel?: string;
}
const {
  kicker,
  sub,
  coords,
  sheet,
  rev,
  progress = 0.35,
  backHref = '/#projects',
  backLabel = 'Back to all projects',
} = Astro.props;
const pct = Math.round(Math.min(1, Math.max(0, progress)) * 100);
---

<main id="main" tabindex="-1" class="soon-draft">
  <div class="draft-bg" aria-hidden="true">
    <div class="gridlines"></div>
    <svg class="contours" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice">
      <path d="M900 120 Q 1050 90 1150 170 T 1380 240 Q 1300 360 1180 330 T 940 280 Q 860 220 900 120 Z" />
      <path class="cy" d="M950 160 Q 1070 140 1140 200 T 1320 250 Q 1260 330 1160 305 T 980 270 Q 920 225 950 160 Z" />
      <path d="M990 200 Q 1080 185 1130 225 T 1260 260 Q 1220 300 1140 285 T 1010 255 Q 970 235 990 200 Z" />
      <path class="cy" d="M180 600 Q 320 540 460 600 T 740 640 Q 660 740 480 710 T 220 670 Q 140 640 180 600 Z" />
      <path d="M260 620 Q 360 580 460 620 T 660 650 Q 600 710 470 690 T 290 660 Q 230 645 260 620 Z" />
    </svg>
  </div>

  <span class="stamp" aria-hidden="true">Under Construction</span>

  <div class="wrap core" data-reveal-group data-stagger="110">
    <p class="sec-kicker">{kicker}</p>
    <h1 class="sec-title draft-title"><slot /><span class="plot-cursor" aria-hidden="true"></span></h1>
    <p class="draft-sub">{sub}</p>

    <div class="meter" role="img" aria-label={`Roughly ${pct}% of the way from field work to publication`}>
      <div class="bar"><i style={`--p:${pct}%`}></i></div>
      <div class="lab"><span>Field work</span><span>Analysis</span><span>Draft</span><span>Published</span></div>
    </div>

    <slot name="extra" />

    <div class="actions">
      <a class="roll-link" href={backHref} data-roll>{backLabel} <span class="arrow" aria-hidden="true">↙</span></a>
      <a class="accent-link" href={`mailto:angad@deltaclimate.earth,shirsha@deltaclimate.earth?subject=Notify%20me%20%E2%80%94%20${sheet}`}>Request a notification ↗</a>
    </div>
  </div>

  <div class="coords" aria-hidden="true">
    <span>{coords}</span><br />
    <span>SHEET <b>{sheet}</b> — REV <b>{rev}</b> — SCALE <b>1:DECISION</b></span>
  </div>
</main>

<style>
  .soon-draft {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 9rem 6rem;
    background: var(--color-base);
  }
  .core { position: relative; z-index: 2; }

  /* survey sheet background */
  .draft-bg { position: absolute; inset: 0; z-index: 0; }
  .gridlines {
    position: absolute; inset: 0; opacity: 0.35;
    background-image:
      linear-gradient(rgb(111 202 214 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(111 202 214 / 0.05) 1px, transparent 1px);
    background-size: 72px 72px;
  }
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; }
  .contours path {
    fill: none; stroke: var(--color-bronze); stroke-opacity: 0.28; stroke-width: 1;
    stroke-dasharray: 1400; stroke-dashoffset: 1400;
    animation: draft-draw 9s ease-in-out infinite alternate;
  }
  .contours path.cy { stroke: var(--color-cyan); stroke-opacity: 0.18; }
  .contours path:nth-child(2) { animation-delay: 0.6s; }
  .contours path:nth-child(3) { animation-delay: 1.2s; }
  .contours path:nth-child(4) { animation-delay: 1.8s; }
  .contours path:nth-child(5) { animation-delay: 2.4s; }
  @keyframes draft-draw { to { stroke-dashoffset: 0; } }

  .stamp {
    position: absolute; right: clamp(2rem, 10vw, 12rem); top: 22%; z-index: 1;
    transform: rotate(-4deg);
    border: 2px solid var(--color-bronze); color: var(--color-bronze);
    font-family: var(--font-mono); font-size: clamp(0.8rem, 1.4vw, 1.05rem);
    letter-spacing: 0.3em; text-transform: uppercase;
    padding: 1rem 1.6rem; opacity: 0.85;
    box-shadow: 0 0 0 5px rgb(176 141 87 / 0.07);
    animation: draft-stamp 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s backwards;
  }
  @keyframes draft-stamp { from { transform: rotate(-9deg) scale(1.8); opacity: 0; } }

  .draft-title { max-width: 16ch; }
  .plot-cursor {
    display: inline-block; width: 0.5em; height: 1em;
    background: var(--color-bronze); vertical-align: -0.08em; margin-left: 0.18em;
    animation: draft-blink 1s steps(2) infinite;
  }
  @keyframes draft-blink { 50% { opacity: 0.15; } }

  .draft-sub {
    margin-top: 1.5rem; max-width: 52ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem); font-weight: 300; line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .meter { margin-top: clamp(2.5rem, 5vh, 4rem); width: min(30rem, 80vw); }
  .meter .bar { height: 2px; background: rgb(176 141 87 / 0.2); position: relative; overflow: hidden; }
  .meter .bar i {
    position: absolute; inset-block: 0; left: 0; width: var(--p, 35%);
    background: var(--color-bronze);
    animation: draft-surveyor 5s ease-in-out infinite alternate;
  }
  @keyframes draft-surveyor { from { margin-right: 0; } to { transform: scaleX(1.12); transform-origin: left; } }
  .meter .lab {
    display: flex; justify-content: space-between; margin-top: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--color-ink-faint);
  }

  .actions {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(2.5rem, 5vh, 4rem);
  }
  .actions .accent-link { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; }

  .coords {
    position: absolute; bottom: 2rem; right: clamp(1.5rem, 4vw, 4rem); z-index: 1;
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em;
    color: var(--color-ink-faint); text-align: right; line-height: 2;
  }
  .coords b { color: var(--color-cyan-muted); font-weight: 400; }

  @media (max-width: 820px) {
    .stamp { right: 1rem; top: 14%; }
    .coords { position: static; margin-top: 3rem; text-align: left; padding-inline: var(--gutter, 1.5rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contours path { animation: none; stroke-dashoffset: 0; }
    .stamp, .plot-cursor, .meter .bar i { animation: none; }
  }
</style>
