---
// Section 03 — Studies. Two panels, side by side on wide screens, stacked
// below: the ECOSTRESS heat-vulnerability paper with a PROCEDURAL heat field
// drawn in the browser, and the embodied-carbon / CBAM work with a restrained
// certificate ledger. Both visuals are generated, both say so on the panel,
// and both hand off to the real thing — the paper and the calculator.
//
// Living parts run from src/scripts/studies-field.ts (init/destroy wired in
// Base.astro like about-field). Layout and reveals use the page's existing
// section system: .section / .divider-top / .draw-line / data-reveal / data-clip.
import { papers, paperHref } from '../../data/papers';

const INDEX = '03';
const heat = papers.find((p) => p.slug === 'ecostress-heat-vulnerability');
const cbam = papers.find((p) => p.slug === 'embodied-carbon-cbam');
if (!heat || !cbam) throw new Error('Studies.astro: expected both paper slugs in src/data/papers');
---

<section id="studies" class="section divider-top" aria-labelledby="studies-title">
  <span class="draw-line" data-draw aria-hidden="true"></span>

  <div class="wrap">
    <div class="head" data-reveal>
      <p class="sec-index">{INDEX} Studies</p>
      <p class="strap">Two things we measured &nbsp;·&nbsp; published as they land</p>
    </div>
    <h2 id="studies-title" class="title" data-reveal>
      <span class="ln"><span>Heat from orbit.</span></span>
      <span class="ln"><span>Carbon <em>at the border.</em></span></span>
    </h2>
  </div>

  <div class="wrap">
    <div class="panels">

      <!-- ── A · ECOSTRESS heat vulnerability ── -->
      <article class="panel" data-reveal>
        <a class="frame" href={paperHref(heat)} data-clip style="--clip-radius: 14px;" aria-label={`Read: ${heat.title}`}>
          <canvas data-heat width="320" height="200" aria-hidden="true"></canvas>
          <span class="tag tl" aria-hidden="true">LST &nbsp;·&nbsp; ECOSTRESS &nbsp;·&nbsp; 70 m &nbsp;·&nbsp; ISS overpass</span>
          <span class="tag bl warn" aria-hidden="true">Procedural field &nbsp;·&nbsp; not a measurement</span>
          <span class="bar" aria-hidden="true"><i>29</i><b></b><i>38 °C</i></span>
          <span class="scrim" aria-hidden="true"></span>
          <span class="call" aria-hidden="true">Read the paper <i>↗</i></span>
        </a>
        <p class="meta">Thermal from the Space Station &nbsp;·&nbsp; 87 ward-scenes &nbsp;·&nbsp; Kolkata</p>
        <h3>{heat.title}</h3>
        <p class="lede">Where the city holds heat after dark — read from orbit at 70 m, and checked ward by ward against what the model says it should be.</p>
      </article>

      <!-- ── B · Embodied carbon & CBAM ── -->
      <article class="panel" data-reveal>
        <a class="frame ledger" href="/cbam" data-clip data-ledger style="--clip-radius: 14px;" aria-label="Open the CBAM explainer">
          <span class="tag tl" aria-hidden="true">CBAM certificate estimate</span>
          <span class="tag tr warn" aria-hidden="true">Illustrative &nbsp;·&nbsp; your route in the calculator</span>

          <div class="tabs" aria-hidden="true">
            <span data-tab class="is-on">Steel</span><span data-tab>Cement</span><span data-tab>Aluminium</span>
          </div>

          <div class="body" aria-hidden="true">
            <div class="bars">
              <div class="col"><span class="track"><i data-bar></i></span><span class="lbl">Direct</span></div>
              <div class="col"><span class="track"><i data-bar class="el"></i></span><span class="lbl">Electricity</span></div>
              <div class="col"><span class="track"><i data-bar></i></span><span class="lbl">Precursors</span></div>
            </div>
            <div class="figs">
              <span class="good" data-good>Steel (BF–BOF)</span>
              <span class="fig"><b data-total>2.6</b><small>t CO₂e per t</small></span>
              <span class="fig eur"><b>€<span data-eur>195</span></b><small>per t at the border</small></span>
            </div>
          </div>

          <div class="route" aria-hidden="true">
            <span class="node">Producer</span><span class="node">Verified</span><span class="node">EU border</span>
            <i class="dot" data-dot></i>
          </div>

          <span class="scrim" aria-hidden="true"></span>
          <span class="call" aria-hidden="true">Open the explainer <i>↗</i></span>
        </a>
        <p class="meta">EU CBAM &nbsp;·&nbsp; steel, cement, aluminium &nbsp;·&nbsp; definitive period from 2026</p>
        <h3>{cbam.title}</h3>
        <p class="lede">What a tonne carries at the border and what it costs — worked from your production route, not a default factor, and refused when the rule can’t be sourced.</p>
      </article>

    </div>
  </div>
</section>

<style>
  #studies { overflow: hidden; }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .sec-index { margin: 0; }
  .strap { margin: 0; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ink-faint); }

  /* the section title — the About scale, one step down */
  .title {
    margin: clamp(1.4rem, 3vh, 2.2rem) 0 clamp(2.4rem, 5vh, 3.8rem);
    font-weight: 500;
    font-size: clamp(2.6rem, 6.4vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--color-paper);
  }
  .title .ln { display: block; }
  .title em { font-style: normal; color: var(--color-cyan); }

  .panels { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 4vw, 3.5rem); }
  @media (min-width: 1100px) { .panels { grid-template-columns: 1fr 1fr; } }

  /* ── the frames ── */
  .frame {
    position: relative; display: block;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-hairline);
    border-radius: 14px; overflow: hidden;
    background: var(--color-surface);
    text-decoration: none; color: inherit;
  }
  .frame canvas { display: block; width: 100%; height: 100%; image-rendering: auto; }
  .tag {
    position: absolute; z-index: 2;
    font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-cyan-muted); background: rgb(5 6 6 / 0.62); padding: 0.35rem 0.6rem; border-radius: 4px;
  }
  .tag.tl { left: 1rem; top: 0.9rem; }
  .tag.tr { right: 1rem; top: 0.9rem; }
  .tag.bl { left: 1rem; bottom: 0.9rem; }
  .tag.warn { color: var(--color-bronze); }
  /* colour bar, bottom right of the heat frame */
  .bar {
    position: absolute; right: 1rem; bottom: 0.9rem; z-index: 2;
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.12em; color: var(--color-paper);
    background: rgb(5 6 6 / 0.62); padding: 0.35rem 0.6rem; border-radius: 4px;
  }
  .bar i { font-style: normal; }
  .bar b { display: block; width: 84px; height: 5px; border-radius: 3px;
           background: linear-gradient(90deg, #5fb7c1, #a9c46b, #e4b34a, #e77a3e, #ea4b4b); }

  .scrim { position: absolute; inset: 0; z-index: 3; opacity: 0;
    background: radial-gradient(60% 50% at 50% 50%, rgb(5 6 6 / 0.55) 0%, rgb(5 6 6 / 0.15) 60%, transparent 100%);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .call { position: absolute; z-index: 4; left: 50%; top: 50%; transform: translate(-50%, -50%) translateY(6px);
    font-family: var(--font-mono); font-size: clamp(0.62rem, 0.85vw, 0.76rem); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-paper); padding: 0.8rem 1.3rem; border: 1px solid rgb(236 237 240 / 0.55); border-radius: 999px;
    background: rgb(5 6 6 / 0.55); backdrop-filter: blur(8px); opacity: 0; white-space: nowrap;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .call i { font-style: normal; color: var(--color-cyan); margin-left: 0.4em; }
  .frame:hover .scrim, .frame:focus-visible .scrim { opacity: 1; }
  .frame:hover .call, .frame:focus-visible .call { opacity: 1; transform: translate(-50%, -50%); }

  /* ── the ledger ── */
  .ledger {
    background:
      linear-gradient(var(--color-hairline) 1px, transparent 1px) 0 0 / 100% 28px,
      linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px) 0 0 / 28px 100%,
      var(--color-surface);
    display: grid; grid-template-rows: auto 1fr auto;
    padding: 3.2rem 1.5rem 1.4rem;
  }
  .tabs { display: flex; gap: 1.2rem; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-faint); }
  .tabs span { transition: color 0.4s ease; padding-bottom: 0.3rem; border-bottom: 1px solid transparent; }
  .tabs span.is-on { color: var(--color-paper); border-bottom-color: var(--color-bronze); }
  .body { display: grid; grid-template-columns: 1fr minmax(11rem, 40%); gap: 1.5rem; align-items: end; padding-block: 1.2rem 1rem; }
  .bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: end; height: 100%; min-height: 8rem; }
  .col { display: grid; grid-template-rows: 1fr auto; gap: 0.55rem; height: 100%; }
  .track { position: relative; display: block; height: 100%; min-height: 6rem; border-bottom: 1px solid rgb(176 141 87 / 0.45); }
  .track i { position: absolute; left: 22%; right: 22%; bottom: 0; height: 100%; display: block; background: var(--color-cyan); opacity: 0.85;
             transform: scaleY(0.05); transform-origin: bottom; transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
  .track i.el { background: var(--color-cyan-muted); }
  .lbl { font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-faint); }
  .figs { display: grid; gap: 0.7rem; text-align: right; }
  .good { font-size: 0.95rem; font-weight: 500; color: var(--color-paper); letter-spacing: -0.01em; }
  .fig b { display: block; font-family: var(--font-mono); font-size: clamp(1.6rem, 2.4vw, 2.3rem); line-height: 1; color: var(--color-cyan); font-weight: 400; letter-spacing: -0.02em; }
  .fig.eur b { color: var(--color-bronze); }
  .fig small { display: block; margin-top: 0.3rem; font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-faint); }
  .route { position: relative; display: flex; justify-content: space-between; padding-top: 0.9rem; border-top: 1px solid var(--color-hairline);
           font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-faint);
           --route-w: calc(100% - 8px); }
  .route .dot { position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--color-bronze); box-shadow: 0 0 0 3px rgb(176 141 87 / 0.18); }

  /* ── copy under each panel ── */
  .meta { margin: 1.1rem 0 0.5rem; font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-faint); }
  .panel h3 { margin: 0; font-size: clamp(1.25rem, 1.7vw, 1.6rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: var(--color-paper); }
  .lede { margin: 0.7rem 0 0; max-width: 46ch; font-size: clamp(0.95rem, 1.1vw, 1.05rem); font-weight: 300; line-height: 1.55; color: var(--color-ink-muted); }

  @media (max-width: 760px) {
    .head { flex-direction: column; gap: 0.4rem; }
    .body { grid-template-columns: 1fr; }
    .figs { text-align: left; }
    .tag.tr { display: none; }
    .call { opacity: 1; transform: translate(-50%, -50%); }
  }
</style>
