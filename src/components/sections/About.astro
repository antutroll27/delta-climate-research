---
// Section 01 — About. Left-set typography over the living GPU wave field:
// a width-filling masked title (ghost index top-right), one clear band of open
// water, then the statement beside a hairline mono table of the three
// practice areas. about-field.ts still owns the sea (it calms as the section
// scrolls: data → decision). Type choreography lives in section-effects.ts.
//
// 2026-09-02: typography ported from the about-v2 preview; the image rafts
// were taken OUT at the same time (the <img data-raft-img> row that fed them
// as textures is gone). about-field.ts handles zero rafts. To bring them back,
// restore that row inside [data-deck] and give placeCards() three anchors.
const pillars = [
  { id: '/01', k: 'Climatology',       v: 'Climate risk assessment · Geospatial research · Global climate modelling' },
  { id: '/02', k: 'Nature Analytics',  v: 'Human–environment interactions · Regional planning · Ecological outcomes' },
  { id: '/03', k: 'Sectoral Strategy', v: 'Regulatory alignment · Environmental compliance · Sustainability reporting' },
];
---

<section id="about" aria-labelledby="about-title">
  <canvas data-field aria-hidden="true"></canvas>
  <div class="field-dim" aria-hidden="true"></div>

  <span class="ghost-index" aria-hidden="true">01</span>

  <div class="about-core">
    <p class="sec-kicker"><b>01</b> About</p>

    <h2 id="about-title" class="sec-title" data-mask>
      <span class="ln"><span>Between the data</span></span>
      <span class="ln"><span>and the <em>decision.</em></span></span>
    </h2>

    <!-- open water: the band where the sea shows through. about-field.ts reads
         [data-deck] to place rafts; there are none now, so it is only the stage. -->
    <div class="water-deck" data-deck aria-hidden="true"></div>

    <div class="deck">
      <div class="statement-col">
        <!-- no data-words: the scrub-blur reveal left this copy faded until
             well past the section, so the statement now renders at full opacity. -->
        <p class="statement">
          Delta Climate Research sits between raw earth-science data and the institutions
          that must act on it — turning <span class="em">decision-grade</span> measurement into
          standards-aligned, <span class="em">defensible</span> adaptation strategy.
        </p>
        <p class="statement-meta">Imagined in Kolkata · Built for the Global South</p>
      </div>

      <table class="practice" aria-label="Practice areas">
        <thead><tr><th scope="col">№</th><th scope="col">Discipline</th><th scope="col">Scope</th><th scope="col"><span class="sr-only">Open</span></th></tr></thead>
        <tbody>
          {pillars.map((p) => (
            <tr>
              <td class="i">{p.id}</td>
              <td class="k">{p.k}</td>
              <td class="s">{p.v}</td>
              <td class="a" aria-hidden="true">→</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="sec-meta" aria-hidden="true">
    <span class="live">OCEAN — LIVE</span><br />
    22.5726°N · 88.3639°E<br />
    EOS / ECOSTRESS
  </div>
</section>

<style>
  #about {
    position: relative;
    overflow: hidden;
    /* extra room at the foot so the coordinates meta sits below the table */
    padding-block: clamp(5.5rem, 10vh, 8rem) clamp(6.5rem, 11vh, 8.5rem);
    /* quiet gradient — all the field non-WebGL users get */
    background:
      radial-gradient(60% 45% at 50% 62%, rgb(111 202 214 / 0.05), transparent 70%),
      var(--color-base);
  }

  [data-field] { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* vignette keeps type sovereign and melts the ocean into the page base —
     the radial is wider than before because the title now spans the width */
  .field-dim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(72% 40% at 50% 30%, rgb(5 6 6 / 0.58) 0%, rgb(5 6 6 / 0.26) 55%, transparent 80%),
      linear-gradient(to bottom, var(--color-base) 0%, transparent 32%, transparent 80%, var(--color-base) 100%),
      linear-gradient(to right, var(--color-base) 0%, transparent 9%, transparent 91%, var(--color-base) 100%);
  }

  .about-core {
    position: relative;
    z-index: 2;
    text-align: left;
    padding-inline: clamp(1.5rem, 5vw, 5.5rem);
  }

  /* kicker: small mono, bronze number, quiet label */
  .sec-kicker {
    display: block;
    margin-bottom: 0;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--color-cyan-muted);
  }
  .sec-kicker b { font-weight: 400; color: var(--color-bronze); }

  /* ghost index — top-right, in the display face, heavy and outlined */
  .ghost-index {
    position: absolute;
    right: clamp(1rem, 4vw, 4rem);
    top: clamp(0.6rem, 2vh, 2rem);
    z-index: 1;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(9rem, 21vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    -webkit-text-stroke: 1px rgb(176 141 87 / 0.26);
    pointer-events: none;
  }

  /* THE TITLE — fills the width */
  .sec-title {
    position: relative;
    z-index: 1;
    margin: clamp(2.2rem, 5vh, 3.6rem) 0 0;
    max-width: none;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.94;
    font-size: clamp(3.4rem, 9.4vw, 9.6rem);
  }
  .sec-title .ln { white-space: nowrap; }
  /* the accent stays in the same face and weight as the line — colour only.
     Overrides the global serif-800 / scaleY(1.18) / capitalised-first-letter accent. */
  .sec-title em {
    font-family: inherit;
    font-weight: inherit;
    font-style: normal;
    color: var(--color-cyan);
    letter-spacing: inherit;
    display: inline;
    transform: none;
  }
  .sec-title em::first-letter { text-transform: none; }
  /* phones: shrink with the shared .sec-title mobile tier so long words fit */
  @media (max-width: 480px) {
    .sec-title { font-size: clamp(2.2rem, 11vw, 3.2rem); }
  }

  /* open water band — deliberately empty */
  .water-deck { height: clamp(7rem, 14vh, 11rem); }

  /* lower deck: statement column beside the practice table */
  .deck {
    display: grid;
    grid-template-columns: minmax(0, 38ch) 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  /* the statement — plain, no per-word reveal (see the markup note above) */
  .statement {
    margin: 0;
    max-width: none;
    font-size: clamp(0.98rem, 1.25vw, 1.15rem);
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--color-paper);
  }
  .statement .em { font-weight: 800; color: var(--color-cyan); }
  .statement-meta {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  /* practice table — hairline rows, mono caps, the discipline in the display face */
  .practice {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .practice th {
    text-align: left;
    font-weight: 400;
    color: var(--color-ink-faint);
    padding: 0 0 0.6rem;
    border-bottom: 1px solid rgb(176 141 87 / 0.35);
  }
  .practice td {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-hairline);
    vertical-align: top;
    color: var(--color-ink-muted);
  }
  .practice td.i { color: var(--color-bronze); width: 3.2rem; }
  .practice td.k {
    width: 15rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--color-paper);
  }
  .practice td.a { width: 2rem; text-align: right; color: var(--color-cyan-muted); }
  .practice tbody tr { transition: color 0.35s ease; }
  .practice tbody tr:hover td { color: var(--color-paper); }
  .practice tbody tr:hover td.a { color: var(--color-cyan); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* coordinates meta — bottom right */
  .sec-meta {
    position: absolute;
    bottom: clamp(1.6rem, 4vw, 3rem);
    right: clamp(1.6rem, 4vw, 3.2rem);
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    text-align: right;
    line-height: 1.8;
  }
  .sec-meta .live { color: var(--color-cyan-muted); }

  @media (max-width: 900px) {
    .deck { grid-template-columns: 1fr; }
    .sec-title { font-size: clamp(2.4rem, 11vw, 4rem); }
    .sec-title .ln { white-space: normal; }
    .ghost-index { font-size: clamp(6rem, 30vw, 10rem); right: 0.5rem; }
    .practice td.k { width: auto; }
    .practice td.s { display: none; }   /* scope line is too long for a phone row */
  }
</style>
