---
// Section 5 — Medni: the interactive data bank (product highlight).
// Map + map-island mount later; this is the dashboard shell structure.
---

<section id="medni" class="section divider-top" aria-labelledby="medni-title">
  <span class="draw-line" data-draw aria-hidden="true"></span>
  <div class="wrap mb-(--space-head-mb)" data-reveal>
    <p class="sec-index">04 — Medni</p>
    <h2 id="medni-title" class="sec-title">Living <em>intelligence,</em> by location.</h2>
    <p class="mt-4 max-w-[50ch] text-mednisub text-ink-muted">
      Hyper-local climate-risk and adaptation guidance, on one geospatial spine.
    </p>
  </div>

  <div class="wrap">
    <!-- data-clip owns the entrance (wipe + fade); no data-reveal, so the GSAP
         clip and the IntersectionObserver reveal never co-own opacity. -->
    <div class="dashboard" data-clip style="--clip-radius: 16px;">
      <div class="map" aria-label="Interactive climate map (placeholder)">
        <span class="map-grid" aria-hidden="true"></span>
        <span class="map-tag">22.57°N · 88.36°E — KOLKATA</span>
        <span class="map-overlay" aria-hidden="true"></span>
      </div>

      <aside class="flex flex-col rounded-[12px] p-[1.25rem] bg-surface-2 border border-hairline font-mono">
        <p class="m-0 mb-[1rem] text-[0.75rem] tracking-[0.08em] text-cyan">// LIVE AI PROCESSING</p>
        <ul class="list-none m-0 mb-auto p-0 grid gap-[0.55rem]" role="list">
          <li class="text-[0.78rem] leading-[1.5] text-ink-muted">&gt; ingesting LST raster…</li>
          <li class="text-[0.78rem] leading-[1.5] text-ink-muted">&gt; computing heat-vulnerability index…</li>
          <li class="text-[0.78rem] leading-[1.5] text-ink-muted">&gt; cross-referencing cool-roof SRI…</li>
          <li class="cursor text-[0.78rem] leading-[1.5] text-ink-muted">&gt; recommending intervention spec</li>
        </ul>
        <a href="#access" class="mt-6 text-center text-[0.8125rem] tracking-[0.03em] text-cyan border border-cyan rounded-lg px-4 py-[0.85rem] no-underline transition-[background-color,color] duration-200 hover:bg-cyan hover:text-[color:var(--color-base)]">Access Planetary Insights →</a>
      </aside>
    </div>
  </div>
</section>

<style>
  .dashboard {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    border: 1px solid var(--color-hairline);
    border-radius: 16px;
    overflow: hidden;
    padding: 1.25rem;
    background: var(--color-surface);
  }
  @media (min-width: 900px) {
    .dashboard { grid-template-columns: 1fr 320px; }
  }

  .map {
    position: relative;
    min-height: clamp(300px, 48vh, 460px);
    border-radius: 12px;
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 35% 40%, rgb(111 202 214 / 0.28), transparent 60%),
      var(--color-surface-2);
  }
  .map-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--color-hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
  }
  .map-overlay {
    position: absolute; inset: 0;
    background: radial-gradient(28% 36% at 38% 42%, rgb(176 141 87 / 0.4), transparent 70%);
    mix-blend-mode: screen;
  }
  .map-tag {
    position: absolute; left: 1rem; bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-cyan-muted);
  }

  .cursor::after {
    content: '▋';
    color: var(--color-cyan);
    margin-left: 2px;
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor::after { animation: none; } }
</style>
