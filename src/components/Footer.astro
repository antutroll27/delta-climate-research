---
const year = 2026;
const links = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'White Papers', href: '/white-papers' },
  { label: 'Medni', href: '/#medni' },
];
---

<footer class="divider-top relative py-footer">
  <span class="draw-line" data-draw aria-hidden="true"></span>
  <div class="wrap flex flex-wrap items-center justify-between gap-6">
    <span class="font-bold text-logo text-paper">Delta<span class="text-cyan">·</span>Climate</span>

    <ul class="flex flex-wrap gap-footergap list-none m-0 p-0 font-mono text-label uppercase tracking-widest" role="list">
      {links.map((l) => (
        <li><a href={l.href} class="text-ink-muted no-underline transition-colors hover:text-paper">{l.label}</a></li>
      ))}
    </ul>

    <p class="m-0 font-mono text-tag tracking-meta text-ink-faint">© {year} Delta Climate Research — Built for the frontier.</p>
  </div>
</footer>
