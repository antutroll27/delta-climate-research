---
// "Night tide" coming-soon page body (Research side). Ties the empty research
// pages to the About night ocean: drifting wave lines, a twinkling star field,
// the ghost numeral bobbing like a berg, and a tide gauge tracking the draft
// revision. Star positions are generated at build time — the page ships as
// static HTML with pure-CSS animation; everything stills under reduced motion.
// Title goes in the default slot so pages can mark up <em> accents.
interface StatusRow {
  k: string;
  v: string;
  live?: boolean;
}
interface Props {
  kicker: string;
  sub: string;
  ghost: string;
  gaugeLabel?: string;
  statusRows?: StatusRow[];
  backHref?: string;
  backLabel?: string;
  nextHref?: string;
  nextLabel?: string;
  notifySubject: string;
}
const {
  kicker,
  sub,
  ghost,
  gaugeLabel,
  statusRows = [],
  backHref = '/#papers',
  backLabel = 'Back to the feed',
  nextHref,
  nextLabel,
  notifySubject,
} = Astro.props;

const stars = Array.from({ length: 70 }, () => ({
  x: +(Math.random() * 100).toFixed(2),
  y: +(Math.random() * 55).toFixed(2),
  d: +(Math.random() * 4).toFixed(2),
  o: +(0.2 + Math.random() * 0.5).toFixed(2),
}));
---

<main class="soon-tide">
  <div class="stars" aria-hidden="true">
    {stars.map((s) => <i style={`left:${s.x}%; top:${s.y}%; animation-delay:${s.d}s; --o:${s.o}`}></i>)}
  </div>

  <span class="ghost-index tide-ghost" aria-hidden="true">{ghost}</span>

  {gaugeLabel && (
    <div class="gauge" aria-hidden="true">
      {Array.from({ length: 9 }, (_, i) => <i style={`bottom:${(i + 1) * 10}%`}></i>)}
      <span class="lvl">{gaugeLabel}</span>
    </div>
  )}

  <div class="sea" aria-hidden="true">
    <svg class="w1" viewBox="0 0 2880 320" preserveAspectRatio="none">
      <path d="M0 160 Q 180 110 360 160 T 720 160 T 1080 160 T 1440 160 T 1800 160 T 2160 160 T 2520 160 T 2880 160" />
    </svg>
    <svg class="w2" viewBox="0 0 2880 320" preserveAspectRatio="none">
      <path d="M0 210 Q 240 170 480 210 T 960 210 T 1440 210 T 1920 210 T 2400 210 T 2880 210" />
    </svg>
    <svg class="w3" viewBox="0 0 2880 320" preserveAspectRatio="none">
      <path d="M0 260 Q 144 235 288 260 T 576 260 T 864 260 T 1152 260 T 1440 260 T 1728 260 T 2016 260 T 2304 260 T 2592 260 T 2880 260" />
    </svg>
  </div>
  <div class="sea-fade" aria-hidden="true"></div>

  <div class="wrap core" data-reveal-group data-stagger="110">
    <p class="sec-kicker">{kicker}</p>
    <h1 class="sec-title tide-title"><slot /></h1>
    <p class="tide-sub">{sub}</p>

    {statusRows.length > 0 && (
      <div class="status corners">
        <span class="ck tl"></span><span class="ck tr"></span><span class="ck bl"></span><span class="ck br"></span>
        {statusRows.map((r) => (
          <span class="st-row">
            <span class="st-k">{r.k}</span>
            {r.live
              ? <span class="st-v st-live"><i class="dot"></i>{r.v}</span>
              : <span class="st-v">{r.v}</span>}
          </span>
        ))}
      </div>
    )}

    <div class="actions">
      <a class="roll-link" href={backHref} data-roll>{backLabel} <span class="arrow" aria-hidden="true">↙</span></a>
      {nextHref && nextLabel && (
        <a class="roll-link" href={nextHref} data-roll>{nextLabel} <span class="arrow" aria-hidden="true">↗</span></a>
      )}
      <a class="accent-link" href={`mailto:hello@delta-climate.example?subject=${encodeURIComponent(notifySubject)}`}>Request a notification ↗</a>
    </div>
  </div>
</main>

<style>
  .soon-tide {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 9rem 6rem;
    background:
      radial-gradient(55% 45% at 70% 25%, rgb(111 202 214 / 0.05), transparent 65%),
      var(--color-base);
  }
  .core { position: relative; z-index: 3; }

  /* star field */
  .stars { position: absolute; inset: 0; z-index: 0; }
  .stars i {
    position: absolute; width: 2px; height: 2px; border-radius: 50%;
    background: var(--color-paper); opacity: var(--o, 0.4);
    animation: tide-twinkle 4s ease-in-out infinite;
  }
  @keyframes tide-twinkle { 0%, 100% { opacity: 0.12; } 50% { opacity: var(--o, 0.6); } }

  /* ghost numeral, bobbing like a berg */
  .tide-ghost {
    position: absolute; right: clamp(0.5rem, 6vw, 7rem); top: 46%; z-index: 1;
    transform: translateY(-50%);
    font-size: clamp(11rem, 30vw, 26rem);
    pointer-events: none;
    animation: tide-bob 9s ease-in-out infinite;
  }
  @keyframes tide-bob {
    0%, 100% { transform: translateY(-50%) rotate(0.4deg); }
    50% { transform: translateY(calc(-50% - 14px)) rotate(-0.5deg); }
  }

  /* tide gauge */
  .gauge {
    position: absolute; right: clamp(2rem, 8vw, 9rem); bottom: 0; z-index: 2;
    height: 34vh; width: 1px; background: var(--color-hairline);
  }
  .gauge i { position: absolute; left: -4px; width: 9px; height: 1px; background: var(--color-cyan-muted); opacity: 0.6; }
  .gauge .lvl {
    position: absolute; right: 1rem; white-space: nowrap;
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.14em;
    color: var(--color-cyan);
    animation: tide-rise 8s ease-in-out infinite;
  }
  @keyframes tide-rise { 0%, 100% { bottom: 30%; } 50% { bottom: 42%; } }

  /* drifting waves */
  .sea { position: absolute; inset-inline: 0; bottom: 0; height: 38vh; z-index: 1; overflow: hidden; }
  .sea svg { position: absolute; bottom: -2px; left: 0; width: 200%; height: 100%; }
  .sea path { fill: none; stroke-width: 1.2; }
  .w1 { animation: tide-drift 26s linear infinite; opacity: 0.5; }
  .w2 { animation: tide-drift 18s linear infinite reverse; opacity: 0.32; }
  .w3 { animation: tide-drift 13s linear infinite; opacity: 0.2; }
  .w1 path { stroke: var(--color-cyan); }
  .w2 path { stroke: var(--color-cyan-muted); }
  .w3 path { stroke: var(--color-bronze); }
  @keyframes tide-drift { to { transform: translateX(-50%); } }
  .sea-fade {
    position: absolute; inset-inline: 0; bottom: 0; height: 38vh; z-index: 2;
    background: linear-gradient(to top, rgb(11 44 46 / 0.35), transparent);
    pointer-events: none;
  }

  .tide-title { max-width: 18ch; }
  .tide-sub {
    margin-top: 1.5rem; max-width: 52ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem); font-weight: 300; line-height: 1.65;
    color: var(--color-ink-muted);
  }

  /* status readout (instrument style, same as the approved WP block) */
  .status {
    display: inline-flex; flex-direction: column; gap: 0.55rem;
    margin-top: clamp(2.5rem, 5vh, 4rem); padding: 1.4rem 1.7rem;
    border: 1px solid var(--color-hairline);
    background: rgb(11 44 46 / 0.25);
  }
  .st-row {
    display: flex; gap: 2.2rem;
    font-family: var(--font-mono); font-size: 0.68rem;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .st-k { min-width: 7ch; color: var(--color-ink-faint); }
  .st-v { color: var(--color-paper); }
  .st-live { color: var(--color-cyan); display: inline-flex; align-items: center; gap: 0.5rem; }
  .st-live .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-cyan);
    animation: tide-blink 1.4s steps(2) infinite;
  }
  @keyframes tide-blink { 50% { opacity: 0.25; } }

  .actions {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(2.5rem, 5vh, 4rem);
  }
  .actions .accent-link { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; }

  @media (max-width: 820px) {
    .tide-ghost { right: -1rem; opacity: 0.6; }
    .gauge { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stars i, .tide-ghost, .gauge .lvl, .w1, .w2, .w3, .st-live .dot { animation: none; }
  }
</style>
