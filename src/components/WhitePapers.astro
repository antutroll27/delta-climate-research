---
// Section 03 — White Papers. Baffait-inspired index rows: big outlined
// numerals that fill bronze when the row crosses the viewport's center band,
// title brightens, excerpt unfolds, a cyan wipe sweeps the row, and hovering
// glues a preview chip to the cursor (desktop). Choreography in
// section-effects.ts; degrades to a fully-visible static list.
const papers = [
  {
    id: '01',
    date: '2026.05',
    cat: 'Blue carbon',
    title: 'Soil organic carbon accounting under VM0033',
    excerpt:
      'Belowground biomass and sediment-core MRV for tidal-wetland restoration — why SOC defensibility separates premium credits.',
    href: '/white-papers/soc-accounting-vm0033',
  },
  {
    id: '02',
    date: '2026.04',
    cat: 'Urban heat',
    title: 'Street-scale heat vulnerability from ECOSTRESS',
    excerpt:
      'Downscaling 70 m land-surface temperature into a sub-block Heat Vulnerability Index for dense Indian wards.',
    href: '/white-papers/ecostress-heat-vulnerability',
  },
  {
    id: '03',
    date: '2026.03',
    cat: 'Materials · CBAM',
    title: 'Embodied-carbon dossiers for the India–UAE corridor',
    excerpt:
      'EPD generation under ISO 14025 and CBAM emissions data for cement, steel and aluminium exporters.',
    href: '/white-papers/embodied-carbon-cbam',
  },
];
---

<section id="papers" class="section" aria-labelledby="papers-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="sec-kicker">03 — White Papers</p>
        <h2 id="papers-title" class="sec-title" data-mask>
          <span class="ln"><span>The thinking</span></span>
          <span class="ln"><span><em>behind</em> the work.</span></span>
        </h2>
      </div>
      <a class="roll-link" href="/white-papers" data-roll>All white papers <span class="arrow" aria-hidden="true">↗</span></a>
    </div>

    <ul class="feed" role="list">
      {papers.map((p, i) => (
        <li>
          <a class="frow" href={p.href} data-band data-chip={i + 1}>
            <span class="f-wipe" data-wipe aria-hidden="true"></span>
            <span class="f-in">
              <span class="f-id" aria-hidden="true">{p.id}</span>
              <span>
                <span class="f-meta">{p.date} — {p.cat}</span>
                <span class="f-title">{p.title}</span>
                <span class="f-ex">{p.excerpt}</span>
              </span>
              <span class="f-arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- cursor-glued preview chip (desktop, motion-permitting) -->
  <div class="chip corners" data-chip-el aria-hidden="true">
    <span class="ck tl"></span><span class="ck tr"></span><span class="ck bl"></span><span class="ck br"></span>
    <span class="cover cover-1 on"></span>
    <span class="cover cover-2"></span>
    <span class="cover cover-3"></span>
    <span class="chip-tag">FIG — WP/01</span>
  </div>
</section>

<style>
  .sec-title { font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; }

  .feed {
    list-style: none;
    margin: clamp(3rem, 7vh, 5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-hairline);
  }
  .frow {
    display: block;
    position: relative;
    border-bottom: 1px solid var(--color-hairline);
    overflow: hidden;
    text-decoration: none;
  }
  .f-wipe {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(111 202 214 / 0.07), rgb(111 202 214 / 0.02));
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }
  .f-in {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(1.2rem, 3vw, 2.6rem);
    align-items: baseline;
    padding: clamp(1.5rem, 3.5vh, 2.4rem) 0.5rem;
    position: relative;
  }
  .f-id {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 300;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(176 141 87 / 0.4);
    transition: color 0.4s ease;
  }
  .frow.active .f-id { color: var(--color-bronze); -webkit-text-stroke: 1px transparent; }
  .f-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 0.4rem;
  }
  .f-title {
    display: block;
    font-size: clamp(1.3rem, 2.5vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--color-paper);
    transition: color 0.4s ease;
  }
  .f-ex {
    display: block;
    margin-top: 0.55rem;
    max-width: 58ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-ink-faint);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .f-arrow {
    font-size: 1.3rem;
    color: var(--color-cyan);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .frow:hover .f-arrow { transform: translate(4px, -4px); }

  /* dimmed/folded resting states only when the band choreography runs */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .f-title { color: rgb(236 237 240 / 0.38); }
    :global(.reveal-ready) .frow.active .f-title { color: var(--color-paper); }
    :global(.reveal-ready) .f-ex { opacity: 0; transform: translateY(6px); }
    :global(.reveal-ready) .frow.active .f-ex { opacity: 1; transform: none; }
    :global(.reveal-ready) .f-arrow { opacity: 0.25; }
    :global(.reveal-ready) .frow.active .f-arrow { opacity: 1; }
  }

  /* cursor-glued preview chip */
  .chip {
    position: fixed;
    z-index: 75;
    top: 0;
    left: 0;
    width: 230px;
    aspect-ratio: 16 / 10;
    pointer-events: none;
    border: 1px solid var(--color-hairline);
    overflow: hidden;
    opacity: 0;
    background: var(--color-surface);
  }
  .chip .cover { position: absolute; inset: 0; opacity: 0; transition: opacity 0.35s ease; }
  .chip .cover.on { opacity: 1; }
  .cover-1 { background: radial-gradient(70% 90% at 30% 20%, rgb(111 202 214 / 0.4), transparent 60%), linear-gradient(140deg, #0e3236, #07191b); }
  .cover-2 { background: radial-gradient(70% 90% at 70% 30%, rgb(176 141 87 / 0.45), transparent 65%), linear-gradient(160deg, #11302a, #060f0e); }
  .cover-3 { background: radial-gradient(80% 80% at 40% 70%, rgb(146 194 203 / 0.35), transparent 60%), linear-gradient(120deg, #1b2b33, #0a1216); }
  .chip-tag {
    position: absolute;
    bottom: 0.5rem;
    left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(236 237 240 / 0.85);
  }
  @media (max-width: 820px), (prefers-reduced-motion: reduce) {
    .chip { display: none; }
  }
</style>
