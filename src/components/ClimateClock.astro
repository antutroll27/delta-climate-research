---
// Climate Clock widget — stacked solid-colour modules in the climateclock.world
// house style: each module is a solid colour block with a black readout showing
// the value in that colour. Live deadline countdown + three lifelines.
// Desktop: fixed below the nav, right edge aligned to the nav gutter.
// Mobile: fixed, centre-right of the hero.
// Data: api.climateclock.world (fetched once, cached 24h); ticks from accurate
// constants immediately so it is never blank, even offline.
---

<div class="cc-wrap" aria-hidden="false">
  <div class="max-w-site mx-auto px-gutter flex justify-end cc-inner">
    <div class="climate-clock" role="group" aria-label="Climate clock: time left to the 1.5°C deadline and global climate-solution lifelines">

      <!-- deadline (red) — live countdown -->
      <div class="cc-mod cc-mod--dead">
        <div class="cc-head">
          <span class="cc-led" aria-hidden="true"></span>
          <span class="cc-label">Time left to 1.5°C</span>
        </div>
        <div class="cc-screen">
          <span class="cc-n" data-yr>3</span><span class="cc-u">Y</span>
          <span class="cc-sep" aria-hidden="true">·</span>
          <span class="cc-n" data-dy>041</span><span class="cc-u">D</span>
          <span class="cc-sep" aria-hidden="true">·</span>
          <span class="cc-n" data-hh>00</span><span class="cc-c">:</span><span class="cc-n" data-mm>00</span><span class="cc-c">:</span><span class="cc-n" data-ss>00</span>
        </div>
      </div>

      <!-- renewables (cyan) — live % -->
      <div class="cc-mod cc-mod--ren">
        <div class="cc-head">
          <span class="cc-arrow" aria-hidden="true">↑</span>
          <span class="cc-label">World energy · renewables</span>
        </div>
        <div class="cc-screen"><span class="cc-n" data-ren>15.555</span><span class="cc-u">%</span></div>
      </div>

      <!-- regenerative agriculture (bronze) -->
      <div class="cc-mod cc-mod--regen">
        <div class="cc-head">
          <span class="cc-arrow" aria-hidden="true">↑</span>
          <span class="cc-label">Regenerative cropland</span>
        </div>
        <div class="cc-screen"><span class="cc-n" data-regen>1,836,452</span><span class="cc-u">ha</span></div>
      </div>

      <!-- indigenous-protected land (teal) -->
      <div class="cc-mod cc-mod--land">
        <div class="cc-head">
          <span class="cc-arrow" aria-hidden="true">↑</span>
          <span class="cc-label">Indigenous-protected land</span>
        </div>
        <div class="cc-screen"><span class="cc-n" data-land>43.5</span><span class="cc-u">M km²</span></div>
      </div>

    </div>
  </div>
</div>

<style>
  /* ── positioning shell ─────────────────────────────────────────
     Absolute inside the hero section (hero is position:relative, overflow:hidden)
     so it scrolls away with the hero instead of persisting over the page.
     Desktop: top-right, pushed down with a clear gap below the nav; right edge
     aligned to the nav gutter via the same max-w-site/px-gutter.              */
  .cc-wrap {
    position: absolute;
    top: 9.75rem;
    inset-inline: 0;
    z-index: 4;
    pointer-events: none;
  }
  .climate-clock { pointer-events: auto; }

  /* ── the widget ────────────────────────────────────────────── */
  .climate-clock {
    width: 18.25rem;
    background: var(--color-base);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 2px;               /* page bg shows through → segmented blocks */
    flex-shrink: 0;
    user-select: none;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }

  /* each module = a solid colour block */
  .cc-mod {
    --c: var(--color-cyan);
    background: var(--c);
    padding: 0.46rem 0.65rem 0.54rem;
    display: flex;
    flex-direction: column;
    gap: 0.39rem;
  }
  .cc-mod--dead  { --c: #eb1c23; }
  .cc-mod--ren   { --c: #6fcad6; }
  .cc-mod--regen { --c: #b08d57; }
  .cc-mod--land  { --c: #4fb0bc; }

  /* header row: label + led/arrow, black on the solid colour */
  .cc-head { display: flex; align-items: center; gap: 0.5rem; }
  .cc-label {
    font-family: var(--font-mono);
    font-size: 0.525rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-base);
  }
  .cc-led {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--color-base);
    flex-shrink: 0;
    animation: cc-pulse 2.2s ease-in-out infinite;
  }
  .cc-arrow {
    font-size: 0.72rem;
    line-height: 1;
    color: var(--color-base);
    flex-shrink: 0;
  }
  @keyframes cc-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.35; transform: scale(0.6); }
  }

  /* black readout, digits in the module colour */
  .cc-screen {
    background: var(--color-base);
    border-radius: 5px;
    padding: 0.3rem 0.5rem;
    display: flex;
    align-items: baseline;
    gap: 0.28rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .cc-n {
    font-size: 0.96rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--c);
  }
  .cc-u {
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
    opacity: 0.7;
    margin-left: -0.12rem;
  }
  .cc-sep {
    font-size: 0.5rem;
    color: var(--c);
    opacity: 0.4;
    align-self: center;
  }
  .cc-c {
    font-size: 0.96rem;
    color: var(--c);
    opacity: 0.55;
    margin: 0 0.5px;
    line-height: 1;
  }
  /* the countdown screen packs more in — let the time group push right */
  .cc-mod--dead .cc-screen { gap: 0.26rem; }

  /* ── mobile: centre-right of the hero, scaled to fit ─────────── */
  @media (max-width: 820px) {
    .cc-wrap {
      top: 50%;
      transform: translateY(-50%);
    }
    .climate-clock { width: min(17rem, 75vw); }
    .cc-n { font-size: 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-led { animation: none; }
  }
</style>

<script>
  // ── data model: constants are the current real values; the API fetch only
  //    keeps them fresh if the org revises a figure. Lifeline value =
  //    initial + rate * secondsSince(origin).  rate = 0 → static.           ──
  const DEADLINE_FALLBACK = '2029-07-22T16:00:00+00:00';
  let deadlineMs = new Date(DEADLINE_FALLBACK).getTime();

  type Lifeline = { key: string; initial: number; rate: number; originMs: number; decimals: number; thousands: boolean };
  const LIFELINES: Record<string, Lifeline> = {
    ren:   { key: 'renewables_1',      initial: 11.4,    rate: 2.0428359571070087e-8, originMs: Date.parse('2020-01-01T00:00:00+00:00'), decimals: 3, thousands: false },
    regen: { key: 'regen_agriculture', initial: 1836452, rate: 0,                     originMs: Date.parse('2021-10-01T00:00:00+00:00'), decimals: 0, thousands: true },
    land:  { key: 'indigenous_land_1', initial: 43.5,    rate: 0,                     originMs: Date.parse('2021-10-01T00:00:00+00:00'), decimals: 1, thousands: false },
  };

  let timer: ReturnType<typeof setInterval> | undefined;
  const pad = (n: number, w: number) => String(Math.floor(n)).padStart(w, '0');

  function fmt(v: number, l: Lifeline) {
    const fixed = v.toFixed(l.decimals);
    return l.thousands ? Number(fixed).toLocaleString('en-US') : fixed;
  }

  function initClock() {
    if (timer) { clearInterval(timer); timer = undefined; }
    const root = document.querySelector('.cc-wrap');
    if (!root) return;

    const yr = root.querySelector('[data-yr]') as HTMLElement | null;
    const dy = root.querySelector('[data-dy]') as HTMLElement | null;
    const hh = root.querySelector('[data-hh]') as HTMLElement | null;
    const mm = root.querySelector('[data-mm]') as HTMLElement | null;
    const ss = root.querySelector('[data-ss]') as HTMLElement | null;
    if (!yr || !dy || !hh || !mm || !ss) return;
    const cells: Record<string, HTMLElement | null> = {
      ren: root.querySelector('[data-ren]'),
      regen: root.querySelector('[data-regen]'),
      land: root.querySelector('[data-land]'),
    };

    const tick = () => {
      const now = Date.now();
      const total = Math.max(0, Math.floor((deadlineMs - now) / 1000));
      yr.textContent = String(Math.floor(total / (365 * 86400)));
      dy.textContent = pad(Math.floor(total / 86400) % 365, 3);
      hh.textContent = pad(Math.floor(total / 3600) % 24, 2);
      mm.textContent = pad(Math.floor(total / 60) % 60, 2);
      ss.textContent = pad(total % 60, 2);
      for (const id in LIFELINES) {
        const cell = cells[id];
        if (!cell) continue;
        const l = LIFELINES[id];
        cell.textContent = fmt(l.initial + l.rate * ((now - l.originMs) / 1000), l);
      }
    };

    tick();
    timer = setInterval(tick, 1000);
    refreshFromApi();
  }

  async function refreshFromApi() {
    try {
      const CACHE_KEY = 'cc:clock';
      let data: any;
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        const c = JSON.parse(cached);
        if (Date.now() - c.at < 86400000) data = c.data;
      }
      if (!data) {
        const ctrl = new AbortController();
        const to = setTimeout(() => ctrl.abort(), 4000);
        const res = await fetch('https://api.climateclock.world/v2/clock.json', { signal: ctrl.signal });
        clearTimeout(to);
        data = (await res.json())?.data;
        if (data) sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), data }));
      }
      const mods = data?.modules;
      if (!mods) return;
      const dl = mods.carbon_deadline_1?.timestamp;
      if (dl) deadlineMs = new Date(dl).getTime();
      for (const id in LIFELINES) {
        const l = LIFELINES[id];
        const m = mods[l.key];
        if (m && m.initial != null && m.rate != null && m.timestamp) {
          l.initial = m.initial;
          l.rate = m.rate;
          l.originMs = new Date(m.timestamp).getTime();
        }
      }
    } catch (e) {
      /* keep constants — already accurate */
    }
  }

  function teardownClock() {
    if (timer) { clearInterval(timer); timer = undefined; }
  }

  initClock();
  document.addEventListener('astro:page-load', initClock);
  document.addEventListener('astro:before-swap', teardownClock);
</script>
