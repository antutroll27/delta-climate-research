---
// Section 01 — About. Centered cathedral in a living GPU wave field: masked
// title with the ghost index to its right, scrub-blur statement, three pillar
// columns, and three image rafts floating on the same sea (about-field.ts —
// the field calms as the section scrolls: data → decision). Static fallbacks:
// without WebGL/motion the rafts render as plain <img> rows and the field is
// a quiet gradient. Type choreography lives in section-effects.ts.
const pillars = [
  { id: '/01', k: 'Climatology', v: 'Climate Risk Assessment · Geospatial Research · Global Climate Modelling', img: '/images/about/climate-science.webp', alt: 'Earth at night from orbit' },
  { id: '/02', k: 'Nature Analytics', v: 'Human–Environment Interactions · Regional Planning · Ecological Outcomes', img: '/images/about/urban-heat.webp', alt: 'Dense city skyline in haze' },
  { id: '/03', k: 'Sectoral Strategy', v: 'Regulatory Alignment · Environmental Compliance · Sustainability Reporting', img: '/images/about/industrial.webp', alt: 'Industrial plant pipework' },
];
---

<section id="about" aria-labelledby="about-title">
  <canvas data-field aria-hidden="true"></canvas>
  <div class="field-dim" aria-hidden="true"></div>

  <div class="sec-frame corners" aria-hidden="true">
    <span class="ck tl"></span><span class="ck tr"></span><span class="ck bl"></span><span class="ck br"></span>
  </div>

  <div class="about-core">
    <p class="sec-kicker">01 About</p>

    <div class="about-head">
      <span class="ghost-index" aria-hidden="true">01</span>
      <h2 id="about-title" class="sec-title" data-mask>
        <span class="ln"><span>Between the data</span></span>
        <span class="ln"><span>and the <em>decision.</em></span></span>
      </h2>
    </div>

    <p class="statement" data-words>
      Delta sits between raw earth-science data and the institutions that must
      act on it — turning <span class="em">decision-grade</span> measurement into
      standards-aligned, <span class="em">defensible</span> adaptation strategy.
    </p>

    <ul class="pillars" role="list" data-reveal-group data-stagger="110">
      {pillars.map((p) => (
        <li class="pillar">
          <span class="p-id">{p.id}</span>
          <span class="p-k">{p.k}</span>
          <span class="p-v" set:html={p.v.replaceAll(' · ', '<br />')} />
        </li>
      ))}
    </ul>

    <!-- water deck: the rafts render here inside the canvas; the <img>s are
         the static fallback (no-JS / reduced-motion / no-WebGL) and the
         texture source for the WebGL rafts. -->
    <div class="water-deck" data-deck>
      {pillars.map((p) => (
        <img data-raft-img src={p.img} alt={p.alt} loading="lazy" decoding="async" width="1200" height="790" />
      ))}
    </div>
  </div>

  <div class="sec-meta" aria-hidden="true">
    <span class="live">OCEAN — LIVE</span><br />
    22.5726°N · 88.3639°E<br />
    EOS / ECOSTRESS
  </div>
</section>

<style>
  #about {
    position: relative;
    overflow: hidden;
    padding-block: clamp(7rem, 16vh, 12rem);
    /* quiet gradient — all the field non-WebGL users get */
    background:
      radial-gradient(60% 45% at 50% 62%, rgb(111 202 214 / 0.05), transparent 70%),
      var(--color-base);
  }

  [data-field] { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* vignette keeps type sovereign and melts the ocean into the page base */
  .field-dim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(52% 38% at 50% 36%, rgb(5 6 6 / 0.58) 0%, rgb(5 6 6 / 0.26) 55%, transparent 80%),
      linear-gradient(to bottom, var(--color-base) 0%, transparent 20%, transparent 80%, var(--color-base) 100%),
      linear-gradient(to right, var(--color-base) 0%, transparent 9%, transparent 91%, var(--color-base) 100%);
  }

  /* crosshair frame around the whole section */
  .sec-frame { position: absolute; inset: clamp(1.2rem, 3vw, 2.6rem); pointer-events: none; z-index: 5; }

  .about-core { position: relative; z-index: 2; text-align: center; }
  .sec-kicker { display: block; text-align: center; margin-bottom: 0; }

  .sec-title {
    position: relative;
    z-index: 1;
    margin: 1.6rem auto 0;
    max-width: none;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
    font-size: clamp(2.6rem, 5.6vw, 5.2rem);
  }

  .about-head { position: relative; }
  /* ghost index — right of the header */
  .ghost-index {
    position: absolute;
    right: clamp(1rem, 5vw, 5rem);
    top: 50%;
    transform: translateY(-54%);
    font-size: clamp(8rem, 19vw, 16rem);
    -webkit-text-stroke: 1px rgb(176 141 87 / 0.22);
    z-index: 0;
  }

  /* the statement — words get .w spans from section-effects.ts (scrub-blur) */
  .statement {
    margin: clamp(3rem, 7vh, 5rem) auto 0;
    max-width: 56ch;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: -0.005em;
    padding-inline: 1.25rem;
    color: var(--color-paper);
  }
  .statement :global(.w) { display: inline-block; white-space: pre-wrap; will-change: opacity, filter; }
  .statement .em {
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 800;
    color: var(--color-cyan);
  }

  /* pillars — three centered columns (rise via the data-reveal-group system) */
  .pillars {
    max-width: 1080px;
    margin: clamp(4rem, 9vh, 7rem) auto 0;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    list-style: none;
    text-align: center;
  }
  .pillar .p-id { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-bronze); display: block; margin-bottom: 0.7rem; }
  .pillar .p-k { font-weight: 400; font-size: 1.45rem; display: block; margin-bottom: 0.55rem; color: var(--color-paper); }
  .pillar .p-v {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    line-height: 1.8;
  }

  /* water deck — the rafts' stage. Fallback <img>s show as a static row
     until the WebGL field marks the section .field-on. */
  .water-deck {
    height: clamp(18rem, 38vh, 26rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-inline: clamp(1.25rem, 4vw, 4rem);
  }
  .water-deck img {
    width: min(26%, 320px);
    height: auto;
    border: 1px solid var(--color-hairline);
    opacity: 0.92;
  }
  :global(#about.field-on) .water-deck img {
    visibility: hidden; /* textures live on — the WebGL rafts take over */
  }

  /* coordinates meta — bottom right */
  .sec-meta {
    position: absolute;
    bottom: clamp(1.6rem, 4vw, 3rem);
    right: clamp(1.6rem, 4vw, 3.2rem);
    z-index: 4;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    text-align: right;
    line-height: 1.8;
  }
  .sec-meta .live { color: var(--color-cyan-muted); }

  @media (max-width: 760px) {
    .pillars { grid-template-columns: 1fr; gap: 2rem; }
    .water-deck { flex-direction: row; flex-wrap: wrap; }
    .water-deck img { width: min(44%, 240px); }
    .ghost-index { right: 0.5rem; }
  }
</style>
