---
// Section 2 — About / mission. 60/40 split.
const pillars = [
  { k: 'Climate science', v: 'Remote sensing, MRV, carbon accounting' },
  { k: 'Urban heat', v: 'Land-surface temperature, vulnerability indices' },
  { k: 'Industrial strategy', v: 'Embodied carbon, trade-corridor compliance' },
];
---

<section id="about" class="section divider-top" aria-labelledby="about-title">
  <span class="draw-line" data-draw aria-hidden="true"></span>
  <div class="wrap grid grid-cols-1 gap-(--space-about-gap) min-[900px]:grid-cols-[6fr_4fr] min-[900px]:items-start">
    <div data-reveal>
      <p class="sec-index">01 — About</p>
      <h2 id="about-title" class="sec-title">
        Between the data and the <em>decision.</em>
      </h2>
      <p class="mt-[1.75rem] max-w-[56ch] text-body leading-[1.6] text-ink-muted">
        Delta Climate Research is a boutique consultancy sitting between raw
        earth-science data and the institutions that must act on it. We turn
        decision-grade measurement into standards-aligned, defensible adaptation
        strategy, bridging climate science, urban-heat research, and industrial
        strategy.
      </p>

      <ul class="list-none m-0 p-0 grid gap-0 mt-[2.5rem]" data-reveal-group data-stagger="80">
        {pillars.map((p) => (
          <li class="flex flex-col gap-[0.3rem] py-[1.1rem] border-t border-hairline [&:last-child]:border-b">
            <span class="font-semibold text-[1.0625rem] text-paper">{p.k}</span>
            <span class="font-mono text-[0.8125rem] text-ink-faint">{p.v}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- data-clip owns this panel's entrance (wipe + fade); no data-reveal here,
         so the GSAP clip and the IntersectionObserver reveal never co-own opacity. -->
    <aside class="about-visual" aria-hidden="true" data-clip style="--clip-radius: 14px;">
      <span class="visual-bg" data-parallax="-0.05" aria-hidden="true"></span>
      <span class="absolute top-[1rem] left-[1rem] font-mono text-[0.6875rem] tracking-[0.14em] text-cyan-muted">FIG. 01 — SYSTEMS MAP</span>
    </aside>
  </div>
</section>

<style>
  .about-visual {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: 14px;
    background:
      radial-gradient(80% 80% at 70% 20%, rgb(111 202 214 / 0.08), transparent 60%),
      var(--color-surface);
  }
  /* parallax layer — drifts slower than the frame for depth */
  .visual-bg {
    position: absolute;
    inset: -12% -4%;
    background: radial-gradient(40% 50% at 30% 30%, rgb(176 141 87 / 0.22), transparent 70%);
    pointer-events: none;
  }
</style>
