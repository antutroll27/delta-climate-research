{
  "name": "delta-climate-research",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/verify-served-data.mjs && astro build && node scripts/prune-dist-assets.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "node scripts/cbam-sync-check.mjs && node --import tsx --test tests/unit/*.test.mjs",
    "report:build": "node scripts/report-build.mjs",
    "check:publication": "node scripts/check-publication-contract.mjs",
    "typecheck": "python3 -m mypy",
    "test:py": "python3 scripts/fetch-canopy.py --self-test && python3 scripts/fetch-canopy.py --check",
    "verify": "npm run check && npm run typecheck && npm run test:py && npm run test:unit && npm run build && npm run report:build && npm run check:publication && npm run test:e2e:built",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "cbam:sync-check": "node scripts/cbam-sync-check.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@paper-design/shaders-react": "^0.0.76",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.1.6",
    "decimal.js": "^10.6.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.23",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^4.7.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
